liste[sayi] d_a;
liste[sayi] d_b;
liste[sayi] d_c;
liste[sayi] d_d;
liste[sayi] d_liste;
liste[sayi] d_liste2;
liste[sayi] d_ptrd;
liste[sayi] d_dims;
liste[sayi] d_bayrak;
sayi d_n = 0;

liste[sayi] l_ofset;
liste[sayi] l_uzunluk;
liste[sayi] l_kap;
liste[sayi] l_veri;
sayi l_n = 0;
liste[sayi] l_bos_of;
liste[sayi] l_bos_kap;

liste[sayi] j_tur;
liste[metin] j_deger;
liste[sayi] j_satir;
liste[sayi] j_sutun;
sayi j_n = 0;

metin g_kaynak = "";
metin g_kaynak_ad = "<girdi>";
sayi g_cp_i = 0;
sayi g_lex_satir = 1;
sayi g_lex_sutun = 1;

metin g_tampon = "";
metin g_bg = "";
sayi g_indent = 0;
sayi g_emit_hedef = 0;

sayi g_ayristir_i = 0;
sayi g_loop = 0;
sayi g_switch = 0;
sayi g_bg_mod = 0;
sayi g_tmp = 0;
sayi g_bg_id = 0;
sayi g_cur_fn = 0;
metin g_cur_class = "";

liste[metin] k_ad;
liste[sayi] k_tip;
liste[sayi] k_seviye;
sayi k_n = 0;
sayi k_seviye_cur = 0;

harita[metin,sayi] t_sinif;
harita[metin,sayi] t_fn;
harita[metin,sayi] t_enum;
harita[metin,sayi] t_global;
liste[metin] t_sinif_adler;

fonk intern_hazir() -> bos {
    eger (intern_n > 0) { don; }
    intern_metin.ekle("");
    intern_map.koy("", 0);
    intern_n = 1;
}

fonk metin_kopya_yeni(metin s) -> metin {
    metin o = "";
    eger (s == yok) { don o; }
    o += s;
    don o;
}

fonk intern_sifirla() -> bos {
    intern_map.bosalt();
    intern_metin.bosalt();
    intern_n = 0;
}

fonk intern(metin s) -> metin {
    intern_hazir();
    eger (s == yok) { s = ""; }
    eger (intern_map.var_mi(s)) {
        don intern_metin.al(intern_map.al(s));
    }
    metin kopya = metin_kopya_yeni(s);
    intern_map.koy(kopya, intern_n);
    intern_metin.ekle(kopya);
    intern_n = intern_n + 1;
    don kopya;
}

fonk derleme_kaynak_ad() -> metin {
    don g_kaynak_ad;
}

fonk metin_esit(metin a, metin b) -> mantik {
    eger (a == yok) { a = ""; }
    eger (b == yok) { b = ""; }
    don a == b;
}

fonk metin_uzun(metin s) -> sayi {
    eger (hata_var()) { don 0; }
    eger (s == yok) { don 0; }
    don upp.uzunluk(s);
}

fonk metin_cp(metin s, sayi i) -> sayi {
    eger (s == yok) { don -1; }
    eger (i < 0 || i >= upp.uzunluk(s)) { don -1; }
    don s[i];
}

fonk metin_adv(metin s, sayi i) -> sayi {
    /* Kod noktası adımı. parser/codegen i += adv ile yürür; bayt değil. */
    eger (s == yok) { don 1; }
    eger (i < 0 || i >= upp.uzunluk(s)) { don 1; }
    don 1;
}

fonk intern_dilim(metin s, sayi bas, sayi son) -> metin {
    eger (s == yok) { s = ""; }
    sayi n = upp.uzunluk(s);
    eger (bas < 0) { bas = 0; }
    eger (son > n) { son = n; }
    eger (son < bas) { son = bas; }
    don intern(upp.metin.kes(s, bas, son - bas));
}

fonk kaynak_lf(metin s) -> metin {
    eger (s == yok) { don yok; }
    sayi n = upp.uzunluk(s);
    sayi i = 0;
    iken (i < n) {
        eger (s[i] == 13) { dur; }
        i = i + 1;
    }
    eger (i >= n) { don intern(s); }
    metin o = "";
    sayi parca = 0;
    i = 0;
    iken (i < n) {
        eger (s[i] == 13) {
            eger (i > parca) { o += upp.metin.kes(s, parca, i - parca); }
            parca = i + 1;
        }
        i = i + 1;
    }
    eger (parca < n) { o += upp.metin.kes(s, parca, n - parca); }
    don intern(o);
}

fonk sayi_metin(sayi n) -> metin {
    eger (n == 0) { don intern("0"); }
    metin o = "";
    eger (n < 0) {
        o += "-";
        n = 0 - n;
    }
    metin haneler = "0123456789";
    metin ters = "";
    iken (n > 0) {
        sayi h = n - (n / 10) * 10;
        ters += upp.metin.kes(haneler, h, 1);
        n = n / 10;
    }
    sayi i = upp.uzunluk(ters) - 1;
    iken (i >= 0) {
        o += upp.metin.kes(ters, i, 1);
        i = i - 1;
    }
    don intern(o);
}

fonk kat(metin a, metin b) -> metin {
    eger (a == yok) { a = ""; }
    eger (b == yok) { b = ""; }
    metin s = "";
    s += a;
    s += b;
    don intern(s);
}

fonk kat3(metin a, metin b, metin c) -> metin {
    don kat(kat(a, b), c);
}

fonk kat4(metin a, metin b, metin c, metin d) -> metin {
    don kat(kat(a, b), kat(c, d));
}

fonk kat5(metin a, metin b, metin c, metin d, metin e) -> metin {
    don kat(kat4(a, b, c, d), e);
}

fonk c_escape(metin s) -> metin {
    eger (s == yok) { s = ""; }
    metin o = "\"";
    sayi i = 0;
    sayi n = upp.uzunluk(s);
    iken (i < n) {
        sayi c = s[i];
        eger (c == 92) { o += "\\\\"; }
        yoksa eger (c == 34) { o += "\\\""; }
        yoksa eger (c == 10) { o += "\\n"; }
        yoksa eger (c == 13) { o += "\\r"; }
        yoksa eger (c == 9) { o += "\\t"; }
        yoksa { o += upp.metin.kes(s, i, 1); }
        i = i + 1;
    }
    o += "\"";
    don intern(o);
}

fonk hex_hane_deger(sayi c) -> sayi {
    eger (c >= 48 && c <= 57) { don c - 48; }
    eger (c >= 97 && c <= 102) { don c - 87; }
    eger (c >= 65 && c <= 70) { don c - 55; }
    don -1;
}

fonk hex_deger(metin lex) -> sayi {
    eger (lex == yok) { don 0; }
    sayi i = 0;
    sayi n = upp.uzunluk(lex);
    sayi isaret = 1;
    eger (i < n && lex[i] == 45) { isaret = 0 - 1; i = i + 1; }
    eger (i + 1 < n && lex[i] == 48 && (lex[i + 1] == 120 || lex[i + 1] == 88)) {
        i = i + 2;
    }
    sayi v = 0;
    iken (i < n) {
        sayi h = hex_hane_deger(lex[i]);
        eger (h < 0) { dur; }
        v = v * 16 + h;
        i = i + 1;
    }
    don v * isaret;
}

fonk sayi_oku(metin lex) -> sayi {
    eger (lex == yok) { don 0; }
    sayi i = 0;
    sayi n = upp.uzunluk(lex);
    sayi isaret = 1;
    eger (i < n && lex[i] == 45) { isaret = 0 - 1; i = i + 1; }
    sayi v = 0;
    iken (i < n) {
        sayi c = lex[i];
        eger (c < 48 || c > 57) { dur; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    don v * isaret;
}

fonk satir_kirp_sol(metin s) -> metin {
    eger (s == yok) { don ""; }
    sayi i = 0;
    sayi n = upp.uzunluk(s);
    iken (i < n && (s[i] == 32 || s[i] == 9 || s[i] == 13)) { i = i + 1; }
    don intern(upp.metin.kes(s, i, n - i));
}

fonk c_on_islemci(metin kod) -> mantik {
    eger (kod == yok) { don yanlis; }
    sayi i = 0;
    sayi n = upp.uzunluk(kod);
    iken (i < n) {
        sayi bas = i;
        iken (i < n && kod[i] != 10) { i = i + 1; }
        metin satir = satir_kirp_sol(upp.metin.kes(kod, bas, i - bas));
        eger (upp.metin.baslar(satir, "#include") || upp.metin.baslar(satir, "#define") || upp.metin.baslar(satir, "#pragma") || upp.metin.baslar(satir, "#if")) {
            don dogru;
        }
        eger (i < n && kod[i] == 10) { i = i + 1; }
    }
    don yanlis;
}

fonk ident_bas(sayi cp) -> mantik {
    eger (cp >= 65 && cp <= 90) { don dogru; }
    eger (cp >= 97 && cp <= 122) { don dogru; }
    eger (cp == 95) { don dogru; }
    eger (cp == 231 || cp == 287 || cp == 305 || cp == 246 || cp == 351 || cp == 252) { don dogru; }
    eger (cp == 199 || cp == 286 || cp == 304 || cp == 214 || cp == 350 || cp == 220) { don dogru; }
    don yanlis;
}

fonk ident_devam(sayi cp) -> mantik {
    eger (cp >= 48 && cp <= 57) { don dogru; }
    don ident_bas(cp);
}

fonk dugum_hazir() -> bos {
    eger (d_n > 0) { don; }
    d_tur.ekle(0);
    d_satir.ekle(0);
    d_sutun.ekle(1);
    d_ad.ekle("");
    d_kaynak.ekle("");
    d_sayi.ekle(0);
    d_a.ekle(0);
    d_b.ekle(0);
    d_c.ekle(0);
    d_d.ekle(0);
    d_liste.ekle(0);
    d_liste2.ekle(0);
    d_ptrd.ekle(0);
    d_dims.ekle(0);
    d_bayrak.ekle(0);
    d_n = 1;
}

fonk dugum_ok(sayi id) -> mantik {
    eger (id <= 0 || id >= d_n) {
        hata_ver(1, 1, "geçersiz düğüm id");
        don yanlis;
    }
    don dogru;
}

fonk dugum_yeni(sayi tur, sayi satir, sayi sutun) -> sayi {
    eger (hata_var()) { don 0; }
    dugum_hazir();
    d_tur.ekle(tur);
    d_satir.ekle(satir);
    d_sutun.ekle(sutun);
    d_ad.ekle("");
    d_kaynak.ekle(g_kaynak_ad);
    d_sayi.ekle(0);
    d_a.ekle(0);
    d_b.ekle(0);
    d_c.ekle(0);
    d_d.ekle(0);
    d_liste.ekle(0);
    d_liste2.ekle(0);
    d_ptrd.ekle(0);
    d_dims.ekle(0);
    d_bayrak.ekle(0);
    sayi id = d_n;
    d_n = d_n + 1;
    don id;
}

fonk dugum_tur(sayi id) -> sayi {
    eger (id == 0) { don 0; }
    eger (!dugum_ok(id)) { don 0; }
    don d_tur.al(id);
}

fonk dugum_satir(sayi id) -> sayi {
    eger (id == 0) { don 0; }
    eger (!dugum_ok(id)) { don 0; }
    don d_satir.al(id);
}

fonk dugum_sutun(sayi id) -> sayi {
    eger (id == 0) { don 1; }
    eger (!dugum_ok(id)) { don 1; }
    don d_sutun.al(id);
}

