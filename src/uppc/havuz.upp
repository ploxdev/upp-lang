/* Native derleyici havuzu — saf u++ SoA (liste/harita).
 * İşaretçi yok. Id 0 = yok; gerçek kayıtlar 1….
 * guvensiz içinde liste/düğüm deposuna işaretçi alıp sonra ekle/dugum_yeni
 * deyip aynı işaretçiyi kullanmak tanımsızdır; bu API yalnızca sayi id döner. */

sayi g_os_hedef = -1;
metin g_gcc_log = "";

harita[metin,sayi] intern_map;
liste[metin] intern_metin;
sayi intern_n = 0;

liste[sayi] d_tur;
liste[sayi] d_satir;
liste[sayi] d_sutun;
liste[metin] d_ad;
liste[metin] d_kaynak;
