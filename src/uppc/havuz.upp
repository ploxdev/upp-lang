fonk kapsam_sifirla() -> bos {
    k_n = 0;
    k_seviye_cur = 0;
}

fonk kapsam_ac() -> bos {
    k_seviye_cur = k_seviye_cur + 1;
}

fonk kapsam_kapat() -> bos {
    iken (k_n > 0 && k_seviye.al(k_n - 1) == k_seviye_cur) {
        k_n = k_n - 1;
    }
    eger (k_seviye_cur > 0) {
        k_seviye_cur = k_seviye_cur - 1;
    }
}

fonk kapsam_bagla(metin ad, sayi ty) -> bos {
    eger (k_seviye_cur <= 0) { kapsam_ac(); }
    eger (k_n == k_ad.uzunluk()) {
        k_ad.ekle(intern(ad));
        k_tip.ekle(ty);
        k_seviye.ekle(k_seviye_cur);
    } yoksa {
        k_ad.yaz(k_n, intern(ad));
        k_tip.yaz(k_n, ty);
        k_seviye.yaz(k_n, k_seviye_cur);
    }
    k_n = k_n + 1;
}

fonk kapsam_bul(metin ad) -> sayi {
    eger (ad == yok) { ad = ""; }
    sayi i = k_n - 1;
    iken (i >= 0) {
        eger (metin_esit(k_ad.al(i), ad)) { don k_tip.al(i); }
        i = i - 1;
    }
    don 0;
}

fonk kapsam_yerel_var(metin ad) -> mantik {
    eger (ad == yok) { ad = ""; }
    eger (k_n <= 0) { don yanlis; }
    sayi sev = k_seviye_cur;
    sayi i = k_n - 1;
    iken (i >= 0 && k_seviye.al(i) == sev) {
        eger (metin_esit(k_ad.al(i), ad)) { don dogru; }
        i = i - 1;
    }
    don yanlis;
}

fonk tablo_sifirla() -> bos {
    t_sinif.bosalt();
    t_fn.bosalt();
    t_enum.bosalt();
    t_global.bosalt();
    t_sinif_adler.bosalt();
}

fonk tablo_yaz(sayi kind, metin ad, sayi id) -> sayi {
    metin k = intern(ad);
    eger (kind == 0) {
        eger (t_sinif.var_mi(k)) {
            t_sinif.koy(k, id);
            don 1;
        }
        t_sinif.koy(k, id);
        t_sinif_adler.ekle(k);
        don 0;
    }
    eger (kind == 1) {
        eger (t_fn.var_mi(k)) {
            t_fn.koy(k, id);
            don 1;
        }
        t_fn.koy(k, id);
        don 0;
    }
    eger (kind == 2) {
        eger (t_enum.var_mi(k)) {
            t_enum.koy(k, id);
            don 1;
        }
        t_enum.koy(k, id);
        don 0;
    }
    eger (t_global.var_mi(k)) {
        t_global.koy(k, id);
        don 1;
    }
    t_global.koy(k, id);
    don 0;
}

fonk tablo_bul(sayi kind, metin ad) -> sayi {
    eger (ad == yok) { ad = ""; }
    eger (kind == 0) {
        eger (t_sinif.var_mi(ad)) { don t_sinif.al(ad); }
        don 0;
    }
    eger (kind == 1) {
        eger (t_fn.var_mi(ad)) { don t_fn.al(ad); }
        don 0;
    }
    eger (kind == 2) {
        eger (t_enum.var_mi(ad)) { don t_enum.al(ad); }
        don 0;
    }
    eger (t_global.var_mi(ad)) { don t_global.al(ad); }
    don 0;
}

fonk tablo_sinif_sayisi() -> sayi {
    don t_sinif_adler.uzunluk();
}

fonk tablo_sinif_ad(sayi i) -> metin {
    eger (i < 0 || i >= t_sinif_adler.uzunluk()) {
        hata_ver(1, 1, "sınıf tablosu indeksi sınır dışında");
        don "";
    }
    don t_sinif_adler.al(i);
}

fonk tablo_sinif_id(sayi i) -> sayi {
    eger (i < 0 || i >= t_sinif_adler.uzunluk()) {
        hata_ver(1, 1, "sınıf tablosu indeksi sınır dışında");
        don 0;
    }
    don t_sinif.al(t_sinif_adler.al(i));
}

fonk os_dosya_yaz(metin yol, metin data) -> mantik {
    eger (yol == yok || metin_esit(yol, "")) { don yanlis; }
    eger (data == yok) { data = ""; }
    upp.yol.klasor_olustur(upp.yol.dizin(yol));
    don upp.dosya_yaz(yol, data) != 0;
}

fonk os_dosya_var(metin yol) -> mantik {
    eger (yol == yok || metin_esit(yol, "")) { don yanlis; }
    don upp.dosya_var_mi(yol);
}

fonk os_yol_dizin(metin yol) -> metin {
    don intern(upp.yol.dizin(yol));
}

fonk os_yol_birlestir(metin dir, metin rel) -> metin {
    don intern(upp.yol.birlestir(dir, rel));
}

fonk os_yol_gercek(metin yol) -> metin {
    don intern(upp.yol.gercek(yol));
}

fonk os_cwd() -> metin {
    don intern(upp.yol.calisma());
}

fonk os_yol_mutlak_mi(metin yol) -> mantik {
    don upp.yol.mutlak_mi(yol);
}

fonk os_runtime_dene(metin kok) -> metin {
    eger (kok == yok || metin_esit(kok, "")) { don ""; }
    metin a = upp.yol.birlestir(kok, "src/runtime/upp_runtime.c");
    eger (upp.dosya_var_mi(a)) { don intern(a); }
    metin b = upp.yol.birlestir(kok, "runtime/upp_runtime.c");
    eger (upp.dosya_var_mi(b)) { don intern(b); }
    don "";
}

fonk os_runtime_bul() -> metin {
    metin hit = os_runtime_dene(upp.yol.calisma());
    eger (!metin_esit(hit, "")) { don hit; }
    metin d = upp.sistem.exe_dizin();
    sayi i = 0;
    iken (i < 6) {
        hit = os_runtime_dene(d);
        eger (!metin_esit(hit, "")) { don hit; }
        metin ust = upp.yol.dizin(d);
        eger (metin_esit(ust, d) || metin_esit(ust, "")) { dur; }
        d = ust;
        i = i + 1;
    }
    don "";
}

metin g_ozel_runtime_yol = "";

fonk os_runtime_ozel_yaz(metin yol) -> bos {
    g_ozel_runtime_yol = yol;
}

fonk os_runtime_oku() -> metin {
    eger (!metin_esit(g_ozel_runtime_yol, "")) {
        eger (upp.dosya_var_mi(g_ozel_runtime_yol)) {
            oto s = upp.dosya_oku(g_ozel_runtime_yol);
            eger (s != yok) { don intern(s); }
        }
    }
    metin p = os_runtime_bul();
    eger (metin_esit(p, "")) { don intern(""); }
    metin s = upp.dosya_oku(p);
    eger (s == yok) { don intern(""); }
    don intern(s);
}

fonk os_gcc_aday_dene(metin p) -> metin {
    eger (upp.dosya_var_mi(p)) { don intern(p); }
    don "";
}

fonk os_gcc_bul() -> metin {
    metin p = upp.sistem.komut_bul("gcc");
    eger (p != yok && !metin_esit(p, "")) { don intern(p); }
    p = os_gcc_aday_dene("C:/msys64/ucrt64/bin/gcc.exe");
    eger (!metin_esit(p, "")) { don p; }
    p = os_gcc_aday_dene("C:/msys64/mingw64/bin/gcc.exe");
    eger (!metin_esit(p, "")) { don p; }
    p = os_gcc_aday_dene("C:/msys64/clang64/bin/gcc.exe");
    eger (!metin_esit(p, "")) { don p; }
    p = os_gcc_aday_dene("C:/mingw64/bin/gcc.exe");
    eger (!metin_esit(p, "")) { don p; }
    p = os_gcc_aday_dene("C:/MinGW/bin/gcc.exe");
    eger (!metin_esit(p, "")) { don p; }
    p = os_gcc_aday_dene("/usr/bin/gcc");
    eger (!metin_esit(p, "")) { don p; }
    p = os_gcc_aday_dene("/usr/local/bin/gcc");
    eger (!metin_esit(p, "")) { don p; }
    don intern("");
}

fonk os_yol_bosluk_var(metin s) -> mantik {
    eger (s == yok) { don yanlis; }
    sayi i = 0;
    sayi n = upp.uzunluk(s);
    iken (i < n) {
        eger (s[i] == 32) { don dogru; }
        i = i + 1;
    }
    don yanlis;
}

fonk os_cmd_parca(metin s) -> metin {
    eger (os_yol_bosluk_var(s)) { don os_tirnak(s); }
    don s;
}

fonk os_gcc_cagir(metin gcc, metin c_yol, metin exe_yol) -> sayi {
    g_gcc_log = metin_kopya_yeni("");
    eger (gcc == yok || metin_esit(gcc, "") || c_yol == yok || exe_yol == yok) { don 1; }
    metin cmd = metin_kopya_yeni(os_cmd_parca(gcc));
    cmd += " -std=gnu11 ";
    oto san = upp.ortam_al("UPP_SANITIZE");
    eger (san != yok && !metin_esit(san, "")) {
        cmd += san;
        cmd += " ";
    }
    eger (os_hedef_al() != 0) {
        cmd += "-pthread ";
        cmd += os_cmd_parca(c_yol);
        cmd += " -o ";
        cmd += os_cmd_parca(exe_yol);
        cmd += " -lm";
    } yoksa {
        cmd += os_cmd_parca(c_yol);
        cmd += " -o ";
        cmd += os_cmd_parca(exe_yol);
        cmd += " -luser32 -lwinmm -lgdi32";
    }
    SurecCikti r = upp.sistem.calistir(cmd);
    eger (r.cikti != yok) { g_gcc_log = r.cikti; }
    don r.kod;
}

fonk os_gcc_cikti() -> metin {
    eger (g_gcc_log == yok) { don intern(""); }
    don intern(g_gcc_log);
}

fonk os_program_calistir(metin yol) -> sayi {
    eger (yol == yok || metin_esit(yol, "")) { don 1; }
    SurecCikti r = upp.sistem.calistir(os_cmd_parca(yol));
    don r.kod;
}

fonk bicim_icinde(metin s, metin ara) -> mantik {
    eger (s == yok || ara == yok) { don yanlis; }
    sayi n = upp.uzunluk(s);
    sayi m = upp.uzunluk(ara);
    eger (m <= 0 || m > n) { don yanlis; }
    sayi i = 0;
    iken (i + m <= n) {
        sayi j = 0;
        mantik ok = dogru;
        iken (j < m) {
            eger (s[i + j] != ara[j]) { ok = yanlis; dur; }
            j = j + 1;
        }
        eger (ok) { don dogru; }
        i = i + 1;
    }
    don yanlis;
}

fonk bicim_kaynak(metin src) -> metin {
    eger (src == yok) { src = ""; }
    eger (upp.uzunluk(src) > 0 && src[0] == 65279) {
        src = intern(upp.metin.kes(src, 1, upp.uzunluk(src) - 1));
    }
    metin out = "";
    sayi depth = 0;
    mantik in_block = yanlis;
    mantik in_triple = yanlis;
    sayi p = 0;
    sayi n = upp.uzunluk(src);
    iken (p < n) {
        sayi bas = p;
        iken (p < n && src[p] != 10 && src[p] != 13) { p = p + 1; }
        metin line = intern(upp.metin.kes(src, bas, p - bas));
        eger (in_block || in_triple) {
            out += line;
            out += "\n";
            eger (in_block && bicim_icinde(line, "*/")) { in_block = yanlis; }
            eger (in_triple) {
                sayi q = 0;
                sayi ln = upp.uzunluk(line);
                iken (q + 2 < ln) {
                    eger (line[q] == 34 && line[q + 1] == 34 && line[q + 2] == 34) {
                        eger (in_triple) { in_triple = yanlis; }
                        yoksa { in_triple = dogru; }
                        q = q + 3;
                        devam;
                    }
                    q = q + 1;
                }
            }
        } yoksa {
            sayi t = 0;
            sayi llen = upp.uzunluk(line);
            iken (t < llen && (line[t] == 32 || line[t] == 9)) { t = t + 1; }
            eger (t >= llen) {
                out += "\n";
            } yoksa {
                sayi slen = llen;
                iken (slen > t && (line[slen - 1] == 32 || line[slen - 1] == 9)) { slen = slen - 1; }
                metin stripped = intern(upp.metin.kes(line, t, slen - t));
                sayi lead = depth;
                sayi tmpi = 0;
                sayi sn = upp.uzunluk(stripped);
                iken (tmpi < sn && stripped[tmpi] == 125) {
                    eger (lead > 0) { lead = lead - 1; }
                    tmpi = tmpi + 1;
                    iken (tmpi < sn && (stripped[tmpi] == 32 || stripped[tmpi] == 9)) { tmpi = tmpi + 1; }
                }
                sayi k = 0;
                iken (k < lead) {
                    out += "    ";
                    k = k + 1;
                }
                out += stripped;
                out += "\n";
                sayi i = 0;
                mantik in_str = yanlis;
                mantik esc = yanlis;
                iken (i < llen) {
                    sayi ch = line[i];
                    sayi nxt = -1;
                    eger (i + 1 < llen) { nxt = line[i + 1]; }
                    eger (in_str) {
                        eger (esc) { esc = yanlis; }
                        yoksa eger (ch == 92) { esc = dogru; }
                        yoksa eger (ch == 34) { in_str = yanlis; }
                        i = i + 1;
                        devam;
                    }
                    eger (ch == 34 && nxt == 34 && i + 2 < llen && line[i + 2] == 34) {
                        in_triple = dogru;
                        i = i + 3;
                        sayi r = i;
                        iken (r + 2 < llen) {
                            eger (line[r] == 34 && line[r + 1] == 34 && line[r + 2] == 34) {
                                in_triple = yanlis;
                                i = r + 3;
                                dur;
                            }
                            r = r + 1;
                        }
                        eger (in_triple) { dur; }
                        devam;
                    }
                    eger (ch == 34) {
                        in_str = dogru;
                        i = i + 1;
                        devam;
                    }
                    eger (ch == 47 && nxt == 47) { dur; }
                    eger (ch == 47 && nxt == 42) {
                        in_block = dogru;
                        i = i + 2;
                        metin kuyruk = intern(upp.metin.kes(line, i, llen - i));
                        eger (bicim_icinde(kuyruk, "*/")) { in_block = yanlis; }
                        dur;
                    }
                    eger (ch == 123) { depth = depth + 1; }
                    yoksa eger (ch == 125) {
                        eger (depth > 0) { depth = depth - 1; }
                    }
                    i = i + 1;
                }
            }
        }
        eger (p < n && src[p] == 13) { p = p + 1; }
        eger (p < n && src[p] == 10) { p = p + 1; }
    }
    don intern(out);
}

fonk bicim_norm(metin ham) -> metin {
    eger (ham == yok) { ham = ""; }
    metin o = "";
    sayi i = 0;
    sayi n = upp.uzunluk(ham);
    eger (n > 0 && ham[0] == 65279) { i = 1; }
    iken (i < n) {
        eger (ham[i] != 13) { o += upp.metin.kes(ham, i, 1); }
        i = i + 1;
    }
    don intern(o);
}

fonk os_bicim_dosya(metin yol, sayi kontrol) -> sayi {
    eger (yol == yok || metin_esit(yol, "")) { don 1; }
    metin ham = upp.dosya_oku(yol);
    eger (ham == yok) { ham = ""; }
    metin yeni = bicim_kaynak(ham);
    eger (kontrol != 0) {
        eger (!metin_esit(bicim_norm(ham), yeni)) { don 1; }
        don 0;
    }
    eger (!os_dosya_yaz(yol, yeni)) { don 1; }
    don 0;
}

