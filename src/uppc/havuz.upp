fonk liste_hazir() -> bos {
    eger (l_n > 0) { don; }
    l_ofset.ekle(0);
    l_uzunluk.ekle(0);
    l_kap.ekle(0);
    l_n = 1;
}

fonk liste_ok(sayi id) -> mantik {
    eger (id <= 0 || id >= l_n) {
        hata_ver(1, 1, "geçersiz liste id");
        don yanlis;
    }
    don dogru;
}

fonk liste_buyut(sayi id) -> bos {
    sayi eski_of = l_ofset.al(id);
    sayi eski_n = l_uzunluk.al(id);
    sayi eski_kap = l_kap.al(id);
    sayi yeni_kap = eski_kap;
    eger (yeni_kap <= 0) { yeni_kap = 4; }
    yoksa {
        eger (yeni_kap > 4611686018427387903) {
            hata_ver(1, 1, "liste kapasitesi taştı");
            don;
        }
        yeni_kap = yeni_kap * 2;
    }
    eger (eski_kap > 0 && eski_of + eski_kap == l_veri.uzunluk()) {
        sayi i = eski_kap;
        iken (i < yeni_kap) {
            l_veri.ekle(0);
            i = i + 1;
        }
        l_kap.yaz(id, yeni_kap);
        don;
    }
    sayi bi = 0;
    iken (bi < l_bos_of.uzunluk()) {
        eger (l_bos_kap.al(bi) >= yeni_kap) {
            sayi yeni_of = l_bos_of.al(bi);
            sayi i = 0;
            iken (i < eski_n) {
                l_veri.yaz(yeni_of + i, l_veri.al(eski_of + i));
                i = i + 1;
            }
            l_ofset.yaz(id, yeni_of);
            l_kap.yaz(id, l_bos_kap.al(bi));
            l_bos_of.sil(bi);
            l_bos_kap.sil(bi);
            eger (eski_kap > 0) {
                l_bos_of.ekle(eski_of);
                l_bos_kap.ekle(eski_kap);
            }
            don;
        }
        bi = bi + 1;
    }
    sayi yeni_of = l_veri.uzunluk();
    sayi i = 0;
    iken (i < eski_n) {
        l_veri.ekle(l_veri.al(eski_of + i));
        i = i + 1;
    }
    iken (i < yeni_kap) {
        l_veri.ekle(0);
        i = i + 1;
    }
    l_ofset.yaz(id, yeni_of);
    l_kap.yaz(id, yeni_kap);
    eger (eski_kap > 0) {
        l_bos_of.ekle(eski_of);
        l_bos_kap.ekle(eski_kap);
    }
}

fonk liste_yeni() -> sayi {
    eger (hata_var()) { don 0; }
    liste_hazir();
    l_ofset.ekle(0);
    l_uzunluk.ekle(0);
    l_kap.ekle(0);
    sayi id = l_n;
    l_n = l_n + 1;
    don id;
}

fonk liste_ekle(sayi id, sayi oge) -> bos {
    eger (id == 0) { don; }
    eger (!liste_ok(id)) { don; }
    eger (l_uzunluk.al(id) >= l_kap.al(id)) {
        liste_buyut(id);
    }
    l_veri.yaz(l_ofset.al(id) + l_uzunluk.al(id), oge);
    l_uzunluk.yaz(id, l_uzunluk.al(id) + 1);
}

fonk liste_uzunluk(sayi id) -> sayi {
    eger (id == 0) { don 0; }
    eger (!liste_ok(id)) { don 0; }
    don l_uzunluk.al(id);
}

fonk liste_al(sayi id, sayi i) -> sayi {
    eger (id == 0) { don 0; }
    eger (!liste_ok(id)) { don 0; }
    eger (i < 0 || i >= l_uzunluk.al(id)) {
        hata_ver(1, 1, "liste indeksi sınır dışında");
        don 0;
    }
    don l_veri.al(l_ofset.al(id) + i);
}

fonk liste_yaz(sayi id, sayi i, sayi v) -> bos {
    eger (id == 0) { don; }
    eger (!liste_ok(id)) { don; }
    eger (i < 0 || i >= l_uzunluk.al(id)) {
        hata_ver(1, 1, "liste indeksi sınır dışında");
        don;
    }
    l_veri.yaz(l_ofset.al(id) + i, v);
}

fonk liste_kisalt(sayi id) -> bos {
    eger (id == 0) { don; }
    eger (!liste_ok(id)) { don; }
    eger (l_uzunluk.al(id) > 0) {
        l_uzunluk.yaz(id, l_uzunluk.al(id) - 1);
    }
}

fonk jeton_hazir() -> bos {
    eger (j_n > 0) { don; }
    j_tur.ekle(0);
    j_deger.ekle("");
    j_satir.ekle(0);
    j_sutun.ekle(1);
    j_n = 1;
}

fonk jeton_ok(sayi id) -> mantik {
    eger (id <= 0 || id >= j_n) {
        hata_ver(1, 1, "geçersiz jeton id");
        don yanlis;
    }
    don dogru;
}

fonk jeton_yeni(sayi tur, metin deger, sayi satir, sayi sutun) -> sayi {
    eger (hata_var()) { don 0; }
    jeton_hazir();
    eger (j_n == j_tur.uzunluk()) {
        j_tur.ekle(tur);
        j_deger.ekle(intern(deger));
        j_satir.ekle(satir);
        j_sutun.ekle(sutun);
    } yoksa {
        j_tur.yaz(j_n, tur);
        j_deger.yaz(j_n, intern(deger));
        j_satir.yaz(j_n, satir);
        j_sutun.yaz(j_n, sutun);
    }
    sayi id = j_n;
    j_n = j_n + 1;
    don id;
}

fonk jeton_tur(sayi id) -> sayi {
    eger (id == 0) { don 0; }
    eger (!jeton_ok(id)) { don 0; }
    don j_tur.al(id);
}

fonk jeton_deger(sayi id) -> metin {
    eger (id == 0) { don ""; }
    eger (!jeton_ok(id)) { don ""; }
    don j_deger.al(id);
}

fonk jeton_satir(sayi id) -> sayi {
    eger (id == 0) { don 0; }
    eger (!jeton_ok(id)) { don 0; }
    don j_satir.al(id);
}

fonk jeton_sutun(sayi id) -> sayi {
    eger (id == 0) { don 1; }
    eger (!jeton_ok(id)) { don 1; }
    don j_sutun.al(id);
}

fonk jeton_sayisi() -> sayi {
    don j_n;
}

fonk jeton_sifirla() -> bos {
    eger (j_tur.uzunluk() == 0) {
        j_n = 0;
        don;
    }
    j_n = 1;
}

fonk kaynak_ayarla(metin s, metin ad) -> bos {
    eger (s == yok) { s = ""; }
    eger (upp.uzunluk(s) > 0 && s[0] == 65279) {
        s = intern(upp.metin.kes(s, 1, upp.uzunluk(s) - 1));
    }
    g_kaynak = s;
    g_cp_i = 0;
    g_lex_satir = 1;
    g_lex_sutun = 1;
    eger (ad == yok || metin_esit(ad, "")) {
        g_kaynak_ad = intern("<girdi>");
    } yoksa {
        g_kaynak_ad = intern(ad);
    }
}

fonk lex_kaynak_ad_guncelle(metin ad) -> bos {
    eger (ad == yok || metin_esit(ad, "")) { don; }
    g_kaynak_ad = intern(ad);
    g_lex_satir = 0;
    g_lex_sutun = 1;
}

fonk lex_yorum_govde(metin govde) -> bos {
    eger (govde == yok) { don; }
    sayi i = 0;
    sayi n = upp.uzunluk(govde);
    iken (i < n && (govde[i] == 32 || govde[i] == 9)) { i = i + 1; }
    metin isaret = "@upp-kaynak";
    sayi m = upp.uzunluk(isaret);
    eger (i + m > n) { don; }
    sayi j = 0;
    iken (j < m) {
        eger (govde[i + j] != isaret[j]) { don; }
        j = j + 1;
    }
    i = i + m;
    eger (i < n && govde[i] != 32 && govde[i] != 9) { don; }
    iken (i < n && (govde[i] == 32 || govde[i] == 9)) { i = i + 1; }
    sayi son = n;
    iken (son > i) {
        sayi c = govde[son - 1];
        eger (c != 32 && c != 9 && c != 13) { dur; }
        son = son - 1;
    }
    eger (son <= i) { don; }
    lex_kaynak_ad_guncelle(intern(upp.metin.kes(govde, i, son - i)));
}

fonk lex_kaynak_metin() -> metin {
    don g_kaynak;
}

fonk lex_cp() -> sayi {
    eger (g_cp_i >= upp.uzunluk(g_kaynak)) { don -1; }
    don upp.metin.kod(g_kaynak, g_cp_i);
}

fonk lex_bitis() -> mantik {
    don g_cp_i >= upp.uzunluk(g_kaynak);
}

fonk lex_pos() -> sayi {
    don g_cp_i;
}

fonk lex_satir() -> sayi {
    don g_lex_satir;
}

fonk lex_sutun() -> sayi {
    don g_lex_sutun;
}

fonk lex_ilerle() -> sayi {
    eger (g_cp_i >= upp.uzunluk(g_kaynak)) { don -1; }
    sayi cp = upp.metin.kod(g_kaynak, g_cp_i);
    g_cp_i = g_cp_i + 1;
    eger (cp == 10) {
        g_lex_satir = g_lex_satir + 1;
        g_lex_sutun = 1;
    } yoksa {
        g_lex_sutun = g_lex_sutun + 1;
    }
    don cp;
}

fonk lex_dilim(sayi bas, sayi son) -> metin {
    don intern_dilim(g_kaynak, bas, son);
}

fonk lex_cp_ileri(sayi kac) -> sayi {
    sayi p = g_cp_i + kac;
    eger (p < 0 || p >= upp.uzunluk(g_kaynak)) { don -1; }
    don upp.metin.kod(g_kaynak, p);
}

fonk tampon_sifirla() -> bos {
    g_tampon = metin_kopya_yeni("");
    g_indent = 0;
}

fonk tampon_yaz(metin s) -> bos {
    eger (s == yok) { s = ""; }
    g_tampon += s;
}

fonk tampon_yaz_sayi(sayi n) -> bos {
    g_tampon += sayi_metin(n);
}

fonk tampon_al() -> metin {
    don g_tampon;
}

fonk bg_yigin_sifirla() -> bos {
    g_bg = metin_kopya_yeni("");
}

fonk bg_yigin_ekle(metin s) -> bos {
    eger (s == yok) { s = ""; }
    g_bg += s;
}

fonk bg_yigin_al() -> metin {
    don g_bg;
}

fonk emit(metin s) -> bos {
    eger (s == yok) { s = ""; }
    eger (g_emit_hedef == 1) {
        eger (metin_esit(s, "")) {
            g_bg += "\n";
            don;
        }
        sayi i = 0;
        iken (i < g_indent) {
            g_bg += "    ";
            i = i + 1;
        }
        g_bg += s;
        g_bg += "\n";
        don;
    }
    eger (metin_esit(s, "")) {
        g_tampon += "\n";
        don;
    }
    sayi k = 0;
    iken (k < g_indent) {
        g_tampon += "    ";
        k = k + 1;
    }
    g_tampon += s;
    g_tampon += "\n";
}

fonk emit_hedef_yaz(sayi v) -> bos {
    eger (v != 0) { g_emit_hedef = 1; }
    yoksa { g_emit_hedef = 0; }
}

fonk os_hedef_yaz(sayi v) -> bos {
    eger (v != 0) { g_os_hedef = 1; }
    yoksa { g_os_hedef = 0; }
}

fonk os_host_linux() -> sayi {
    metin p = upp.yol.birlestir("a", "b");
    sayi i = 0;
    sayi n = upp.uzunluk(p);
    iken (i < n) {
        sayi c = p[i];
        eger (c == 47) { don 1; }
        eger (c == 92) { don 0; }
        i = i + 1;
    }
    don 0;
}

fonk os_hedef_al() -> sayi {
    eger (g_os_hedef < 0) {
        g_os_hedef = os_host_linux();
    }
    don g_os_hedef;
}

