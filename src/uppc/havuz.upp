    d_tur.bosalt();
    d_satir.bosalt();
    d_sutun.bosalt();
    d_ad.bosalt();
    d_kaynak.bosalt();
    d_sayi.bosalt();
    d_a.bosalt();
    d_b.bosalt();
    d_c.bosalt();
    d_d.bosalt();
    d_liste.bosalt();
    d_liste2.bosalt();
    d_ptrd.bosalt();
    d_dims.bosalt();
    d_bayrak.bosalt();
    d_n = 0;
    l_ofset.bosalt();
    l_uzunluk.bosalt();
    l_kap.bosalt();
    l_veri.bosalt();
    l_bos_of.temizle();
    l_bos_kap.temizle();
    l_n = 0;
    j_tur.bosalt();
    j_deger.bosalt();
    j_satir.bosalt();
    j_sutun.bosalt();
    j_n = 0;
    kapsam_sifirla();
    tablo_sifirla();
    tampon_sifirla();
    bg_yigin_sifirla();
    g_emit_hedef = 0;
    g_ayristir_i = 0;
    g_loop = 0;
    g_switch = 0;
    g_bg_mod = 0;
    g_tmp = 0;
    g_bg_id = 0;
    hata_analiz_topla_ayarla(0);
    hata_sifirla();
    intern_sifirla();
}
