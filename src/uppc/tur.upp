fonk tip_bos(sayi satir, sayi sutun) -> sayi { don tur_dugum(satir, sutun, "bos", 0, 0); }
fonk tip_sayi(sayi satir, sayi sutun) -> sayi { don tur_dugum(satir, sutun, "sayi", 0, 0); }
fonk tip_bayt(sayi satir, sayi sutun) -> sayi { don tur_dugum(satir, sutun, "bayt", 0, 0); }
fonk tip_ondalik(sayi satir, sayi sutun) -> sayi { don tur_dugum(satir, sutun, "ondalik", 0, 0); }
fonk tip_metin(sayi satir, sayi sutun) -> sayi { don tur_dugum(satir, sutun, "metin", 0, 0); }
fonk tip_mantik(sayi satir, sayi sutun) -> sayi { don tur_dugum(satir, sutun, "mantik", 0, 0); }

fonk cift_tanim_ver(sayi eski, sayi yeni, metin ad) -> bos {
    hata_fmt_basla();
    hata_fmt_yaz("'");
    hata_fmt_yaz(ad);
    hata_fmt_yaz("' birden fazla kez tanımlandı.");
    oto ey = dugum_kaynak(eski);
    oto ny = dugum_kaynak(yeni);
    eger (!metin_esit(ey, "") || !metin_esit(ny, "")) {
        hata_fmt_yaz(" (");
        eger (metin_esit(ey, "")) { hata_fmt_yaz("?"); } yoksa { hata_fmt_yaz(ey); }
        hata_fmt_yaz(" ve ");
        eger (metin_esit(ny, "")) { hata_fmt_yaz("?"); } yoksa { hata_fmt_yaz(ny); }
        hata_fmt_yaz(")");
    }
    hata_fmt_ver(dugum_satir(yeni), dugum_sutun(yeni));
}

fonk tip_void_mi(sayi t) -> mantik {
    don t != 0 && metin_esit(dugum_ad(t), "bos") && dugum_ptrd(t) == 0 && dugum_dims(t) == 0;
}
fonk tip_yok_mi(sayi t) -> mantik {
    don t != 0 && metin_esit(dugum_ad(t), "yok");
}
fonk tip_metin_mi(sayi t) -> mantik {
    don t != 0 && metin_esit(dugum_ad(t), "metin") && dugum_ptrd(t) == 0;
}
// cmetin: başlıksız ham C dizgisi (const char*); yönetilmez, bırakılmaz.
fonk tip_cmetin_mi(sayi t) -> mantik {
    don t != 0 && metin_esit(dugum_ad(t), "cmetin") && dugum_ptrd(t) == 0 && dugum_dims(t) == 0;
}
fonk tip_tamsayi_adi_mi(metin n) -> mantik {
    eger (metin_esit(n, "sayi") || metin_esit(n, "bayt") || metin_esit(n, "ubayt")) { don dogru; }
    eger (metin_esit(n, "s16") || metin_esit(n, "u16") || metin_esit(n, "s32") || metin_esit(n, "u32") || metin_esit(n, "u64")) { don dogru; }
    don yanlis;
}

fonk tip_tam_sayi_mi(sayi t) -> mantik {
    don t != 0 && tip_tamsayi_adi_mi(dugum_ad(t)) && dugum_ptrd(t) == 0 && dugum_dims(t) == 0;
}

fonk arg_tam_sayi_olmali(sayi e) -> bos {
    sayi t = tip_ifade(e);
    eger (hata_var()) { don; }
    eger (!tip_tam_sayi_mi(t)) {
        hata_ver(dugum_satir(e), dugum_sutun(e), "Bu konumda 'sayi' bekleniyor (ondalik/mantik sessizce kesilmez).");
    }
}

fonk tip_sayisal_mi(sayi t) -> mantik {
    eger (t == 0) { don yanlis; }
    eger (dugum_ptrd(t) != 0 || dugum_dims(t) != 0) { don yanlis; }
    oto n = dugum_ad(t);
    don tip_tamsayi_adi_mi(n) || metin_esit(n, "ondalik") || metin_esit(n, "mantik");
}

fonk sabit_araliga_sigar(metin tur, sayi v) -> mantik {
    eger (metin_esit(tur, "bayt")) { don v >= 0 - 128 && v <= 127; }
    eger (metin_esit(tur, "ubayt")) { don v >= 0 && v <= 255; }
    eger (metin_esit(tur, "s16")) { don v >= 0 - 32768 && v <= 32767; }
    eger (metin_esit(tur, "u16")) { don v >= 0 && v <= 65535; }
    eger (metin_esit(tur, "s32")) { don v >= 0 - 2147483648 && v <= 2147483647; }
    eger (metin_esit(tur, "u32")) { don v >= 0 && v <= 4294967295; }
    eger (metin_esit(tur, "u64")) { don v >= 0; }
    eger (metin_esit(tur, "sayi")) { don dogru; }
    don yanlis;
}

fonk soneksiz_sabit_mi(sayi e) -> mantik {
    eger (e == 0) { don yanlis; }
    eger (dugum_tur(e) == DugumTur.D_SABIT && dugum_ptrd(e) == 0 && metin_esit(dugum_ad(e), "sayi")) { don dogru; }
    eger (dugum_tur(e) == DugumTur.D_TEKIL) {
        oto op = dugum_ad(e);
        eger (metin_esit(op, "-") || metin_esit(op, "+")) { don soneksiz_sabit_mi(dugum_a(e)); }
    }
    don yanlis;
}
fonk tip_sinif_deger_mi(sayi t) -> mantik {
    eger (t == 0 || dugum_ptrd(t) != 0 || dugum_dims(t) != 0) { don yanlis; }
    don tablo_bul(0, dugum_ad(t)) != 0;
}
fonk tip_enum_mi(sayi t) -> mantik {
    eger (t == 0 || dugum_ptrd(t) != 0 || dugum_dims(t) != 0) { don yanlis; }
    don tablo_bul(2, dugum_ad(t)) != 0;
}
fonk tip_num_genis(sayi t) -> mantik {
    don tip_sayisal_mi(t) || tip_enum_mi(t);
}

fonk tip_beklenen_mi(sayi t) -> mantik {
    don t != 0 && dugum_ptrd(t) == 0 && dugum_dims(t) == 0 && beklenen_tur_mi(dugum_ad(t));
}

fonk tip_beklenen_bos_mu(sayi t) -> mantik {
    don tip_beklenen_mi(t) && metin_esit(beklenen_deger_ad(dugum_ad(t)), "bos");
}

// hata(e): 'hata' adında yerel bir değişken yokken tek argümanlı çağrı.
fonk hata_kurucu_mi(sayi e) -> mantik {
    eger (e == 0 || dugum_tur(e) != DugumTur.D_CAGRI) { don yanlis; }
    sayi c = dugum_a(e);
    eger (dugum_tur(c) != DugumTur.D_KIMLIK || !metin_esit(dugum_ad(c), "hata")) { don yanlis; }
    eger (kapsam_bul("hata") != 0 || tablo_bul(3, "hata") != 0) { don yanlis; }
    don liste_uzunluk(dugum_liste(e)) == 1;
}

fonk soru_icerir(sayi e) -> mantik {
    eger (e == 0) { don yanlis; }
    sayi t = dugum_tur(e);
    eger (t == DugumTur.D_HATA_YAY) { don dogru; }
    eger (t == DugumTur.D_TUR || t == DugumTur.D_FONK || t == DugumTur.D_BLOK) { don yanlis; }
    eger (soru_icerir(dugum_a(e)) || soru_icerir(dugum_b(e)) || soru_icerir(dugum_c(e))) { don dogru; }
    sayi L = dugum_liste(e);
    sayi i = 0;
    iken (i < liste_uzunluk(L)) {
        eger (soru_icerir(liste_al(L, i))) { don dogru; }
        i = i + 1;
    }
    don yanlis;
}

fonk tip_atanir(sayi dst, sayi src) -> mantik {
    eger (dst == 0 || src == 0) { don yanlis; }
    eger (tip_void_mi(src) || tip_void_mi(dst)) { don yanlis; }
    eger (tip_yok_mi(src)) {
        don tip_metin_mi(dst) || dugum_ptrd(dst) > 0 || tip_fonk_mi(dst) || tip_cmetin_mi(dst);
    }
    // metin → cmetin örtük (verinin kendisi; ödünç). cmetin → metin yalnızca (metin)c ile.
    eger (tip_cmetin_mi(dst)) {
        don tip_cmetin_mi(src) || tip_metin_mi(src);
    }
    eger (tip_cmetin_mi(src)) { don yanlis; }
    eger (tip_ref_metin_mi(dst)) {
        don tip_ref_metin_mi(src) || tip_metin_mi(src);
    }
    eger (tip_ref_dilim_mi(dst)) {
        oto delem = dilim_ref_elem_ad(dugum_ad(dst));
        eger (tip_ref_dilim_mi(src)) {
            don metin_esit(delem, dilim_ref_elem_ad(dugum_ad(src)));
        }
        eger (dugum_dims(src) > 0 && dugum_ptrd(src) == 0 && metin_esit(dugum_ad(src), delem)) {
            don dogru;
        }
        eger (liste_tur_mi(dugum_ad(src)) && dugum_ptrd(src) == 0) {
            don metin_esit(liste_elem_ad(dugum_ad(src)), delem) && (metin_esit(delem, "sayi") || metin_esit(delem, "ondalik"));
        }
        don yanlis;
    }
    eger (dugum_ptrd(dst) > 0 && dugum_ptrd(src) > 0) {
        // bos* her işaretçiye dönüşür; diğerlerinde tür ve derinlik (sayi* / sayi**) aynı olmalı
        eger ((metin_esit(dugum_ad(src), "bos") && dugum_ptrd(src) == 1) || (metin_esit(dugum_ad(dst), "bos") && dugum_ptrd(dst) == 1)) { don dogru; }
        don metin_esit(dugum_ad(src), dugum_ad(dst)) && dugum_ptrd(src) == dugum_ptrd(dst);
    }
    eger (dugum_ptrd(dst) != dugum_ptrd(src)) { don yanlis; }
    eger (dugum_dims(dst) != dugum_dims(src)) { don yanlis; }
    eger (metin_esit(dugum_ad(dst), dugum_ad(src))) { don dogru; }
    eger (tip_enum_mi(dst) && dugum_dims(src) == 0) {
        oto sn = dugum_ad(src);
        don metin_esit(sn, dugum_ad(dst)) || metin_esit(sn, "sayi") || metin_esit(sn, "mantik");
    }
    eger (tip_enum_mi(src) && metin_esit(dugum_ad(dst), "sayi") && dugum_dims(dst) == 0) { don dogru; }
    eger (metin_esit(dugum_ad(dst), "ondalik") && (metin_esit(dugum_ad(src), "sayi") || metin_esit(dugum_ad(src), "bayt") || metin_esit(dugum_ad(src), "mantik"))) { don dogru; }
    eger (metin_esit(dugum_ad(dst), "sayi") && (metin_esit(dugum_ad(src), "mantik") || tip_tamsayi_adi_mi(dugum_ad(src)))) { don dogru; }
    eger (metin_esit(dugum_ad(dst), "mantik") && (metin_esit(dugum_ad(src), "sayi") || metin_esit(dugum_ad(src), "bayt"))) { don dogru; }
    eger (metin_esit(dugum_ad(dst), "bayt") && metin_esit(dugum_ad(src), "mantik")) { don dogru; }
    don yanlis;
}

fonk atama_uyumsuz_ver(sayi satir, sayi sutun, sayi dst, sayi expr) -> bos {
    oto da = tur_aciklama(dst);
    oto sa = tur_aciklama(tip_ifade(expr));
    hata_fmt_basla();
    hata_fmt_yaz("Atama türü uyumsuz: '");
    hata_fmt_yaz(da);
    hata_fmt_yaz("' beklenir, '");
    hata_fmt_yaz(sa);
    hata_fmt_yaz("' verildi.");
    eger (tip_metin_mi(dst) && tip_cmetin_mi(tip_ifade(expr))) {
        hata_fmt_yaz(" cmetin yönetilmeyen bir C dizgisidir; '(metin)c' ile kopyalayın.");
    }
    hata_fmt_ver(satir, sutun);
}

// Geçici (sahipsiz) bir metin cmetin değişkenine konamaz: deyim bitince serbest kalır.
fonk cmetin_gecici_denetle(sayi dst, sayi expr, sayi satir, sayi sutun) -> bos {
    eger (!tip_cmetin_mi(dst) || expr == 0) { don; }
    eger (ifade_rvalue_metin_mi(expr) || interp_dugum_mi(expr)) {
        hata_ver(satir, sutun, "Geçici bir metin cmetin değişkenine konamaz (deyim bitince serbest kalır). Önce bir metin değişkenine atayın.");
    }
}

fonk tip_ifade_atanir(sayi dst, sayi expr) -> mantik {
    eger (tip_beklenen_mi(dst)) {
        oto bn = dugum_ad(dst);
        eger (hata_kurucu_mi(expr)) {
            don tip_ifade_atanir(ad_tur_dugum(beklenen_hata_ad(bn)), liste_al(dugum_liste(expr), 0));
        }
        sayi bs = tip_ifade(expr);
        eger (bs != 0 && dugum_ptrd(bs) == 0 && metin_esit(dugum_ad(bs), bn)) { don dogru; }
        oto dn = beklenen_deger_ad(bn);
        eger (metin_esit(dn, "bos")) { don yanlis; }
        don tip_ifade_atanir(ad_tur_dugum(dn), expr);
    }
    sayi src = tip_ifade(expr);
    eger (tip_atanir(dst, src)) { don dogru; }
    eger (dst != 0 && dugum_ptrd(dst) == 0 && dugum_dims(dst) == 0 && soneksiz_sabit_mi(expr) && tip_tamsayi_adi_mi(dugum_ad(dst))) {
        don sabit_araliga_sigar(dugum_ad(dst), sabit_tamsayi_deger(expr));
    }
    don yanlis;
}

fonk ifade_kisa_devre_mi(sayi e) -> mantik {
    sayi t = 0;
    eger (e == 0) { don yanlis; }
    t = dugum_tur(e);
    eger (t == DugumTur.D_UCLU) { don dogru; }
    eger (t == DugumTur.D_IKIL) {
        oto op = dugum_ad(e);
        eger (metin_esit(op, "&&") || metin_esit(op, "||")) { don dogru; }
        don ifade_kisa_devre_mi(dugum_a(e)) || ifade_kisa_devre_mi(dugum_b(e));
    }
    eger (t == DugumTur.D_TEKIL) { don ifade_kisa_devre_mi(dugum_a(e)); }
    eger (t == DugumTur.D_CAGRI) {
        sayi L = dugum_liste(e);
        sayi i = 0;
        eger (ifade_kisa_devre_mi(dugum_a(e))) { don dogru; }
        iken (i < liste_uzunluk(L)) {
            eger (ifade_kisa_devre_mi(liste_al(L, i))) { don dogru; }
            i = i + 1;
        }
        don yanlis;
    }
    don ifade_kisa_devre_mi(dugum_a(e)) || ifade_kisa_devre_mi(dugum_b(e)) || ifade_kisa_devre_mi(dugum_c(e));
}

fonk ifade_rvalue_metin_mi(sayi e) -> mantik {
    sayi t = 0;
    sayi ty = 0;
    eger (e == 0) { don yanlis; }
    t = dugum_tur(e);
    eger (t == DugumTur.D_KIMLIK) { don yanlis; }
    eger (t == DugumTur.D_UYE) { don yanlis; }
    eger (t == DugumTur.D_SABIT) { don yanlis; }
    eger (t == DugumTur.D_IKIL) {
        eger (metin_esit(dugum_ad(e), "+") && tip_metin_mi(tip_ifade(dugum_a(e))) && tip_metin_mi(tip_ifade(dugum_b(e)))) {
            don dogru;
        }
        don yanlis;
    }
    eger (t == DugumTur.D_INDIS) {
        ty = tip_ifade(dugum_a(e));
        don dugum_c(e) == 0 && liste_tur_mi(dugum_ad(ty)) && metin_esit(liste_elem_ad(dugum_ad(ty)), "metin");
    }
    eger (t == DugumTur.D_CAGRI || t == DugumTur.D_UCLU || t == DugumTur.D_HATA_YAY) {
        ty = tip_ifade(e);
        don tip_metin_mi(ty);
    }
    eger (t == DugumTur.D_DONUSUM) {
        don tip_metin_mi(dugum_sayi(e)) && !tip_metin_mi(tip_ifade(dugum_a(e)));
    }
    don yanlis;
}

fonk ifade_metin_uretken_mi(sayi e) -> mantik {
    sayi t = 0;
    sayi L = 0;
    sayi i = 0;
    eger (e == 0) { don yanlis; }
    eger (ifade_rvalue_metin_mi(e)) { don dogru; }
    t = dugum_tur(e);
    eger (ifade_metin_uretken_mi(dugum_a(e))) { don dogru; }
    eger (ifade_metin_uretken_mi(dugum_b(e))) { don dogru; }
    eger (ifade_metin_uretken_mi(dugum_c(e))) { don dogru; }
    L = dugum_liste(e);
    iken (i < liste_uzunluk(L)) {
        eger (ifade_metin_uretken_mi(liste_al(L, i))) { don dogru; }
        i = i + 1;
    }
    don yanlis;
}

fonk lvalue_mi(sayi e) -> mantik {
    eger (e == 0) { don yanlis; }
    sayi t = dugum_tur(e);
    eger (t == DugumTur.D_KIMLIK) {
        don !metin_esit(dugum_ad(e), "upp") && !tur_adi_mi(dugum_ad(e));
    }
    eger (t == DugumTur.D_UYE || t == DugumTur.D_INDIS) { don dogru; }
    eger (t == DugumTur.D_TEKIL && metin_esit(dugum_ad(e), "*")) { don dogru; }
    don yanlis;
}

fonk tip_yerlesik_sinif(metin ad, metin a, metin ta, metin b, metin tb, metin c, metin tc) -> sayi {
    sayi n = dugum_yeni(DugumTur.D_SINIF, 0, 1);
    dugum_yaz_ad(n, ad);
    sayi F = liste_yeni();
    dugum_yaz_liste(n, F);
    dugum_yaz_liste2(n, liste_yeni());
    eger (!metin_esit(a, "")) {
        sayi f = dugum_yeni(DugumTur.D_ALAN, 0, 1);
        dugum_yaz_ad(f, a);
        dugum_yaz_a(f, tur_dugum(0, 1, ta, 0, 0));
        liste_ekle(F, f);
    }
    eger (!metin_esit(b, "")) {
        sayi f = dugum_yeni(DugumTur.D_ALAN, 0, 1);
        dugum_yaz_ad(f, b);
        dugum_yaz_a(f, tur_dugum(0, 1, tb, 0, 0));
        liste_ekle(F, f);
    }
    eger (!metin_esit(c, "")) {
        sayi f = dugum_yeni(DugumTur.D_ALAN, 0, 1);
        dugum_yaz_ad(f, c);
        dugum_yaz_a(f, tur_dugum(0, 1, tc, 0, 0));
        liste_ekle(F, f);
    }
    tablo_yaz(0, ad, n);
    don n;
}

fonk tip_uyelik_yolu(sayi e, sayi i, sayi L) -> bos {
    eger (e == 0) { don; }
    eger (dugum_tur(e) == DugumTur.D_UYE) {
        tip_uyelik_yolu(dugum_a(e), i, L);
        liste_ekle(L, e);
        don;
    }
    eger (dugum_tur(e) == DugumTur.D_KIMLIK) {
        liste_ekle(L, e);
    }
}

fonk upp_yol(sayi e) -> sayi {
    sayi L = liste_yeni();
    tip_uyelik_yolu(e, 0, L);
    eger (liste_uzunluk(L) < 1) { don 0; }
    sayi first = liste_al(L, 0);
    eger (dugum_tur(first) != DugumTur.D_KIMLIK || !metin_esit(dugum_ad(first), "upp")) { don 0; }
    don L;
}

fonk sayilabilir_dizi_mi(sayi e) -> mantik {
    eger (e == 0) { don yanlis; }
    eger (dugum_tur(e) == DugumTur.D_DIZI_SABIT) { don dogru; }
    eger (dugum_tur(e) == DugumTur.D_KIMLIK) {
        sayi t = kapsam_bul(dugum_ad(e));
        don t != 0 && dugum_dims(t) > 0;
    }
    eger (dugum_tur(e) == DugumTur.D_UYE) {
        sayi t = tip_ifade(e);
        don t != 0 && dugum_dims(t) > 0;
    }
    don yanlis;
}

fonk secim_uygun_tur(sayi t) -> mantik {
    eger (t == 0) { don yanlis; }
    eger (dugum_ptrd(t) != 0 || dugum_dims(t) != 0) { don yanlis; }
    oto n = dugum_ad(t);
    eger (metin_esit(n, "sayi") || metin_esit(n, "mantik") || metin_esit(n, "metin") || tip_tamsayi_adi_mi(n)) { don dogru; }
    don tip_enum_mi(t);
}

fonk secim_sabit_mi(sayi e) -> mantik {
    sayi t = 0;
    sayi k = 0;
    sayi obj_t = 0;
    oto on = "";
    eger (e == 0) { don yanlis; }
    t = dugum_tur(e);
    eger (t == DugumTur.D_SABIT) {
        k = dugum_ptrd(e);
        don k == 0 || k == 3 || k == 2;
    }
    eger (t == DugumTur.D_TEKIL && metin_esit(dugum_ad(e), "-")) {
        don secim_sabit_mi(dugum_a(e));
    }
    eger (t == DugumTur.D_UYE) {
        obj_t = tip_ifade(dugum_a(e));
        eger (obj_t == 0) { don yanlis; }
        on = dugum_ad(obj_t);
        eger (metin_uzun(on) >= 8 && metin_esit(intern_dilim(on, 0, 8), "secenek.")) {
            don dogru;
        }
        don yanlis;
    }
    don yanlis;
}

fonk bg_ad_listesi_kopya(sayi L) -> sayi {
    sayi N = liste_yeni();
    sayi i = 0;
    iken (i < liste_uzunluk(L)) {
        liste_ekle(N, liste_al(L, i));
        i = i + 1;
    }
    don N;
}

fonk bg_liste_ad_var(sayi L, metin ad) -> mantik {
    sayi i = 0;
    iken (i < liste_uzunluk(L)) {
        eger (metin_esit(dugum_ad(liste_al(L, i)), ad)) { don dogru; }
        i = i + 1;
    }
    don yanlis;
}

fonk bg_ident_ekle(sayi idn, sayi declared, sayi used, sayi yer) -> bos {
    oto ad = "";
    sayi ty = 0;
    sayi cap = 0;
    eger (idn == 0 || hata_var()) { don; }
    ad = dugum_ad(idn);
    eger (tur_adi_mi(ad) || metin_esit(ad, "upp") || tablo_bul(2, ad) != 0) { don; }
    eger (bg_liste_ad_var(declared, ad)) { don; }
    eger (bg_liste_ad_var(used, ad)) { don; }
    eger (metin_esit(ad, "kendi")) {
        eger (metin_esit(cur_class_al(), "")) { don; }
        ty = tur_dugum(dugum_satir(yer), dugum_sutun(yer), cur_class_al(), 1, 0);
    } yoksa {
        ty = kapsam_bul(ad);
        eger (ty == 0) { don; }
        ty = tur_kopya(ty);
    }
    eger (dugum_dims(ty) > 0) {
        hata_fmt_basla();
        hata_fmt_yaz("'arkaplan' dizi '");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' yakalayamaz. Elemanı kopyalayın veya diziyi iş parçacığı içinde oluşturun.");
        hata_fmt_ver(dugum_satir(yer), dugum_sutun(yer));
        don;
    }
    eger (liste_tur_mi(dugum_ad(ty)) || harita_tur_mi(dugum_ad(ty))) {
        hata_fmt_basla();
        hata_fmt_yaz("'arkaplan' '");
        hata_fmt_yaz(dugum_ad(ty));
        hata_fmt_yaz("' '");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' yakalayamaz. Koleksiyonu iş parçacığı içinde oluşturun.");
        hata_fmt_ver(dugum_satir(yer), dugum_sutun(yer));
        don;
    }
    eger (metin_esit(dugum_ad(ty), "JSONDeger")) {
        hata_fmt_basla();
        hata_fmt_yaz("'arkaplan' JSONDeger '");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' yakalayamaz. Değeri iş parçacığı içinde okuyun.");
        hata_fmt_ver(dugum_satir(yer), dugum_sutun(yer));
        don;
    }
    eger (beklenen_tur_mi(dugum_ad(ty))) {
        hata_fmt_basla();
        hata_fmt_yaz("'arkaplan' beklenen '");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' yakalayamaz. Önce '.deger()' ile değeri alın.");
        hata_fmt_ver(dugum_satir(yer), dugum_sutun(yer));
        don;
    }
    eger (tip_gorunum_mi(ty)) {
        hata_fmt_basla();
        hata_fmt_yaz("'arkaplan' görünüm '");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' yakalayamaz. Görünümü iş parçacığı içinde oluşturun.");
        hata_fmt_ver(dugum_satir(yer), dugum_sutun(yer));
        don;
    }
    // Sahipli sınıf (metin ya da koleksiyon alanı olan; veri taşıyan 'sirali'
    // dahil) değer olarak yakalanırsa bağlam yapısına sığ kopyalanırdı: dıştaki
    // nesne bırakılınca iş parçacığı serbest belleği okur. Koleksiyonlar gibi
    // yasak; sahipli olmayan sınıflar düz kopyayla güvenlidir.
    eger (tur_sahipli_sinif(ty) != 0) {
        hata_fmt_basla();
        hata_fmt_yaz("'arkaplan' sahipli sınıf '");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' yakalayamaz. Gereken alanları ayrı değişkenlere kopyalayın ya da nesneyi iş parçacığı içinde oluşturun.");
        hata_fmt_ver(dugum_satir(yer), dugum_sutun(yer));
        don;
    }
    cap = kimlik_dugum(dugum_satir(yer), dugum_sutun(yer), ad);
    dugum_yaz_a(cap, ty);
    liste_ekle(used, cap);
}

fonk bg_interp_topla(sayi e, sayi declared, sayi used, sayi yer) -> bos {
    oto raw = "";
    oto text = "";
    oto name = "";
    oto ilk = "";
    sayi n = 0;
    sayi i = 0;
    sayi c = 0;
    sayi adv = 0;
    sayi j = 0;
    sayi k = 0;
    sayi nn = 0;
    sayi nokta = -1;
    eger (e == 0 || dugum_tur(e) != DugumTur.D_SABIT || dugum_ptrd(e) != 2) { don; }
    raw = dugum_ad(e);
    text = metin_coz(raw);
    n = metin_uzun(text);
    i = 0;
    iken (i < n && !hata_var()) {
        c = metin_cp(text, i);
        adv = metin_adv(text, i);
        eger (c == 123 && i + adv < n && metin_cp(text, i + adv) == 123) {
            i = i + adv + metin_adv(text, i + adv);
            devam;
        }
        eger (c == 125 && i + adv < n && metin_cp(text, i + adv) == 125) {
            i = i + adv + metin_adv(text, i + adv);
            devam;
        }
        eger (c == 123) {
            j = i + adv;
            iken (j < n && metin_cp(text, j) != 125) {
                j = j + metin_adv(text, j);
            }
            eger (j >= n) { don; }
            name = intern_dilim(text, i + adv, j);
            eger (!metin_esit(name, "")) {
                nokta = -1;
                k = 0;
                nn = metin_uzun(name);
                iken (k < nn) {
                    eger (metin_cp(name, k) == 46) { nokta = k; }
                    k = k + metin_adv(name, k);
                }
                eger (nokta < 0) { ilk = name; }
                yoksa { ilk = intern_dilim(name, 0, nokta); }
                bg_ident_ekle(kimlik_dugum(dugum_satir(e), dugum_sutun(e), ilk), declared, used, yer);
            }
            i = j + 1;
            devam;
        }
        i = i + adv;
    }
}

fonk bg_ident_topla(sayi n, sayi declared, sayi used, sayi yer) -> bos {
    sayi t = 0;
    sayi L = 0;
    sayi i = 0;
    sayi inner = 0;
    eger (n == 0 || hata_var()) { don; }
    t = dugum_tur(n);
    eger (t == DugumTur.D_DEGISKEN) {
        bg_ident_topla(dugum_c(n), declared, used, yer);
        bg_ident_topla(dugum_b(n), declared, used, yer);
        liste_ekle(declared, kimlik_dugum(dugum_satir(n), dugum_sutun(n), dugum_ad(n)));
        don;
    }
    eger (t == DugumTur.D_KIMLIK) {
        bg_ident_ekle(n, declared, used, yer);
        don;
    }
    eger (t == DugumTur.D_SABIT) {
        // interpolasyon ayrıştırıldıysa parçaları sıradan ifadelerdir: {f(x)}, {a[i]}
        eger (interp_dugum_mi(n)) {
            sayi P = dugum_liste(n);
            her (sayi pi in 0..liste_uzunluk(P)) {
                sayi parca = liste_al(P, pi);
                eger (dugum_tur(parca) == DugumTur.D_SABIT && dugum_ptrd(parca) == 7) { devam; }
                bg_ident_topla(parca, declared, used, yer);
            }
            don;
        }
        bg_interp_topla(n, declared, used, yer);
        don;
    }
    eger (t == DugumTur.D_ARKAPLAN || t == DugumTur.D_ARKAPLAN_IFADE) {
        inner = bg_ad_listesi_kopya(declared);
        bg_ident_topla(dugum_a(n), inner, used, yer);
        don;
    }
    eger (t == DugumTur.D_HER) {
        bg_ident_topla(dugum_b(n), declared, used, yer);
        bg_ident_topla(dugum_d(n), declared, used, yer);
        inner = bg_ad_listesi_kopya(declared);
        liste_ekle(inner, kimlik_dugum(dugum_satir(n), dugum_sutun(n), dugum_ad(n)));
        bg_ident_topla(dugum_c(n), inner, used, yer);
        don;
    }
    bg_ident_topla(dugum_a(n), declared, used, yer);
    bg_ident_topla(dugum_b(n), declared, used, yer);
    bg_ident_topla(dugum_c(n), declared, used, yer);
    bg_ident_topla(dugum_d(n), declared, used, yer);
    L = dugum_liste(n);
    i = 0;
    iken (i < liste_uzunluk(L)) {
        bg_ident_topla(liste_al(L, i), declared, used, yer);
        i = i + 1;
    }
}

fonk bg_yakala(sayi node) -> bos {
    sayi used = 0;
    sayi declared = 0;
    eger (node == 0 || hata_var()) { don; }
    used = liste_yeni();
    declared = liste_yeni();
    bg_ident_topla(dugum_a(node), declared, used, node);
    dugum_yaz_liste2(node, used);
}

fonk sabit_dogru_mu(sayi e) -> mantik {
    eger (e == 0) { don yanlis; }
    don dugum_tur(e) == DugumTur.D_SABIT && dugum_ptrd(e) == 3 && dugum_sayi(e) != 0;
}

fonk her_zaman_doner(sayi stmt) -> mantik {
    eger (stmt == 0) { don yanlis; }
    sayi t = dugum_tur(stmt);
    eger (t == DugumTur.D_DON) { don dogru; }
    eger (t == DugumTur.D_BLOK) {
        sayi L = dugum_liste(stmt);
        sayi i = 0;
        iken (i < liste_uzunluk(L)) {
            eger (her_zaman_doner(liste_al(L, i))) { don dogru; }
            i = i + 1;
        }
        don yanlis;
    }
    eger (t == DugumTur.D_GUVENSIZ || t == DugumTur.D_GUVENLI) { don her_zaman_doner(dugum_a(stmt)); }
    eger (t == DugumTur.D_EGER) {
        don her_zaman_doner(dugum_b(stmt)) && her_zaman_doner(dugum_c(stmt));
    }
    eger (t == DugumTur.D_IKEN) {
        eger (sabit_dogru_mu(dugum_a(stmt))) {
            don her_zaman_doner(dugum_b(stmt));
        }
        don yanlis;
    }
    eger (t == DugumTur.D_DONGU) {
        sayi c = dugum_b(stmt);
        eger (c == 0 || sabit_dogru_mu(c)) {
            don her_zaman_doner(dugum_d(stmt));
        }
        don yanlis;
    }
    eger (t == DugumTur.D_SECIM) {
        sayi L = dugum_liste(stmt);
        eger (liste_uzunluk(L) == 0) { don yanlis; }
        // Bayrak 4: tüm 'sirali' varyantları kapsandı; codegen panikleyen bir
        // 'default' yazdığı için kapsama 'varsayilan' kadar eksiksizdir.
        mantik def = (dugum_bayrak(stmt) & 4) != 0;
        sayi i = 0;
        iken (i < liste_uzunluk(L)) {
            eger (dugum_a(liste_al(L, i)) == 0) { def = dogru; }
            i = i + 1;
        }
        eger (!def) { don yanlis; }
        i = 0;
        iken (i < liste_uzunluk(L)) {
            sayi k = i;
            mantik ok = yanlis;
            iken (k < liste_uzunluk(L) && !ok) {
                sayi sl = dugum_liste(liste_al(L, k));
                sayi dolu = 0;
                mantik var_don = yanlis;
                sayi j = 0;
                iken (j < liste_uzunluk(sl)) {
                    sayi s = liste_al(sl, j);
                    eger (dugum_tur(s) != DugumTur.D_BOS_CUMLE) {
                        dolu = dolu + 1;
                        eger (her_zaman_doner(s)) { var_don = dogru; }
                    }
                    j = j + 1;
                }
                eger (var_don) {
                    ok = dogru;
                } yoksa eger (dolu > 0) {
                    dur;
                } yoksa {
                    k = k + 1;
                }
            }
            eger (!ok) { don yanlis; }
            i = i + 1;
        }
        don dogru;
    }
    don yanlis;
}

fonk tip_yazilabilir_mi(sayi t) -> mantik {
    eger (t == 0) { don yanlis; }
    eger (tip_metin_mi(t) || tip_ref_metin_mi(t)) { don dogru; }
    eger (dugum_ptrd(t) != 0 || dugum_dims(t) != 0) { don yanlis; }
    oto n = dugum_ad(t);
    eger (tip_tamsayi_adi_mi(n) || metin_esit(n, "ondalik") || metin_esit(n, "mantik")) { don dogru; }
    don tip_enum_mi(t);
}

fonk tip_interp(sayi e) -> bos {
    eger (!interp_dugum_mi(e)) { don; }
    sayi L = dugum_liste(e);
    sayi i = 0;
    iken (i < liste_uzunluk(L)) {
        sayi p = liste_al(L, i);
        eger (!(dugum_tur(p) == DugumTur.D_SABIT && dugum_ptrd(p) == 7)) {
            sayi t = tip_ifade(p);
            eger (hata_var()) { don; }
            eger (!tip_yazilabilir_mi(t)) {
                oto ta = tur_aciklama(t);
                hata_fmt_basla();
                hata_fmt_yaz("İnterpolasyonda yazdırılamayan tür: ");
                hata_fmt_yaz(ta);
                hata_fmt_ver(dugum_satir(p), dugum_sutun(p));
                don;
            }
        }
        i = i + 1;
    }
}

fonk tip_liste_uye(sayi expr, metin on) -> sayi {
    oto name = dugum_ad(expr);
    oto elem = liste_elem_ad(on);
    eger (metin_esit(name, "ekle") || metin_esit(name, "yaz") || metin_esit(name, "bosalt")) {
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "al")) {
        don tur_dugum(dugum_satir(expr), dugum_sutun(expr), elem, 0, 0);
    }
    eger (metin_esit(name, "uzunluk")) {
        don tip_sayi(dugum_satir(expr), dugum_sutun(expr));
    }
    hata_ver(dugum_satir(expr), dugum_sutun(expr), "'liste' üzerinde bu üye yok.");
    don tip_bos(dugum_satir(expr), dugum_sutun(expr));
}

fonk tip_harita_uye(sayi expr, metin on) -> sayi {
    oto name = dugum_ad(expr);
    oto val = harita_deger_ad(on);
    eger (metin_esit(name, "koy") || metin_esit(name, "bosalt")) {
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "al")) {
        don tur_dugum(dugum_satir(expr), dugum_sutun(expr), val, 0, 0);
    }
    eger (metin_esit(name, "var_mi")) {
        don tip_mantik(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "uzunluk")) {
        don tip_sayi(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "anahtarlar")) {
        don tur_dugum(dugum_satir(expr), dugum_sutun(expr), kat3("liste[", harita_anahtar_ad(on), "]"), 0, 0);
    }
    hata_ver(dugum_satir(expr), dugum_sutun(expr), "'harita' üzerinde bu üye yok.");
    don tip_bos(dugum_satir(expr), dugum_sutun(expr));
}

fonk tip_uye(sayi expr, mantik as_call) -> sayi {
    // sirali: veri taşımayan varyant değeri (Durum.Bekliyor)
    sayi sr = sirali_ad_ifadesi(dugum_a(expr));
    eger (sr >= 0 && g_sr_veri[sr] == 1) {
        sayi st = sirali_birim_deger(expr, sr);
        eger (st == 0) { don tip_bos(dugum_satir(expr), dugum_sutun(expr)); }
        don st;
    }
    sayi obj_t = tip_ifade(dugum_a(expr));
    eger (hata_var() || obj_t == 0) { don tip_bos(dugum_satir(expr), dugum_sutun(expr)); }
    oto on = dugum_ad(obj_t);
    eger (tip_ref_metin_mi(obj_t) || tip_ref_dilim_mi(obj_t)) {
        eger (as_call) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "Görünüm alanı çağrılamaz.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (metin_esit(dugum_ad(expr), "uzunluk")) {
            don tip_sayi(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (metin_esit(dugum_ad(expr), "veri")) {
            eger (tip_ref_metin_mi(obj_t)) {
                don tip_metin(dugum_satir(expr), dugum_sutun(expr));
            }
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "'veri' yalnızca '&metin' görünümünde vardır; dilim için indeks kullanın.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        hata_fmt_basla();
        hata_fmt_yaz("Görünümde üye yok: ");
        hata_fmt_yaz(dugum_ad(expr));
        hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_uzun(on) >= 8) {
        oto pref = intern_dilim(on, 0, 8);
        eger (metin_esit(pref, "secenek.")) {
            oto en = intern_dilim(on, 8, metin_uzun(on));
            sayi ed = tablo_bul(2, en);
            eger (ed == 0) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "Seçenek bulunamadı.");
                don tip_bos(dugum_satir(expr), dugum_sutun(expr));
            }
            sayi L = dugum_liste(ed);
            sayi i = 0;
            iken (i < liste_uzunluk(L)) {
                sayi v = liste_al(L, i);
                eger (metin_esit(dugum_ad(v), dugum_ad(expr))) {
                    eger (as_call) {
                        hata_ver(dugum_satir(expr), dugum_sutun(expr), "Seçenek değeri çağrılamaz.");
                    }
                    don tur_dugum(dugum_satir(expr), dugum_sutun(expr), en, 0, 0);
                }
                i = i + 1;
            }
            hata_fmt_basla();
            hata_fmt_yaz("Seçenekte üye yok: ");
            hata_fmt_yaz(dugum_ad(expr));
            hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
    }
    eger (metin_esit(on, "upp") || (metin_uzun(on) >= 4 && metin_esit(intern_dilim(on, 0, 4), "upp."))) {
        don tur_dugum(dugum_satir(expr), dugum_sutun(expr), intern(kat3(on, ".", dugum_ad(expr))), 0, 0);
    }
    eger (metin_uzun(on) >= 6 && metin_esit(intern_dilim(on, 0, 6), "modul.")) {
        oto alias = intern_dilim(on, 6, metin_uzun(on));
        oto uye = dugum_ad(expr);
        sayi fn = tablo_bul(1, c_sembol(uye, alias));
        eger (fn != 0 && !as_call) {
            // çağrısız 'm.f': fonksiyon değeri (yerel 'f' gibi)
            harici_cagri_denetle(fn, dugum_satir(expr), dugum_sutun(expr));
            don tur_dugum(dugum_satir(expr), dugum_sutun(expr), dugum_ad(fonk_imza_tur(fn)), 0, 0);
        }
        eger (fn != 0) {
            sayi rt = dugum_a(fn);
            don tur_dugum(dugum_satir(fn), dugum_sutun(fn), dugum_ad(rt), dugum_ptrd(rt), 0);
        }
        sayi cls = tablo_bul(0, kat3(alias, ".", uye));
        eger (cls != 0) {
            don tur_dugum(dugum_satir(expr), dugum_sutun(expr), intern(kat("sinif.", kat3(alias, ".", uye))), 0, 0);
        }
        sayi ed = tablo_bul(2, kat3(alias, ".", uye));
        eger (ed != 0) {
            don tur_dugum(dugum_satir(expr), dugum_sutun(expr), intern(kat("secenek.", kat3(alias, ".", uye))), 0, 0);
        }
        sayi vr = tablo_bul(3, c_sembol(uye, alias));
        eger (vr != 0) {
            don tur_kopya(vr);
        }
        hata_ver(dugum_satir(expr), dugum_sutun(expr), "Modülde üye yok.");
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_uzun(on) >= 6 && metin_esit(intern_dilim(on, 0, 6), "sinif.")) {
        oto key = intern_dilim(on, 6, metin_uzun(on));
        sayi cls = tablo_bul(0, key);
        eger (cls == 0) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "Sınıf bulunamadı.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (dugum_c(cls) != 0) {
            sayi L = dugum_liste(dugum_c(cls));
            sayi i = 0;
            iken (i < liste_uzunluk(L)) {
                sayi c = liste_al(L, i);
                eger (metin_esit(dugum_ad(c), dugum_ad(expr))) {
                    eger (as_call) {
                        hata_ver(dugum_satir(expr), dugum_sutun(expr), "Sınıf sabiti çağrılamaz.");
                    }
                    don tur_kopya(dugum_a(c));
                }
                i = i + 1;
            }
        }
        hata_ver(dugum_satir(expr), dugum_sutun(expr), "Sınıf sabiti yok.");
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (liste_tur_mi(on) && dugum_ptrd(obj_t) == 0) {
        don tip_liste_uye(expr, on);
    }
    eger (harita_tur_mi(on) && dugum_ptrd(obj_t) == 0) {
        don tip_harita_uye(expr, on);
    }
    sayi cls = tablo_bul(0, on);
    eger (cls != 0 && g_sr_dugum.var_mi(cls) && !sirali_alan_izinli(expr)) {
        sirali_alan_hatasi(expr, on);
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (cls == 0) {
        hata_fmt_basla();
        hata_fmt_yaz("Sınıf değil; üye erişimi yok: ");
        hata_fmt_yaz(on);
        hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    sayi F = dugum_liste(cls);
    sayi i = 0;
    iken (i < liste_uzunluk(F)) {
        sayi f = liste_al(F, i);
        eger (metin_esit(dugum_ad(f), dugum_ad(expr))) {
            eger (as_call) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "Alan fonksiyon gibi çağrılamaz.");
            }
            sayi dims = 0;
            eger (dugum_b(f) != 0 || (dugum_bayrak(f) & 8) != 0) { dims = 1; }
            sayi ft = dugum_a(f);
            don tur_dugum(dugum_satir(f), dugum_sutun(f), dugum_ad(ft), dugum_ptrd(ft), dims);
        }
        i = i + 1;
    }
    sayi M = dugum_liste2(cls);
    i = 0;
    iken (i < liste_uzunluk(M)) {
        sayi m = liste_al(M, i);
        eger (metin_esit(dugum_ad(m), dugum_ad(expr))) {
            sayi rt = dugum_a(m);
            don tur_dugum(dugum_satir(m), dugum_sutun(m), dugum_ad(rt), dugum_ptrd(rt), 0);
        }
        i = i + 1;
    }
    eger (metin_esit(dugum_ad(cls), "ArkaplanIs") && metin_esit(dugum_ad(expr), "bekle")) {
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(dugum_ad(cls), "Kilit") && (metin_esit(dugum_ad(expr), "kilitle") || metin_esit(dugum_ad(expr), "birak"))) {
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    hata_fmt_basla();
    hata_fmt_yaz("Sınıfta üye yok: ");
    hata_fmt_yaz(dugum_ad(expr));
    hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
    don tip_bos(dugum_satir(expr), dugum_sutun(expr));
}

fonk kaldirilan_upp_ipucu(metin name) -> metin {
    eger (metin_esit(name, "metin_bosalt")) {
        don "Metinler kapsam sonunda otomatik bırakılır; satırı silin.";
    }
    don "";
}

fonk upp_donus(metin name, sayi satir, sayi sutun) -> sayi {
    // Yalnızca tabloda olmayan özel yerleşikler; diğerleri yerlesik.upp.
    eger (metin_esit(name, "yaz") || metin_esit(name, "satir_yaz") || metin_esit(name, "hata_yaz") || metin_esit(name, "hata_satir_yaz") || metin_esit(name, "bekle")) {
        don tip_bos(satir, sutun);
    }
    eger (metin_esit(name, "uzunluk")) {
        don tip_sayi(satir, sutun);
    }
    don 0;
}

// Tablodaki bir yerleşik çağrının tür denetimi: argüman sayısı/türleri, hedef platform.
fonk yerlesik_cagri_tip(sayi yi, metin tam_ad, sayi expr, sayi args) -> sayi {
    sayi satir = dugum_satir(expr);
    sayi sutun = dugum_sutun(expr);
    sayi n = yerlesik_param_say(yi);
    sayi m = liste_uzunluk(args);
    eger (m != n) {
        hata_fmt_basla();
        hata_fmt_yaz("'upp.");
        hata_fmt_yaz(tam_ad);
        hata_fmt_yaz("' ");
        hata_fmt_sayi(n);
        hata_fmt_yaz(" argüman bekler, ");
        hata_fmt_sayi(m);
        hata_fmt_yaz(" verildi.");
        hata_fmt_ver(satir, sutun);
        don tip_bos(satir, sutun);
    }
    sayi i = 0;
    iken (i < n) {
        sayi a = liste_al(args, i);
        sayi at = tip_ifade(a);
        tip_interp(a);
        eger (hata_var()) { don tip_bos(satir, sutun); }
        oto pt = yerlesik_param_tur(yi, i);
        eger (!tip_ifade_atanir(tur_dugum(satir, sutun, pt, 0, 0), a)) {
            oto ata = tur_aciklama(at);
            hata_fmt_basla();
            hata_fmt_yaz("'upp.");
            hata_fmt_yaz(tam_ad);
            hata_fmt_yaz("' ");
            hata_fmt_sayi(i + 1);
            hata_fmt_yaz(". argüman '");
            hata_fmt_yaz(pt);
            hata_fmt_yaz("' bekler, '");
            hata_fmt_yaz(ata);
            hata_fmt_yaz("' verildi.");
            hata_fmt_ver(dugum_satir(a), dugum_sutun(a));
            don tip_bos(satir, sutun);
        }
        i = i + 1;
    }
    sayi b = yerlesik_bayrak(yi);
    eger ((b & 2) != 0 && serbest_mi()) {
        hata_fmt_basla();
        hata_fmt_yaz("'upp.");
        hata_fmt_yaz(tam_ad);
        hata_fmt_yaz("' işletim sistemi gerektirir; serbest/çekirdek hedefinde yok.");
        hata_fmt_ver(satir, sutun);
        don tip_bos(satir, sutun);
    }
    eger ((b & 64) != 0 && !serbest_mi()) {
        hata_fmt_basla();
        hata_fmt_yaz("'upp.");
        hata_fmt_yaz(tam_ad);
        hata_fmt_yaz("' yalnızca serbest/çekirdek hedefinde kullanılabilir (--hedef cekirdek).");
        hata_fmt_ver(satir, sutun);
        don tip_bos(satir, sutun);
    }
    eger ((b & 4) != 0 && os_hedef_al() != 0 && !serbest_mi()) {
        hata_fmt_basla();
        hata_fmt_yaz("'upp.");
        hata_fmt_yaz(tam_ad);
        hata_fmt_yaz("' yalnızca Windows hedefinde kullanılabilir.");
        hata_fmt_ver(satir, sutun);
        don tip_bos(satir, sutun);
    }
    eger ((b & 8) != 0 && os_hedef_al() == 0 && !serbest_mi()) {
        hata_fmt_basla();
        hata_fmt_yaz("'upp.");
        hata_fmt_yaz(tam_ad);
        hata_fmt_yaz("' yalnızca Linux hedefinde kullanılabilir (--linux).");
        hata_fmt_ver(satir, sutun);
        don tip_bos(satir, sutun);
    }
    don tur_dugum(satir, sutun, yerlesik_donus(yi), 0, 0);
}

fonk yerlesik_bilinmiyor(metin ns, metin name, sayi satir, sayi sutun) -> bos {
    oto adlar = yerlesik_ns_adlari(ns);
    hata_fmt_basla();
    hata_fmt_yaz("'upp.");
    eger (!metin_esit(ns, "")) {
        hata_fmt_yaz(ns);
        hata_fmt_yaz(".");
    }
    hata_fmt_yaz(name);
    hata_fmt_yaz("' yerleşik bir fonksiyon değil.");
    eger (!metin_esit(adlar, "")) {
        hata_fmt_yaz(" Mevcut: ");
        hata_fmt_yaz(adlar);
    }
    hata_fmt_ver(satir, sutun);
}

fonk tip_liste_cagri(sayi expr, metin on) -> sayi {
    sayi callee = dugum_a(expr);
    sayi args = dugum_liste(expr);
    oto name = dugum_ad(callee);
    oto elem = liste_elem_ad(on);
    eger (metin_esit(name, "ekle")) {
        eger (liste_uzunluk(args) != 1) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "liste.ekle 1 argüman bekler.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (!tip_ifade_atanir(tur_dugum(dugum_satir(expr), dugum_sutun(expr), elem, 0, 0), liste_al(args, 0))) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "liste.ekle argüman türü uyumsuz.");
        }
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "al")) {
        eger (liste_uzunluk(args) != 1) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "liste.al 1 argüman bekler.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        kol_indeks_denetle(expr, liste_al(args, 0), "liste.al");
        don tur_dugum(dugum_satir(expr), dugum_sutun(expr), elem, 0, 0);
    }
    eger (metin_esit(name, "yaz")) {
        eger (liste_uzunluk(args) != 2) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "liste.yaz 2 argüman bekler.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        kol_indeks_denetle(expr, liste_al(args, 0), "liste.yaz");
        eger (!tip_ifade_atanir(tur_dugum(dugum_satir(expr), dugum_sutun(expr), elem, 0, 0), liste_al(args, 1))) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "liste.yaz argüman türü uyumsuz.");
        }
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "uzunluk")) {
        eger (liste_uzunluk(args) != 0) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "liste.uzunluk argüman almaz.");
        }
        don tip_sayi(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "bosalt")) {
        eger (liste_uzunluk(args) != 0) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "liste.bosalt argüman almaz.");
        }
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "sil")) {
        eger (liste_uzunluk(args) != 1) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "liste.sil 1 argüman bekler.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        kol_indeks_denetle(expr, liste_al(args, 0), "liste.sil");
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "temizle")) {
        eger (liste_uzunluk(args) != 0) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "liste.temizle argüman almaz.");
        }
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    hata_ver(dugum_satir(expr), dugum_sutun(expr), "'liste' üzerinde bu metot yok.");
    don tip_bos(dugum_satir(expr), dugum_sutun(expr));
}

fonk kol_indeks_denetle(sayi expr, sayi arg, metin ne) -> bos {
    sayi t = tip_ifade(arg);
    eger (!hata_var() && !tip_tam_sayi_mi(t)) {
        oto verilen = tur_aciklama(t);
        hata_fmt_basla();
        hata_fmt_yaz(ne);
        hata_fmt_yaz(" indeksi tamsayı olmalı (verilen: ");
        hata_fmt_yaz(verilen);
        hata_fmt_yaz(").");
        hata_fmt_ver(dugum_satir(arg), dugum_sutun(arg));
    }
}

fonk harita_anahtar_denetle(sayi expr, sayi arg, metin ktur, metin ne) -> bos {
    tip_ifade(arg);
    eger (!hata_var() && !tip_ifade_atanir(tur_dugum(dugum_satir(expr), dugum_sutun(expr), ktur, 0, 0), arg)) {
        hata_fmt_basla();
        hata_fmt_yaz("harita.");
        hata_fmt_yaz(ne);
        hata_fmt_yaz(" anahtar türü uyumsuz: '");
        hata_fmt_yaz(ktur);
        hata_fmt_yaz("' bekleniyor.");
        hata_fmt_ver(dugum_satir(arg), dugum_sutun(arg));
    }
}

fonk tip_harita_cagri(sayi expr, metin on) -> sayi {
    sayi callee = dugum_a(expr);
    sayi args = dugum_liste(expr);
    oto name = dugum_ad(callee);
    oto ktur = harita_anahtar_ad(on);
    oto vtur = harita_deger_ad(on);
    eger (metin_esit(name, "koy")) {
        eger (liste_uzunluk(args) != 2) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "harita.koy 2 argüman bekler.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (!tip_ifade_atanir(tur_dugum(dugum_satir(expr), dugum_sutun(expr), ktur, 0, 0), liste_al(args, 0))) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "harita.koy anahtar türü uyumsuz.");
        }
        eger (!tip_ifade_atanir(tur_dugum(dugum_satir(expr), dugum_sutun(expr), vtur, 0, 0), liste_al(args, 1))) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "harita.koy değer türü uyumsuz.");
        }
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_esit(name, "al") || metin_esit(name, "var_mi")) {
        eger (liste_uzunluk(args) != 1) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "harita.al/var_mi 1 argüman bekler.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        harita_anahtar_denetle(expr, liste_al(args, 0), ktur, name);
        eger (metin_esit(name, "var_mi")) {
            don tip_mantik(dugum_satir(expr), dugum_sutun(expr));
        }
        don tur_dugum(dugum_satir(expr), dugum_sutun(expr), vtur, 0, 0);
    }
    eger (metin_esit(name, "uzunluk")) {
        eger (liste_uzunluk(args) != 0) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "harita.uzunluk argüman almaz.");
        }
        don tip_sayi(dugum_satir(expr), dugum_sutun(expr));
    }
        eger (metin_esit(name, "bosalt")) {
            eger (liste_uzunluk(args) != 0) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "harita.bosalt argüman almaz.");
            }
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (metin_esit(name, "anahtarlar")) {
            eger (liste_uzunluk(args) != 0) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "harita.anahtarlar argüman almaz.");
            }
            don tur_dugum(dugum_satir(expr), dugum_sutun(expr), kat3("liste[", ktur, "]"), 0, 0);
        }
        eger (metin_esit(name, "sil")) {
            eger (liste_uzunluk(args) != 1) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "harita.sil 1 argüman bekler.");
                don tip_bos(dugum_satir(expr), dugum_sutun(expr));
            }
            harita_anahtar_denetle(expr, liste_al(args, 0), ktur, name);
            don tip_mantik(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (metin_esit(name, "temizle")) {
            eger (liste_uzunluk(args) != 0) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "harita.temizle argüman almaz.");
            }
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        hata_ver(dugum_satir(expr), dugum_sutun(expr), "'harita' üzerinde bu metot yok.");
    don tip_bos(dugum_satir(expr), dugum_sutun(expr));
}

fonk tip_fonk_mi(sayi t) -> mantik {
    don t != 0 && dugum_ptrd(t) == 0 && dugum_dims(t) == 0 && fonk_tur_mi(dugum_ad(t));
}

// Ad bir fonksiyonu değer olarak gösteriyorsa bildirimi (yerel/küresel değişken önceliklidir).
fonk fonk_deger_bildirim(sayi e) -> sayi {
    eger (e == 0 || dugum_tur(e) != DugumTur.D_KIMLIK) { don 0; }
    sayi an = dugum_sayi(e);
    eger (an != 0 && dugum_tur(an) == DugumTur.D_FONK) { don an; }
    oto name = dugum_ad(e);
    eger (kapsam_bul(name) != 0 || tablo_bul(3, name) != 0) { don 0; }
    sayi fn = tablo_bul(1, name);
    eger (fn == 0 || dugum_c(fn) != 0) { don 0; }
    don fn;
}

// Çağrının hedefi bir fonksiyon değeriyse (değişken, alan, indis, anonim...) türü; değilse 0.
fonk cagri_fonk_turu(sayi expr) -> sayi {
    sayi callee = dugum_a(expr);
    sayi ct = dugum_tur(callee);
    eger (ct == DugumTur.D_KIMLIK) {
        eger (dugum_sayi(callee) != 0) { don fonk_imza_tur(dugum_sayi(callee)); }
        oto name = dugum_ad(callee);
        sayi lt = kapsam_bul(name);
        eger (lt == 0) { lt = tablo_bul(3, name); }
        eger (tip_fonk_mi(lt)) { don lt; }
        don 0;
    }
    eger (ct == DugumTur.D_UYE) {
        sayi obj_t = tip_ifade(dugum_a(callee));
        eger (hata_var() || obj_t == 0) { don 0; }
        sayi cls = tablo_bul(0, dugum_ad(obj_t));
        eger (cls == 0 || dugum_ptrd(obj_t) > 1) { don 0; }
        sayi F = dugum_liste(cls);
        sayi i = 0;
        iken (i < liste_uzunluk(F)) {
            sayi f = liste_al(F, i);
            eger (metin_esit(dugum_ad(f), dugum_ad(callee))) {
                eger (tip_fonk_mi(dugum_a(f))) { don dugum_a(f); }
                don 0;
            }
            i = i + 1;
        }
        don 0;
    }
    sayi t = tip_ifade(callee);
    eger (tip_fonk_mi(t)) { don t; }
    don 0;
}

fonk tip_fonk_cagri(sayi ft, sayi expr) -> sayi {
    sayi args = dugum_liste(expr);
    oto n = dugum_ad(ft);
    sayi np = fonk_param_say(n);
    sayi satir = dugum_satir(expr);
    sayi sutun = dugum_sutun(expr);
    eger (liste_uzunluk(args) != np) {
        hata_fmt_basla();
        hata_fmt_yaz("Fonksiyon değeri ");
        hata_fmt_yaz(sayi_metin(np));
        hata_fmt_yaz(" argüman bekler, ");
        hata_fmt_yaz(sayi_metin(liste_uzunluk(args)));
        hata_fmt_yaz(" verildi (tür: ");
        hata_fmt_yaz(n);
        hata_fmt_yaz(").");
        hata_fmt_ver(satir, sutun);
        don tip_bos(satir, sutun);
    }
    sayi i = 0;
    iken (i < np) {
        sayi a = liste_al(args, i);
        sayi pt = ad_tur_dugum(fonk_param_ad(n, i));
        eger (!tip_ifade_atanir(pt, a)) {
            hata_fmt_basla();
            hata_fmt_yaz("Fonksiyon değeri argüman türü uyumsuz: ");
            hata_fmt_yaz(sayi_metin(i + 1));
            hata_fmt_yaz(". parametre '");
            hata_fmt_yaz(fonk_param_ad(n, i));
            hata_fmt_yaz("' bekler, '");
            hata_fmt_yaz(tur_aciklama(tip_ifade(a)));
            hata_fmt_yaz("' verildi.");
            hata_fmt_ver(dugum_satir(a), dugum_sutun(a));
            don tip_bos(satir, sutun);
        }
        i = i + 1;
    }
    sayi rt = ad_tur_dugum(fonk_donus_ad(n));
    don tur_dugum(satir, sutun, dugum_ad(rt), dugum_ptrd(rt), 0);
}

fonk tip_args_ok(sayi P, sayi args, sayi satir, sayi sutun) -> mantik {
    sayi ngot = liste_uzunluk(args);
    sayi nneed = liste_uzunluk(P);
    sayi i = 0;
    eger (ngot > nneed) {
        hata_ver(satir, sutun, "Fonksiyon argüman sayısı uyumsuz.");
        don yanlis;
    }
    iken (i < nneed) {
        sayi p = liste_al(P, i);
        eger (i < ngot) {
            sayi pt = dugum_a(p);
            eger (pt != 0 && !tip_ifade_atanir(pt, liste_al(args, i))) {
                hata_ver(satir, sutun, "Fonksiyon argüman türü uyumsuz.");
            }
        } yoksa eger (dugum_c(p) == 0) {
            hata_ver(satir, sutun, "Fonksiyon argüman sayısı uyumsuz.");
            don yanlis;
        }
        i = i + 1;
    }
    don dogru;
}

fonk tip_beklenen_cagri(sayi expr, metin on) -> sayi {
    sayi callee = dugum_a(expr);
    sayi args = dugum_liste(expr);
    oto m = dugum_ad(callee);
    sayi satir = dugum_satir(expr);
    sayi sutun = dugum_sutun(expr);
    oto dn = beklenen_deger_ad(on);
    sayi na = liste_uzunluk(args);
    eger (metin_esit(m, "tamam_mi") || metin_esit(m, "hata_mi")) {
        eger (na != 0) { hata_ver(satir, sutun, "Bu metot argüman almaz."); }
        don tip_mantik(satir, sutun);
    }
    eger (metin_esit(m, "deger")) {
        eger (na != 0) { hata_ver(satir, sutun, "Bu metot argüman almaz."); }
        eger (metin_esit(dn, "bos")) {
            hata_ver(satir, sutun, "'beklenen[bos, ...]' değer taşımaz; '.deger()' yok.");
            don tip_bos(satir, sutun);
        }
        sayi dt = ad_tur_dugum(dn);
        don tur_dugum(satir, sutun, dugum_ad(dt), dugum_ptrd(dt), 0);
    }
    eger (metin_esit(m, "hata")) {
        eger (na != 0) { hata_ver(satir, sutun, "Bu metot argüman almaz."); }
        sayi ht = ad_tur_dugum(beklenen_hata_ad(on));
        don tur_dugum(satir, sutun, dugum_ad(ht), dugum_ptrd(ht), 0);
    }
    eger (metin_esit(m, "deger_yoksa")) {
        eger (metin_esit(dn, "bos")) {
            hata_ver(satir, sutun, "'beklenen[bos, ...]' değer taşımaz; '.deger_yoksa()' yok.");
            don tip_bos(satir, sutun);
        }
        sayi dt = ad_tur_dugum(dn);
        eger (na != 1) {
            hata_ver(satir, sutun, "'.deger_yoksa(v)' tek argüman alır.");
        } yoksa eger (!tip_ifade_atanir(dt, liste_al(args, 0))) {
            atama_uyumsuz_ver(satir, sutun, dt, liste_al(args, 0));
        }
        don tur_dugum(satir, sutun, dugum_ad(dt), dugum_ptrd(dt), 0);
    }
    hata_fmt_basla();
    hata_fmt_yaz("'beklenen' değerinde '");
    hata_fmt_yaz(m);
    hata_fmt_yaz("' metodu yok. Mevcut: tamam_mi, hata_mi, deger, hata, deger_yoksa.");
    hata_fmt_ver(satir, sutun);
    don tip_bos(satir, sutun);
}

// Tür adı geçerli mi (boyut/dönüşüm hedefi için).
fonk tur_bilinen_mi(sayi t) -> mantik {
    eger (t == 0) { don yanlis; }
    eger (dugum_ptrd(t) > 0) { don dogru; }
    oto n = dugum_ad(t);
    eger (tip_tamsayi_adi_mi(n) || metin_esit(n, "ondalik") || metin_esit(n, "metin") || metin_esit(n, "mantik") || metin_esit(n, "cmetin")) { don dogru; }
    eger (liste_tur_mi(n) || harita_tur_mi(n) || beklenen_tur_mi(n) || fonk_tur_mi(n) || tip_gorunum_mi(t)) { don dogru; }
    eger (tablo_bul(0, n) != 0 || tablo_bul(2, n) != 0) { don dogru; }
    don yanlis;
}

fonk tip_boyut(sayi e) -> sayi {
    sayi satir = dugum_satir(e);
    sayi sutun = dugum_sutun(e);
    sayi ty = dugum_sayi(e);
    eger (ty != 0 && dugum_ptrd(ty) == 0 && !tur_bilinen_mi(ty)) {
        oto ad = dugum_ad(ty);
        sayi vt = kapsam_bul(ad);
        eger (vt == 0) { vt = tablo_bul(3, ad); }
        eger (vt != 0) {
            dugum_yaz_bayrak(e, dugum_bayrak(e) | 1);
            dugum_yaz_ad(e, ad);
            don tip_sayi(satir, sutun);
        }
        hata_fmt_basla();
        hata_fmt_yaz("'boyut(");
        hata_fmt_yaz(ad);
        hata_fmt_yaz(")': bilinmeyen tür ya da ad.");
        hata_fmt_ver(satir, sutun);
        don tip_sayi(satir, sutun);
    }
    eger (ty != 0 && dugum_ptrd(ty) == 0 && tip_void_mi(ty)) {
        hata_ver(satir, sutun, "'boyut(bos)' yok.");
    }
    don tip_sayi(satir, sutun);
}

fonk tip_isaret_benzeri_mi(sayi t) -> mantik {
    don t != 0 && dugum_dims(t) == 0 && (dugum_ptrd(t) > 0 || tip_fonk_mi(t));
}

fonk tip_donusum(sayi e) -> sayi {
    sayi satir = dugum_satir(e);
    sayi sutun = dugum_sutun(e);
    sayi dst = dugum_sayi(e);
    sayi src = tip_ifade(dugum_a(e));
    eger (hata_var()) { don tur_kopya(dst); }
    sayi sonuc_t = tur_dugum(satir, sutun, dugum_ad(dst), dugum_ptrd(dst), 0);
    eger (!tur_bilinen_mi(dst)) {
        hata_fmt_basla();
        hata_fmt_yaz("Dönüşüm hedefi bilinmeyen tür: '");
        hata_fmt_yaz(tur_aciklama(dst));
        hata_fmt_yaz("'.");
        hata_fmt_ver(satir, sutun);
        don sonuc_t;
    }
    eger (dugum_dims(src) > 0) {
        hata_ver(satir, sutun, "Dizi dönüştürülemez.");
        don sonuc_t;
    }
    eger (metin_esit(dugum_ad(src), dugum_ad(dst)) && dugum_ptrd(src) == dugum_ptrd(dst)) { don sonuc_t; }
    // (metin)c: C dizgisini yönetilen metne kopyalar (NULL → boş). (cmetin)m: verinin kendisi.
    eger ((tip_metin_mi(dst) && (tip_cmetin_mi(src) || tip_yok_mi(src))) || (tip_cmetin_mi(dst) && tip_metin_mi(src))) {
        don sonuc_t;
    }
    mantik isd = tip_isaret_benzeri_mi(dst);
    mantik iss = tip_isaret_benzeri_mi(src) || tip_yok_mi(src);
    eger (isd || iss) {
        eger ((isd || tip_tam_sayi_mi(dst)) && (iss || tip_tam_sayi_mi(src))) {
            eger (g_guvensiz_derin <= 0) {
                hata_guvenlik(satir, sutun, "İşaretçi ya da fonksiyon dönüşümü yalnızca 'guvensiz' blokta yapılabilir.");
            }
            don sonuc_t;
        }
    } yoksa eger (tip_num_genis(dst) && tip_num_genis(src)) {
        don sonuc_t;
    }
    hata_fmt_basla();
    hata_fmt_yaz("'");
    hata_fmt_yaz(tur_aciklama(src));
    hata_fmt_yaz("' türü '");
    hata_fmt_yaz(tur_aciklama(dst));
    hata_fmt_yaz("' türüne dönüştürülemez.");
    eger (tip_metin_mi(src) || tip_metin_mi(dst)) {
        hata_fmt_yaz(" Metin için 'upp.metinden_sayiya' / 'upp.sayidan_metin' kullanın.");
    }
    hata_fmt_ver(satir, sutun);
    don sonuc_t;
}

fonk tip_hata_yay(sayi e) -> sayi {
    sayi satir = dugum_satir(e);
    sayi sutun = dugum_sutun(e);
    sayi it = tip_ifade(dugum_a(e));
    eger (hata_var()) { don tip_bos(satir, sutun); }
    eger (!tip_beklenen_mi(it)) {
        hata_fmt_basla();
        hata_fmt_yaz("'?' yalnızca 'beklenen' değerine uygulanır; '");
        hata_fmt_yaz(tur_aciklama(it));
        hata_fmt_yaz("' bulundu.");
        hata_fmt_ver(satir, sutun);
        don tip_bos(satir, sutun);
    }
    eger (bg_al() > 0) {
        hata_ver(satir, sutun, "'arkaplan' bloğunda '?' kullanılamaz.");
        don tip_bos(satir, sutun);
    }
    sayi fn = cur_fn_al();
    eger (fn == 0 || !tip_beklenen_mi(dugum_a(fn))) {
        hata_ver(satir, sutun, "'?' yalnızca 'beklenen' dönen fonksiyonda kullanılabilir; burada '.tamam_mi()' ile denetleyin.");
        don tip_bos(satir, sutun);
    }
    oto ih = beklenen_hata_ad(dugum_ad(it));
    oto fh = beklenen_hata_ad(dugum_ad(dugum_a(fn)));
    eger (!metin_esit(ih, fh)) {
        hata_fmt_basla();
        hata_fmt_yaz("'?' hata türleri uyuşmuyor: ifade '");
        hata_fmt_yaz(ih);
        hata_fmt_yaz("', fonksiyon '");
        hata_fmt_yaz(fh);
        hata_fmt_yaz("' döndürür.");
        hata_fmt_ver(satir, sutun);
        don tip_bos(satir, sutun);
    }
    sayi dt = ad_tur_dugum(beklenen_deger_ad(dugum_ad(it)));
    don tur_dugum(satir, sutun, dugum_ad(dt), dugum_ptrd(dt), 0);
}

fonk tip_kurucu(sayi cls, sayi expr) -> sayi {
    sayi args = dugum_liste(expr);
    sayi M = dugum_liste2(cls);
    sayi ol = 0;
    sayi say = 0;
    sayi i = 0;
    iken (i < liste_uzunluk(M)) {
        sayi m = liste_al(M, i);
        eger (metin_esit(dugum_ad(m), "olustur")) {
            ol = m;
            say = say + 1;
        }
        i = i + 1;
    }
    eger (say != 1) {
        hata_ver(dugum_satir(expr), dugum_sutun(expr), "Kurucu için tek 'olustur' metodu gerekir.");
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (!tip_void_mi(dugum_a(ol)) || dugum_ptrd(dugum_a(ol)) != 0) {
        hata_ver(dugum_satir(expr), dugum_sutun(expr), "olustur dönüşü 'bos' olmalı.");
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    tip_args_ok(dugum_liste(ol), args, dugum_satir(expr), dugum_sutun(expr));
    don tur_dugum(dugum_satir(expr), dugum_sutun(expr), sinif_tur_ad(cls), 0, 0);
}

// Takma adla katılan modülün ('kullan ... olarak m') kendi gövdesinde nitelemesiz
// bir fonksiyon ya da küresel ad (yerel değilse) o modüldedir: kimlik düğümü
// yerinde 'm.ad' üye erişimine çevrilir. Çevrildiyse dogru.
metin g_tip_global_alias = "";

fonk tip_alias_baglam() -> metin {
    sayi fn = cur_fn_al();
    eger (fn != 0) { don dugum_alias_ad(fn); }
    don g_tip_global_alias;
}

fonk modul_ici_ad_cevir(sayi e) -> mantik {
    eger (e == 0 || dugum_tur(e) != DugumTur.D_KIMLIK) { don yanlis; }
    oto alias = tip_alias_baglam();
    eger (alias == yok || metin_esit(alias, "")) { don yanlis; }
    oto ad = dugum_ad(e);
    eger (kapsam_bul(ad) != 0) { don yanlis; }
    oto sembol = c_sembol(ad, alias);
    eger (tablo_bul(1, sembol) == 0 && tablo_bul(3, sembol) == 0) { don yanlis; }
    dugum_yaz_tur(e, DugumTur.D_UYE);
    dugum_yaz_a(e, kimlik_dugum(dugum_satir(e), dugum_sutun(e), alias));
    don dogru;
}

fonk tip_cagri(sayi expr) -> sayi {
    sayi callee = dugum_a(expr);
    // sirali kurucusu: Durum.V(a, b)
    eger (dugum_tur(callee) == DugumTur.D_UYE) {
        sayi sr = sirali_ad_ifadesi(dugum_a(callee));
        eger (sr >= 0 && g_sr_veri[sr] == 1) {
            eger (!sirali_kurucu_cevir(expr, sr)) { don tip_bos(dugum_satir(expr), dugum_sutun(expr)); }
            callee = dugum_a(expr);
        }
    }
    sayi args = dugum_liste(expr);
    sayi fdt = cagri_fonk_turu(expr);
    eger (hata_var()) { don tip_bos(dugum_satir(expr), dugum_sutun(expr)); }
    eger (fdt != 0) { don tip_fonk_cagri(fdt, expr); }
    eger (dugum_tur(callee) == DugumTur.D_UYE) {
        sayi obj_t = tip_ifade(dugum_a(callee));
        eger (hata_var()) { don tip_bos(dugum_satir(expr), dugum_sutun(expr)); }
        oto on = dugum_ad(obj_t);
        eger (metin_esit(on, "upp")) {
            oto name = dugum_ad(callee);
            oto kaldirildi = kaldirilan_upp_ipucu(name);
            oto yeni_ad = yerlesik_kaldirilan(name);
            eger (!metin_esit(yeni_ad, "")) {
                kaldirildi = kat3("Yerine 'upp.", yeni_ad, "' yazın.");
            }
            eger (!metin_esit(kaldirildi, "")) {
                hata_fmt_basla();
                hata_fmt_yaz("'upp.");
                hata_fmt_yaz(name);
                hata_fmt_yaz("' dilden kaldırıldı. ");
                hata_fmt_yaz(kaldirildi);
                hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
                don tip_bos(dugum_satir(expr), dugum_sutun(expr));
            }
            sayi tyi = yerlesik_bul("", name);
            eger (tyi != 0) {
                don yerlesik_cagri_tip(tyi, name, expr, args);
            }
            sayi rt = upp_donus(name, dugum_satir(expr), dugum_sutun(expr));
            eger (rt == 0) {
                yerlesik_bilinmiyor("", name, dugum_satir(expr), dugum_sutun(expr));
                don tip_bos(dugum_satir(expr), dugum_sutun(expr));
            }
            sayi i = 0;
            iken (i < liste_uzunluk(args)) {
                tip_ifade(liste_al(args, i));
                tip_interp(liste_al(args, i));
                i = i + 1;
            }
            eger (metin_esit(name, "yaz") || metin_esit(name, "satir_yaz") || metin_esit(name, "hata_yaz") || metin_esit(name, "hata_satir_yaz")) {
                eger (liste_uzunluk(args) > 1) {
                    hata_fmt_basla();
                    hata_fmt_yaz("'upp.");
                    hata_fmt_yaz(name);
                    hata_fmt_yaz("' en fazla bir argüman alır; birleştirmek için interpolasyon kullanın: \"{{a}} {{b}}\".");
                    hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
                    don tip_bos(dugum_satir(expr), dugum_sutun(expr));
                }
                eger (liste_uzunluk(args) == 1 && !hata_var()) {
                    sayi yt = tip_ifade(liste_al(args, 0));
                    eger (!tip_yok_mi(yt) && !tip_yazilabilir_mi(yt)) {
                        oto yta = tur_aciklama(yt);
                        hata_fmt_basla();
                        hata_fmt_yaz("'upp.");
                        hata_fmt_yaz(name);
                        hata_fmt_yaz("' bu türü yazdıramaz: ");
                        hata_fmt_yaz(yta);
                        hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
                        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
                    }
                }
            }
            eger (metin_esit(name, "uzunluk") && liste_uzunluk(args) == 1) {
                sayi a0 = liste_al(args, 0);
                sayi at = tip_ifade(a0);
                eger (dugum_dims(at) > 0 && !sayilabilir_dizi_mi(a0)) {
                    hata_ver(dugum_satir(a0), dugum_sutun(a0), "'upp.uzunluk' gerçek dizi veya '[...]' bekler; işaretçi verilemez.");
                }
                eger (dugum_dims(at) == 0 && !tip_metin_mi(at) && !tip_ref_metin_mi(at) && !tip_ref_dilim_mi(at) && !tip_yok_mi(at) && !liste_tur_mi(dugum_ad(at)) && !harita_tur_mi(dugum_ad(at))) {
                    hata_ver(dugum_satir(expr), dugum_sutun(expr), "'upp.uzunluk' metin, dizi, liste, harita veya görünüm bekler.");
                }
            }
            don rt;
        }
        eger (metin_uzun(on) >= 4 && metin_esit(intern_dilim(on, 0, 4), "upp.")) {
            oto ns = intern_dilim(on, 4, metin_uzun(on));
            oto name = dugum_ad(callee);
            eger (metin_esit(ns, "bellek") || metin_esit(ns, "girdi") || metin_esit(ns, "cizim")) {
                hata_fmt_basla();
                hata_fmt_yaz("'upp.");
                hata_fmt_yaz(ns);
                hata_fmt_yaz("' kısayolu dilden kaldırıldı; 'upp.windows.");
                hata_fmt_yaz(ns);
                hata_fmt_yaz(".");
                hata_fmt_yaz(name);
                hata_fmt_yaz("' yazın.");
                hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
                don tip_bos(dugum_satir(expr), dugum_sutun(expr));
            }
            oto ns_yeni = yerlesik_kaldirilan(yerlesik_anahtar(ns, name));
            eger (!metin_esit(ns_yeni, "")) {
                hata_fmt_basla();
                hata_fmt_yaz("'upp.");
                hata_fmt_yaz(yerlesik_anahtar(ns, name));
                hata_fmt_yaz("' dilden kaldırıldı. Yerine 'upp.");
                hata_fmt_yaz(ns_yeni);
                hata_fmt_yaz("' yazın.");
                hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
                don tip_bos(dugum_satir(expr), dugum_sutun(expr));
            }
            sayi nyi = yerlesik_bul(ns, name);
            eger (nyi != 0) {
                don yerlesik_cagri_tip(nyi, yerlesik_anahtar(ns, name), expr, args);
            }
            sayi i = 0;
            iken (i < liste_uzunluk(args)) {
                tip_ifade(liste_al(args, i));
                i = i + 1;
            }
            eger (metin_esit(ns, "matematik") && metin_esit(name, "dunya_ekran")) {
                eger (liste_uzunluk(args) >= 4) {
                    sayi m = liste_al(args, 3);
                    eger (!sayilabilir_dizi_mi(m)) {
                        hata_ver(dugum_satir(m), dugum_sutun(m), "'upp.matematik.dunya_ekran' gerçek ondalik dizisi bekler.");
                    } yoksa eger (dugum_tur(m) == DugumTur.D_DIZI_SABIT && liste_uzunluk(dugum_liste(m)) < 16) {
                        hata_ver(dugum_satir(m), dugum_sutun(m), "'upp.matematik.dunya_ekran' 16 elemanlı (4x4) ondalik dizisi bekler.");
                    } yoksa eger (dugum_tur(m) == DugumTur.D_KIMLIK) {
                        sayi ty = kapsam_bul(dugum_ad(m));
                        eger (ty != 0 && dugum_sayi(ty) > 0 && dugum_sayi(ty) < 16) {
                            hata_ver(dugum_satir(m), dugum_sutun(m), "'upp.matematik.dunya_ekran' 16 elemanlı (4x4) ondalik dizisi bekler.");
                        }
                    }
                }
                don tur_dugum(dugum_satir(expr), dugum_sutun(expr), "EkranNokta", 0, 0);
            }
            eger (metin_esit(ns, "windows.bellek") && metin_esit(name, "zincir_oku")) {
                eger (liste_uzunluk(args) >= 1) { arg_tam_sayi_olmali(liste_al(args, 0)); }
                don tip_sayi(dugum_satir(expr), dugum_sutun(expr));
            }
            yerlesik_bilinmiyor(ns, name, dugum_satir(expr), dugum_sutun(expr));
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (metin_uzun(on) >= 6 && metin_esit(intern_dilim(on, 0, 6), "modul.")) {
            oto alias = intern_dilim(on, 6, metin_uzun(on));
            oto name = dugum_ad(callee);
            sayi fn = tablo_bul(1, c_sembol(name, alias));
            eger (fn != 0) {
                donus_bekleyen_denetle(fn);
                harici_cagri_denetle(fn, dugum_satir(expr), dugum_sutun(expr));
                tip_args_ok(dugum_liste(fn), args, dugum_satir(expr), dugum_sutun(expr));
                sayi rt = dugum_a(fn);
                don tur_dugum(dugum_satir(fn), dugum_sutun(fn), dugum_ad(rt), dugum_ptrd(rt), 0);
            }
            sayi kcls = tablo_bul(0, intern(kat3(alias, ".", name)));
            eger (kcls != 0) {
                don tip_kurucu(kcls, expr);
            }
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "Modülde üye yok.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (metin_uzun(on) >= 6 && metin_esit(intern_dilim(on, 0, 6), "sinif.")) {
            oto key = intern_dilim(on, 6, metin_uzun(on));
            sayi kcls = tablo_bul(0, key);
            eger (kcls == 0) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "Sınıf bulunamadı.");
                don tip_bos(dugum_satir(expr), dugum_sutun(expr));
            }
            don tip_kurucu(kcls, expr);
        }
        eger (liste_tur_mi(on) && dugum_ptrd(obj_t) == 0) {
            don tip_liste_cagri(expr, on);
        }
        eger (harita_tur_mi(on) && dugum_ptrd(obj_t) == 0) {
            don tip_harita_cagri(expr, on);
        }
        eger (beklenen_tur_mi(on) && dugum_ptrd(obj_t) == 0) {
            don tip_beklenen_cagri(expr, on);
        }
        sayi cls = tablo_bul(0, on);
        eger (cls == 0) {
            hata_ver(dugum_satir(expr), dugum_sutun(expr), "Sınıf değil; metot çağrılamaz.");
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (metin_esit(dugum_ad(cls), "ArkaplanIs") && metin_esit(dugum_ad(callee), "bekle")) {
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        eger (metin_esit(dugum_ad(cls), "Kilit") && (metin_esit(dugum_ad(callee), "kilitle") || metin_esit(dugum_ad(callee), "birak"))) {
            eger (serbest_mi()) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "'Kilit' iş parçacığı kilididir; serbest/çekirdek hedefinde yok.");
            }
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        sayi M = dugum_liste2(cls);
        sayi i = 0;
        iken (i < liste_uzunluk(M)) {
            sayi m = liste_al(M, i);
            eger (metin_esit(dugum_ad(m), dugum_ad(callee))) {
                donus_bekleyen_denetle(m);
                tip_args_ok(dugum_liste(m), args, dugum_satir(expr), dugum_sutun(expr));
                sayi rt = dugum_a(m);
                don tur_dugum(dugum_satir(m), dugum_sutun(m), dugum_ad(rt), dugum_ptrd(rt), 0);
            }
            i = i + 1;
        }
        hata_ver(dugum_satir(expr), dugum_sutun(expr), "Sınıfta metot yok.");
        don tip_bos(dugum_satir(expr), dugum_sutun(expr));
    }
    eger (dugum_tur(callee) == DugumTur.D_KIMLIK) {
        oto name = dugum_ad(callee);
        eger (metin_esit(name, "bellek_ayir")) {
            don tur_dugum(dugum_satir(expr), dugum_sutun(expr), "bos", 1, 0);
        }
        eger (metin_esit(name, "bellek_bosalt")) {
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        sayi cls_id = tablo_bul(0, name);
        eger (cls_id != 0 && !yerlesik_sinif_mi(name)) {
            don tip_kurucu(cls_id, expr);
        }
        eger (metin_esit(name, "hata") && kapsam_bul("hata") == 0 && tablo_bul(3, "hata") == 0) {
            eger (liste_uzunluk(args) != 1) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "'hata(...)' tek argüman alır: hata değeri.");
                don tip_bos(dugum_satir(expr), dugum_sutun(expr));
            }
            sayi hat = tip_ifade(liste_al(args, 0));
            eger (hata_var()) { don tip_bos(dugum_satir(expr), dugum_sutun(expr)); }
            eger (tip_void_mi(hat) || tip_gorunum_mi(hat) || dugum_dims(hat) > 0) {
                hata_ver(dugum_satir(expr), dugum_sutun(expr), "'hata(...)' değeri 'bos', dizi ya da görünüm olamaz.");
                don tip_bos(dugum_satir(expr), dugum_sutun(expr));
            }
            don tur_dugum(dugum_satir(expr), dugum_sutun(expr), intern(kat3("hata[", tur_kanonik_ad(hat), "]")), 0, 0);
        }
        sayi fn = tablo_bul(1, name);
        eger (fn != 0) { donus_bekleyen_denetle(fn); }
        eger (fn == 0 && modul_ici_ad_cevir(callee)) {
            don tip_cagri(expr);
        }
        eger (fn == 0) {
            hata_fmt_basla();
            hata_fmt_yaz("Tanımsız fonksiyon: '");
            hata_fmt_yaz(name);
            hata_fmt_yaz("'.");
            hata_fmt_ver(dugum_satir(expr), dugum_sutun(expr));
            don tip_bos(dugum_satir(expr), dugum_sutun(expr));
        }
        harici_cagri_denetle(fn, dugum_satir(expr), dugum_sutun(expr));
        sayi P = dugum_liste(fn);
        tip_args_ok(P, args, dugum_satir(expr), dugum_sutun(expr));
        sayi rt = dugum_a(fn);
        don tur_dugum(dugum_satir(fn), dugum_sutun(fn), dugum_ad(rt), dugum_ptrd(rt), 0);
    }
    hata_ver(dugum_satir(expr), dugum_sutun(expr), "Yalnızca ad, 'nesne.metot' veya fonksiyon değeri çağrılabilir.");
    don tip_bos(dugum_satir(expr), dugum_sutun(expr));
}

fonk tip_ikil(sayi expr) -> sayi {
    sayi left = tip_ifade(dugum_a(expr));
    sayi right = tip_ifade(dugum_b(expr));
    oto op = dugum_ad(expr);
    sayi satir = dugum_satir(expr);
    sayi sutun = dugum_sutun(expr);
    eger (tip_sinif_deger_mi(left) || tip_sinif_deger_mi(right)) {
        hata_ver(satir, sutun, "Sınıf değerleri işlemle kullanılamaz. C'de yapı (struct) karşılaştırması veya aritmetiği yoktur.");
        don tip_mantik(satir, sutun);
    }
    eger (tip_beklenen_mi(left) || tip_beklenen_mi(right)) {
        hata_ver(satir, sutun, "'beklenen' değerleri işlemle kullanılamaz; '.deger()', '.tamam_mi()' ya da '?' kullanın.");
        don tip_mantik(satir, sutun);
    }
    eger ((metin_esit(op, "&&") || metin_esit(op, "||")) && soru_icerir(dugum_b(expr))) {
        hata_ver(satir, sutun, "'&&' / '||' sağ tarafında '?' kullanılamaz; değeri önce bir değişkene alın.");
        don tip_mantik(satir, sutun);
    }
    eger (tip_cmetin_mi(left) || tip_cmetin_mi(right)) {
        mantik esit_op = metin_esit(op, "==") || metin_esit(op, "!=");
        mantik uygun = (tip_cmetin_mi(left) || tip_yok_mi(left)) && (tip_cmetin_mi(right) || tip_yok_mi(right));
        eger (!esit_op || !uygun) {
            hata_ver(satir, sutun, "cmetin yalnızca 'yok' ya da başka bir cmetin ile '==' / '!=' karşılaştırılır (işaretçi eşitliği). İçerik için '(metin)c' ile kopyalayın.");
        }
        don tip_mantik(satir, sutun);
    }
    eger ((tip_fonk_mi(left) || tip_fonk_mi(right)) && !metin_esit(op, "==") && !metin_esit(op, "!=")) {
        hata_ver(satir, sutun, "Fonksiyon değerleriyle yalnızca '==' ve '!=' kullanılabilir.");
        don tip_mantik(satir, sutun);
    }
    eger (metin_esit(op, "+")) {
        eger (tip_metin_mi(left) && tip_metin_mi(right)) { don tip_metin(satir, sutun); }
        eger (tip_metin_mi(left) || tip_metin_mi(right)) {
            hata_ver(satir, sutun, "Metin birleştirme yalnızca 'metin + metin' biçimindedir.");
            don tip_metin(satir, sutun);
        }
    }
    eger (metin_esit(op, "==") || metin_esit(op, "!=") || sira_op_mu(op)) {
        // metin yalnızca metinle (== ve != için 'yok' ile de) karşılaştırılır;
        // <, >, <=, >= sözlük sırasıdır
        mantik lm = tip_metin_karsilastir_mi(left);
        mantik rm = tip_metin_karsilastir_mi(right);
        eger (lm != rm) {
            mantik yok_esit = !sira_op_mu(op) && (tip_yok_mi(left) || tip_yok_mi(right));
            eger (!yok_esit) {
                hata_ver(satir, sutun, "Metin yalnızca metinle karşılaştırılır; sayıya çevirmek için 'upp.metinden_sayiya' kullanın.");
                don tip_mantik(satir, sutun);
            }
        }
        eger (tip_tam_sayi_mi(left) && tip_tam_sayi_mi(right)) {
            eger (metin_esit(ikil_tamsayi_ad(expr), "")) {
                hata_ver(satir, sutun, "Tamsayı türleri uyumsuz. Soneksiz sabit karşı aralığa sığmıyorsa açık dönüşüm gerekir.");
            }
        }
        don tip_mantik(satir, sutun);
    }
    eger (metin_esit(op, "&&") || metin_esit(op, "||")) {
        don tip_mantik(satir, sutun);
    }
    eger (dugum_ptrd(left) > 0 || dugum_ptrd(right) > 0) {
        hata_ver(satir, sutun, "İşaretçi aritmetiği u++'ta yoktur.");
        don left;
    }
    eger (tip_metin_karsilastir_mi(left) || tip_metin_karsilastir_mi(right) || tip_cmetin_mi(left) || tip_cmetin_mi(right)) {
        hata_fmt_basla();
        hata_fmt_yaz("Metinlerle '");
        hata_fmt_yaz(op);
        hata_fmt_yaz("' işlemi yapılamaz; metinler yalnızca '+' ile birleştirilir ve karşılaştırılır.");
        hata_fmt_ver(satir, sutun);
        don tip_sayi(satir, sutun);
    }
    eger (metin_esit(dugum_ad(left), "ondalik") || metin_esit(dugum_ad(right), "ondalik")) {
        don tip_ondalik(satir, sutun);
    }
    eger (tip_tam_sayi_mi(left) && tip_tam_sayi_mi(right)) {
        eger ((metin_esit(op, "/") || metin_esit(op, "%")) && sabit_tamsayi_mi(dugum_b(expr)) && sabit_tamsayi_deger(dugum_b(expr)) == 0) {
            hata_ver(satir, sutun, "Sabit sıfıra bölme.");
            don tip_sayi(satir, sutun);
        }
        oto ad = ikil_tamsayi_ad(expr);
        eger (metin_esit(ad, "")) {
            hata_ver(satir, sutun, "Tamsayı türleri uyumsuz. Soneksiz sabit karşı aralığa sığmıyorsa açık dönüşüm gerekir.");
            don tip_sayi(satir, sutun);
        }
        don tur_dugum(satir, sutun, ad, 0, 0);
    }
    don tip_sayi(satir, sutun);
}

fonk sira_op_mu(metin op) -> mantik => metin_esit(op, "<") || metin_esit(op, ">") || metin_esit(op, "<=") || metin_esit(op, ">=");

fonk ikil_tamsayi_ad(sayi expr) -> metin {
    sayi la = dugum_a(expr);
    sayi lb = dugum_b(expr);
    sayi ta = tip_ifade(la);
    sayi tb = tip_ifade(lb);
    metin na = dugum_ad(ta);
    metin nb = dugum_ad(tb);
    eger (soneksiz_sabit_mi(lb) && tip_tamsayi_adi_mi(na) && sabit_araliga_sigar(na, sabit_tamsayi_deger(lb))) { nb = na; }
    eger (soneksiz_sabit_mi(la) && tip_tamsayi_adi_mi(nb) && sabit_araliga_sigar(nb, sabit_tamsayi_deger(la))) { na = nb; }
    eger (metin_esit(na, nb) && tip_tamsayi_adi_mi(na)) { don na; }
    don "";
}

fonk sabit_tamsayi_mi(sayi e) -> mantik {
    eger (e == 0) { don yanlis; }
    eger (dugum_tur(e) == DugumTur.D_SABIT && dugum_ptrd(e) == 0) { don dogru; }
    eger (dugum_tur(e) == DugumTur.D_TEKIL) {
        oto op = dugum_ad(e);
        eger (metin_esit(op, "-") || metin_esit(op, "+")) { don sabit_tamsayi_mi(dugum_a(e)); }
    }
    don yanlis;
}

fonk sabit_tamsayi_deger(sayi e) -> sayi {
    eger (e == 0) { don 0; }
    eger (dugum_tur(e) == DugumTur.D_SABIT) { don dugum_sayi(e); }
    eger (dugum_tur(e) == DugumTur.D_TEKIL) {
        oto op = dugum_ad(e);
        eger (metin_esit(op, "-")) { don 0 - sabit_tamsayi_deger(dugum_a(e)); }
        eger (metin_esit(op, "+")) { don sabit_tamsayi_deger(dugum_a(e)); }
    }
    don 0;
}

fonk tip_ifade(sayi e) -> sayi {
    hata_dosya_yaz(dugum_kaynak(e));
    eger (e == 0) { don tip_bos(0, 1); }
    eger (hata_var()) { don tip_bos(dugum_satir(e), dugum_sutun(e)); }
    sayi t = dugum_tur(e);
    eger (t == DugumTur.D_SABIT) {
        sayi k = dugum_ptrd(e);
        eger (k == 6) { don tur_dugum(dugum_satir(e), dugum_sutun(e), "u64", 0, 0); }
        eger (k == 0) {
            oto n = dugum_ad(e);
            eger (tip_tamsayi_adi_mi(n)) { don tur_dugum(dugum_satir(e), dugum_sutun(e), n, 0, 0); }
            don tip_sayi(dugum_satir(e), dugum_sutun(e));
        }
        eger (k == 1) { don tip_ondalik(dugum_satir(e), dugum_sutun(e)); }
        eger (k == 2) {
            tip_interp(e);
            don tip_metin(dugum_satir(e), dugum_sutun(e));
        }
        eger (k == 3) { don tip_mantik(dugum_satir(e), dugum_sutun(e)); }
        eger (k == 4) { don tur_dugum(dugum_satir(e), dugum_sutun(e), "yok", 1, 0); }
        don tip_sayi(dugum_satir(e), dugum_sutun(e));
    }
    eger (t == DugumTur.D_KIMLIK) {
        oto name = dugum_ad(e);
        eger (metin_esit(name, "kendi")) {
            oto stad = cur_class_al();
            eger (metin_esit(stad, "")) {
                sayi kt = kapsam_bul("kendi");
                eger (kt != 0 && !metin_esit(dugum_ad(kt), "")) {
                    don tur_kopya(kt);
                }
                hata_ver(dugum_satir(e), dugum_sutun(e), "'kendi' yalnızca sınıf metodu içinde kullanılabilir.");
                don tip_bos(dugum_satir(e), dugum_sutun(e));
            }
            don tur_dugum(dugum_satir(e), dugum_sutun(e), stad, 1, 0);
        }
        eger (metin_esit(name, "upp")) {
            don tur_dugum(dugum_satir(e), dugum_sutun(e), "upp", 0, 0);
        }
        // yerel değişken ve parametreler modül takma adlarını, sınıf ve seçenek adlarını gölgeler
        sayi yerel = kapsam_bul(name);
        eger (yerel != 0) { don tur_kopya(yerel); }
        eger (tablo_bul(3, intern(kat("modul.", name))) != 0) {
            don tur_dugum(dugum_satir(e), dugum_sutun(e), intern(kat("modul.", name)), 0, 0);
        }
        eger (tablo_bul(0, name) != 0 && !yerlesik_sinif_mi(name)) {
            don tur_dugum(dugum_satir(e), dugum_sutun(e), intern(kat("sinif.", name)), 0, 0);
        }
        eger (tablo_bul(2, name) != 0) {
            don tur_dugum(dugum_satir(e), dugum_sutun(e), kat("secenek.", name), 0, 0);
        }
        sayi fdb = fonk_deger_bildirim(e);
        eger (fdb != 0) { donus_bekleyen_denetle(fdb); }
        eger (fdb != 0) {
            eger (metin_esit(dugum_ad(fdb), "ana") && metin_esit(dugum_alias_ad(fdb), "")) {
                hata_ver(dugum_satir(e), dugum_sutun(e), "'ana' fonksiyon değeri olarak kullanılamaz.");
                don tip_bos(dugum_satir(e), dugum_sutun(e));
            }
            harici_cagri_denetle(fdb, dugum_satir(e), dugum_sutun(e));
            don tur_dugum(dugum_satir(e), dugum_sutun(e), dugum_ad(fonk_imza_tur(fdb)), 0, 0);
        }
        sayi found = kapsam_bul(name);
        eger (found == 0) {
            found = tablo_bul(3, name);
        }
        eger (found == 0 && modul_ici_ad_cevir(e)) {
            don tip_ifade(e);
        }
        eger (found == 0) {
            hata_fmt_basla();
            hata_fmt_yaz("Tanımsız ad: '");
            hata_fmt_yaz(name);
            hata_fmt_yaz("'.");
            sayi cf = cur_fn_al();
            eger (cf != 0 && metin_uzun(dugum_ad(cf)) > 10 && metin_esit(intern_dilim(dugum_ad(cf), 0, 10), "_upp_anon_")) {
                hata_fmt_yaz(" Anonim fonksiyonlar dış yerel değişkenleri yakalamaz; değeri parametre olarak geçin.");
            }
            hata_fmt_ver(dugum_satir(e), dugum_sutun(e));
            don tip_bos(dugum_satir(e), dugum_sutun(e));
        }
        don tur_kopya(found);
    }
    eger (t == DugumTur.D_UYE) { don tip_uye(e, yanlis); }
    eger (t == DugumTur.D_DONUSUM) { don tip_donusum(e); }
    eger (t == DugumTur.D_BOYUT) { don tip_boyut(e); }
    eger (t == DugumTur.D_HATA_YAY) { don tip_hata_yay(e); }
    eger (t == DugumTur.D_INDIS) {
        sayi inner = tip_ifade(dugum_a(e));
        sayi idx = dugum_b(e);
        sayi son = dugum_c(e);
        tip_ifade(idx);
        eger (son != 0) {
            tip_ifade(son);
            arg_tam_sayi_olmali(idx);
            arg_tam_sayi_olmali(son);
            eger (hata_var()) { don inner; }
            eger (dugum_dims(inner) > 0 && dugum_ptrd(inner) == 0) {
                don tur_dugum(dugum_satir(e), dugum_sutun(e), intern(kat3("&dilim[", dugum_ad(inner), "]")), 0, 0);
            }
            eger (liste_tur_mi(dugum_ad(inner)) && dugum_ptrd(inner) == 0) {
                oto elem = liste_elem_ad(dugum_ad(inner));
                eger (!metin_esit(elem, "sayi") && !metin_esit(elem, "ondalik")) {
                    hata_ver(dugum_satir(e), dugum_sutun(e), "liste dilimi v1'de yalnızca liste[sayi] veya liste[ondalik] kabul eder.");
                    don inner;
                }
                don tur_dugum(dugum_satir(e), dugum_sutun(e), intern(kat3("&dilim[", elem, "]")), 0, 0);
            }
            eger (tip_ref_dilim_mi(inner)) {
                don inner;
            }
            hata_ver(dugum_satir(e), dugum_sutun(e), "Dilim yalnızca dizi, liste[sayi/ondalik] veya '&dilim[T]' üzerinde kullanılır.");
            don inner;
        }
        eger (dugum_dims(inner) > 0 && dugum_sayi(inner) > 0 && sabit_tamsayi_mi(idx)) {
            sayi iv = sabit_tamsayi_deger(idx);
            sayi n = dugum_sayi(inner);
            eger (iv < 0 || iv >= n) {
                hata_fmt_basla();
                hata_fmt_yaz("indeks ");
                hata_fmt_sayi(iv);
                hata_fmt_yaz(", dizi boyutu ");
                hata_fmt_sayi(n);
                hata_fmt_yaz("'yi aşıyor");
                hata_fmt_ver(dugum_satir(e), dugum_sutun(e));
            }
        }
        eger (liste_tur_mi(dugum_ad(inner)) && dugum_ptrd(inner) == 0) {
            don tur_dugum(dugum_satir(e), dugum_sutun(e), liste_elem_ad(dugum_ad(inner)), 0, 0);
        }
        eger (tip_ref_dilim_mi(inner)) {
            don tur_dugum(dugum_satir(e), dugum_sutun(e), dilim_ref_elem_ad(dugum_ad(inner)), 0, 0);
        }
        eger (dugum_dims(inner) > 0) {
            don tur_dugum(dugum_satir(inner), dugum_sutun(inner), dugum_ad(inner), dugum_ptrd(inner), dugum_dims(inner) - 1);
        }
        eger (dugum_ptrd(inner) > 0) {
            don tur_dugum(dugum_satir(inner), dugum_sutun(inner), dugum_ad(inner), dugum_ptrd(inner) - 1, 0);
        }
        eger (tip_metin_mi(inner)) { don tip_sayi(dugum_satir(inner), dugum_sutun(inner)); }
        hata_ver(dugum_satir(e), dugum_sutun(e), "Dizinlenemez.");
        don inner;
    }
    eger (t == DugumTur.D_CAGRI) { don tip_cagri(e); }
    eger (t == DugumTur.D_ATAMA) {
        eger (!lvalue_mi(dugum_a(e))) {
            hata_ver(dugum_satir(e), dugum_sutun(e), "Atama hedefi bir lvalue olmalı.");
        }
        eger (dugum_tur(dugum_a(e)) == DugumTur.D_KIMLIK) {
            oto nm = dugum_ad(dugum_a(e));
            sayi gt = kapsam_bul(nm);
            eger (gt == 0) { gt = tablo_bul(3, nm); }
            eger (gt != 0 && (dugum_bayrak(gt) & 16) != 0) {
                hata_fmt_basla();
                hata_fmt_yaz("'");
                hata_fmt_yaz(nm);
                hata_fmt_yaz("' sabittir; yeniden atanamaz.");
                hata_fmt_ver(dugum_satir(e), dugum_sutun(e));
            }
        }
        sayi tt = tip_ifade(dugum_a(e));
        sayi vt = tip_ifade(dugum_b(e));
        oto aop = dugum_ad(e);
        eger (!metin_esit(aop, "") && !metin_esit(aop, "=")) {
            eger (metin_esit(aop, "+=") && tip_metin_mi(tt) && (tip_metin_mi(vt) || tip_yok_mi(vt))) {
                don tt;
            }
            eger (tip_metin_mi(tt) || tip_metin_mi(vt)) {
                hata_ver(dugum_satir(e), dugum_sutun(e), "Bileşik atama metin üzerinde kullanılamaz.");
            }
        }
        eger (!tip_ifade_atanir(tt, dugum_b(e))) {
            atama_uyumsuz_ver(dugum_satir(e), dugum_sutun(e), tt, dugum_b(e));
        }
        cmetin_gecici_denetle(tt, dugum_b(e), dugum_satir(e), dugum_sutun(e));
        don tt;
    }
    eger (t == DugumTur.D_UCLU) {
        eger (soru_icerir(dugum_a(e)) || soru_icerir(dugum_b(e)) || soru_icerir(dugum_c(e))) {
            hata_ver(dugum_satir(e), dugum_sutun(e), "'?:' içinde hata yayma '?' kullanılamaz; değeri önce bir değişkene alın.");
            don tip_bos(dugum_satir(e), dugum_sutun(e));
        }
        tip_ifade(dugum_a(e));
        sayi tt = tip_ifade(dugum_b(e));
        sayi et = tip_ifade(dugum_c(e));
        eger (tip_void_mi(tt) || tip_void_mi(et)) {
            hata_ver(dugum_satir(e), dugum_sutun(e), "'?:' dalları 'bos' olamaz.");
            don tt;
        }
        eger (tip_atanir(tt, et)) { don tt; }
        eger (tip_atanir(et, tt)) { don et; }
        hata_ver(dugum_satir(e), dugum_sutun(e), "'?:' dal türleri uyumsuz.");
        don tt;
    }
    eger (t == DugumTur.D_TEKIL) {
        sayi inner = tip_ifade(dugum_a(e));
        oto op = dugum_ad(e);
        eger (metin_esit(op, "&")) {
            don tur_dugum(dugum_satir(inner), dugum_sutun(inner), dugum_ad(inner), dugum_ptrd(inner) + 1, dugum_dims(inner));
        }
        eger (metin_esit(op, "*")) {
            eger (dugum_ptrd(inner) <= 0) {
                hata_ver(dugum_satir(e), dugum_sutun(e), "İşaretçi değil; '*' uygulanamaz.");
                don inner;
            }
            don tur_dugum(dugum_satir(inner), dugum_sutun(inner), dugum_ad(inner), dugum_ptrd(inner) - 1, 0);
        }
        eger (metin_esit(op, "!")) { don tip_mantik(dugum_satir(e), dugum_sutun(e)); }
        don inner;
    }
    eger (t == DugumTur.D_IKIL) { don tip_ikil(e); }
    eger (t == DugumTur.D_DIZI_SABIT) {
        sayi L = dugum_liste(e);
        eger (liste_uzunluk(L) == 0) { don tur_dugum(dugum_satir(e), dugum_sutun(e), "sayi", 0, 1); }
        sayi inner = tip_ifade(liste_al(L, 0));
        eger (dugum_dims(inner) > 0) {
            hata_ver(dugum_satir(e), dugum_sutun(e), "İç içe dizi sabiti yok; tek boyut veya 'liste[T]' kullanın.");
            don tur_dugum(dugum_satir(e), dugum_sutun(e), "sayi", 0, 1);
        }
        don tur_dugum(dugum_satir(inner), dugum_sutun(inner), dugum_ad(inner), dugum_ptrd(inner), dugum_dims(inner) + 1);
    }
    eger (t == DugumTur.D_ARKAPLAN_IFADE) {
        eger (serbest_mi()) {
            hata_ver(dugum_satir(e), dugum_sutun(e), "'arkaplan' iş parçacığı ister; serbest/çekirdek hedefinde yok.");
            don tip_bos(dugum_satir(e), dugum_sutun(e));
        }
        bg_yaz(bg_al() + 1);
        tip_yuru(dugum_a(e));
        bg_yaz(bg_al() - 1);
        eger (!hata_var()) { bg_yakala(e); }
        don tur_dugum(dugum_satir(e), dugum_sutun(e), "ArkaplanIs", 0, 0);
    }
    don tip_bos(dugum_satir(e), dugum_sutun(e));
}

fonk sabit_ifade_mi(sayi e) -> mantik {
    eger (e == 0) { don yanlis; }
    sayi t = dugum_tur(e);
    eger (t == DugumTur.D_SABIT) { don dogru; }
    eger (t == DugumTur.D_TEKIL) {
        oto op = dugum_ad(e);
        eger (metin_esit(op, "+") || metin_esit(op, "-")) { don sabit_ifade_mi(dugum_a(e)); }
        don yanlis;
    }
    eger (t == DugumTur.D_IKIL) { don sabit_ifade_mi(dugum_a(e)) && sabit_ifade_mi(dugum_b(e)); }
    eger (t == DugumTur.D_UCLU) {
        don sabit_ifade_mi(dugum_a(e)) && sabit_ifade_mi(dugum_b(e)) && sabit_ifade_mi(dugum_c(e));
    }
    eger (t == DugumTur.D_BOYUT) { don dogru; }
    eger (t == DugumTur.D_DONUSUM) {
        don dugum_ptrd(dugum_sayi(e)) == 0 && sabit_ifade_mi(dugum_a(e));
    }
    eger (t == DugumTur.D_KIMLIK) {
        eger (fonk_deger_bildirim(e) != 0) { don dogru; }
        sayi gt = kapsam_bul(dugum_ad(e));
        eger (gt == 0) { gt = tablo_bul(3, dugum_ad(e)); }
        don gt != 0 && (dugum_bayrak(gt) & 16) != 0;
    }
    eger (t == DugumTur.D_UYE) {
        sayi obj_t = tip_ifade(dugum_a(e));
        eger (metin_uzun(dugum_ad(obj_t)) >= 8 && metin_esit(intern_dilim(dugum_ad(obj_t), 0, 8), "secenek.")) {
            don dogru;
        }
        don yanlis;
    }
    don yanlis;
}

// Adlar C'ye olduğu gibi geçer. C anahtar sözcükleri ve libc makroları hiçbir
// yerde ad olamaz; libc/POSIX fonksiyon adları üst düzey fonksiyon ve küresel
// değişken adı olamaz (başlıklardaki bildirimlerle çakışır).
harita[metin, mantik] g_c_ayrilmis;
harita[metin, mantik] g_c_libc;

fonk c_adlari_hazirla() -> bos {
    eger (g_c_ayrilmis.uzunluk() > 0) { don; }
    oto ayrilmis = "auto break case char const continue default do double else enum extern float for goto if inline int long register restrict return short signed sizeof static struct switch typedef union unsigned void volatile while _Alignas _Alignof _Atomic _Bool _Complex _Generic _Imaginary _Noreturn _Static_assert _Thread_local asm typeof bool true false NULL main errno stdin stdout stderr EOF min max assert offsetof";
    her (oto a in upp.metin.bol(ayrilmis, " ")) { g_c_ayrilmis.koy(intern(a), dogru); }
    oto libc = "printf fprintf sprintf snprintf scanf fscanf sscanf puts fputs putchar fputc putc getchar fgetc getc fgets fopen fclose fread fwrite fseek ftell rewind fflush remove rename tmpfile perror feof ferror clearerr setbuf setvbuf vprintf vfprintf vsprintf vsnprintf ungetc freopen malloc calloc realloc free abort exit atexit getenv system abs labs llabs div ldiv atoi atol atoll atof strtol strtoll strtoul strtoull strtod strtof qsort bsearch rand srand memcpy memmove memset memcmp memchr strcpy strncpy strcat strncat strcmp strncmp strlen strchr strrchr strstr strtok strerror strdup strspn strcspn strpbrk sin cos tan asin acos atan atan2 sinh cosh tanh exp log log10 log2 pow sqrt cbrt ceil floor fabs fmod round trunc hypot fmin fmax modf frexp ldexp time clock difftime mktime localtime gmtime strftime asctime ctime read write close open sleep usleep pipe fork dup dup2 unlink rmdir chdir getcwd access lseek getpid isatty signal raise isalpha isdigit isspace isupper islower toupper tolower isalnum ispunct isprint";
    her (oto a in upp.metin.bol(libc, " ")) { g_c_libc.koy(intern(a), dogru); }
}

fonk c_ad_denetle(metin ad, sayi satir, sayi sutun, mantik ust_duzey) -> bos {
    c_adlari_hazirla();
    eger (g_c_ayrilmis.var_mi(ad)) {
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' C'de ayrılmış bir addır (anahtar sözcük ya da makro); başka bir ad seçin.");
        hata_fmt_ver(satir, sutun);
    } yoksa eger (ust_duzey && g_c_libc.var_mi(ad)) {
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' C standart kütüphanesinde tanımlı; üst düzey fonksiyon ya da değişken adı olamaz. Başka bir ad seçin ya da dosyayı 'kullan ... olarak' ile katın.");
        hata_fmt_ver(satir, sutun);
    }
}

fonk kapsam_bagla_yeni(metin ad, sayi ty, sayi satir, sayi sutun) -> bos {
    c_ad_denetle(ad, satir, sutun, yanlis);
    eger (hata_var()) { don; }
    eger (kapsam_yerel_var(ad)) {
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' bu kapsamda birden fazla kez tanımlandı.");
        hata_fmt_ver(satir, sutun);
        don;
    }
    kapsam_bagla(ad, ty);
}

// ---- c_kod metin sözleşmesi ----
// metin her zaman yönetilen bir değerdir (başlık + başvuru sayısı, paylaşımlı
// içerik). c_kod içindeki C metni sözcüklere ayrılır; kapsamdaki bir 'metin'
// değişkeni yeniden yönlendirilirse (=, +=, -=, ++, --) ya da içeriğine
// yazılırsa (s[i] = ..., *s = ...) derleme hatası verilir. Ham C dizgisi
// upp_metin_ata_c(&s, ...), başka bir metin upp_metin_ata(&s, ...) ile atanır.
// Dizgi/karakter sabitleri, yorumlar ve önişlemci satırları atlanır.
fonk ckod_kume(metin s) -> harita[metin, mantik] {
    harita[metin, mantik] K;
    her (oto p in upp.metin.bol(s, " ")) { K.koy(p, dogru); }
    don K;
}

fonk ckod_jetonlar(metin k) -> liste[metin] {
    liste[metin] J;
    sayi n = upp.uzunluk(k);
    sayi i = 0;
    oto iki = ckod_kume("== != <= >= += -= *= /= %= &= |= ^= ++ -- -> && || << >>");
    iken (i < n) {
        sayi c = k[i];
        sayi s2 = -1;
        eger (i + 1 < n) { s2 = k[i + 1]; }
        eger (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; devam; }
        eger (c == 47 && s2 == 47) {
            iken (i < n && k[i] != 10) { i = i + 1; }
            devam;
        }
        eger (c == 47 && s2 == 42) {
            i = i + 2;
            iken (i + 1 < n && !(k[i] == 42 && k[i + 1] == 47)) { i = i + 1; }
            i = i + 2;
            devam;
        }
        eger (c == 35) {
            iken (i < n && k[i] != 10) { i = i + 1; }
            devam;
        }
        eger (c == 34 || c == 39) {
            sayi kapat = c;
            i = i + 1;
            iken (i < n && k[i] != kapat) {
                eger (k[i] == 92) { i = i + 1; }
                i = i + 1;
            }
            i = i + 1;
            J.ekle("\"");
            devam;
        }
        eger (ident_bas(c)) {
            sayi bas = i;
            iken (i < n && ident_devam(k[i])) { i = i + 1; }
            J.ekle(upp.metin.kes(k, bas, i - bas));
            devam;
        }
        eger (c >= 48 && c <= 57) {
            iken (i < n && (ident_devam(k[i]) || k[i] == 46)) { i = i + 1; }
            J.ekle("0");
            devam;
        }
        eger (s2 >= 0) {
            metin op = upp.metin.kes(k, i, 2);
            eger (iki.var_mi(op)) {
                J.ekle(op);
                i = i + 2;
                devam;
            }
        }
        J.ekle(upp.metin.kes(k, i, 1));
        i = i + 1;
    }
    don J;
}

fonk ckod_kimlik_mi(metin j) -> mantik => upp.uzunluk(j) > 0 && ident_bas(j[0]);

fonk ckod_metin_degisken_mi(metin ad) -> mantik {
    sayi t = kapsam_bul(ad);
    eger (t == 0) { t = tablo_bul(3, ad); }
    don t != 0 && tip_metin_mi(t);
}

// j[i] bir tanımın adı mı (C'nin kendi yereli): "char *s", "int s", "T* s".
fonk ckod_tanim_mi(liste[metin] J, sayi i) -> mantik {
    sayi p = i - 1;
    iken (p >= 0 && J[p] == "*") { p = p - 1; }
    eger (p < 0 || !ckod_kimlik_mi(J[p])) { don yanlis; }
    oto onceki = J[p];
    don onceki != "return" && onceki != "else" && onceki != "do" && onceki != "case" && onceki != "sizeof";
}

fonk ckod_ihlal_ver(sayi node, metin ad, mantik icerik) -> bos {
    hata_fmt_basla();
    hata_fmt_yaz("c_kod içinde metin değişkeni '");
    hata_fmt_yaz(ad);
    eger (icerik) {
        hata_fmt_yaz("' içeriğine yazılamaz: metin paylaşımlı ve değişmez bir değerdir. Yeni bir metin kurup upp_metin_ata_c(&");
    } yoksa {
        hata_fmt_yaz("' doğrudan değiştirilemez: metin yönetilen bir değerdir. Ham C dizgisi için upp_metin_ata_c(&");
    }
    hata_fmt_yaz(ad);
    hata_fmt_yaz(", ...), başka bir metin için upp_metin_ata(&");
    hata_fmt_yaz(ad);
    hata_fmt_yaz(", ...) kullanın.");
    hata_fmt_ver(dugum_satir(node), dugum_sutun(node));
}

fonk ckod_metin_denetle(sayi node) -> bos {
    liste[metin] J = ckod_jetonlar(dugum_ad(node));
    harita[metin, mantik] yerel;
    oto yonlendir = ckod_kume("= += -= ++ --");
    oto yaz_op = ckod_kume("= += -= *= /= %= &= |= ^= ++ --");
    sayi n = J.uzunluk();
    dongu (sayi i = 0; i < n; i += 1) {
        oto ad = J[i];
        eger (!ckod_kimlik_mi(ad) || yerel.var_mi(ad)) { devam; }
        eger (i > 0 && (J[i - 1] == "." || J[i - 1] == "->")) { devam; }
        eger (!ckod_metin_degisken_mi(ad)) { devam; }
        eger (ckod_tanim_mi(J, i)) {
            yerel.koy(ad, dogru);
            devam;
        }
        oto sonraki = "";
        eger (i + 1 < n) { sonraki = J[i + 1]; }
        // Yeniden yönlendirme: s = ..., s += 1, s++, ++s
        eger (yonlendir.var_mi(sonraki) || (i > 0 && (J[i - 1] == "++" || J[i - 1] == "--"))) {
            ckod_ihlal_ver(node, ad, yanlis);
            don;
        }
        // İçeriğe yazma: s[...] = ...
        eger (sonraki == "[") {
            sayi d = 0;
            sayi j = i + 1;
            iken (j < n) {
                eger (J[j] == "[") { d = d + 1; }
                eger (J[j] == "]") {
                    d = d - 1;
                    eger (d == 0) { dur; }
                }
                j = j + 1;
            }
            eger (j + 1 < n && yaz_op.var_mi(J[j + 1])) {
                ckod_ihlal_ver(node, ad, dogru);
                don;
            }
        }
        // İçeriğe yazma: *s = ... (tekli *; öncesi değer değilse)
        eger (i > 0 && J[i - 1] == "*" && yaz_op.var_mi(sonraki)) {
            mantik tekli = i < 2 || !(ckod_kimlik_mi(J[i - 2]) || J[i - 2] == ")" || J[i - 2] == "]" || J[i - 2] == "0" || J[i - 2] == "\"");
            eger (tekli) {
                ckod_ihlal_ver(node, ad, dogru);
                don;
            }
        }
    }
}

fonk tip_yuru(sayi stmt) -> bos {
    hata_dosya_yaz(dugum_kaynak(stmt));
    eger (stmt == 0 || hata_var()) { don; }
    sayi t = dugum_tur(stmt);
    eger (t == DugumTur.D_BLOK) {
        kapsam_ac();
        sayi L = dugum_liste(stmt);
        sayi i = 0;
        iken (i < liste_uzunluk(L)) {
            tip_yuru(liste_al(L, i));
            i = i + 1;
        }
        kapsam_kapat();
        don;
    }
    eger (t == DugumTur.D_C_GOMMU) {
        ckod_metin_denetle(stmt);
        don;
    }
    eger (t == DugumTur.D_GUVENSIZ) {
        g_guvensiz_derin = g_guvensiz_derin + 1;
        tip_yuru(dugum_a(stmt));
        g_guvensiz_derin = g_guvensiz_derin - 1;
        don;
    }
    eger (t == DugumTur.D_GUVENLI) {
        sayi eski_g = g_guvensiz_derin;
        g_guvensiz_derin = 0;
        tip_yuru(dugum_a(stmt));
        g_guvensiz_derin = eski_g;
        don;
    }
    eger (t == DugumTur.D_ERTELE) {
        eger (bg_al() > 0) {
            hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'ertele' 'arkaplan' bloğunda kullanılamaz.");
            don;
        }
        eger ((dugum_bayrak(stmt) & 1) != 0) {
            sayi efn = cur_fn_al();
            eger (efn == 0 || !tip_beklenen_mi(dugum_a(efn))) {
                hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'hata_ertele' yalnızca 'beklenen' dönen fonksiyonda kullanılabilir.");
                don;
            }
        }
        kapsam_ac();
        tip_yuru(dugum_a(stmt));
        kapsam_kapat();
        don;
    }
    eger (t == DugumTur.D_ARKAPLAN) {
        eger (serbest_mi()) {
            hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'arkaplan' iş parçacığı ister; serbest/çekirdek hedefinde yok.");
            don;
        }
        bg_yaz(bg_al() + 1);
        tip_yuru(dugum_a(stmt));
        bg_yaz(bg_al() - 1);
        eger (!hata_var()) { bg_yakala(stmt); }
        don;
    }
    eger (t == DugumTur.D_DEGISKEN) {
        sayi init_t = 0;
        eger (dugum_c(stmt) != 0) {
            init_t = tip_ifade(dugum_c(stmt));
            eger ((dugum_bayrak(stmt) & 1) != 0 && init_t != 0 && hata_isaret_mi(dugum_ad(init_t))) {
                hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'oto' ile 'hata(...)' kullanılamaz; türü yazın: beklenen[T] x = hata(...).");
                don;
            }
            eger ((dugum_bayrak(stmt) & 1) != 0 && !hata_var() && (tip_void_mi(init_t) || tip_yok_mi(init_t))) {
                hata_fmt_basla();
                hata_fmt_yaz("'oto ");
                hata_fmt_yaz(dugum_ad(stmt));
                hata_fmt_yaz("' türünü çıkaramaz: ifade değer üretmiyor ('bos' ya da 'yok').");
                hata_fmt_ver(dugum_satir(stmt), dugum_sutun(stmt));
                don;
            }
            eger ((dugum_bayrak(stmt) & 1) != 0) {
                eger (dugum_tur(dugum_c(stmt)) == DugumTur.D_DIZI_SABIT) {
                sayi dd = dugum_dims(init_t);
                    eger (dd < 1) {
                        dd = 1;
                    }
                    dugum_yaz_dims(init_t, dd);
                }
                dugum_yaz_a(stmt, init_t);
            }
        }
        sayi bound = dugum_a(stmt);
        eger (dugum_b(stmt) != 0 || (dugum_bayrak(stmt) & 8) != 0) {
            bound = tur_dugum(dugum_satir(stmt), dugum_sutun(stmt), dugum_ad(dugum_a(stmt)), dugum_ptrd(dugum_a(stmt)), 1);
            dugum_yaz_a(stmt, bound);
        }
        sayi alen = 0;
        eger (dugum_c(stmt) != 0 && dugum_tur(dugum_c(stmt)) == DugumTur.D_DIZI_SABIT) {
            alen = liste_uzunluk(dugum_liste(dugum_c(stmt)));
        } yoksa eger (dugum_b(stmt) != 0 && dugum_tur(dugum_b(stmt)) == DugumTur.D_SABIT && dugum_ptrd(dugum_b(stmt)) == 0 && dugum_sayi(dugum_b(stmt)) > 0) {
            alen = dugum_sayi(dugum_b(stmt));
        }
        eger (alen > 0 && bound != 0) {
            dugum_yaz_sayi(bound, alen);
        }
        eger ((dugum_bayrak(stmt) & 16) != 0) {
            eger (dugum_c(stmt) == 0 || !sabit_ifade_mi(dugum_c(stmt))) {
                hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "sabit derleme zamanı ifadesi ile başlatılmalıdır.");
            }
            eger (bound != 0) {
                dugum_yaz_bayrak(bound, dugum_bayrak(bound) | 16);
            }
        }
        eger (init_t != 0 && (dugum_bayrak(stmt) & 1) == 0 && bound != 0) {
            eger (!tip_ifade_atanir(bound, dugum_c(stmt))) {
                atama_uyumsuz_ver(dugum_satir(stmt), dugum_sutun(stmt), bound, dugum_c(stmt));
            }
            cmetin_gecici_denetle(bound, dugum_c(stmt), dugum_satir(stmt), dugum_sutun(stmt));
        }
        kapsam_bagla_yeni(dugum_ad(stmt), bound, dugum_satir(stmt), dugum_sutun(stmt));
        don;
    }
    eger (t == DugumTur.D_EGER) {
        tip_ifade(dugum_a(stmt));
        tip_yuru(dugum_b(stmt));
        tip_yuru(dugum_c(stmt));
        don;
    }
    eger (t == DugumTur.D_IKEN) {
        eger (soru_icerir(dugum_a(stmt))) {
            hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "Döngü koşulunda '?' kullanılamaz; değeri önce bir değişkene alın.");
            don;
        }
        tip_ifade(dugum_a(stmt));
        tip_yuru(dugum_b(stmt));
        don;
    }
    eger (t == DugumTur.D_DONGU) {
        eger (soru_icerir(dugum_b(stmt)) || soru_icerir(dugum_c(stmt))) {
            hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "Döngü koşulunda ya da adımında '?' kullanılamaz.");
            don;
        }
        kapsam_ac();
        tip_yuru(dugum_a(stmt));
        tip_ifade(dugum_b(stmt));
        tip_ifade(dugum_c(stmt));
        tip_yuru(dugum_d(stmt));
        kapsam_kapat();
        don;
    }
    eger (t == DugumTur.D_SECIM) {
        sayi sw_t = tip_ifade(dugum_a(stmt));
        eger (hata_var()) { don; }
        sayi sr_kip = sirali_secim(stmt, sw_t);
        eger (hata_var()) { don; }
        eger (sr_kip == 1) {
            tip_yuru(stmt);
            don;
        }
        sayi L = dugum_liste(stmt);
        sayi i = 0;
        eger (!secim_uygun_tur(sw_t)) {
            hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'secim' tam sayı, metin veya seçenek bekler.");
            don;
        }
        iken (i < liste_uzunluk(L)) {
            sayi c = liste_al(L, i);
            eger (dugum_a(c) != 0) {
                sayi val = dugum_a(c);
                sayi ct = tip_ifade(val);
                eger (hata_var()) { don; }
                eger (!secim_sabit_mi(val)) {
                    hata_ver(dugum_satir(c), dugum_sutun(c), "'durum' değeri derleme zamanı sabiti (sayı, metin veya seçenek üyesi) olmalıdır.");
                    don;
                }
                eger (!tip_ifade_atanir(sw_t, val) && !tip_atanir(sw_t, ct) && !tip_atanir(ct, sw_t)) {
                    hata_ver(dugum_satir(c), dugum_sutun(c), "'durum' türü uyumsuz.");
                    don;
                }
            }
            sayi sl = dugum_liste(c);
            sayi j = 0;
            iken (j < liste_uzunluk(sl)) {
                tip_yuru(liste_al(sl, j));
                j = j + 1;
            }
            i = i + 1;
        }
        don;
    }
    eger (t == DugumTur.D_HER && (dugum_bayrak(stmt) & 2) != 0) {
        // Aralık: her (T i in a..b); a ve b tamsayı, T tamsayı (oto → sayi).
        sayi bas_t = tip_ifade(dugum_b(stmt));
        sayi son_t = tip_ifade(dugum_d(stmt));
        eger (hata_var()) { don; }
        eger (!tip_tam_sayi_mi(bas_t) || !tip_tam_sayi_mi(son_t)) {
            hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "Aralık sınırları tamsayı olmalı: her (sayi i in a..b).");
            don;
        }
        eger ((dugum_bayrak(stmt) & 1) != 0) {
            dugum_yaz_a(stmt, tip_sayi(dugum_satir(stmt), dugum_sutun(stmt)));
        } yoksa eger (!tip_tam_sayi_mi(dugum_a(stmt))) {
            hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "Aralık döngüsünün değişkeni tamsayı türünde olmalı (ya da 'oto').");
            don;
        }
        kapsam_ac();
        kapsam_bagla_yeni(dugum_ad(stmt), dugum_a(stmt), dugum_satir(stmt), dugum_sutun(stmt));
        tip_yuru(dugum_c(stmt));
        kapsam_kapat();
        don;
    }
    eger (t == DugumTur.D_HER) {
        sayi it_t = tip_ifade(dugum_b(stmt));
        sayi elem = 0;
        eger (liste_tur_mi(dugum_ad(it_t)) && dugum_ptrd(it_t) == 0) {
            elem = tur_dugum(dugum_satir(stmt), dugum_sutun(stmt), liste_elem_ad(dugum_ad(it_t)), 0, 0);
        } yoksa eger (harita_tur_mi(dugum_ad(it_t)) && dugum_ptrd(it_t) == 0) {
            elem = tur_dugum(dugum_satir(stmt), dugum_sutun(stmt), harita_anahtar_ad(dugum_ad(it_t)), 0, 0);
        } yoksa {
            eger (dugum_dims(it_t) < 1 && dugum_tur(dugum_b(stmt)) != DugumTur.D_DIZI_SABIT) {
                hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'her' gerçek bir dizi veya liste bekler.");
            }
            eger (dugum_dims(it_t) > 1) {
                hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'her' tek boyutlu dizi bekler; iç içe '[...]' desteklenmez.");
            }
            sayi edim = dugum_dims(it_t);
            eger (edim > 0) {
                edim = edim - 1;
            }
            elem = tur_dugum(dugum_satir(stmt), dugum_sutun(stmt), dugum_ad(it_t), dugum_ptrd(it_t), edim);
        }
        eger ((dugum_bayrak(stmt) & 1) != 0) {
            dugum_yaz_a(stmt, elem);
        } yoksa eger (!hata_var() && !tip_atanir(dugum_a(stmt), elem)) {
            oto degisken_t = tur_aciklama(dugum_a(stmt));
            oto eleman_t = tur_aciklama(elem);
            hata_fmt_basla();
            hata_fmt_yaz("'her' değişkeni '");
            hata_fmt_yaz(dugum_ad(stmt));
            hata_fmt_yaz("' ");
            hata_fmt_yaz(degisken_t);
            hata_fmt_yaz(" türünde, elemanlar ise ");
            hata_fmt_yaz(eleman_t);
            hata_fmt_yaz(" (ya da 'oto' yazın).");
            hata_fmt_ver(dugum_satir(stmt), dugum_sutun(stmt));
            don;
        }
        kapsam_ac();
        kapsam_bagla_yeni(dugum_ad(stmt), dugum_a(stmt), dugum_satir(stmt), dugum_sutun(stmt));
        tip_yuru(dugum_c(stmt));
        kapsam_kapat();
        don;
    }
    eger (t == DugumTur.D_DON) {
        sayi got = tip_bos(dugum_satir(stmt), dugum_sutun(stmt));
        sayi fn = 0;
        sayi expect = 0;
        eger (dugum_a(stmt) != 0) { got = tip_ifade(dugum_a(stmt)); }
        eger (hata_var()) { don; }
        eger (bg_al() > 0) {
            eger (dugum_a(stmt) != 0 && !tip_void_mi(got)) {
                hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'arkaplan' bloğunda 'don' değer alamaz; iş parçacığını bitirmek için 'don;' yazın.");
            }
            don;
        }
        fn = cur_fn_al();
        eger (fn == 0) { don; }
        expect = dugum_a(fn);
        eger (tip_void_mi(expect)) {
            eger (dugum_a(stmt) != 0 && !tip_void_mi(got) && (dugum_bayrak(fn) & 2048) != 0) {
                hata_fmt_basla();
                hata_fmt_yaz("'");
                hata_fmt_yaz(dugum_ad(fn));
                hata_fmt_yaz("' dönüş türü çıkarılamadı (özyinelemeli ya da çözülemeyen çağrı); '-> T' ile yazın.");
                hata_fmt_ver(dugum_satir(stmt), dugum_sutun(stmt));
                don;
            }
            eger (dugum_a(stmt) != 0 && !tip_void_mi(got)) {
                oto bul = tur_aciklama(got);
                hata_fmt_basla();
                hata_fmt_yaz("'bos' dönen fonksiyonda değer döndürülemez (ifade türü '");
                hata_fmt_yaz(bul);
                hata_fmt_yaz("').");
                hata_fmt_ver(dugum_satir(stmt), dugum_sutun(stmt));
            }
            don;
        }
        eger (dugum_a(stmt) == 0 && tip_beklenen_bos_mu(expect)) { don; }
        eger (dugum_a(stmt) == 0 || tip_void_mi(got)) {
            oto bek = tur_aciklama(expect);
            hata_fmt_basla();
            hata_fmt_yaz("'");
            hata_fmt_yaz(bek);
            hata_fmt_yaz("' dönen fonksiyonda 'don' bir değer gerektirir.");
            hata_fmt_ver(dugum_satir(stmt), dugum_sutun(stmt));
            don;
        }
        eger (!tip_ifade_atanir(expect, dugum_a(stmt))) {
            oto bek = tur_aciklama(expect);
            oto bul = tur_aciklama(got);
            hata_fmt_basla();
            hata_fmt_yaz("Dönüş türü uyumsuz: beklenen '");
            hata_fmt_yaz(bek);
            hata_fmt_yaz("', bulunan '");
            hata_fmt_yaz(bul);
            hata_fmt_yaz("'.");
            hata_fmt_ver(dugum_satir(stmt), dugum_sutun(stmt));
        }
        don;
    }
    eger (t == DugumTur.D_IFADE_CUMLE) {
        sayi ie = dugum_a(stmt);
        eger (hata_kurucu_mi(ie)) {
            hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'hata(...)' yalnızca 'don', atama ya da ilk değer olarak kullanılır.");
            don;
        }
        sayi it = tip_ifade(ie);
        eger (!hata_var() && tip_beklenen_mi(it) && dugum_tur(ie) != DugumTur.D_ATAMA) {
            hata_ver(dugum_satir(stmt), dugum_sutun(stmt), "'beklenen' sonucu yok sayılamaz; '?' ile yayın ya da '.tamam_mi()' ile denetleyin.");
        }
        don;
    }
}

fonk gorunum_donus_yasak(sayi t, sayi satir, sayi sutun) -> bos {
    eger (tip_gorunum_mi(t)) {
        hata_ver(satir, sutun, "Görünüm türü ('&metin' / '&dilim[T]') döndürülemez; ömür sarkması oluşur.");
    }
}

fonk tip_fn_doldur(sayi fn) -> bos {
    sayi P = dugum_liste(fn);
    sayi i = 0;
    iken (i < liste_uzunluk(P)) {
        sayi p = liste_al(P, i);
        eger (dugum_a(p) == 0 || metin_esit(dugum_ad(dugum_a(p)), "")) {
            dugum_yaz_a(p, tip_sayi(dugum_satir(fn), dugum_sutun(fn)));
        }
        eger (dugum_c(p) != 0 && !sabit_ifade_mi(dugum_c(p))) {
            hata_ver(dugum_satir(p), dugum_sutun(p), "Varsayılan derleme sabiti olmalı ve parametreye bakamaz.");
        }
        i = i + 1;
    }
    gorunum_donus_yasak(dugum_a(fn), dugum_satir(fn), dugum_sutun(fn));
}

fonk tip_fn_govde_sinif(sayi fn, metin sinif_ad) -> bos {
    kapsam_sifirla();
    kapsam_ac();
    cur_fn_yaz(fn);
    oto stad = sinif_ad;
    eger (metin_esit(stad, "")) {
        stad = metot_sinif_tur_ad(fn);
    }
    eger (!metin_esit(stad, "")) {
        cur_class_yaz(stad);
        kapsam_bagla_yeni("kendi", tur_dugum(dugum_satir(fn), dugum_sutun(fn), stad, 1, 0), dugum_satir(fn), dugum_sutun(fn));
    } yoksa {
        cur_class_yaz("");
    }
    sayi P = dugum_liste(fn);
    sayi i = 0;
    iken (i < liste_uzunluk(P)) {
        sayi p = liste_al(P, i);
        kapsam_bagla_yeni(dugum_ad(p), dugum_a(p), dugum_satir(p), dugum_sutun(p));
        i = i + 1;
    }
    tip_yuru(dugum_b(fn));
    eger (!hata_var()) {
        sayi rt = dugum_a(fn);
        eger (!tip_void_mi(rt) && !tip_beklenen_bos_mu(rt)) {
            eger (!her_zaman_doner(dugum_b(fn))) {
                hata_fmt_basla();
                hata_fmt_yaz("'");
                hata_fmt_yaz(dugum_ad(fn));
                hata_fmt_yaz("' dönüş değeri olmayan yollara sahip.");
                hata_fmt_ver(dugum_satir(fn), dugum_sutun(fn));
            }
        }
    }
    cur_fn_yaz(0);
    cur_class_yaz("");
}

// c_harici imzası: C ABI'sine doğrudan geçen türler.
fonk harici_tur_uygun(sayi t, mantik donus) -> mantik {
    eger (t == 0) { don yanlis; }
    eger (dugum_dims(t) != 0) { don yanlis; }
    eger (dugum_ptrd(t) > 0) { don dogru; }
    oto n = dugum_ad(t);
    eger (tip_tamsayi_adi_mi(n) || metin_esit(n, "ondalik") || metin_esit(n, "mantik") || metin_esit(n, "cmetin")) { don dogru; }
    eger (donus) { don tip_void_mi(t); }
    don metin_esit(n, "metin");
}

fonk harici_imza_denetle(sayi fn) -> bos {
    sayi P = dugum_liste(fn);
    dongu (sayi i = 0; i < liste_uzunluk(P); i += 1) {
        sayi p = liste_al(P, i);
        eger (dugum_c(p) != 0) {
            hata_ver(dugum_satir(p), dugum_sutun(p), "c_harici parametresi varsayılan değer alamaz.");
            don;
        }
        eger (!harici_tur_uygun(dugum_a(p), yanlis)) {
            hata_fmt_basla();
            hata_fmt_yaz("c_harici parametresi '");
            hata_fmt_yaz(dugum_ad(p));
            hata_fmt_yaz("' C'ye geçirilemeyen bir türde ('");
            hata_fmt_yaz(tur_aciklama(dugum_a(p)));
            hata_fmt_yaz("'). Tamsayı, ondalik, mantik, cmetin, metin ya da işaretçi kullanın.");
            hata_fmt_ver(dugum_satir(p), dugum_sutun(p));
            don;
        }
    }
    sayi rt = dugum_a(fn);
    eger (tip_metin_mi(rt)) {
        hata_ver(dugum_satir(fn), dugum_sutun(fn), "c_harici 'metin' döndüremez (C dizgisi yönetilmez). 'cmetin' döndürüp '(metin)c' ile kopyalayın.");
        don;
    }
    eger (!harici_tur_uygun(rt, dogru)) {
        hata_fmt_basla();
        hata_fmt_yaz("c_harici dönüş türü C'ye uygun değil ('");
        hata_fmt_yaz(tur_aciklama(rt));
        hata_fmt_yaz("'). bos, tamsayı, ondalik, mantik, cmetin ya da işaretçi kullanın.");
        hata_fmt_ver(dugum_satir(fn), dugum_sutun(fn));
    }
}

// c_harici çağrısı bellek güvenliğini derleyicinin denetleyemediği koda gider.
// Yalnızca tür denetimi aşamasında: codegen de tip_ifade çağırır ama 'guvensiz'
// derinliğini tutmaz.
mantik g_tip_asamasi = yanlis;

fonk harici_cagri_denetle(sayi fn, sayi satir, sayi sutun) -> bos {
    eger (!g_tip_asamasi || !harici_mi(fn) || g_guvensiz_derin > 0) { don; }
    hata_fmt_basla();
    hata_fmt_yaz("c_harici fonksiyon '");
    hata_fmt_yaz(dugum_ad(fn));
    hata_fmt_yaz("' yalnızca 'guvensiz' blokta çağrılabilir ya da değer olarak alınabilir.");
    hata_fmt_guvenlik(satir, sutun);
}

// ---- Ok gövdeli fonksiyonda dönüş türü çıkarımı: fonk kare(sayi x) => x * x; ----
// Bayrak 1024: türü henüz çıkarılmadı. Çıkarım sessiz turlarla yapılır; çağırdığı
// bekleyen bir fonksiyon varsa o tur başarısız sayılır ve bir sonraki turda denenir.
fonk donus_bekleyen_denetle(sayi fn) -> bos {
    eger (g_hata_sessiz > 0 && (dugum_bayrak(fn) & 1024) != 0) { g_sessiz_hata = 1; }
}

fonk ok_donus_bekliyor_mu(sayi fn) -> mantik {
    sayi fl = dugum_bayrak(fn);
    eger ((fl & 2) == 0 || (fl & 4) != 0 || harici_mi(fn)) { don yanlis; }
    sayi b = dugum_b(fn);
    eger (b == 0 || liste_uzunluk(dugum_liste(b)) != 1) { don yanlis; }
    sayi s = liste_al(dugum_liste(b), 0);
    don dugum_tur(s) == DugumTur.D_DON && dugum_a(s) != 0;
}

fonk ok_donus_dene(sayi fn, metin sinif_ad) -> mantik {
    kapsam_sifirla();
    kapsam_ac();
    cur_fn_yaz(fn);
    oto stad = sinif_ad;
    eger (metin_esit(stad, "")) { stad = metot_sinif_tur_ad(fn); }
    eger (!metin_esit(stad, "")) {
        cur_class_yaz(stad);
        kapsam_bagla_yeni("kendi", tur_dugum(dugum_satir(fn), dugum_sutun(fn), stad, 1, 0), dugum_satir(fn), dugum_sutun(fn));
    } yoksa {
        cur_class_yaz("");
    }
    g_hata_sessiz = g_hata_sessiz + 1;
    g_sessiz_hata = 0;
    sayi P = dugum_liste(fn);
    sayi i = 0;
    iken (i < liste_uzunluk(P)) {
        sayi p = liste_al(P, i);
        kapsam_bagla_yeni(dugum_ad(p), dugum_a(p), dugum_satir(p), dugum_sutun(p));
        i = i + 1;
    }
    sayi ex = dugum_a(liste_al(dugum_liste(dugum_b(fn)), 0));
    sayi t = tip_ifade(ex);
    g_hata_sessiz = g_hata_sessiz - 1;
    mantik ok = g_sessiz_hata == 0 && t != 0 && dugum_dims(t) == 0 && !hata_isaret_mi(dugum_ad(t));
    g_sessiz_hata = 0;
    cur_fn_yaz(0);
    cur_class_yaz("");
    kapsam_kapat();
    eger (ok && !tip_void_mi(t)) {
        dugum_yaz_a(fn, tur_dugum(dugum_satir(fn), dugum_sutun(fn), dugum_ad(t), dugum_ptrd(t), 0));
    }
    don ok;
}

fonk ok_donus_turleri_cikar(sayi decls) -> bos {
    liste[sayi] bekleyen;
    liste[metin] sinifi;
    sayi i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_FONK && ok_donus_bekliyor_mu(d)) {
            bekleyen.ekle(d);
            sinifi.ekle("");
        }
        eger (dugum_tur(d) == DugumTur.D_SINIF) {
            sayi M = dugum_liste2(d);
            sayi j = 0;
            iken (j < liste_uzunluk(M)) {
                sayi m = liste_al(M, j);
                eger (ok_donus_bekliyor_mu(m)) {
                    bekleyen.ekle(m);
                    sinifi.ekle(sinif_tur_ad(d));
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    eger (bekleyen.uzunluk() == 0) { don; }
    her (oto f in bekleyen) { dugum_yaz_bayrak(f, dugum_bayrak(f) | 1024); }
    mantik ilerledi = dogru;
    iken (ilerledi && !hata_var()) {
        ilerledi = yanlis;
        dongu (sayi k = 0; k < bekleyen.uzunluk(); k += 1) {
            sayi f = bekleyen[k];
            eger ((dugum_bayrak(f) & 1024) != 0 && ok_donus_dene(f, sinifi[k])) {
                dugum_yaz_bayrak(f, dugum_bayrak(f) - 1024);
                ilerledi = dogru;
            }
        }
    }
    // Çözülemeyenler (özyineleme, gerçek hata) 'bos' kalır; gövde denetimi açık hata verir.
    her (oto f in bekleyen) {
        eger ((dugum_bayrak(f) & 1024) != 0) {
            dugum_yaz_bayrak(f, (dugum_bayrak(f) - 1024) | 2048);
        }
    }
}

fonk tip_fn_govde(sayi fn) -> bos {
    eger (harici_mi(fn)) {
        harici_imza_denetle(fn);
        don;
    }
    tip_fn_govde_sinif(fn, "");
}

// Sınıflar birbirini değer olarak (alan ya da alan dizisi) içerebilir ama döngü
// kuramaz: C'de sonsuz boyutlu yapı olur. Döngü liste[T] ile kırılır.
harita[sayi, sayi] g_sd_renk;      // 1 ziyarette, 2 bitti

// Alan türü değer olarak gömülen bir kullanıcı sınıfıysa o sınıf; değilse 0.
fonk alan_gomulu_sinif(sayi f) -> sayi {
    sayi t = dugum_a(f);
    eger (t == 0 || dugum_ptrd(t) != 0) { don 0; }
    oto ad = dugum_ad(t);
    eger (liste_tur_mi(ad) || harita_tur_mi(ad) || beklenen_tur_mi(ad) || yerlesik_sinif_mi(ad)) { don 0; }
    don tablo_bul(0, ad);
}

fonk sinif_dongu_dfs(sayi cls) -> bos {
    g_sd_renk.koy(cls, 1);
    sayi F = dugum_liste(cls);
    her (sayi i in 0..liste_uzunluk(F)) {
        sayi f = liste_al(F, i);
        sayi c2 = alan_gomulu_sinif(f);
        eger (c2 == 0) { devam; }
        sayi r = 0;
        eger (g_sd_renk.var_mi(c2)) { r = g_sd_renk.al(c2); }
        eger (r == 1) {
            hata_fmt_basla();
            hata_fmt_yaz("'");
            hata_fmt_yaz(dugum_ad(cls));
            hata_fmt_yaz(".");
            hata_fmt_yaz(dugum_ad(f));
            hata_fmt_yaz("': '");
            hata_fmt_yaz(dugum_ad(c2));
            hata_fmt_yaz("' sınıfı kendini (dolaylı olarak) değer olarak içeriyor; yapı sonsuz büyüklükte olur. Döngüyü 'liste[");
            hata_fmt_yaz(dugum_ad(c2));
            hata_fmt_yaz("]' ile kırın.");
            hata_fmt_ver(dugum_satir(f), dugum_sutun(f));
            don;
        }
        eger (r == 0) {
            sinif_dongu_dfs(c2);
            eger (hata_var()) { don; }
        }
    }
    g_sd_renk.koy(cls, 2);
}

fonk sinif_dongu_denetle(sayi decls) -> bos {
    g_sd_renk.temizle();
    her (sayi i in 0..liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) != DugumTur.D_SINIF) { devam; }
        sayi cls = tablo_bul(0, sinif_tur_ad(d));
        eger (cls == 0 || g_sd_renk.var_mi(cls)) { devam; }
        sinif_dongu_dfs(cls);
        eger (hata_var()) { don; }
    }
}

fonk tip_calistir(sayi program) -> bos {
    g_tip_asamasi = dogru;
    tip_calistir_govde(program);
    g_tip_asamasi = yanlis;
}

fonk tip_calistir_govde(sayi program) -> bos {
    tablo_sifirla();
    tip_yerlesik_sinif("Yonelme", "pitch", "ondalik", "yaw", "ondalik", "", "");
    tip_yerlesik_sinif("EkranNokta", "x", "ondalik", "y", "ondalik", "gorunur", "sayi");
    tip_yerlesik_sinif("Vektor3", "x", "ondalik", "y", "ondalik", "z", "ondalik");
    tip_yerlesik_sinif("ArkaplanIs", "handle", "sayi", "", "", "", "");
    tip_yerlesik_sinif("JSONDeger", "id", "sayi", "", "", "", "");
    tip_yerlesik_sinif("SurecCikti", "cikti", "metin", "kod", "sayi", "basarili", "mantik");
    tip_yerlesik_sinif("Kilit", "id", "sayi", "", "", "", "");
    sayi decls = dugum_liste(program);
    sayi i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        sayi t = dugum_tur(d);
        eger (t == DugumTur.D_SECENEK) {
            oto ekey = sinif_tur_ad(d);
            oto ealias = dugum_alias_ad(d);
            eger (!metin_esit(ealias, "") && tablo_bul(3, intern(kat("modul.", ealias))) == 0) {
                tablo_yaz(3, intern(kat("modul.", ealias)), tur_dugum(dugum_satir(d), dugum_sutun(d), intern(kat("modul.", ealias)), 0, 0));
            }
            eger (tablo_bul(2, ekey) != 0 || tablo_bul(0, ekey) != 0 || tur_adi_mi(dugum_ad(d))) {
                hata_fmt_basla();
                hata_fmt_yaz("'");
                hata_fmt_yaz(dugum_ad(d));
                hata_fmt_yaz("' zaten tanımlı; seçenek olarak kullanılamaz.");
                hata_fmt_ver(dugum_satir(d), dugum_sutun(d));
            } yoksa {
                tablo_yaz(2, ekey, d);
            }
        } yoksa eger (t == DugumTur.D_SINIF) {
            oto skey = sinif_tur_ad(d);
            oto alias = dugum_alias_ad(d);
            eger (!metin_esit(alias, "") && tablo_bul(3, intern(kat("modul.", alias))) == 0) {
                tablo_yaz(3, intern(kat("modul.", alias)), tur_dugum(dugum_satir(d), dugum_sutun(d), intern(kat("modul.", alias)), 0, 0));
            }
            eger (yerlesik_sinif_mi(dugum_ad(d)) && metin_esit(alias, "")) {
                hata_fmt_basla();
                hata_fmt_yaz("'");
                hata_fmt_yaz(dugum_ad(d));
                hata_fmt_yaz("' yerleşik bir türdür; yeniden tanımlanamaz.");
                hata_fmt_ver(dugum_satir(d), dugum_sutun(d));
            } yoksa eger (tablo_bul(2, dugum_ad(d)) != 0) {
                hata_fmt_basla();
                hata_fmt_yaz("'");
                hata_fmt_yaz(dugum_ad(d));
                hata_fmt_yaz("' seçenek adı olarak tanımlı; sınıf olamaz.");
                hata_fmt_ver(dugum_satir(d), dugum_sutun(d));
            } yoksa eger (tablo_bul(0, skey) != 0) {
                cift_tanim_ver(tablo_bul(0, skey), d, skey);
            } yoksa {
                c_ad_denetle(dugum_ad(d), dugum_satir(d), dugum_sutun(d), yanlis);
                her (sayi fi in 0..liste_uzunluk(dugum_liste(d))) {
                    sayi alan = liste_al(dugum_liste(d), fi);
                    c_ad_denetle(dugum_ad(alan), dugum_satir(alan), dugum_sutun(alan), yanlis);
                }
                tablo_yaz(0, skey, d);
                sayi M = dugum_liste2(d);
                sayi j = 0;
                iken (j < liste_uzunluk(M)) {
                    sayi m = liste_al(M, j);
                    oto anahtar = kat3(nokta_altcizgi(skey), "_", dugum_ad(m));
                    eger (tablo_bul(1, anahtar) != 0) {
                        cift_tanim_ver(tablo_bul(1, anahtar), m, anahtar);
                    }
                    tablo_yaz(1, anahtar, m);
                    j = j + 1;
                }
            }
            sayi SF = dugum_liste(d);
            sayi si = 0;
            iken (si < liste_uzunluk(SF)) {
                sayi sf = liste_al(SF, si);
                eger (tip_gorunum_mi(dugum_a(sf))) {
                    hata_ver(dugum_satir(sf), dugum_sutun(sf), "Sınıf alanında görünüm türü yok.");
                }
                eger (beklenen_tur_mi(dugum_ad(dugum_a(sf)))) {
                    hata_ver(dugum_satir(sf), dugum_sutun(sf), "Sınıf alanı 'beklenen' türünde olamaz; değeri ve hatayı ayrı alanlarda tutun.");
                }
                si = si + 1;
            }
        } yoksa eger (t == DugumTur.D_FONK) {
            oto fkey = dugum_c_ad(d);
            oto falias = dugum_alias_ad(d);
            eger (!metin_esit(falias, "") && tablo_bul(3, intern(kat("modul.", falias))) == 0) {
                tablo_yaz(3, intern(kat("modul.", falias)), tur_dugum(dugum_satir(d), dugum_sutun(d), intern(kat("modul.", falias)), 0, 0));
            }
            eger (tablo_bul(1, fkey) != 0) {
                cift_tanim_ver(tablo_bul(1, fkey), d, fkey);
            }
            eger (metin_esit(falias, "") && !metin_esit(dugum_ad(d), "ana") && !harici_mi(d)) {
                c_ad_denetle(dugum_ad(d), dugum_satir(d), dugum_sutun(d), dogru);
            }
            tablo_yaz(1, fkey, d);
        }
        i = i + 1;
    }
    eger (!hata_var()) { sinif_dongu_denetle(decls); }
    eger (hata_var()) { don; }
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_FONK) { tip_fn_doldur(d); }
        eger (dugum_tur(d) == DugumTur.D_SINIF) {
            sayi M = dugum_liste2(d);
            sayi j = 0;
            iken (j < liste_uzunluk(M)) {
                tip_fn_doldur(liste_al(M, j));
                j = j + 1;
            }
        }
        i = i + 1;
    }
    kapsam_sifirla();
    kapsam_ac();
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_DEGISKEN) {
            oto vkey = dugum_c_ad(d);
            oto valias = dugum_alias_ad(d);
            eger (!metin_esit(valias, "") && tablo_bul(3, intern(kat("modul.", valias))) == 0) {
                tablo_yaz(3, intern(kat("modul.", valias)), tur_dugum(dugum_satir(d), dugum_sutun(d), intern(kat("modul.", valias)), 0, 0));
            }
            eger (kapsam_bul(vkey) != 0 || tablo_bul(3, vkey) != 0) {
                sayi eski = kapsam_bul(vkey);
                eger (eski == 0) { eski = tablo_bul(3, vkey); }
                cift_tanim_ver(eski, d, vkey);
            }
            c_ad_denetle(dugum_ad(d), dugum_satir(d), dugum_sutun(d), metin_esit(valias, ""));
            eger (dugum_ptrd(dugum_a(d)) > 0) {
                hata_ver(dugum_satir(d), dugum_sutun(d), "Üst düzeyde işaretçi değişken yok.");
            }
            eger (tip_gorunum_mi(dugum_a(d))) {
                hata_ver(dugum_satir(d), dugum_sutun(d), "Üst düzeyde görünüm değişken yok.");
            }
            eger (beklenen_tur_mi(dugum_ad(dugum_a(d))) && dugum_c(d) != 0) {
                hata_ver(dugum_satir(d), dugum_sutun(d), "Üst düzey 'beklenen' değişkeni ilk değer alamaz.");
            }
            eger (dugum_b(d) != 0 || (dugum_bayrak(d) & 8) != 0 || dugum_dims(dugum_a(d)) > 0) {
                hata_ver(dugum_satir(d), dugum_sutun(d), "Üst düzeyde dizi yok; 'liste[T]' kullanın.");
            }
            eger ((dugum_bayrak(d) & 16) == 0 && dugum_c(d) != 0 && !sabit_ifade_mi(dugum_c(d))) {
                hata_ver(dugum_satir(d), dugum_sutun(d), "Üst düzey değişken derleme sabiti veya sıfır ile başlatılmalıdır.");
            }
            eger (dugum_c(d) != 0) {
                g_tip_global_alias = dugum_alias_ad(d);
                sayi got = tip_ifade(dugum_c(d));
                g_tip_global_alias = "";
                eger (!tip_ifade_atanir(dugum_a(d), dugum_c(d))) {
                    atama_uyumsuz_ver(dugum_satir(d), dugum_sutun(d), dugum_a(d), dugum_c(d));
                }
            }
            sayi bound = dugum_a(d);
            eger ((dugum_bayrak(d) & 16) != 0 && bound != 0) {
                dugum_yaz_bayrak(bound, dugum_bayrak(bound) | 16);
            }
            kapsam_bagla_yeni(vkey, bound, dugum_satir(d), dugum_sutun(d));
            eger (bound != 0) {
                tablo_yaz(3, vkey, bound);
            }
        }
        i = i + 1;
    }
    ok_donus_turleri_cikar(decls);
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_FONK) { tip_fn_govde(d); }
        eger (dugum_tur(d) == DugumTur.D_SINIF) {
            sayi M = dugum_liste2(d);
            sayi j = 0;
            oto stad = sinif_tur_ad(d);
            iken (j < liste_uzunluk(M)) {
                sayi m = liste_al(M, j);
                eger (dugum_c(m) == 0 || metin_esit(dugum_ad(dugum_c(m)), "")) {
                    dugum_yaz_c(m, kimlik_dugum(dugum_satir(m), dugum_sutun(m), stad));
                }
                tip_fn_govde_sinif(m, stad);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_FONK && metin_esit(dugum_ad(d), "ana")) {
            sayi rt = dugum_a(d);
            eger (!(metin_esit(dugum_ad(rt), "sayi") || metin_esit(dugum_ad(rt), "bos")) || dugum_ptrd(rt) != 0) {
                hata_ver(dugum_satir(d), dugum_sutun(d), "'ana' dönüş türü 'sayi' veya 'bos' olmalı.");
            }
            eger (liste_uzunluk(dugum_liste(d)) != 0) {
                hata_ver(dugum_satir(d), dugum_sutun(d), "'ana' parametre alamaz.");
            }
        }
        i = i + 1;
    }
}
