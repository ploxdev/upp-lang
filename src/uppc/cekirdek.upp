// --hedef cekirdek: u++ programını önyüklenebilir x86_64 çekirdeğine çevirir.
// Önyükleyici (Multiboot 1 → 32 bit → long mode), bağlayıcı betiği ve araç
// zinciri seçimi burada. Çıktı: <ad>.elf (64 bit) ve <ad>32.elf (QEMU -kernel).

fonk ck_boot_s() -> metin {
    metin o = "/* u++ çekirdek önyükleyicisi (uppc gömülü) — Multiboot 1, x86_64 */\n";
    o += ".set MB_SIHIR, 0x1BADB002\n";
    o += ".set MB_BAYRAK, 0x00000003\n";
    o += ".set MB_TOPLAM, -(MB_SIHIR + MB_BAYRAK)\n";
    o += "\n.section .multiboot, \"a\"\n.align 4\n.long MB_SIHIR, MB_BAYRAK, MB_TOPLAM\n";
    o += "\n.section .bss\n.align 4096\n";
    o += "ck_pml4: .skip 4096\nck_pdpt: .skip 4096\nck_pd: .skip 4096\n";
    o += ".align 16\nck_yigin_alt: .skip 65536\nck_yigin_ust:\n";
    o += ".global upp_multiboot_bilgi\nupp_multiboot_bilgi: .skip 8\n";
    o += "\n.section .rodata\n.align 8\nck_gdt:\n";
    o += "    .quad 0\n    .quad 0x00AF9A000000FFFF\n    .quad 0x00CF92000000FFFF\nck_gdt_son:\n";
    o += "ck_gdt_ptr:\n    .word ck_gdt_son - ck_gdt - 1\n    .quad ck_gdt\n";
    o += "\n.section .text\n.code32\n.global _start\n_start:\n";
    o += "    cli\n    mov $ck_yigin_ust, %esp\n    mov %ebx, upp_multiboot_bilgi\n";
    o += "    /* PML4 -> PDPT -> PD; ilk 1 GiB 2 MiB sayfalarla birebir */\n";
    o += "    mov $ck_pdpt, %eax\n    or $3, %eax\n    mov %eax, ck_pml4\n";
    o += "    mov $ck_pd, %eax\n    or $3, %eax\n    mov %eax, ck_pdpt\n";
    o += "    xor %ecx, %ecx\n1:\n    mov %ecx, %eax\n    shl $21, %eax\n    or $0x83, %eax\n";
    o += "    mov %eax, ck_pd(,%ecx,8)\n    inc %ecx\n    cmp $512, %ecx\n    jne 1b\n";
    o += "    mov $ck_pml4, %eax\n    mov %eax, %cr3\n";
    o += "    mov %cr4, %eax\n    or $0x20, %eax\n    mov %eax, %cr4\n";
    o += "    mov $0xC0000080, %ecx\n    rdmsr\n    or $0x100, %eax\n    wrmsr\n";
    o += "    mov %cr0, %eax\n    or $0x80000000, %eax\n    mov %eax, %cr0\n";
    o += "    lgdt ck_gdt_ptr\n    ljmp $0x08, $ck_uzun\n";
    o += "\n.code64\nck_uzun:\n";
    o += "    mov $0x10, %ax\n    mov %ax, %ds\n    mov %ax, %es\n    mov %ax, %ss\n    mov %ax, %fs\n    mov %ax, %gs\n";
    o += "    mov $ck_yigin_ust, %rsp\n";
    o += "    /* SSE: CR0.EM=0, CR0.MP=1, CR4.OSFXSR|OSXMMEXCPT */\n";
    o += "    mov %cr0, %rax\n    and $~0x4, %rax\n    or $0x2, %rax\n    mov %rax, %cr0\n";
    o += "    mov %cr4, %rax\n    or $0x600, %rax\n    mov %rax, %cr4\n";
    o += "    call upp_cekirdek_giris\n2:\n    cli\n    hlt\n    jmp 2b\n";
    o += "\n.section .note.GNU-stack, \"\", @progbits\n";
    don o;
}

fonk ck_ld() -> metin {
    metin o = "/* u++ çekirdek bağlayıcı betiği (uppc gömülü) */\n";
    o += "ENTRY(_start)\nSECTIONS\n{\n    . = 1M;\n";
    o += "    .multiboot : { KEEP(*(.multiboot)) }\n";
    o += "    .text : ALIGN(4K) { *(.text .text.*) }\n";
    o += "    .rodata : ALIGN(4K) { *(.rodata .rodata.*) }\n";
    o += "    .data : ALIGN(4K) { *(.data .data.*) }\n";
    o += "    .bss : ALIGN(4K) { *(COMMON) *(.bss .bss.*) }\n";
    o += "    /DISCARD/ : { *(.eh_frame) *(.note .note.*) *(.comment) }\n";
    o += "}\n";
    don o;
}

// C:\a\b → /mnt/c/a/b (WSL üzerinden derlerken)
fonk ck_wsl_yol(metin p) -> metin {
    oto g = upp.metin.degistir(os_yol_gercek(p), "\\", "/");
    eger (upp.uzunluk(g) >= 2 && g[1] == 58) {
        oto surucu = upp.metin.kucuk(upp.metin.kes(g, 0, 1));
        don "/mnt/" + surucu + upp.metin.kes(g, 2, upp.uzunluk(g) - 2);
    }
    don g;
}

metin g_ck_onek = "";
metin g_ck_gcc = "";
metin g_ck_ld = "";
metin g_ck_objcopy = "";
mantik g_ck_wsl = yanlis;

// x86_64 ELF araç zinciri: Linux'ta yerel gcc; Windows'ta x86_64-elf-* ya da WSL.
fonk ck_arac_bul() -> mantik {
    eger (os_host_linux() != 0) {
        g_ck_gcc = "gcc";
        g_ck_ld = "ld";
        g_ck_objcopy = "objcopy";
        don dogru;
    }
    oto capraz = upp.sistem.komut_bul("x86_64-elf-gcc");
    eger (capraz != yok && !metin_esit(capraz, "")) {
        g_ck_gcc = "x86_64-elf-gcc";
        g_ck_ld = "x86_64-elf-ld";
        g_ck_objcopy = "x86_64-elf-objcopy";
        don dogru;
    }
    oto wsl = upp.sistem.komut_bul("wsl");
    eger (wsl != yok && !metin_esit(wsl, "")) {
        SurecCikti r = upp.sistem.calistir("wsl -e sh -c \"command -v gcc && command -v ld && command -v objcopy\"");
        eger (r.kod == 0) {
            g_ck_wsl = dogru;
            g_ck_onek = "wsl -e ";
            g_ck_gcc = "gcc";
            g_ck_ld = "ld";
            g_ck_objcopy = "objcopy";
            don dogru;
        }
    }
    don yanlis;
}

fonk ck_yol(metin p) -> metin {
    eger (g_ck_wsl) { don os_tirnak(ck_wsl_yol(p)); }
    don os_cmd_parca(p);
}

fonk ck_calistir(metin cmd) -> sayi {
    SurecCikti r = upp.sistem.calistir(g_ck_onek + cmd);
    eger (r.kod != 0 && r.cikti != yok) { upp.yaz(r.cikti); }
    don r.kod;
}

fonk ck_qemu_komut() -> metin {
    eger (g_ck_wsl) {
        SurecCikti r = upp.sistem.calistir("wsl -e sh -c \"command -v qemu-system-x86_64\"");
        eger (r.kod == 0) { don "wsl -e qemu-system-x86_64"; }
    }
    oto q = upp.sistem.komut_bul("qemu-system-x86_64");
    eger (q != yok && !metin_esit(q, "")) { don os_cmd_parca(q); }
    don "";
}

// c_yol: üretilmiş C; kok: çıktı kökü (uzantısız). 0 = başarılı.
fonk cekirdek_derle(metin c_yol, metin kok, mantik calistir) -> sayi {
    eger (!ck_arac_bul()) {
        upp.satir_yaz("[u++ HATA] x86_64 ELF araç zinciri bulunamadı. Linux'ta 'gcc', Windows'ta 'x86_64-elf-gcc' ya da WSL içinde 'gcc' gerekir.");
        don 1;
    }
    oto dizin = upp.yol.dizin(kok);
    oto boot_s = upp.yol.birlestir(dizin, "upp_boot.S");
    oto ld_yol = upp.yol.birlestir(dizin, "upp_cekirdek.ld");
    os_dosya_yaz(boot_s, ck_boot_s());
    os_dosya_yaz(ld_yol, ck_ld());
    oto boot_o = kok + "_boot.o";
    oto prog_o = kok + ".o";
    oto elf = kok + ".elf";
    oto elf32 = kok + "32.elf";
    metin bayrak = " -std=gnu11 -O2 -m64 -ffreestanding -fno-stack-protector -fno-pic -fno-pie -mno-red-zone -fno-asynchronous-unwind-tables -nostdlib -Wno-unused-function";
    upp.yaz("[u++] çekirdek derleniyor (");
    eger (g_ck_wsl) { upp.yaz("WSL "); }
    upp.yaz(g_ck_gcc);
    upp.satir_yaz(")...");
    eger (ck_calistir(g_ck_gcc + bayrak + " -c " + ck_yol(boot_s) + " -o " + ck_yol(boot_o)) != 0) { don 1; }
    eger (ck_calistir(g_ck_gcc + bayrak + " -c " + ck_yol(c_yol) + " -o " + ck_yol(prog_o)) != 0) { don 1; }
    eger (ck_calistir(g_ck_ld + " -n -nostdlib -T " + ck_yol(ld_yol) + " -o " + ck_yol(elf) + " " + ck_yol(boot_o) + " " + ck_yol(prog_o)) != 0) { don 1; }
    eger (ck_calistir(g_ck_objcopy + " -O elf32-i386 " + ck_yol(elf) + " " + ck_yol(elf32)) != 0) { don 1; }
    upp.yaz("[u++] ÇEKİRDEK HAZIR: ");
    upp.yaz(elf);
    upp.yaz(" (QEMU için: ");
    upp.yaz(elf32);
    upp.satir_yaz(")");
    eger (!calistir) { don 0; }
    oto q = ck_qemu_komut();
    eger (metin_esit(q, "")) {
        upp.satir_yaz("[u++] QEMU bulunamadı; çalıştırmak için 'qemu-system-x86_64' kurun (Ubuntu/WSL: sudo apt install qemu-system-x86).");
        don 0;
    }
    metin hedef = os_cmd_parca(elf32);
    eger (metin_esit(upp.metin.kes(q, 0, 3), "wsl")) { hedef = os_tirnak(ck_wsl_yol(elf32)); }
    upp.satir_yaz("==================================================");
    sayi kod = upp.sistem.kos(q + " -kernel " + hedef + " -serial stdio -display none -no-reboot -device isa-debug-exit,iobase=0xf4,iosize=0x04");
    // isa-debug-exit: çıkış kodu (deger << 1) | 1
    eger (kod == 1 || kod == 0) { don 0; }
    don kod / 2;
}
