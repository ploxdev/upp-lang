fonk jeton_id_at(sayi off) -> sayi {
    sayi i = ayristir_i_al() + off;
    sayi n = jeton_sayisi();
    eger (n <= 1) {
        don 0;
    }
    eger (i < 1) {
        i = 1;
    }
    eger (i >= n) {
        don n - 1;
    }
    don i;
}

fonk bak_tur() -> sayi {
    don jeton_tur(jeton_id_at(0));
}

fonk bak_deger() -> metin {
    don jeton_deger(jeton_id_at(0));
}

fonk bak_satir() -> sayi {
    don jeton_satir(jeton_id_at(0));
}

fonk bak_sutun() -> sayi {
    don jeton_sutun(jeton_id_at(0));
}

fonk bak_tur_at(sayi off) -> sayi {
    don jeton_tur(jeton_id_at(off));
}

fonk bak_deger_at(sayi off) -> metin {
    don jeton_deger(jeton_id_at(off));
}

fonk j_ilerle() -> sayi {
    sayi id = jeton_id_at(0);
    eger (bak_tur() != JetonTur.J_EOF) {
        ayristir_i_yaz(ayristir_i_al() + 1);
    }
    don id;
}

fonk esles_tur(sayi t) -> mantik {
    eger (bak_tur() == t) {
        j_ilerle();
        don dogru;
    }
    don yanlis;
}

fonk esles_kw(metin w) -> mantik {
    eger (bak_tur() == JetonTur.J_ANAHTAR && metin_esit(bak_deger(), w)) {
        j_ilerle();
        don dogru;
    }
    don yanlis;
}

fonk kw_mi(metin w) -> mantik {
    don bak_tur() == JetonTur.J_ANAHTAR && metin_esit(bak_deger(), w);
}

fonk beklenen_tur(sayi t, metin goster) -> sayi {
    eger (hata_var()) {
        don 0;
    }
    eger (bak_tur() != t) {
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(goster);
        hata_fmt_yaz("' bekleniyordu, '");
        hata_fmt_yaz(bak_deger());
        hata_fmt_yaz("' bulundu.");
        hata_fmt_ver(bak_satir(), bak_sutun());
        don 0;
    }
    don j_ilerle();
}

fonk beklenen_kw(metin w) -> sayi {
    eger (hata_var()) {
        don 0;
    }
    eger (!kw_mi(w)) {
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(w);
        hata_fmt_yaz("' anahtar sözcüğü bekleniyordu, '");
        hata_fmt_yaz(bak_deger());
        hata_fmt_yaz("' bulundu.");
        hata_fmt_ver(bak_satir(), bak_sutun());
        don 0;
    }
    don j_ilerle();
}

fonk beklenen_kimlik(mantik tur_kw_izin) -> sayi {
    eger (hata_var()) {
        don 0;
    }
    eger (bak_tur() == JetonTur.J_KIMLIK) {
        don j_ilerle();
    }
    eger (bak_tur() == JetonTur.J_ANAHTAR) {
        eger (tur_kw_izin && tur_adi_mi(bak_deger())) {
            don j_ilerle();
        }
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(bak_deger());
        hata_fmt_yaz("' bir anahtar sözcüktür; tanımlayıcı olarak kullanılamaz.");
        hata_fmt_ver(bak_satir(), bak_sutun());
        don 0;
    }
    hata_fmt_basla();
    hata_fmt_yaz("Tanımlayıcı bekleniyordu, '");
    hata_fmt_yaz(bak_deger());
    hata_fmt_yaz("' bulundu.");
    hata_fmt_ver(bak_satir(), bak_sutun());
    don 0;
}

fonk metin_coz(metin raw) -> metin {
    sayi n = metin_uzun(raw);
    eger (n >= 6 && metin_cp(raw, 0) == 34 && metin_cp(raw, 1) == 34 && metin_cp(raw, 2) == 34 && metin_cp(raw, n - 3) == 34 && metin_cp(raw, n - 2) == 34 && metin_cp(raw, n - 1) == 34) {
        metin s = "";
        sayi i = 3;
        iken (i < n - 3) {
            sayi c = metin_cp(raw, i);
            sayi adv = metin_adv(raw, i);
            eger (c != 13) {
                s = kat(s, intern_dilim(raw, i, i + adv));
            }
            i = i + adv;
        }
        don s;
    }
    eger (n < 2 || metin_cp(raw, 0) != 34 || metin_cp(raw, n - 1) != 34) {
        don raw;
    }
    metin s = "";
    sayi i = 1;
    iken (i < n - 1) {
        sayi c = metin_cp(raw, i);
        sayi adv = metin_adv(raw, i);
        eger (c == 92 && i + adv < n - 1) {
            sayi nxt = metin_cp(raw, i + adv);
            sayi nadv = metin_adv(raw, i + adv);
            eger (nxt == 110) { s = kat(s, "\n"); }
            yoksa eger (nxt == 116) { s = kat(s, "\t"); }
            yoksa eger (nxt == 114) { s = kat(s, "\r"); }
            yoksa eger (nxt == 92) { s = kat(s, "\\"); }
            yoksa eger (nxt == 34) { s = kat(s, "\""); }
            yoksa eger (nxt == 39) { s = kat(s, "'"); }
            yoksa eger (nxt == 101) { s = kat(s, upp.metin.hex_coz("1b")); }
            yoksa eger (nxt == 120 && i + adv + nadv + 1 < n - 1 && hex_hane_deger(metin_cp(raw, i + adv + nadv)) >= 0 && hex_hane_deger(metin_cp(raw, i + adv + nadv + 1)) >= 0) {
                s = kat(s, upp.metin.hex_coz(intern_dilim(raw, i + adv + nadv, i + adv + nadv + 2)));
                i = i + adv + nadv + 2;
                devam;
            }
            yoksa eger (nxt == 117) {
                // \uHHHH: Unicode kod noktası
                sayi bas = i + adv + nadv;
                sayi kod = 0;
                sayi k = 0;
                iken (k < 4 && bas + k < n - 1 && hex_hane_deger(metin_cp(raw, bas + k)) >= 0) {
                    kod = kod * 16 + hex_hane_deger(metin_cp(raw, bas + k));
                    k = k + 1;
                }
                eger (k != 4 || (kod >= 55296 && kod <= 57343)) {
                    g_kacis_hatasi = "'\\u' ardından 4 onaltılık hane gelmeli (ör. \\u00e7)";
                } yoksa {
                    s = kat(s, upp.metin.karakter(kod));
                }
                i = bas + k;
                devam;
            }
            yoksa {
                g_kacis_hatasi = kat3("Bilinmeyen kaçış dizisi '\\", intern_dilim(raw, i + adv, i + adv + nadv), "'. Geçerli: \\n \\t \\r \\\\ \\\" \\' \\e \\xHH \\uHHHH");
                s = kat(s, intern_dilim(raw, i + adv, i + adv + nadv));
            }
            i = i + adv + nadv;
            devam;
        }
        s = kat(s, intern_dilim(raw, i, i + adv));
        i = i + adv;
    }
    don s;
}

// ---- interpolasyon: "...{ifade}..." ayrıştırma anında AST'ye çözülür ----
// '{' hemen ardından harf/_ ya da '(' gelirse ifade başlar; '{{' ve '}}' kaçıştır.
// Parçalar dugum_liste(n)'de: ptrd 7 olan D_SABIT ham metin, diğerleri ifade.
fonk interp_baslar_mi(sayi c) -> mantik {
    don ident_bas(c) || c == 40;
}

// p konumunda eksiksiz bir karakter sabiti mi: 'a', '\n', '\x41', 'ş'.
// "'{' ile" gibi düz metinler (tırnaktan sonra kapanmayan) interpolasyon sayılmaz.
fonk interp_kar_sabiti_mi(metin t, sayi p) -> mantik {
    eger (metin_cp(t, p) != 39) { don yanlis; }
    sayi c = metin_cp(t, p + 1);
    eger (c < 0 || c == 39 || c == 10) { don yanlis; }
    eger (c != 92) { don metin_cp(t, p + 2) == 39; }
    sayi k = metin_cp(t, p + 2);
    eger (k == 120) { don hex_hane_deger(metin_cp(t, p + 3)) >= 0 && hex_hane_deger(metin_cp(t, p + 4)) >= 0 && metin_cp(t, p + 5) == 39; }
    eger (k == 117) {
        dongu (sayi h = 3; h < 7; h += 1) {
            eger (hex_hane_deger(metin_cp(t, p + h)) < 0) { don yanlis; }
        }
        don metin_cp(t, p + 7) == 39;
    }
    eger (k == 34) {
        // "..." içinde '"' kaynakta '\"' diye yazılır: '\"' + kapanış
        eger (metin_cp(t, p + 3) == 39) { don dogru; }
    }
    don k >= 0 && metin_cp(t, p + 3) == 39;
}

// p'de eksiksiz bir karakter sabiti varsa kapanış tırnağından sonraki konum, yoksa -1.
fonk kar_sabiti_son(metin t, sayi p) -> sayi {
    eger (!interp_kar_sabiti_mi(t, p)) { don -1; }
    sayi q = p + 2;
    iken (metin_cp(t, q) != 39) { q = q + 1; }
    don q + 1;
}

// t[i] == '{' bir interpolasyon ifadesi başlatıyor mu (tanımlayıcı, '(' ya da karakter sabiti).
fonk interp_ifade_baslar(metin t, sayi i) -> mantik {
    sayi c2 = metin_cp(t, i + 1);
    don interp_baslar_mi(c2) || interp_kar_sabiti_mi(t, i + 1);
}

fonk interp_aday_var(metin text) -> mantik {
    sayi n = metin_uzun(text);
    sayi i = 0;
    iken (i + 1 < n) {
        eger (metin_cp(text, i) == 123) {
            sayi c2 = metin_cp(text, i + 1);
            eger (c2 == 123) {
                i = i + 2;
                devam;
            }
            eger (interp_ifade_baslar(text, i)) { don dogru; }
        }
        i = i + 1;
    }
    don yanlis;
}

fonk interp_parca_ekle(sayi L, metin parca, sayi satir, sutun) -> bos {
    eger (metin_esit(parca, "")) { don; }
    sayi p = dugum_yeni(DugumTur.D_SABIT, satir, sutun);
    dugum_yaz_ad(p, intern(parca));
    dugum_yaz_ptrd(p, 7);
    liste_ekle(L, p);
}

// İfade metnini ana jeton akışının sonuna lex'leyip ayrıştırır; lexer/ayrıştırıcı durumu geri yüklenir.
fonk interp_ifade_ayristir(metin src, sayi satir, sayi sutun) -> sayi {
    oto k_kaynak = g_kaynak;
    sayi k_cp = g_cp_i;
    sayi k_satir = g_lex_satir;
    sayi k_sutun = g_lex_sutun;
    sayi k_i = ayristir_i_al();
    sayi bas = j_n;
    g_kaynak = intern(src);
    g_cp_i = 0;
    g_lex_satir = satir;
    g_lex_sutun = sutun;
    lex_tara();
    sayi e = 0;
    eger (!hata_var()) {
        ayristir_i_yaz(bas);
        e = ayristir_ifade();
        eger (!hata_var() && bak_tur() != JetonTur.J_EOF) {
            hata_ver(satir, sutun, "İnterpolasyon ifadesi ayrıştırılamadı. Düz '{{' yazmak için '{{{{' kullanın.");
            e = 0;
        }
    }
    g_kaynak = k_kaynak;
    g_cp_i = k_cp;
    g_lex_satir = k_satir;
    g_lex_sutun = k_sutun;
    ayristir_i_yaz(k_i);
    don e;
}

fonk kacis_var(metin text) -> mantik {
    sayi m = metin_uzun(text);
    sayi i = 0;
    iken (i + 1 < m) {
        sayi c = metin_cp(text, i);
        eger ((c == 123 || c == 125) && metin_cp(text, i + 1) == c) { don dogru; }
        i = i + 1;
    }
    don yanlis;
}

// Düz metin parçasının kaçışlarını çözer ("..." için); üçlü tırnakta yalnızca CR atılır.
fonk interp_parca_coz(metin ham, mantik uclu) -> metin {
    eger (uclu) { don metin_coz(kat3("\"\"\"", ham, "\"\"\"")); }
    don metin_coz(kat3("\"", ham, "\""));
}

// İnterpolasyon kaynak (ham) metin üzerinde bölünür:
//  - düz parçaların kaçışları (\n, \u00e7 ...) yalnızca o parçalara uygulanır;
//  - {ifade} kaynakta yazıldığı gibi ayrıştırılır; tek istisna "..." içinde iç içe
//    metnin tırnağının \" yazılmasıdır. Böylece "{'\n'}", "{'}'}", "{'\''}" doğru çalışır.
//  - {{ ve }} düz { ve } olur.
fonk interp_ayristir(sayi n) -> bos {
    oto raw = dugum_ad(n);
    sayi rn = metin_uzun(raw);
    mantik uclu = rn >= 6 && metin_cp(raw, 0) == 34 && metin_cp(raw, 1) == 34 && metin_cp(raw, 2) == 34;
    eger (rn < 2 || metin_cp(raw, 0) != 34) { don; }
    sayi tq = 1;
    eger (uclu) { tq = 3; }
    oto ic = intern_dilim(raw, tq, rn - tq);
    eger (!interp_aday_var(ic) && !kacis_var(ic)) {
        // Düz metin: kaçış hatası varsa şimdi bildir (codegen yeniden çözer).
        metin_coz(raw);
        eger (!metin_esit(g_kacis_hatasi, "")) {
            oto kh = g_kacis_hatasi;
            g_kacis_hatasi = "";
            hata_ver(dugum_satir(n), dugum_sutun(n), kh);
        }
        don;
    }
    sayi satir = dugum_satir(n);
    sayi sutun = dugum_sutun(n);
    sayi L = liste_yeni();
    metin parca = "";
    metin duz = "";
    mantik ifade_var = yanlis;
    sayi m = metin_uzun(ic);
    sayi i = 0;
    iken (i < m && !hata_var()) {
        sayi c = metin_cp(ic, i);
        sayi c2 = -1;
        eger (i + 1 < m) { c2 = metin_cp(ic, i + 1); }
        eger (c == 92 && c2 >= 0 && !uclu) {
            // kaçış çifti düz parçada kalır; \{ gibi geçersizler çözümde hata verir
            parca += intern_dilim(ic, i, i + 2);
            i = i + 2;
            devam;
        }
        eger (c == 123 && c2 == 123) {
            parca += "{";
            i = i + 2;
            devam;
        }
        eger (c == 125 && c2 == 125) {
            parca += "}";
            i = i + 2;
            devam;
        }
        eger (c == 123 && interp_ifade_baslar(ic, i)) {
            // {ifade}: kaynak olduğu gibi; yalnızca \" → " (iç içe metin tırnağı)
            metin ifade = "";
            sayi j = i + 1;
            sayi derin = 0;
            mantik ic_metin = yanlis;
            mantik ic_kar = yanlis;
            mantik kapandi = yanlis;
            iken (j < m) {
                sayi d = metin_cp(ic, j);
                sayi d2 = -1;
                eger (j + 1 < m) { d2 = metin_cp(ic, j + 1); }
                eger (d == 92 && d2 >= 0) {
                    eger (d2 == 34 && !uclu) {
                        ifade += "\"";
                        eger (!ic_kar) { ic_metin = !ic_metin; }
                    } yoksa {
                        ifade += intern_dilim(ic, j, j + 2);
                    }
                    j = j + 2;
                    devam;
                }
                eger (uclu && d == 34 && !ic_kar) {
                    ic_metin = !ic_metin;
                } yoksa eger (!ic_metin && d == 39) {
                    ic_kar = !ic_kar;
                } yoksa eger (!ic_metin && !ic_kar) {
                    eger (d == 40 || d == 91 || d == 123) {
                        derin = derin + 1;
                    } yoksa eger (d == 41 || d == 93) {
                        derin = derin - 1;
                    } yoksa eger (d == 125) {
                        eger (derin == 0) {
                            kapandi = dogru;
                            dur;
                        }
                        derin = derin - 1;
                    }
                }
                ifade += intern_dilim(ic, j, j + 1);
                j = j + 1;
            }
            eger (!kapandi) {
                hata_ver(satir, sutun, "Kapatılmamış interpolasyon '{'. Düz '{{' yazmak için '{{{{' kullanın.");
                don;
            }
            oto cozulmus = interp_parca_coz(parca, uclu);
            eger (!metin_esit(g_kacis_hatasi, "")) {
                oto kh = g_kacis_hatasi;
                g_kacis_hatasi = "";
                hata_ver(satir, sutun, kh);
                don;
            }
            interp_parca_ekle(L, cozulmus, satir, sutun);
            duz += cozulmus;
            parca = "";
            sayi e = interp_ifade_ayristir(ifade, satir, sutun);
            eger (e == 0) { don; }
            liste_ekle(L, e);
            ifade_var = dogru;
            i = j + 1;
            devam;
        }
        parca += intern_dilim(ic, i, i + 1);
        i = i + 1;
    }
    oto son = interp_parca_coz(parca, uclu);
    eger (!metin_esit(g_kacis_hatasi, "")) {
        oto kh = g_kacis_hatasi;
        g_kacis_hatasi = "";
        hata_ver(satir, sutun, kh);
        don;
    }
    eger (!ifade_var) {
        // yalnızca {{ / }} kaçışı: çözülmüş metni ham sabit olarak geri yaz
        dugum_yaz_ad(n, c_escape(kat(duz, son)));
        don;
    }
    interp_parca_ekle(L, son, satir, sutun);
    dugum_yaz_liste(n, L);
    dugum_yaz_bayrak(n, dugum_bayrak(n) | 32);
}

fonk interp_dugum_mi(sayi e) -> mantik {
    don e != 0 && dugum_tur(e) == DugumTur.D_SABIT && dugum_ptrd(e) == 2 && (dugum_bayrak(e) & 32) != 0;
}

fonk tur_baslangici_mi() -> mantik {
    eger (bak_tur() == JetonTur.J_VE_ISARET) {
        eger (bak_tur_at(1) == JetonTur.J_ANAHTAR && metin_esit(bak_deger_at(1), "metin")) {
            don bak_tur_at(2) == JetonTur.J_KIMLIK;
        }
        eger (bak_tur_at(1) == JetonTur.J_ANAHTAR && metin_esit(bak_deger_at(1), "dilim")) {
            don bak_tur_at(5) == JetonTur.J_KIMLIK;
        }
        don yanlis;
    }
    eger (bak_tur() == JetonTur.J_ANAHTAR && tur_adi_mi(bak_deger())) {
        don dogru;
    }
    eger (bak_tur() == JetonTur.J_ANAHTAR && metin_esit(bak_deger(), "fonk") && bak_tur_at(1) == JetonTur.J_PARANTEZ_AC) {
        don dogru;
    }
    eger (bak_tur() == JetonTur.J_KIMLIK) {
        sayi i = 1;
        eger (bak_tur_at(i) == JetonTur.J_NOKTA && bak_tur_at(i + 1) == JetonTur.J_KIMLIK) {
            i = i + 2;
        }
        iken (bak_tur_at(i) == JetonTur.J_YILDIZ) {
            i = i + 1;
        }
        don bak_tur_at(i) == JetonTur.J_KIMLIK;
    }
    don yanlis;
}

fonk ayristir_koleksiyon_elem() -> metin {
    eger (hata_var()) {
        don "";
    }
    eger (bak_tur() == JetonTur.J_ANAHTAR && koleksiyon_elem_mi(bak_deger())) {
        oto ad = kanonik_tur(bak_deger());
        j_ilerle();
        don ad;
    }
    hata_fmt_basla();
    hata_fmt_yaz("Koleksiyon eleman türü 'sayi', 'ondalik', 'mantik' veya 'metin' olmalı, '");
    hata_fmt_yaz(bak_deger());
    hata_fmt_yaz("' bulundu.");
    hata_fmt_ver(bak_satir(), bak_sutun());
    don "";
}

// Koleksiyon eleman türü: işaretçi ve görünüm dışında her değer türü
// (sayısal türler, metin, sınıf, liste[...], harita[...]).
fonk ayristir_koleksiyon_tur() -> metin {
    eger (hata_var()) { don ""; }
    sayi satir = bak_satir();
    sayi sutun = bak_sutun();
    sayi t = ayristir_tur();
    eger (hata_var() || t == 0) { don ""; }
    eger (dugum_ptrd(t) != 0 || metin_esit(intern_dilim(dugum_ad(t), 0, 1), "&")) {
        hata_ver(satir, sutun, "Koleksiyon elemanı işaretçi ya da görünüm olamaz.");
        don "";
    }
    eger (metin_esit(dugum_ad(t), "bos")) {
        hata_ver(satir, sutun, "Koleksiyon elemanı 'bos' olamaz.");
        don "";
    }
    don dugum_ad(t);
}

// fonk(P1, P2) -> R  (R yazılmazsa bos). Parametre adı yazılmaz.
fonk ayristir_fonk_tur() -> sayi {
    sayi satir = bak_satir();
    sayi sutun = bak_sutun();
    j_ilerle();
    beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
    metin s = "fonk(";
    sayi n = 0;
    eger (bak_tur() != JetonTur.J_PARANTEZ_KAPA) {
        mantik devam_et = dogru;
        iken (devam_et && !hata_var()) {
            sayi ps = bak_satir();
            sayi pc = bak_sutun();
            sayi pt = ayristir_tur();
            eger (hata_var() || pt == 0) { don 0; }
            eger (dugum_dims(pt) > 0 || tip_void_mi(pt)) {
                hata_ver(ps, pc, "Fonksiyon türü parametresi 'bos' ya da dizi olamaz.");
                don 0;
            }
            eger (n > 0) { s = kat(s, ","); }
            s = kat(s, tur_kanonik_ad(pt));
            n = n + 1;
            devam_et = esles_tur(JetonTur.J_VIRGUL);
        }
    }
    beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
    metin r = "bos";
    eger (esles_tur(JetonTur.J_OK)) {
        sayi rt = ayristir_tur();
        eger (hata_var() || rt == 0) { don 0; }
        r = tur_kanonik_ad(rt);
    }
    don tur_dugum(satir, sutun, intern(kat3(s, ")->", r)), 0, 0);
}

fonk ayristir_tur() -> sayi {
    eger (hata_var()) {
        don 0;
    }
    sayi satir = bak_satir();
    sayi sutun = bak_sutun();
    eger (esles_tur(JetonTur.J_VE_ISARET)) {
        eger (bak_tur() == JetonTur.J_ANAHTAR && metin_esit(bak_deger(), "metin")) {
            j_ilerle();
            don tur_dugum(satir, sutun, intern("&metin"), 0, 0);
        }
        eger (bak_tur() == JetonTur.J_ANAHTAR && metin_esit(bak_deger(), "dilim")) {
            oto elem = "";
            j_ilerle();
            beklenen_tur(JetonTur.J_KOSE_AC, "[");
            elem = ayristir_koleksiyon_elem();
            beklenen_tur(JetonTur.J_KOSE_KAPA, "]");
            eger (metin_esit(elem, "metin")) {
                hata_ver(satir, sutun, "'&dilim[metin]' v1'de yok; sayısal T veya '&metin' kullanın.");
                don 0;
            }
            eger (!metin_esit(elem, "sayi") && !metin_esit(elem, "bayt") && !metin_esit(elem, "ubayt") && !metin_esit(elem, "ondalik") && !metin_esit(elem, "mantik")) {
                hata_ver(satir, sutun, "'&dilim[T]' yalnızca sayi/bayt/ondalik/mantik kabul eder.");
                don 0;
            }
            don tur_dugum(satir, sutun, intern(kat3("&dilim[", elem, "]")), 0, 0);
        }
        hata_ver(satir, sutun, "'&' tür konumunda yalnızca '&metin' veya '&dilim[T]' olabilir.");
        don 0;
    }
    eger (bak_tur() == JetonTur.J_ANAHTAR && metin_esit(bak_deger(), "fonk") && bak_tur_at(1) == JetonTur.J_PARANTEZ_AC) {
        don ayristir_fonk_tur();
    }
    metin ad = "";
    eger (bak_tur() == JetonTur.J_ANAHTAR && tur_adi_mi(bak_deger())) {
        ad = bak_deger();
        j_ilerle();
    } yoksa eger (bak_tur() == JetonTur.J_KIMLIK) {
        ad = bak_deger();
        j_ilerle();
        eger (esles_tur(JetonTur.J_NOKTA)) {
            sayi p = beklenen_kimlik(yanlis);
            ad = kat3(ad, ".", jeton_deger(p));
        }
    } yoksa {
        hata_fmt_basla();
        hata_fmt_yaz("Tür bekleniyordu ('sayi', 'ondalik', 'metin', 'mantik', 'bos', 'liste[T]', 'harita[K,V]', '&metin', '&dilim[T]' veya sınıf adı), '");
        hata_fmt_yaz(bak_deger());
        hata_fmt_yaz("' bulundu.");
        hata_fmt_ver(satir, sutun);
        don 0;
    }
    ad = kanonik_tur(ad);
    eger (metin_esit(ad, "dilim")) {
        hata_ver(satir, sutun, "'dilim' yalnızca '&dilim[T]' olarak kullanılır.");
        don 0;
    }
    eger (metin_esit(ad, "liste")) {
        beklenen_tur(JetonTur.J_KOSE_AC, "[");
        oto elem = ayristir_koleksiyon_tur();
        beklenen_tur(JetonTur.J_KOSE_KAPA, "]");
        ad = kat3("liste[", elem, "]");
    } yoksa eger (metin_esit(ad, "harita")) {
        beklenen_tur(JetonTur.J_KOSE_AC, "[");
        oto k = ayristir_koleksiyon_tur();
        beklenen_tur(JetonTur.J_VIRGUL, ",");
        oto v = ayristir_koleksiyon_tur();
        beklenen_tur(JetonTur.J_KOSE_KAPA, "]");
        eger (!metin_esit(k, "metin") && !metin_esit(k, "sayi")) {
            hata_ver(satir, sutun, "harita anahtarı 'metin' veya 'sayi' olmalı.");
            don 0;
        }
        ad = kat(kat3("harita[", k, ","), kat(v, "]"));
    } yoksa eger (metin_esit(ad, "beklenen")) {
        beklenen_tur(JetonTur.J_KOSE_AC, "[");
        sayi ds = bak_satir();
        sayi dc = bak_sutun();
        sayi dt = ayristir_tur();
        eger (hata_var() || dt == 0) { don 0; }
        eger (dugum_dims(dt) > 0 || tip_gorunum_mi(dt)) {
            hata_ver(ds, dc, "'beklenen' değer türü dizi ya da görünüm olamaz.");
            don 0;
        }
        metin hn = "metin";
        eger (esles_tur(JetonTur.J_VIRGUL)) {
            sayi hs = bak_satir();
            sayi hc = bak_sutun();
            sayi ht = ayristir_tur();
            eger (hata_var() || ht == 0) { don 0; }
            eger (dugum_dims(ht) > 0 || tip_gorunum_mi(ht) || tip_void_mi(ht)) {
                hata_ver(hs, hc, "'beklenen' hata türü 'bos', dizi ya da görünüm olamaz.");
                don 0;
            }
            hn = tur_kanonik_ad(ht);
        }
        beklenen_tur(JetonTur.J_KOSE_KAPA, "]");
        ad = intern(kat(kat3("beklenen[", tur_kanonik_ad(dt), ","), kat(hn, "]")));
    }
    sayi depth = 0;
    iken (esles_tur(JetonTur.J_YILDIZ)) {
        depth = depth + 1;
    }
    don tur_dugum(satir, sutun, ad, depth, 0);
}

fonk ayristir_dizi_sabit() -> sayi {
    sayi tok = beklenen_tur(JetonTur.J_KOSE_AC, "[");
    sayi n = dugum_yeni(DugumTur.D_DIZI_SABIT, jeton_satir(tok), jeton_sutun(tok));
    sayi L = liste_yeni();
    dugum_yaz_liste(n, L);
    eger (bak_tur() != JetonTur.J_KOSE_KAPA) {
        liste_ekle(L, ayristir_ifade());
        iken (esles_tur(JetonTur.J_VIRGUL)) {
            eger (bak_tur() == JetonTur.J_KOSE_KAPA) {
                dur;
            }
            liste_ekle(L, ayristir_ifade());
        }
    }
    beklenen_tur(JetonTur.J_KOSE_KAPA, "]");
    don n;
}

fonk ayristir_baslatici() -> sayi {
    eger (bak_tur() == JetonTur.J_KOSE_AC) {
        don ayristir_dizi_sabit();
    }
    don ayristir_ifade();
}

fonk diyez_yer(metin s) -> sayi {
    sayi i = 0;
    sayi n = metin_uzun(s);
    iken (i < n) {
        eger (metin_cp(s, i) == 35) { don i; }
        i = i + metin_adv(s, i);
    }
    don 0 - 1;
}

fonk sabit_sayi_sonek(sayi satir, sayi sutun, metin v) -> sayi {
    sayi yer = diyez_yer(v);
    eger (yer < 0) {
        don sabit_sayi(satir, sutun, sayi_oku(v));
    }
    oto num = intern_dilim(v, 0, yer);
    oto suf = intern_dilim(v, yer + 1, metin_uzun(v));
    mantik ham = metin_uzun(num) > 0 && metin_cp(num, 0) == 64;
    eger (ham) { num = intern_dilim(num, 1, metin_uzun(num)); }
    eger (!ham && metin_uzun(num) > 19) { ham = dogru; }
    eger (ham) {
        eger (!metin_esit(suf, "u64")) {
            hata_ver(satir, sutun, "Tamsayı sabiti işaretli aralığın dışında.");
            don 0;
        }
        sayi n = dugum_yeni(DugumTur.D_SABIT, satir, sutun);
        dugum_yaz_ad(n, num);
        dugum_yaz_ptrd(n, 6);
        don n;
    }
    sayi deger = sayi_oku(num);
    eger (!sabit_araliga_sigar(suf, deger)) {
        hata_ver(satir, sutun, "Tamsayı sabiti türün aralığına sığmıyor.");
        don 0;
    }
    sayi n = sabit_sayi(satir, sutun, deger);
    dugum_yaz_ad(n, suf);
    don n;
}

fonk ayristir_birincil() -> sayi {
    eger (hata_var()) {
        don 0;
    }
    sayi satir = bak_satir();
    sayi sutun = bak_sutun();
    eger (bak_tur() == JetonTur.J_KIMLIK && metin_esit(bak_deger(), "boyut") && bak_tur_at(1) == JetonTur.J_PARANTEZ_AC) {
        j_ilerle();
        j_ilerle();
        sayi bt = bak_tur();
        eger (bt != JetonTur.J_ANAHTAR && bt != JetonTur.J_KIMLIK && bt != JetonTur.J_VE_ISARET) {
            hata_ver(bak_satir(), bak_sutun(), "'boyut(...)' bir tür ya da değişken adı alır.");
            don 0;
        }
        sayi ty = ayristir_tur();
        beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
        eger (hata_var()) { don 0; }
        sayi n = dugum_yeni(DugumTur.D_BOYUT, satir, sutun);
        dugum_yaz_sayi(n, ty);
        don n;
    }
    eger (bak_tur() == JetonTur.J_SAYI) {
        oto v = bak_deger();
        j_ilerle();
        don sabit_sayi_sonek(satir, sutun, v);
    }
    eger (bak_tur() == JetonTur.J_ONDALIK) {
        sayi n = dugum_yeni(DugumTur.D_SABIT, satir, sutun);
            dugum_yaz_ad(n, bak_deger());
        dugum_yaz_ptrd(n, 1);
        j_ilerle();
        don n;
    }
    eger (bak_tur() == JetonTur.J_METIN) {
        sayi n = dugum_yeni(DugumTur.D_SABIT, satir, sutun);
        dugum_yaz_ad(n, bak_deger());
        dugum_yaz_ptrd(n, 2);
        j_ilerle();
        interp_ayristir(n);
        don n;
    }
    eger (bak_tur() == JetonTur.J_ANAHTAR) {
        eger (metin_esit(bak_deger(), "dogru")) {
            j_ilerle();
            sayi n = dugum_yeni(DugumTur.D_SABIT, satir, sutun);
            dugum_yaz_ad(n, "mantik");
            dugum_yaz_sayi(n, 1);
            dugum_yaz_ptrd(n, 3);
            don n;
        }
        eger (metin_esit(bak_deger(), "yanlis")) {
            j_ilerle();
            sayi n = dugum_yeni(DugumTur.D_SABIT, satir, sutun);
            dugum_yaz_ad(n, "mantik");
            dugum_yaz_sayi(n, 0);
            dugum_yaz_ptrd(n, 3);
            don n;
        }
        eger (metin_esit(bak_deger(), "yok")) {
            j_ilerle();
            sayi n = dugum_yeni(DugumTur.D_SABIT, satir, sutun);
            dugum_yaz_ad(n, "yok");
            dugum_yaz_ptrd(n, 4);
            don n;
        }
        eger (metin_esit(bak_deger(), "kendi")) {
            j_ilerle();
            don kimlik_dugum(satir, sutun, "kendi");
        }
        eger (metin_esit(bak_deger(), "fonk") && bak_tur_at(1) == JetonTur.J_PARANTEZ_AC) {
            sayi sl = loop_al();
            sayi ss = switch_al();
            loop_yaz(0);
            switch_yaz(0);
            sayi n = ayristir_anonim_fonk();
            loop_yaz(sl);
            switch_yaz(ss);
            don n;
        }
        eger (metin_esit(bak_deger(), "arkaplan")) {
            j_ilerle();
            sayi sl = loop_al();
            sayi ss = switch_al();
            loop_yaz(0);
            switch_yaz(0);
            sayi body = ayristir_blok();
            loop_yaz(sl);
            switch_yaz(ss);
            sayi n = dugum_yeni(DugumTur.D_ARKAPLAN_IFADE, satir, sutun);
            dugum_yaz_a(n, body);
            don n;
        }
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(bak_deger());
        hata_fmt_yaz("' burada ifade olarak kullanılamaz.");
        hata_fmt_ver(satir, sutun);
        don 0;
    }
    eger (bak_tur() == JetonTur.J_KIMLIK) {
        oto ad = bak_deger();
        j_ilerle();
        don kimlik_dugum(satir, sutun, ad);
    }
    eger (bak_tur() == JetonTur.J_KOSE_AC) {
        don ayristir_dizi_sabit();
    }
    eger (esles_tur(JetonTur.J_PARANTEZ_AC)) {
        sayi e = ayristir_ifade();
        beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
        don e;
    }
    hata_fmt_basla();
    hata_fmt_yaz("İfade bekleniyordu, '");
    hata_fmt_yaz(bak_deger());
    hata_fmt_yaz("' bulundu.");
    hata_fmt_ver(satir, sutun);
    don 0;
}

// Sonek '?': ardından ifade başlayamayan bir jeton gelir (üçlü '? :' ile karışmaz).
fonk soru_yay_mi() -> mantik {
    sayi t = bak_tur_at(1);
    don t == JetonTur.J_NOKTALI_VIRGUL || t == JetonTur.J_PARANTEZ_KAPA || t == JetonTur.J_VIRGUL || t == JetonTur.J_KOSE_KAPA || t == JetonTur.J_SLUS_KAPA || t == JetonTur.J_NOKTA || t == JetonTur.J_ARALIK;
}

// '(' tür ')' ile başlayan dönüşüm mü?
fonk donusum_basi_mi() -> mantik {
    eger (bak_tur() != JetonTur.J_PARANTEZ_AC) { don yanlis; }
    sayi t1 = bak_tur_at(1);
    eger (t1 == JetonTur.J_ANAHTAR) {
        oto v = bak_deger_at(1);
        eger (tur_adi_mi(v)) { don dogru; }
        don metin_esit(v, "fonk") && bak_tur_at(2) == JetonTur.J_PARANTEZ_AC;
    }
    eger (t1 != JetonTur.J_KIMLIK) { don yanlis; }
    sayi i = 2;
    eger (bak_tur_at(i) == JetonTur.J_NOKTA && bak_tur_at(i + 1) == JetonTur.J_KIMLIK) { i = i + 2; }
    sayi yildiz = 0;
    iken (bak_tur_at(i) == JetonTur.J_YILDIZ) {
        i = i + 1;
        yildiz = yildiz + 1;
    }
    eger (bak_tur_at(i) != JetonTur.J_PARANTEZ_KAPA) { don yanlis; }
    eger (yildiz > 0) { don dogru; }
    // (Ad)x: yalnızca ardından değer başlıyorsa (sayı, ad, sabit sözcük) dönüşümdür.
    sayi sn = bak_tur_at(i + 1);
    eger (sn == JetonTur.J_SAYI || sn == JetonTur.J_ONDALIK || sn == JetonTur.J_KIMLIK) { don dogru; }
    eger (sn == JetonTur.J_ANAHTAR) {
        oto w = bak_deger_at(i + 1);
        don metin_esit(w, "dogru") || metin_esit(w, "yanlis") || metin_esit(w, "yok") || metin_esit(w, "kendi");
    }
    don yanlis;
}

fonk ayristir_sonek() -> sayi {
    sayi expr = ayristir_birincil();
    iken (!hata_var()) {
        eger (esles_tur(JetonTur.J_PARANTEZ_AC)) {
            sayi n = dugum_yeni(DugumTur.D_CAGRI, dugum_satir(expr), dugum_sutun(expr));
            dugum_yaz_a(n, expr);
            sayi L = liste_yeni();
            dugum_yaz_liste(n, L);
            eger (bak_tur() != JetonTur.J_PARANTEZ_KAPA) {
                liste_ekle(L, ayristir_ifade());
                iken (esles_tur(JetonTur.J_VIRGUL)) {
                    liste_ekle(L, ayristir_ifade());
                }
            }
            beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
            expr = n;
        } yoksa eger (esles_tur(JetonTur.J_KOSE_AC)) {
            sayi idx = ayristir_ifade();
            eger (esles_tur(JetonTur.J_ARALIK)) {
                sayi son = ayristir_ifade();
                beklenen_tur(JetonTur.J_KOSE_KAPA, "]");
                sayi n = dugum_yeni(DugumTur.D_INDIS, dugum_satir(expr), dugum_sutun(expr));
                dugum_yaz_a(n, expr);
                dugum_yaz_b(n, idx);
                dugum_yaz_c(n, son);
                expr = n;
            } yoksa {
                beklenen_tur(JetonTur.J_KOSE_KAPA, "]");
                sayi n = dugum_yeni(DugumTur.D_INDIS, dugum_satir(expr), dugum_sutun(expr));
                dugum_yaz_a(n, expr);
                dugum_yaz_b(n, idx);
                expr = n;
            }
        } yoksa eger (bak_tur() == JetonTur.J_SORU && soru_yay_mi()) {
            sayi qt = j_ilerle();
            eger (g_ertele_derin > 0) {
                hata_ver(jeton_satir(qt), jeton_sutun(qt), "'ertele' gövdesinde '?' kullanılamaz.");
                don 0;
            }
            sayi n = dugum_yeni(DugumTur.D_HATA_YAY, jeton_satir(qt), jeton_sutun(qt));
            dugum_yaz_a(n, expr);
            expr = n;
        } yoksa eger (bak_tur() == JetonTur.J_ARALIK) {
            dur;
        } yoksa eger (esles_tur(JetonTur.J_NOKTA)) {
            sayi nm = beklenen_kimlik(dogru);
            sayi n = dugum_yeni(DugumTur.D_UYE, dugum_satir(expr), dugum_sutun(expr));
            dugum_yaz_a(n, expr);
            dugum_yaz_ad(n, jeton_deger(nm));
            expr = n;
        } yoksa {
            dur;
        }
    }
    don expr;
}

fonk ayristir_tekil() -> sayi {
    eger (donusum_basi_mi()) {
        sayi satir = bak_satir();
        sayi sutun = bak_sutun();
        j_ilerle();
        sayi hedef = ayristir_tur();
        beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
        eger (hata_var()) { don 0; }
        sayi n = dugum_yeni(DugumTur.D_DONUSUM, satir, sutun);
        dugum_yaz_sayi(n, hedef);
        dugum_yaz_a(n, ayristir_tekil());
        don n;
    }
    sayi t = bak_tur();
    eger (t == JetonTur.J_UNLEM || t == JetonTur.J_EKSI || t == JetonTur.J_ARTI || t == JetonTur.J_YILDIZ || t == JetonTur.J_VE_ISARET) {
        sayi satir = bak_satir();
        sayi sutun = bak_sutun();
        metin op = bak_deger();
        j_ilerle();
        sayi n = dugum_yeni(DugumTur.D_TEKIL, satir, sutun);
        dugum_yaz_ad(n, op);
        dugum_yaz_a(n, ayristir_tekil());
        don n;
    }
    don ayristir_sonek();
}

fonk ayristir_carpan() -> sayi {
    sayi left = ayristir_tekil();
    iken (!hata_var()) {
        eger (esles_tur(JetonTur.J_YILDIZ) || esles_tur(JetonTur.J_BOLU) || esles_tur(JetonTur.J_MOD)) {
            // esles already advanced — need previous token op. Use last consumed: index-1
            sayi opid = jeton_id_at(-1);
            sayi n = dugum_yeni(DugumTur.D_IKIL, jeton_satir(opid), jeton_sutun(opid));
            dugum_yaz_ad(n, jeton_deger(opid));
            dugum_yaz_a(n, left);
            dugum_yaz_b(n, ayristir_tekil());
            left = n;
        } yoksa {
            dur;
        }
    }
    don left;
}

fonk ayristir_terim() -> sayi {
    sayi left = ayristir_carpan();
    iken (!hata_var()) {
        eger (esles_tur(JetonTur.J_ARTI) || esles_tur(JetonTur.J_EKSI)) {
            sayi opid = jeton_id_at(-1);
            sayi n = dugum_yeni(DugumTur.D_IKIL, jeton_satir(opid), jeton_sutun(opid));
            dugum_yaz_ad(n, jeton_deger(opid));
            dugum_yaz_a(n, left);
            dugum_yaz_b(n, ayristir_carpan());
            left = n;
        } yoksa {
            dur;
        }
    }
    don left;
}

fonk ayristir_karsilastirma() -> sayi {
    sayi left = ayristir_terim();
    iken (!hata_var()) {
        sayi t = bak_tur();
        eger (t == JetonTur.J_KUCUK || t == JetonTur.J_BUYUK || t == JetonTur.J_KUCUK_ESIT || t == JetonTur.J_BUYUK_ESIT) {
            sayi opid = j_ilerle();
            sayi n = dugum_yeni(DugumTur.D_IKIL, jeton_satir(opid), jeton_sutun(opid));
            dugum_yaz_ad(n, jeton_deger(opid));
            dugum_yaz_a(n, left);
            dugum_yaz_b(n, ayristir_terim());
            left = n;
        } yoksa {
            dur;
        }
    }
    don left;
}

fonk ayristir_esitlik() -> sayi {
    sayi left = ayristir_karsilastirma();
    iken (!hata_var()) {
        eger (esles_tur(JetonTur.J_ESIT_ESIT) || esles_tur(JetonTur.J_ESIT_DEGIL)) {
            sayi opid = jeton_id_at(-1);
            sayi n = dugum_yeni(DugumTur.D_IKIL, jeton_satir(opid), jeton_sutun(opid));
            dugum_yaz_ad(n, jeton_deger(opid));
            dugum_yaz_a(n, left);
            dugum_yaz_b(n, ayristir_karsilastirma());
            left = n;
        } yoksa {
            dur;
        }
    }
    don left;
}

fonk ayristir_bit_ve() -> sayi {
    sayi left = ayristir_esitlik();
    iken (!hata_var() && esles_tur(JetonTur.J_VE_ISARET)) {
        sayi opid = jeton_id_at(-1);
        sayi n = dugum_yeni(DugumTur.D_IKIL, jeton_satir(opid), jeton_sutun(opid));
        dugum_yaz_ad(n, "&");
        dugum_yaz_a(n, left);
        dugum_yaz_b(n, ayristir_esitlik());
        left = n;
    }
    don left;
}

fonk ayristir_xor() -> sayi {
    sayi left = ayristir_bit_ve();
    iken (!hata_var() && esles_tur(JetonTur.J_XOR)) {
        sayi opid = jeton_id_at(-1);
        sayi n = dugum_yeni(DugumTur.D_IKIL, jeton_satir(opid), jeton_sutun(opid));
        dugum_yaz_ad(n, "^");
        dugum_yaz_a(n, left);
        dugum_yaz_b(n, ayristir_bit_ve());
        left = n;
    }
    don left;
}

fonk ayristir_bit_veya() -> sayi {
    sayi left = ayristir_xor();
    iken (!hata_var() && esles_tur(JetonTur.J_VAY_ISARET)) {
        sayi opid = jeton_id_at(-1);
        sayi n = dugum_yeni(DugumTur.D_IKIL, jeton_satir(opid), jeton_sutun(opid));
        dugum_yaz_ad(n, "|");
        dugum_yaz_a(n, left);
        dugum_yaz_b(n, ayristir_xor());
        left = n;
    }
    don left;
}

fonk ayristir_ve() -> sayi {
    sayi left = ayristir_bit_veya();
    iken (!hata_var() && esles_tur(JetonTur.J_VE)) {
        sayi opid = jeton_id_at(-1);
        sayi n = dugum_yeni(DugumTur.D_IKIL, jeton_satir(opid), jeton_sutun(opid));
        dugum_yaz_ad(n, "&&");
        dugum_yaz_a(n, left);
        dugum_yaz_b(n, ayristir_bit_veya());
        left = n;
    }
    don left;
}

fonk ayristir_veya() -> sayi {
    sayi left = ayristir_ve();
    iken (!hata_var() && esles_tur(JetonTur.J_VEYA)) {
        sayi opid = jeton_id_at(-1);
        sayi n = dugum_yeni(DugumTur.D_IKIL, jeton_satir(opid), jeton_sutun(opid));
        dugum_yaz_ad(n, "||");
        dugum_yaz_a(n, left);
        dugum_yaz_b(n, ayristir_ve());
        left = n;
    }
    don left;
}

fonk ayristir_uclu() -> sayi {
    sayi expr = ayristir_veya();
    eger (esles_tur(JetonTur.J_SORU)) {
        sayi thenb = ayristir_atama();
        beklenen_tur(JetonTur.J_IKI_NOKTA, ":");
        sayi elseb = ayristir_uclu();
        sayi n = dugum_yeni(DugumTur.D_UCLU, dugum_satir(expr), dugum_sutun(expr));
        dugum_yaz_a(n, expr);
        dugum_yaz_b(n, thenb);
        dugum_yaz_c(n, elseb);
        don n;
    }
    don expr;
}

fonk ayristir_atama() -> sayi {
    sayi expr = ayristir_uclu();
    metin op = "";
    eger (esles_tur(JetonTur.J_ATAMA)) { op = "="; }
    yoksa eger (esles_tur(JetonTur.J_ARTI_ATAMA)) { op = "+="; }
    yoksa eger (esles_tur(JetonTur.J_EKSI_ATAMA)) { op = "-="; }
    yoksa eger (esles_tur(JetonTur.J_YILDIZ_ATAMA)) { op = "*="; }
    yoksa eger (esles_tur(JetonTur.J_BOLU_ATAMA)) { op = "/="; }
    yoksa eger (esles_tur(JetonTur.J_MOD_ATAMA)) { op = "%="; }
    eger (!metin_esit(op, "")) {
        sayi n = dugum_yeni(DugumTur.D_ATAMA, dugum_satir(expr), dugum_sutun(expr));
        dugum_yaz_ad(n, op);
        dugum_yaz_a(n, expr);
        dugum_yaz_b(n, ayristir_atama());
        don n;
    }
    don expr;
}

fonk ayristir_ifade() -> sayi {
    don ayristir_atama();
}

fonk ayristir_param() -> sayi {
    sayi satir = bak_satir();
    sayi sutun = bak_sutun();
    eger (tur_baslangici_mi()) {
        sayi typ = ayristir_tur();
        sayi nm = beklenen_kimlik(yanlis);
        sayi n = dugum_yeni(DugumTur.D_PARAM, jeton_satir(nm), jeton_sutun(nm));
        dugum_yaz_ad(n, jeton_deger(nm));
        dugum_yaz_a(n, typ);
        eger (esles_tur(JetonTur.J_ATAMA)) {
            dugum_yaz_c(n, ayristir_ifade());
        }
        don n;
    }
    sayi nm = beklenen_kimlik(yanlis);
    sayi n = dugum_yeni(DugumTur.D_PARAM, jeton_satir(nm), jeton_sutun(nm));
    dugum_yaz_ad(n, jeton_deger(nm));
    eger (esles_tur(JetonTur.J_ATAMA)) {
        dugum_yaz_c(n, ayristir_ifade());
    }
    don n;
}

fonk ayristir_alan() -> sayi {
    sayi typ = ayristir_tur();
    sayi nm = beklenen_kimlik(yanlis);
    sayi n = dugum_yeni(DugumTur.D_ALAN, jeton_satir(nm), jeton_sutun(nm));
    dugum_yaz_ad(n, jeton_deger(nm));
    dugum_yaz_a(n, typ);
    eger (esles_tur(JetonTur.J_KOSE_AC)) {
        eger (bak_tur() == JetonTur.J_KOSE_KAPA) {
            dugum_yaz_bayrak(n, 8);
        } yoksa {
            dugum_yaz_b(n, ayristir_ifade());
        }
        beklenen_tur(JetonTur.J_KOSE_KAPA, "]");
    }
    eger (esles_tur(JetonTur.J_ATAMA)) {
        hata_ver(jeton_satir(nm), jeton_sutun(nm), "Sınıf alanları başlatıcı alamaz. Değer atamasını 'olustur' metodunda yapın.");
    }
    beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
    don n;
}

fonk ayristir_oto() -> sayi {
    sayi kw = beklenen_kw("oto");
    sayi nm = beklenen_kimlik(yanlis);
    eger (!esles_tur(JetonTur.J_ATAMA)) {
        hata_fmt_basla();
        hata_fmt_yaz("'oto ");
        hata_fmt_yaz(jeton_deger(nm));
        hata_fmt_yaz("' bir başlatıcı gerektirir.");
        hata_fmt_ver(jeton_satir(nm), jeton_sutun(nm));
        don 0;
    }
    sayi init = ayristir_baslatici();
    beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
    sayi n = dugum_yeni(DugumTur.D_DEGISKEN, jeton_satir(nm), jeton_sutun(nm));
    dugum_yaz_ad(n, jeton_deger(nm));
    dugum_yaz_a(n, tur_dugum(jeton_satir(kw), jeton_sutun(kw), "", 0, 0));
    dugum_yaz_c(n, init);
    dugum_yaz_bayrak(n, 1);
    don n;
}

fonk ayristir_degisken_bayrak(sayi sabit_mi) -> sayi {
    sayi typ = ayristir_tur();
    sayi nm = beklenen_kimlik(yanlis);
    sayi n = dugum_yeni(DugumTur.D_DEGISKEN, jeton_satir(nm), jeton_sutun(nm));
    dugum_yaz_ad(n, jeton_deger(nm));
    dugum_yaz_a(n, typ);
    eger (esles_tur(JetonTur.J_KOSE_AC)) {
        eger (sabit_mi != 0) {
            hata_ver(jeton_satir(nm), jeton_sutun(nm), "'sabit' dizi olamaz; skaler bir tür kullanın.");
        }
        eger (bak_tur() == JetonTur.J_KOSE_KAPA) {
            dugum_yaz_bayrak(n, 8);
        } yoksa {
            dugum_yaz_b(n, ayristir_ifade());
        }
        beklenen_tur(JetonTur.J_KOSE_KAPA, "]");
    }
    eger (esles_tur(JetonTur.J_ATAMA)) {
        dugum_yaz_c(n, ayristir_baslatici());
    }
    eger (sabit_mi != 0) {
        dugum_yaz_bayrak(n, dugum_bayrak(n) | 16);
        eger (dugum_c(n) == 0) {
            hata_fmt_basla();
            hata_fmt_yaz("'sabit ");
            hata_fmt_yaz(jeton_deger(nm));
            hata_fmt_yaz("' bir başlatıcı gerektirir.");
            hata_fmt_ver(jeton_satir(nm), jeton_sutun(nm));
        }
    }
    eger ((dugum_bayrak(n) & 8) != 0 && dugum_c(n) == 0) {
        hata_fmt_basla();
        hata_fmt_yaz("Boyutsuz dizi '");
        hata_fmt_yaz(jeton_deger(nm));
        hata_fmt_yaz("' bir başlatıcı gerektirir.");
        hata_fmt_ver(jeton_satir(nm), jeton_sutun(nm));
    }
    beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
    don n;
}

fonk ayristir_degisken() -> sayi {
    don ayristir_degisken_bayrak(0);
}

fonk ayristir_sabit() -> sayi {
    beklenen_kw("sabit");
    don ayristir_degisken_bayrak(1);
}

fonk ayristir_blok() -> sayi {
    sayi tok = beklenen_tur(JetonTur.J_SLUS_AC, "{");
    sayi n = dugum_yeni(DugumTur.D_BLOK, jeton_satir(tok), jeton_sutun(tok));
    sayi L = liste_yeni();
    dugum_yaz_liste(n, L);
    iken (bak_tur() != JetonTur.J_SLUS_KAPA && bak_tur() != JetonTur.J_EOF && !hata_var()) {
        liste_ekle(L, ayristir_cumle());
    }
    beklenen_tur(JetonTur.J_SLUS_KAPA, "}");
    don n;
}

fonk ayristir_eger() -> sayi {
    sayi kw = beklenen_kw("eger");
    beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
    sayi cond = ayristir_ifade();
    beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
    sayi thenb = ayristir_cumle();
    sayi elseb = 0;
    eger (esles_kw("yoksa")) {
        elseb = ayristir_cumle();
    }
    sayi n = dugum_yeni(DugumTur.D_EGER, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_a(n, cond);
    dugum_yaz_b(n, thenb);
    dugum_yaz_c(n, elseb);
    don n;
}

fonk ayristir_iken() -> sayi {
    sayi kw = beklenen_kw("iken");
    beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
    sayi cond = ayristir_ifade();
    beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
    loop_yaz(loop_al() + 1);
    sayi body = ayristir_cumle();
    loop_yaz(loop_al() - 1);
    sayi n = dugum_yeni(DugumTur.D_IKEN, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_a(n, cond);
    dugum_yaz_b(n, body);
    don n;
}

fonk ayristir_dongu() -> sayi {
    sayi kw = beklenen_kw("dongu");
    beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
    sayi init = 0;
    eger (esles_tur(JetonTur.J_NOKTALI_VIRGUL)) {
        init = 0;
    } yoksa eger (kw_mi("oto")) {
        init = ayristir_oto();
    } yoksa eger (tur_baslangici_mi()) {
        init = ayristir_degisken();
    } yoksa {
        sayi e = ayristir_ifade();
        beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
        init = dugum_yeni(DugumTur.D_IFADE_CUMLE, dugum_satir(e), dugum_sutun(e));
        dugum_yaz_a(init, e);
    }
    sayi cond = 0;
    eger (bak_tur() != JetonTur.J_NOKTALI_VIRGUL) {
        cond = ayristir_ifade();
    }
    beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
    sayi step = 0;
    eger (bak_tur() != JetonTur.J_PARANTEZ_KAPA) {
        step = ayristir_ifade();
    }
    beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
    loop_yaz(loop_al() + 1);
    sayi body = ayristir_cumle();
    loop_yaz(loop_al() - 1);
    sayi n = dugum_yeni(DugumTur.D_DONGU, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_a(n, init);
    dugum_yaz_b(n, cond);
    dugum_yaz_c(n, step);
    dugum_yaz_d(n, body);
    don n;
}

fonk ayristir_secim_kol() -> sayi {
    sayi L = liste_yeni();
    iken (bak_tur() != JetonTur.J_SLUS_KAPA && bak_tur() != JetonTur.J_EOF && !kw_mi("durum") && !kw_mi("varsayilan") && !hata_var()) {
        liste_ekle(L, ayristir_cumle());
    }
    don L;
}

fonk ayristir_secim() -> sayi {
    sayi kw = beklenen_kw("secim");
    beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
    sayi expr = ayristir_ifade();
    beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
    beklenen_tur(JetonTur.J_SLUS_AC, "{");
    sayi L = liste_yeni();
    mantik gordu_varsayilan = yanlis;
    switch_yaz(switch_al() + 1);
    iken (bak_tur() != JetonTur.J_SLUS_KAPA && bak_tur() != JetonTur.J_EOF && !hata_var()) {
        eger (kw_mi("durum")) {
            sayi et = j_ilerle();
            sayi val = ayristir_ifade();
            eger (bak_tur() != JetonTur.J_IKI_NOKTA) {
                hata_ver(jeton_satir(et), bak_sutun(), "':' bekleniyordu.");
            } yoksa {
                j_ilerle();
            }
            sayi c = dugum_yeni(DugumTur.D_DURUM, jeton_satir(et), jeton_sutun(et));
            dugum_yaz_a(c, val);
            dugum_yaz_liste(c, ayristir_secim_kol());
            liste_ekle(L, c);
        } yoksa eger (kw_mi("varsayilan")) {
            sayi et = j_ilerle();
            eger (gordu_varsayilan) {
                hata_ver(jeton_satir(et), jeton_sutun(et), "'varsayilan' bir 'secim' içinde bir kez yazılabilir.");
            }
            gordu_varsayilan = dogru;
            eger (bak_tur() != JetonTur.J_IKI_NOKTA) {
                hata_ver(jeton_satir(et), bak_sutun(), "':' bekleniyordu.");
            } yoksa {
                j_ilerle();
            }
            sayi c = dugum_yeni(DugumTur.D_DURUM, jeton_satir(et), jeton_sutun(et));
            dugum_yaz_liste(c, ayristir_secim_kol());
            liste_ekle(L, c);
        } yoksa {
            hata_fmt_basla();
            hata_fmt_yaz("'durum' veya 'varsayilan' bekleniyordu, '");
            hata_fmt_yaz(bak_deger());
            hata_fmt_yaz("' bulundu.");
            hata_fmt_ver(bak_satir(), bak_sutun());
            dur;
        }
    }
    switch_yaz(switch_al() - 1);
    beklenen_tur(JetonTur.J_SLUS_KAPA, "}");
    sayi n = dugum_yeni(DugumTur.D_SECIM, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_a(n, expr);
    dugum_yaz_liste(n, L);
    don n;
}

fonk ayristir_her() -> sayi {
    sayi kw = beklenen_kw("her");
    beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
    sayi inferred = 0;
    sayi typ = 0;
    sayi nm = 0;
    eger (kw_mi("oto")) {
        j_ilerle();
        inferred = 1;
        typ = tur_dugum(jeton_satir(kw), jeton_sutun(kw), "", 0, 0);
        nm = beklenen_kimlik(yanlis);
    } yoksa {
        typ = ayristir_tur();
        nm = beklenen_kimlik(yanlis);
    }
    beklenen_kw("in");
    sayi it = ayristir_ifade();
    // Aralık: her (sayi i in a..b) — a dahil, b hariç; b bir kez hesaplanır.
    sayi aralik_son = 0;
    eger (esles_tur(JetonTur.J_ARALIK)) {
        aralik_son = ayristir_ifade();
    }
    beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
    loop_yaz(loop_al() + 1);
    sayi body = ayristir_cumle();
    loop_yaz(loop_al() - 1);
    sayi n = dugum_yeni(DugumTur.D_HER, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_ad(n, jeton_deger(nm));
    dugum_yaz_a(n, typ);
    dugum_yaz_b(n, it);
    dugum_yaz_c(n, body);
    sayi fl = 0;
    eger (inferred != 0) { fl = fl + 1; }
    eger (aralik_son != 0) {
        fl = fl + 2;
        dugum_yaz_d(n, aralik_son);
    }
    dugum_yaz_bayrak(n, fl);
    don n;
}

fonk ayristir_cumle() -> sayi {
    eger (hata_var()) {
        don 0;
    }
    eger (kw_mi("c_ekle")) {
        hata_ver(bak_satir(), bak_sutun(), "'c_ekle' yalnızca dosya başında (üst düzeyde) kullanılır. Fonksiyon içine #include koymayın.");
        don 0;
    }
    eger (kw_mi("kullan")) {
        hata_ver(bak_satir(), bak_sutun(), "'kullan' yalnızca dosya başında (üst düzeyde) kullanılır.");
        don 0;
    }
    eger (kw_mi("sabit")) { don ayristir_sabit(); }
    eger (kw_mi("eger")) { don ayristir_eger(); }
    eger (kw_mi("secim")) { don ayristir_secim(); }
    eger (kw_mi("her")) { don ayristir_her(); }
    eger (kw_mi("iken")) { don ayristir_iken(); }
    eger (kw_mi("dongu")) { don ayristir_dongu(); }
    eger (kw_mi("ertele") || kw_mi("hata_ertele")) {
        mantik hk = kw_mi("hata_ertele");
        sayi kw = j_ilerle();
        sayi sl = loop_al();
        sayi ss = switch_al();
        loop_yaz(0);
        switch_yaz(0);
        g_ertele_derin = g_ertele_derin + 1;
        sayi govde = ayristir_cumle();
        g_ertele_derin = g_ertele_derin - 1;
        loop_yaz(sl);
        switch_yaz(ss);
        sayi n = dugum_yeni(DugumTur.D_ERTELE, jeton_satir(kw), jeton_sutun(kw));
        dugum_yaz_a(n, govde);
        eger (hk) { dugum_yaz_bayrak(n, 1); }
        don n;
    }
    eger (kw_mi("don")) {
        eger (g_ertele_derin > 0) {
            hata_ver(bak_satir(), bak_sutun(), "'ertele' gövdesinden 'don' ile çıkılamaz.");
            don 0;
        }
        sayi kw = j_ilerle();
        sayi val = 0;
        eger (bak_tur() != JetonTur.J_NOKTALI_VIRGUL) {
            val = ayristir_ifade();
        }
        beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
        sayi n = dugum_yeni(DugumTur.D_DON, jeton_satir(kw), jeton_sutun(kw));
        dugum_yaz_a(n, val);
        don n;
    }
    eger (kw_mi("dur")) {
        sayi kw = j_ilerle();
        eger (loop_al() <= 0 && switch_al() <= 0) {
            hata_ver(jeton_satir(kw), jeton_sutun(kw), "'dur' yalnızca 'iken', 'dongu', 'her' veya 'secim' içinde kullanılabilir.");
        }
        beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
        don dugum_yeni(DugumTur.D_DUR, jeton_satir(kw), jeton_sutun(kw));
    }
    eger (kw_mi("devam")) {
        sayi kw = j_ilerle();
        eger (loop_al() <= 0) {
            hata_ver(jeton_satir(kw), jeton_sutun(kw), "'devam' yalnızca 'iken', 'dongu' veya 'her' içinde kullanılabilir.");
        }
        beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
        don dugum_yeni(DugumTur.D_DEVAM, jeton_satir(kw), jeton_sutun(kw));
    }
    eger (kw_mi("guvensiz")) {
        sayi kw = j_ilerle();
        sayi body = ayristir_blok();
        sayi n = dugum_yeni(DugumTur.D_GUVENSIZ, jeton_satir(kw), jeton_sutun(kw));
        dugum_yaz_a(n, body);
        don n;
    }
    eger (kw_mi("arkaplan")) {
        sayi kw = j_ilerle();
        sayi sl = loop_al();
        sayi ss = switch_al();
        loop_yaz(0);
        switch_yaz(0);
        sayi body = ayristir_blok();
        loop_yaz(sl);
        switch_yaz(ss);
        sayi n = dugum_yeni(DugumTur.D_ARKAPLAN, jeton_satir(kw), jeton_sutun(kw));
        dugum_yaz_a(n, body);
        don n;
    }
    eger (kw_mi("guvenli")) {
        sayi kw = j_ilerle();
        sayi body = ayristir_blok();
        sayi n = dugum_yeni(DugumTur.D_GUVENLI, jeton_satir(kw), jeton_sutun(kw));
        dugum_yaz_a(n, body);
        don n;
    }
    eger (kw_mi("oto")) {
        don ayristir_oto();
    }
    eger (bak_tur() == JetonTur.J_SLUS_AC) {
        don ayristir_blok();
    }
    eger (bak_tur() == JetonTur.J_C_GOMMU) {
        sayi tok = j_ilerle();
        sayi n = dugum_yeni(DugumTur.D_C_GOMMU, jeton_satir(tok), jeton_sutun(tok));
        dugum_yaz_ad(n, jeton_deger(tok));
        don n;
    }
    eger (tur_baslangici_mi()) {
        don ayristir_degisken();
    }
    eger (esles_tur(JetonTur.J_NOKTALI_VIRGUL)) {
        sayi tok = jeton_id_at(-1);
        don dugum_yeni(DugumTur.D_BOS_CUMLE, jeton_satir(tok), jeton_sutun(tok));
    }
    sayi e = ayristir_ifade();
    beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
    sayi n = dugum_yeni(DugumTur.D_IFADE_CUMLE, dugum_satir(e), dugum_sutun(e));
    dugum_yaz_a(n, e);
    don n;
}

fonk ayristir_fonksiyon(metin sinif_ad) -> sayi {
    sayi kw = beklenen_kw("fonk");
    sayi nm = beklenen_kimlik(yanlis);
    eger (metin_esit(jeton_deger(nm), "upp") && metin_esit(sinif_ad, "")) {
        hata_ver(jeton_satir(nm), jeton_sutun(nm), "'upp' yerleşik ad alanıdır; fonksiyon adı olamaz.");
    }
    eger (metin_esit(sinif_ad, "") && (metin_esit(jeton_deger(nm), "hata") || metin_esit(jeton_deger(nm), "boyut"))) {
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(jeton_deger(nm));
        hata_fmt_yaz("' yerleşik addır; fonksiyon adı olamaz.");
        hata_fmt_ver(jeton_satir(nm), jeton_sutun(nm));
    }
    don ayristir_fonk_govde(kw, jeton_deger(nm), jeton_satir(nm), jeton_sutun(nm), sinif_ad, yanlis);
}

// Anonim fonksiyon ifadesi: fonk(sayi x) -> sayi => x * 2  veya  fonk(...) -> T { ... }
// Yakalama yoktur; gövde gizli bir üst düzey fonksiyona taşınır.
fonk ayristir_anonim_fonk() -> sayi {
    sayi kw = beklenen_kw("fonk");
    g_anon_n = g_anon_n + 1;
    oto ad = intern(kat("_upp_anon_", sayi_metin(g_anon_n)));
    sayi fn = ayristir_fonk_govde(kw, ad, jeton_satir(kw), jeton_sutun(kw), "", dogru);
    eger (hata_var()) { don 0; }
    g_anon.ekle(fn);
    sayi n = kimlik_dugum(jeton_satir(kw), jeton_sutun(kw), ad);
    dugum_yaz_sayi(n, fn);
    don n;
}

fonk ayristir_fonk_govde(sayi kw, metin ad, sayi nm_satir, sayi nm_sutun, metin sinif_ad, mantik ifade_ici) -> sayi {
    beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
    sayi params = liste_yeni();
    eger (bak_tur() != JetonTur.J_PARANTEZ_KAPA) {
        liste_ekle(params, ayristir_param());
        iken (esles_tur(JetonTur.J_VIRGUL)) {
            liste_ekle(params, ayristir_param());
        }
    }
    beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
    sayi saw_def = 0;
    sayi pi = 0;
    iken (pi < liste_uzunluk(params)) {
        sayi p = liste_al(params, pi);
        eger (dugum_c(p) != 0) {
            saw_def = 1;
        } yoksa eger (saw_def != 0) {
            hata_ver(dugum_satir(p), dugum_sutun(p), "Varsayılan parametreler sonda art arda olmalıdır.");
        }
        pi = pi + 1;
    }
    sayi ret = tur_dugum(jeton_satir(kw), jeton_sutun(kw), "bos", 0, 0);
    sayi ret_ex = 0;
    eger (esles_tur(JetonTur.J_OK)) {
        ret = ayristir_tur();
        ret_ex = 1;
    }
    sayi body = 0;
    sayi arrow = 0;
    eger (esles_tur(JetonTur.J_YAG_OK)) {
        sayi expr = ayristir_ifade();
        eger (!ifade_ici) { beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";"); }
        body = dugum_yeni(DugumTur.D_BLOK, dugum_satir(expr), dugum_sutun(expr));
        sayi L = liste_yeni();
        dugum_yaz_liste(body, L);
        sayi rs = dugum_yeni(DugumTur.D_DON, dugum_satir(expr), dugum_sutun(expr));
        dugum_yaz_a(rs, expr);
        liste_ekle(L, rs);
        arrow = 1;
    } yoksa {
        body = ayristir_blok();
    }
    sayi n = dugum_yeni(DugumTur.D_FONK, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_ad(n, ad);
    dugum_yaz_a(n, ret);
    dugum_yaz_b(n, body);
    dugum_yaz_liste(n, params);
    eger (!metin_esit(sinif_ad, "")) {
        dugum_yaz_c(n, kimlik_dugum(nm_satir, nm_sutun, sinif_ad));
    }
    sayi fl = 0;
    eger (arrow != 0) {
        fl = fl + 2;
    }
    eger (ret_ex != 0) {
        fl = fl + 4;
    }
    dugum_yaz_bayrak(n, fl);
    don n;
}

fonk sinif_uye_var(sayi fields, sayi methods, metin ad) -> mantik {
    sayi i = 0;
    iken (i < liste_uzunluk(fields)) {
        eger (metin_esit(dugum_ad(liste_al(fields, i)), ad)) { don dogru; }
        i = i + 1;
    }
    i = 0;
    iken (i < liste_uzunluk(methods)) {
        eger (metin_esit(dugum_ad(liste_al(methods, i)), ad)) { don dogru; }
        i = i + 1;
    }
    don yanlis;
}

fonk ayristir_sinif() -> sayi {
    sayi kw = beklenen_kw("sinif");
    sayi nm = beklenen_kimlik(yanlis);
    eger (metin_esit(jeton_deger(nm), "upp")) {
        hata_ver(jeton_satir(nm), jeton_sutun(nm), "'upp' yerleşik ad alanıdır; sınıf adı olamaz.");
    }
    beklenen_tur(JetonTur.J_SLUS_AC, "{");
    sayi fields = liste_yeni();
    sayi methods = liste_yeni();
    sayi constants = liste_yeni();
    oto sinif_ad = jeton_deger(nm);
    iken (bak_tur() != JetonTur.J_SLUS_KAPA && bak_tur() != JetonTur.J_EOF && !hata_var()) {
        eger (kw_mi("fonk") && bak_tur_at(1) != JetonTur.J_PARANTEZ_AC) {
            sayi m = ayristir_fonksiyon(sinif_ad);
            eger (sinif_uye_var(fields, methods, dugum_ad(m))) {
                hata_fmt_basla();
                hata_fmt_yaz("'");
                hata_fmt_yaz(sinif_ad);
                hata_fmt_yaz("' içinde '");
                hata_fmt_yaz(dugum_ad(m));
                hata_fmt_yaz("' birden fazla kez tanımlandı.");
                hata_fmt_ver(dugum_satir(m), dugum_sutun(m));
            } yoksa {
                liste_ekle(methods, m);
            }
        } yoksa eger (kw_mi("sabit")) {
            sayi c = ayristir_sabit();
            eger (sinif_uye_var(fields, methods, dugum_ad(c))) {
                hata_fmt_basla();
                hata_fmt_yaz("'");
                hata_fmt_yaz(sinif_ad);
                hata_fmt_yaz("' içinde '");
                hata_fmt_yaz(dugum_ad(c));
                hata_fmt_yaz("' birden fazla kez tanımlandı.");
                hata_fmt_ver(dugum_satir(c), dugum_sutun(c));
            } yoksa {
                sayi ci = 0;
                iken (ci < liste_uzunluk(constants)) {
                    eger (metin_esit(dugum_ad(liste_al(constants, ci)), dugum_ad(c))) {
                        hata_ver(dugum_satir(c), dugum_sutun(c), "Sınıf sabiti birden fazla kez tanımlandı.");
                    }
                    ci = ci + 1;
                }
                liste_ekle(constants, c);
            }
        } yoksa eger (tur_baslangici_mi()) {
            sayi f = ayristir_alan();
            eger (metin_esit(dugum_ad(f), "kendi")) {
                hata_ver(dugum_satir(f), dugum_sutun(f), "'kendi' alan adı olarak kullanılamaz.");
            }
            eger (sinif_uye_var(fields, methods, dugum_ad(f))) {
                hata_fmt_basla();
                hata_fmt_yaz("'");
                hata_fmt_yaz(sinif_ad);
                hata_fmt_yaz("' içinde '");
                hata_fmt_yaz(dugum_ad(f));
                hata_fmt_yaz("' birden fazla kez tanımlandı.");
                hata_fmt_ver(dugum_satir(f), dugum_sutun(f));
            } yoksa {
                liste_ekle(fields, f);
            }
        } yoksa {
            hata_fmt_basla();
            hata_fmt_yaz("Sınıf gövdesinde alan, 'sabit' veya 'fonk' bekleniyordu, '");
            hata_fmt_yaz(bak_deger());
            hata_fmt_yaz("' bulundu.");
            hata_fmt_ver(bak_satir(), bak_sutun());
            dur;
        }
    }
    beklenen_tur(JetonTur.J_SLUS_KAPA, "}");
    sayi n = dugum_yeni(DugumTur.D_SINIF, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_ad(n, jeton_deger(nm));
    dugum_yaz_liste(n, fields);
    dugum_yaz_liste2(n, methods);
    eger (liste_uzunluk(constants) > 0) {
        sayi holder = dugum_yeni(DugumTur.D_BLOK, jeton_satir(kw), jeton_sutun(kw));
        dugum_yaz_liste(holder, constants);
        dugum_yaz_c(n, holder);
    }
    don n;
}

fonk ayristir_secenek() -> sayi {
    sayi kw = beklenen_kw("secenek");
    sayi nm = beklenen_kimlik(yanlis);
    oto ad = jeton_deger(nm);
    eger (tur_adi_mi(ad) || metin_esit(ad, "upp") || metin_esit(ad, "ana") || metin_esit(ad, "main")) {
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' seçenek adı olarak kullanılamaz.");
        hata_fmt_ver(jeton_satir(nm), jeton_sutun(nm));
    }
    beklenen_tur(JetonTur.J_SLUS_AC, "{");
    sayi L = liste_yeni();
    sayi next_val = 0;
    iken (bak_tur() != JetonTur.J_SLUS_KAPA && bak_tur() != JetonTur.J_EOF && !hata_var()) {
        sayi ident = beklenen_kimlik(yanlis);
        sayi value = next_val;
        eger (esles_tur(JetonTur.J_ATAMA)) {
            sayi num = beklenen_tur(JetonTur.J_SAYI, "tam sayı");
            value = hex_deger(jeton_deger(num));
        }
        sayi v = dugum_yeni(DugumTur.D_SECENEK_UYE, jeton_satir(ident), jeton_sutun(ident));
        dugum_yaz_ad(v, jeton_deger(ident));
        dugum_yaz_sayi(v, value);
        liste_ekle(L, v);
        next_val = value + 1;
        eger (!esles_tur(JetonTur.J_VIRGUL)) {
            dur;
        }
    }
    beklenen_tur(JetonTur.J_SLUS_KAPA, "}");
    eger (liste_uzunluk(L) == 0) {
        hata_fmt_basla();
        hata_fmt_yaz("'");
        hata_fmt_yaz(ad);
        hata_fmt_yaz("' en az bir seçenek değeri içermelidir.");
        hata_fmt_ver(jeton_satir(nm), jeton_sutun(nm));
    }
    sayi n = dugum_yeni(DugumTur.D_SECENEK, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_ad(n, ad);
    dugum_yaz_liste(n, L);
    don n;
}

fonk ayristir_kullan() -> sayi {
    sayi kw = beklenen_kw("kullan");
    sayi spec = beklenen_tur(JetonTur.J_METIN, "kütüphane yolu");
    sayi alias = 0;
    eger (kw_mi("olarak")) {
        j_ilerle();
        sayi ad = beklenen_kimlik(yanlis);
        alias = kimlik_dugum(jeton_satir(ad), jeton_sutun(ad), jeton_deger(ad));
    }
    beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
    oto inner = metin_coz(jeton_deger(spec));
    eger (metin_esit(inner, "")) {
        hata_ver(jeton_satir(kw), jeton_sutun(kw), "'kullan' boş bir yol alamaz.");
    }
    sayi n = dugum_yeni(DugumTur.D_KULLAN, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_ad(n, inner);
    eger (alias != 0) {
        dugum_yaz_b(n, alias);
    }
    don n;
}

fonk ayristir_include() -> sayi {
    sayi kw = beklenen_kw("c_ekle");
    sayi spec = beklenen_tur(JetonTur.J_METIN, "başlık dizgesi");
    beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
    oto inner = metin_coz(jeton_deger(spec));
    eger (metin_esit(inner, "")) {
        hata_ver(jeton_satir(kw), jeton_sutun(kw), "c_ekle boş bir başlık alamaz.");
    }
    sayi n = dugum_yeni(DugumTur.D_CEKLE, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_ad(n, inner);
    don n;
}

// ---- nitelikler: @paketli, @hizali(N), @bolum("ad") ----
// Üst düzey bildirimden hemen önce yazılır; düğüm kimliğine göre yan tablolarda
// tutulur ve codegen GCC __attribute__((...)) olarak üretir.
//   sinif              : @paketli, @hizali
//   üst düzey fonk     : @hizali, @bolum
//   global değişken    : @hizali, @bolum   (@bolum ayrıca 'used': bağlayıcı atmaz)
harita[sayi, mantik] g_nit_paketli;
harita[sayi, sayi] g_nit_hizali;
harita[sayi, metin] g_nit_bolum;
mantik g_nb_paketli = yanlis;
sayi g_nb_hizali = 0;
metin g_nb_bolum = "";
sayi g_nb_satir = 0;
sayi g_nb_sutun = 0;
sayi g_nb_say = 0;

fonk nitelik_paketli(sayi d) -> mantik => g_nit_paketli.var_mi(d);
fonk nitelik_hizali(sayi d) -> sayi => g_nit_hizali.al(d);
fonk nitelik_bolum(sayi d) -> metin {
    eger (!g_nit_bolum.var_mi(d)) { don ""; }
    don g_nit_bolum.al(d);
}

fonk nitelik_iki_kuvveti_mi(sayi v) -> mantik {
    eger (v < 1) { don yanlis; }
    iken (v % 2 == 0) { v = v / 2; }
    don v == 1;
}

fonk nitelik_bolum_adi_gecerli(metin s) -> mantik {
    sayi n = upp.uzunluk(s);
    eger (n == 0 || n > 64) { don yanlis; }
    dongu (sayi i = 0; i < n; i += 1) {
        sayi c = s[i];
        mantik ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 46 || c == 95 || c == 36;
        eger (!ok) { don yanlis; }
    }
    don dogru;
}

// Bildirimden önceki @... dizisini okur; değerleri g_nb_* içinde bekletir.
fonk ayristir_nitelikler() -> bos {
    g_nb_paketli = yanlis;
    g_nb_hizali = 0;
    g_nb_bolum = "";
    g_nb_say = 0;
    g_nb_satir = bak_satir();
    g_nb_sutun = bak_sutun();
    iken (bak_tur() == JetonTur.J_AT && !hata_var()) {
        sayi at = j_ilerle();
        sayi nm = beklenen_tur(JetonTur.J_KIMLIK, "nitelik adı");
        eger (nm == 0) { don; }
        oto ad = jeton_deger(nm);
        g_nb_say = g_nb_say + 1;
        eger (metin_esit(ad, "paketli")) {
            eger (g_nb_paketli) { hata_ver(jeton_satir(at), jeton_sutun(at), "'@paketli' iki kez yazılmış."); don; }
            g_nb_paketli = dogru;
        } yoksa eger (metin_esit(ad, "hizali")) {
            eger (g_nb_hizali != 0) { hata_ver(jeton_satir(at), jeton_sutun(at), "'@hizali' iki kez yazılmış."); don; }
            beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
            sayi sj = beklenen_tur(JetonTur.J_SAYI, "hizalama (bayt, 2'nin kuvveti)");
            beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
            eger (hata_var()) { don; }
            oto sv = jeton_deger(sj);
            sayi v = 0;
            eger (diyez_yer(sv) < 0 && metin_cp(sv, 0) != 64) { v = upp.metinden_sayiya(sv); }
            eger (!nitelik_iki_kuvveti_mi(v) || v > 1073741824) {
                hata_ver(jeton_satir(sj), jeton_sutun(sj), "'@hizali' değeri 1 ile 2^30 arasında 2'nin kuvveti olan soneksiz bir tamsayı olmalı (ör. @hizali(16), @hizali(4096)).");
                don;
            }
            g_nb_hizali = v;
        } yoksa eger (metin_esit(ad, "bolum")) {
            eger (!metin_esit(g_nb_bolum, "")) { hata_ver(jeton_satir(at), jeton_sutun(at), "'@bolum' iki kez yazılmış."); don; }
            beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
            sayi mj = beklenen_tur(JetonTur.J_METIN, "bölüm adı (metin)");
            beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
            eger (hata_var()) { don; }
            oto bad = metin_coz(jeton_deger(mj));
            eger (!nitelik_bolum_adi_gecerli(bad)) {
                hata_ver(jeton_satir(mj), jeton_sutun(mj), "'@bolum' adı boş olmayan, en çok 64 karakterlik ve yalnızca harf, rakam, '.', '_', '$' içeren bir ad olmalı (ör. @bolum(\".limine_istekler\")).");
                don;
            }
            g_nb_bolum = bad;
        } yoksa {
            hata_fmt_basla();
            hata_fmt_yaz("Bilinmeyen nitelik '@");
            hata_fmt_yaz(ad);
            hata_fmt_yaz("'. Geçerli: @paketli, @hizali(N), @bolum(\"ad\").");
            hata_fmt_ver(jeton_satir(at), jeton_sutun(at));
            don;
        }
    }
}

fonk nitelik_uygulanamaz(metin nit, metin hedef) -> bos {
    hata_fmt_basla();
    hata_fmt_yaz("'@");
    hata_fmt_yaz(nit);
    hata_fmt_yaz("' ");
    hata_fmt_yaz(hedef);
    hata_fmt_yaz(" için kullanılamaz.");
    hata_fmt_ver(g_nb_satir, g_nb_sutun);
}

// Bekleyen nitelikleri d bildirimine bağlar; bildirim türüne uygunluğu denetler.
fonk nitelik_bagla(sayi d) -> bos {
    eger (g_nb_say == 0 || d == 0 || hata_var()) { don; }
    sayi t = dugum_tur(d);
    eger (t == DugumTur.D_SINIF) {
        eger (!metin_esit(g_nb_bolum, "")) { nitelik_uygulanamaz("bolum", "sınıf"); don; }
    } yoksa eger (t == DugumTur.D_FONK) {
        eger (g_nb_paketli) { nitelik_uygulanamaz("paketli", "fonksiyon"); don; }
    } yoksa eger (t == DugumTur.D_DEGISKEN) {
        eger (g_nb_paketli) { nitelik_uygulanamaz("paketli", "değişken"); don; }
    } yoksa {
        hata_ver(g_nb_satir, g_nb_sutun, "Nitelikler yalnızca sınıf, üst düzey fonksiyon ve global değişken bildirimlerinden önce yazılabilir.");
        don;
    }
    eger (g_nb_paketli) { g_nit_paketli.koy(d, dogru); }
    eger (g_nb_hizali > 0) { g_nit_hizali.koy(d, g_nb_hizali); }
    eger (!metin_esit(g_nb_bolum, "")) { g_nit_bolum.koy(d, g_nb_bolum); }
    g_nb_say = 0;
}

fonk ayristir_birim() -> sayi {
    sayi first_satir = bak_satir();
    sayi first_sutun = bak_sutun();
    sayi decls = liste_yeni();
    g_anon.temizle();
    iken (bak_tur() != JetonTur.J_EOF && !hata_var()) {
        ayristir_nitelikler();
        eger (hata_var()) { dur; }
        sayi onceki_n = liste_uzunluk(decls);
        ayristir_bildirim(decls);
        eger (g_nb_say > 0 && !hata_var()) {
            eger (liste_uzunluk(decls) > onceki_n) {
                nitelik_bagla(liste_al(decls, liste_uzunluk(decls) - 1));
            } yoksa {
                hata_ver(g_nb_satir, g_nb_sutun, "Nitelikten sonra bir bildirim bekleniyordu.");
            }
        }
    }
    eger (hata_var()) {
        don 0;
    }
    her (oto af in g_anon) { liste_ekle(decls, af); }
    g_anon.temizle();
    sayi n = dugum_yeni(DugumTur.D_PROGRAM, first_satir, first_sutun);
    dugum_yaz_liste(n, decls);
    don n;
}

// ---- c_harici: C fonksiyonu bildirimi ----
//   c_harici fonk strlen(cmetin s) -> u64;
//   c_harici "puts" fonk c_yaz(cmetin s) -> s32;   (C sembolü u++ adından farklıysa)
// Gövdesiz bir D_FONK üretir; C sembolü g_harici_sembol'de tutulur. Codegen
// başlıktaki prototiple çakışmasın diye GCC asm etiketiyle ayrı bir C adı bildirir.
harita[sayi, metin] g_harici_sembol;

fonk harici_mi(sayi fn) -> mantik => fn != 0 && g_harici_sembol.var_mi(fn);
fonk harici_sembol(sayi fn) -> metin => g_harici_sembol.al(fn);

// ASCII C tanımlayıcısı: [A-Za-z_][A-Za-z0-9_]*
fonk c_tanimlayici_mi(metin s) -> mantik {
    sayi n = upp.uzunluk(s);
    eger (n == 0) { don yanlis; }
    dongu (sayi i = 0; i < n; i += 1) {
        sayi c = s[i];
        mantik harf = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
        eger (!harf && !(i > 0 && c >= 48 && c <= 57)) { don yanlis; }
    }
    don dogru;
}

fonk ayristir_c_harici() -> sayi {
    sayi kw = beklenen_kw("c_harici");
    metin sembol = "";
    eger (bak_tur() == JetonTur.J_METIN) {
        sayi sj = j_ilerle();
        sembol = metin_coz(jeton_deger(sj));
        eger (!c_tanimlayici_mi(sembol)) {
            hata_ver(jeton_satir(sj), jeton_sutun(sj), "c_harici C sembol adı geçerli bir ASCII C tanımlayıcısı olmalı (harf, rakam, '_').");
            don 0;
        }
    }
    eger (!kw_mi("fonk")) {
        hata_ver(bak_satir(), bak_sutun(), "'c_harici' ardından 'fonk ad(...) -> tür;' bildirimi bekleniyordu.");
        don 0;
    }
    sayi fkw = j_ilerle();
    sayi nm = beklenen_kimlik(yanlis);
    eger (hata_var()) { don 0; }
    beklenen_tur(JetonTur.J_PARANTEZ_AC, "(");
    sayi params = liste_yeni();
    eger (bak_tur() != JetonTur.J_PARANTEZ_KAPA) {
        liste_ekle(params, ayristir_param());
        iken (esles_tur(JetonTur.J_VIRGUL)) {
            liste_ekle(params, ayristir_param());
        }
    }
    beklenen_tur(JetonTur.J_PARANTEZ_KAPA, ")");
    sayi ret = tur_dugum(jeton_satir(fkw), jeton_sutun(fkw), "bos", 0, 0);
    eger (esles_tur(JetonTur.J_OK)) {
        ret = ayristir_tur();
    }
    eger (bak_tur() == JetonTur.J_SLUS_AC || bak_tur() == JetonTur.J_YAG_OK) {
        hata_ver(bak_satir(), bak_sutun(), "'c_harici' fonksiyonun gövdesi olmaz; tanım C tarafındadır. Bildirimi ';' ile bitirin.");
        don 0;
    }
    beklenen_tur(JetonTur.J_NOKTALI_VIRGUL, ";");
    eger (hata_var()) { don 0; }
    sayi n = dugum_yeni(DugumTur.D_FONK, jeton_satir(kw), jeton_sutun(kw));
    dugum_yaz_ad(n, jeton_deger(nm));
    dugum_yaz_a(n, ret);
    dugum_yaz_liste(n, params);
    dugum_yaz_bayrak(n, 4);
    eger (metin_esit(sembol, "")) {
        sembol = jeton_deger(nm);
        eger (!c_tanimlayici_mi(sembol)) {
            hata_ver(jeton_satir(nm), jeton_sutun(nm), "c_harici fonksiyon adı ASCII bir C tanımlayıcısı değil; C sembolünü açıkça yazın: c_harici \"c_adi\" fonk ...");
            don 0;
        }
    }
    g_harici_sembol.koy(n, sembol);
    don n;
}

// Tek bir üst düzey bildirim ayrıştırır ve decls listesine ekler.
fonk ayristir_bildirim(sayi decls) -> bos {
    eger (bak_tur() == JetonTur.J_EOF || hata_var()) { don; }
    eger (kw_mi("c_ekle")) {
        liste_ekle(decls, ayristir_include());
    } yoksa eger (kw_mi("c_harici")) {
        liste_ekle(decls, ayristir_c_harici());
    } yoksa eger (kw_mi("kullan")) {
        liste_ekle(decls, ayristir_kullan());
    } yoksa eger (kw_mi("sabit")) {
        liste_ekle(decls, ayristir_sabit());
    } yoksa eger (kw_mi("sinif")) {
        liste_ekle(decls, ayristir_sinif());
    } yoksa eger (kw_mi("secenek")) {
        liste_ekle(decls, ayristir_secenek());
    } yoksa eger (kw_mi("fonk") && bak_tur_at(1) != JetonTur.J_PARANTEZ_AC) {
        liste_ekle(decls, ayristir_fonksiyon(""));
    } yoksa eger (kw_mi("oto") || tur_baslangici_mi()) {
        eger (kw_mi("oto")) {
            liste_ekle(decls, ayristir_oto());
        } yoksa {
            liste_ekle(decls, ayristir_degisken());
        }
    } yoksa {
        hata_fmt_basla();
        hata_fmt_yaz("Üst düzeyde 'c_ekle', 'c_harici', 'kullan', 'sabit', değişken, 'sinif', 'secenek' veya 'fonk' bekleniyordu, '");
        hata_fmt_yaz(bak_deger());
        hata_fmt_yaz("' bulundu.");
        hata_fmt_ver(bak_satir(), bak_sutun());
    }
}

fonk ayristir_program() -> sayi {
    sayi birim = ayristir_birim();
    eger (birim == 0 || hata_var()) {
        don 0;
    }
    sayi decls = dugum_liste(birim);
    sayi ana_say = 0;
    sayi ana_ikinci = 0;
    sayi i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_FONK && metin_esit(dugum_ad(d), "ana")) {
            ana_say = ana_say + 1;
            eger (ana_say > 1) {
                ana_ikinci = d;
            }
        }
        i = i + 1;
    }
    eger (ana_say == 0) {
        hata_ver(dugum_satir(birim), dugum_sutun(birim), "Giriş noktası bulunamadı. Bir 'fonk ana()' tanımlayın.");
        don 0;
    }
    eger (ana_say > 1) {
        hata_ver(dugum_satir(ana_ikinci), dugum_sutun(ana_ikinci), "Birden fazla 'fonk ana()' tanımlanamaz; giriş noktası tek olmalıdır.");
        don 0;
    }
    don birim;
}

fonk sabit_tur_kodu(sayi n) -> sayi {
    eger (n == 0) {
        don 0;
    }
    eger (metin_esit(dugum_ad(n), "mantik")) {
        don 3;
    }
    eger (metin_esit(dugum_ad(n), "yok")) {
        don 4;
    }
    don dugum_sayi(n);
}
