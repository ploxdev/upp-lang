fonk uret_ctur(sayi t) -> metin {
    eger (t == 0) { don "void"; }
    oto n = dugum_ad(t);
    metin s = n;
    eger (metin_esit(n, "sayi")) { s = "long long"; }
    yoksa eger (metin_esit(n, "bayt")) { s = "int8_t"; }
    yoksa eger (metin_esit(n, "ubayt")) { s = "uint8_t"; }
    yoksa eger (metin_esit(n, "s16")) { s = "int16_t"; }
    yoksa eger (metin_esit(n, "u16")) { s = "uint16_t"; }
    yoksa eger (metin_esit(n, "s32")) { s = "int32_t"; }
    yoksa eger (metin_esit(n, "u32")) { s = "uint32_t"; }
    yoksa eger (metin_esit(n, "u64")) { s = "unsigned long long"; }
    yoksa eger (metin_esit(n, "ondalik")) { s = "double"; }
    yoksa eger (metin_esit(n, "metin")) { s = "char*"; }
    yoksa eger (metin_esit(n, "mantik")) { s = "bool"; }
    yoksa eger (metin_esit(n, "bos")) { s = "void"; }
    yoksa eger (metin_esit(n, "&metin")) { s = "upp_ref_metin"; }
    yoksa eger (tip_ref_dilim_mi(t)) {
        oto elem = dilim_ref_elem_ad(n);
        eger (metin_esit(elem, "bayt")) { s = "upp_ref_dilim_bayt"; }
        yoksa eger (metin_esit(elem, "ubayt")) { s = "upp_ref_dilim_ubayt"; }
        yoksa eger (metin_esit(elem, "ondalik")) { s = "upp_ref_dilim_ondalik"; }
        yoksa eger (metin_esit(elem, "mantik")) { s = "upp_ref_dilim_mantik"; }
        yoksa { s = "upp_ref_dilim_sayi"; }
    }
    yoksa eger (liste_tur_mi(n)) { s = "UppKolListe"; }
    yoksa eger (harita_tur_mi(n)) { s = "UppKolHarita"; }
    yoksa { s = nokta_altcizgi(n); }
    sayi i = 0;
    iken (i < dugum_ptrd(t)) {
        s = kat(s, "*");
        i = i + 1;
    }
    don s;
}

fonk emit_drop_ad(metin ad) -> bos {
    emit(kat(kat3("upp_metin_release(", ad, "); "), kat(ad, " = NULL;")));
}

fonk emit_drop_i(sayi i) -> bos {
    oto fn = drop_fn_al(i);
    eger (metin_esit(fn, "")) {
        emit_drop_ad(drop_ad_al(i));
    } yoksa {
        emit(kat4(fn, "(&", drop_ad_al(i), ");"));
    }
}

fonk emit_drop_min(sayi cer_min) -> bos {
    sayi i = drop_n_al() - 1;
    iken (i >= 0) {
        eger (drop_cer_al(i) >= cer_min) {
            emit_drop_i(i);
        }
        i = i - 1;
    }
}

// ---- sahipli sınıflar: metin (ya da sahipli sınıf) alanı taşıyan değer türleri ----
fonk sinif_c_ad(sayi cls) -> metin {
    oto c = dugum_c_ad(cls);
    eger (c == yok || metin_esit(c, "")) { don dugum_ad(cls); }
    don c;
}

fonk sinif_sahipli_mi(sayi cls) -> mantik {
    eger (cls == 0) { don yanlis; }
    sayi F = dugum_liste(cls);
    sayi i = 0;
    iken (i < liste_uzunluk(F)) {
        sayi ft = dugum_a(liste_al(F, i));
        eger (tip_metin_mi(ft)) { don dogru; }
        eger (tur_sahipli_sinif(ft) != 0) { don dogru; }
        i = i + 1;
    }
    don yanlis;
}

fonk tur_sahipli_sinif(sayi t) -> sayi {
    eger (t == 0 || dugum_ptrd(t) != 0 || dugum_dims(t) != 0) { don 0; }
    sayi cls = tablo_bul(0, dugum_ad(t));
    eger (cls == 0) { don 0; }
    eger (sinif_sahipli_mi(cls)) { don cls; }
    don 0;
}

fonk sinif_birak_fn(sayi cls) -> metin {
    don kat(sinif_c_ad(cls), "__birak");
}

fonk sinif_kopya_fn(sayi cls) -> metin {
    don kat(sinif_c_ad(cls), "__kopya");
}

fonk uret_sinif_sahiplik_prototip(sayi cls) -> bos {
    oto cn = sinif_c_ad(cls);
    emit(kat5("static void ", sinif_birak_fn(cls), "(", cn, "* p);"));
    emit(kat5("static ", cn, " ", sinif_kopya_fn(cls), kat3("(", cn, " v);")));
}

fonk uret_sinif_alan_dongu(sayi f, metin govde_i) -> bos {
    oto ad = dugum_ad(f);
    emit(kat(kat5("{ long long _i; for (_i = 0; _i < (long long)(sizeof(p->", ad, ") / sizeof(p->", ad, "[0])); _i++) { "), kat(govde_i, " } }")));
}

fonk uret_sinif_sahiplik_tanim(sayi cls) -> bos {
    oto cn = sinif_c_ad(cls);
    sayi F = dugum_liste(cls);
    sayi i = 0;
    emit(kat5("static void ", sinif_birak_fn(cls), "(", cn, "* p) {"));
    indent_ekle(1);
    emit("if (!p) { return; }");
    iken (i < liste_uzunluk(F)) {
        sayi f = liste_al(F, i);
        sayi ft = dugum_a(f);
        oto ad = dugum_ad(f);
        mantik dizi = dugum_b(f) != 0;
        eger (tip_metin_mi(ft)) {
            eger (dizi) {
                uret_sinif_alan_dongu(f, kat5("upp_metin_release(p->", ad, "[_i]); p->", ad, "[_i] = NULL;"));
            } yoksa {
                emit(kat5("upp_metin_release(p->", ad, "); p->", ad, " = NULL;"));
            }
        } yoksa {
            sayi icc = tur_sahipli_sinif(ft);
            eger (icc != 0) {
                eger (dizi) {
                    uret_sinif_alan_dongu(f, kat5(sinif_birak_fn(icc), "(&p->", ad, "[_i]);", ""));
                } yoksa {
                    emit(kat4(sinif_birak_fn(icc), "(&p->", ad, ");"));
                }
            }
        }
        i = i + 1;
    }
    indent_ekle(-1);
    emit("}");
    emit(kat5("static ", cn, " ", sinif_kopya_fn(cls), kat3("(", cn, " v) {")));
    indent_ekle(1);
    emit(kat3(cn, "* p = &v;", ""));
    i = 0;
    iken (i < liste_uzunluk(F)) {
        sayi f = liste_al(F, i);
        sayi ft = dugum_a(f);
        oto ad = dugum_ad(f);
        mantik dizi = dugum_b(f) != 0;
        eger (tip_metin_mi(ft)) {
            eger (dizi) {
                uret_sinif_alan_dongu(f, kat5("p->", ad, "[_i] = upp_metin_kopya(p->", ad, "[_i]);"));
            } yoksa {
                emit(kat5("p->", ad, " = upp_metin_kopya(p->", ad, ");"));
            }
        } yoksa {
            sayi icc = tur_sahipli_sinif(ft);
            eger (icc != 0) {
                eger (dizi) {
                    uret_sinif_alan_dongu(f, kat(kat5("p->", ad, "[_i] = ", sinif_kopya_fn(icc), "(p->"), kat(ad, "[_i]);")));
                } yoksa {
                    emit(kat(kat5("p->", ad, " = ", sinif_kopya_fn(icc), "(p->"), kat(ad, ");")));
                }
            }
        }
        i = i + 1;
    }
    emit("return v;");
    indent_ekle(-1);
    emit("}");
    emit("");
}

// Sahipli sınıf değerinin SAHİP OLUNAN bir kopyasını veren C ifadesi:
// lvalue → __kopya (ref artışı); kayıtlı geçici → taşınır ve sıfırlanır;
// diğer taze değer (satır içi çağrı) → olduğu gibi.
fonk uret_sinif_deger(sayi e, sayi cls) -> metin {
    oto cn = sinif_c_ad(cls);
    eger (lvalue_mi(e)) {
        don kat4(sinif_kopya_fn(cls), "(", uret_ifade(e), ")");
    }
    eger (dugum_tur(e) == DugumTur.D_UCLU) {
        oto ad = kat("_su", sayi_metin(tmp_yeni()));
        emit(kat3(cn, " ", kat(ad, ";")));
        emit(kat3("if (", uret_kosul(dugum_a(e)), ") {"));
        indent_ekle(1);
        emit(kat4(ad, " = ", uret_sinif_deger(dugum_b(e), cls), ";"));
        indent_ekle(-1);
        emit("} else {");
        indent_ekle(1);
        emit(kat4(ad, " = ", uret_sinif_deger(dugum_c(e), cls), ";"));
        indent_ekle(-1);
        emit("}");
        don ad;
    }
    oto c = uret_ifade(e);
    eger (drop_ad_var(c)) {
        oto mv = kat("_mv", sayi_metin(tmp_yeni()));
        emit(kat5(cn, " ", mv, " = ", kat(c, ";")));
        emit(kat5(c, " = (", cn, "){0};", ""));
        don mv;
    }
    don c;
}

fonk emit_drop_cerceve() -> bos {
    emit_drop_min(drop_cer_cur_al());
}

fonk emit_her_bosalt() -> bos {
    sayi i = her_n_al() - 1;
    iken (i >= 0) {
        emit(kat3("upp_liste_bosalt(&(", her_ad_al(i), "));"));
        i = i - 1;
    }
}

fonk emit_don_temizlik() -> bos {
    emit_her_bosalt();
    emit_drop_min(1);
}

fonk uret_metin_temp(metin cexpr) -> metin {
    sayi id = tmp_yeni();
    oto ad = kat("_t", sayi_metin(id));
    emit(kat3("char* ", ad, " = NULL;"));
    emit(kat(kat3(ad, " = ", cexpr), ";"));
    drop_kaydet(ad);
    don ad;
}

fonk uret_ifade_metin(sayi e) -> metin {
    don uret_ifade(e);
}

fonk uret_metin_ata_hedef(metin lhs, sayi rhs) -> bos {
    eger ((ifade_rvalue_metin_mi(rhs) || interp_dugum_mi(rhs)) && hoist_izin_al() != 0) {
        oto tmp = uret_ifade(rhs);
        emit(kat(kat3("upp_metin_tasi(&(", lhs, "), &"), kat(tmp, ");")));
        don;
    }
    emit(kat(kat3("upp_metin_ata(&(", lhs, "), "), kat(uret_ifade(rhs), ");")));
}

fonk uret_gorunum_metin(sayi e) -> metin {
    eger (tip_ref_metin_mi(tip_ifade(e))) {
        don uret_ifade(e);
    }
    don kat3("upp_metin_gorunum(", uret_ifade(e), ")");
}

fonk tip_metin_karsilastir_mi(sayi t) -> mantik {
    don tip_metin_mi(t) || tip_ref_metin_mi(t);
}

fonk uret_metin_ptr(sayi e) -> metin {
    eger (tip_ref_metin_mi(tip_ifade(e))) {
        don kat3("(", uret_ifade(e), ").veri");
    }
    don uret_ifade(e);
}

fonk uret_args_fn(sayi fn, sayi args) -> metin {
    sayi P = dugum_liste(fn);
    sayi nneed = liste_uzunluk(P);
    sayi ngot = liste_uzunluk(args);
    metin s = "";
    sayi i = 0;
    iken (i < nneed) {
        eger (i > 0) { s = kat(s, ", "); }
        eger (i < ngot) {
            sayi a = liste_al(args, i);
            sayi pt = dugum_a(liste_al(P, i));
            eger (tip_ref_metin_mi(pt)) {
                s = kat(s, uret_gorunum_metin(a));
            } yoksa eger (tip_ref_dilim_mi(pt)) {
                s = kat(s, uret_gorunum_dilim(pt, a));
            } yoksa {
                s = kat(s, uret_ifade(a));
            }
        } yoksa {
            s = kat(s, uret_ifade(dugum_c(liste_al(P, i))));
        }
        i = i + 1;
    }
    don s;
}

fonk uret_kurucu(sayi cls, sayi args) -> metin {
    sayi M = dugum_liste2(cls);
    sayi ol = 0;
    sayi i = 0;
    iken (i < liste_uzunluk(M)) {
        eger (metin_esit(dugum_ad(liste_al(M, i)), "olustur")) {
            ol = liste_al(M, i);
        }
        i = i + 1;
    }
    oto cn = dugum_c_ad(cls);
    sayi id = tmp_yeni();
    oto tn = kat("_upp_ct", sayi_metin(id));
    emit(kat(kat3(cn, " ", tn), " = {0};"));
    eger (sinif_sahipli_mi(cls)) {
        drop_kaydet_fn(tn, sinif_birak_fn(cls));
    }
    metin cagri = kat(cn, "_olustur(&");
    cagri = kat(cagri, tn);
    eger (ol != 0 && liste_uzunluk(dugum_liste(ol)) > 0) {
        cagri = kat(cagri, ", ");
        cagri = kat(cagri, uret_args_fn(ol, args));
    }
    cagri = kat(cagri, ");");
    emit(cagri);
    don tn;
}

fonk uret_args(sayi L) -> metin {
    metin s = "";
    sayi i = 0;
    iken (i < liste_uzunluk(L)) {
        eger (i > 0) { s = kat(s, ", "); }
        s = kat(s, uret_ifade(liste_al(L, i)));
        i = i + 1;
    }
    don s;
}

fonk uret_sabit(sayi e) -> metin {
    sayi k = dugum_ptrd(e);
    eger (k == 6) { don kat(dugum_ad(e), "ULL"); }
    eger (k == 0) {
        oto n = dugum_ad(e);
        eger (metin_esit(n, "u64")) { don kat(sayi_metin(dugum_sayi(e)), "ULL"); }
        don kat(sayi_metin(dugum_sayi(e)), "LL");
    }
    eger (k == 1) { don dugum_ad(e); }
    eger (k == 2) { don uret_metin_sabit(e); }
    eger (k == 3) {
        eger (dugum_sayi(e) != 0) { don "true"; }
        don "false";
    }
    don "NULL";
}

// Bir değeri metin kurucuya ekleyen C deyimi (yazdırılabilir türler).
fonk uret_mk_ekle(metin var, sayi p) -> bos {
    eger (dugum_tur(p) == DugumTur.D_SABIT && dugum_ptrd(p) == 7) {
        emit(kat5("upp_mk_metin(&", var, ", ", lit_havuz_ref(dugum_ad(p)), ");"));
        don;
    }
    sayi t = tip_ifade(p);
    oto c = uret_ifade(p);
    oto n = dugum_ad(t);
    metin fn = "upp_mk_sayi";
    metin cast = "(long long)";
    eger (tip_metin_mi(t)) { fn = "upp_mk_metin"; cast = ""; }
    yoksa eger (tip_ref_metin_mi(t)) { fn = "upp_mk_ref"; cast = ""; }
    yoksa eger (metin_esit(n, "mantik")) { fn = "upp_mk_mantik"; cast = "(int)"; }
    yoksa eger (metin_esit(n, "ondalik")) { fn = "upp_mk_ondalik"; cast = "(double)"; }
    yoksa eger (metin_esit(n, "u64") || metin_esit(n, "u32") || metin_esit(n, "u16") || metin_esit(n, "ubayt")) {
        fn = "upp_mk_usayi";
        cast = "(unsigned long long)";
    }
    emit(kat(kat5(fn, "(&", var, ", ", cast), kat3("(", c, "));")));
}

// İnterpolasyonlu metin → kayıtlı (kapsam sonunda bırakılan) yönetilen metin.
fonk uret_interp_metin(sayi lit) -> metin {
    oto var = kat("_upp_s", sayi_metin(tmp_yeni()));
    emit(kat3("char* ", var, " = upp_mk_bas();"));
    drop_kaydet(var);
    sayi L = dugum_liste(lit);
    sayi i = 0;
    iken (i < liste_uzunluk(L)) {
        uret_mk_ekle(var, liste_al(L, i));
        i = i + 1;
    }
    don var;
}

fonk uret_metin_sabit(sayi e) -> metin {
    eger (!interp_dugum_mi(e)) {
        don lit_havuz_ref(metin_coz(dugum_ad(e)));
    }
    don uret_interp_metin(e);
}

// upp.yaz / satir_yaz / hata_*: her yazdırılabilir tür; libc printf üretilmez.
fonk uret_yazdir(sayi args, mantik nl, mantik hata) -> metin {
    oto nls = "0";
    eger (nl) { nls = "1"; }
    metin fn = "upp_yaz_metin";
    metin akis = "UPP_AKIS_CIKTI";
    eger (hata) {
        fn = "upp_hata_yaz_metin";
        akis = "UPP_AKIS_HATA";
    }
    eger (liste_uzunluk(args) == 0) {
        don kat5(fn, "(NULL, ", nls, ")", "");
    }
    sayi a = liste_al(args, 0);
    sayi t = tip_ifade(a);
    eger (tip_ref_metin_mi(t)) {
        don kat(kat5("upp_yaz_ref(", uret_ifade(a), ", ", nls, ", "), kat(akis, ")"));
    }
    eger (tip_metin_mi(t) || tip_yok_mi(t)) {
        don kat5(fn, "(", uret_ifade(a), ", ", kat(nls, ")"));
    }
    oto var = kat("_upp_s", sayi_metin(tmp_yeni()));
    emit(kat3("char* ", var, " = upp_mk_bas();"));
    drop_kaydet(var);
    uret_mk_ekle(var, a);
    don kat5(fn, "(", var, ", ", kat(nls, ")"));
}

fonk uret_kol_pack(metin elem, metin cval) -> metin {
    eger (metin_esit(elem, "ondalik")) { don kat3("0LL, ", cval, ", NULL"); }
    eger (metin_esit(elem, "metin")) { don kat("0LL, 0.0, ", cval); }
    eger (metin_esit(elem, "bayt")) { don kat3("(long long)(int8_t)(", cval, "), 0.0, NULL"); }
    eger (metin_esit(elem, "ubayt")) { don kat3("(long long)(uint8_t)(", cval, "), 0.0, NULL"); }
    eger (metin_esit(elem, "s16")) { don kat3("(long long)(int16_t)(", cval, "), 0.0, NULL"); }
    eger (metin_esit(elem, "u16")) { don kat3("(long long)(uint16_t)(", cval, "), 0.0, NULL"); }
    eger (metin_esit(elem, "s32")) { don kat3("(long long)(int32_t)(", cval, "), 0.0, NULL"); }
    eger (metin_esit(elem, "u32")) { don kat3("(long long)(uint32_t)(", cval, "), 0.0, NULL"); }
    eger (metin_esit(elem, "u64")) { don kat3("(long long)(unsigned long long)(", cval, "), 0.0, NULL"); }
    don kat3("(long long)(", cval, "), 0.0, NULL");
}

fonk uret_liste_al(metin elem, metin recv, metin idx) -> metin {
    eger (metin_esit(elem, "ondalik")) { don kat4("upp_liste_al_d(", recv, ", ", kat(idx, ")")); }
    eger (metin_esit(elem, "metin")) { don kat4("upp_liste_al_s(", recv, ", ", kat(idx, ")")); }
    eger (metin_esit(elem, "mantik")) { don kat4("(bool)upp_liste_al_i(", recv, ", ", kat(idx, ")")); }
    eger (metin_esit(elem, "bayt")) { don kat4("(int8_t)upp_liste_al_i(", recv, ", ", kat(idx, ")")); }
    eger (metin_esit(elem, "ubayt")) { don kat4("(uint8_t)upp_liste_al_i(", recv, ", ", kat(idx, ")")); }
    eger (metin_esit(elem, "s16")) { don kat4("(int16_t)upp_liste_al_i(", recv, ", ", kat(idx, ")")); }
    eger (metin_esit(elem, "u16")) { don kat4("(uint16_t)upp_liste_al_i(", recv, ", ", kat(idx, ")")); }
    eger (metin_esit(elem, "s32")) { don kat4("(int32_t)upp_liste_al_i(", recv, ", ", kat(idx, ")")); }
    eger (metin_esit(elem, "u32")) { don kat4("(uint32_t)upp_liste_al_i(", recv, ", ", kat(idx, ")")); }
    eger (metin_esit(elem, "u64")) { don kat4("(unsigned long long)upp_liste_al_i(", recv, ", ", kat(idx, ")")); }
    don kat4("upp_liste_al_i(", recv, ", ", kat(idx, ")"));
}

fonk uret_harita_key(metin ktur, sayi e) -> metin {
    oto c = uret_ifade(e);
    eger (metin_esit(ktur, "metin")) { don kat("0LL, ", c); }
    don kat3("(long long)(", c, "), NULL");
}

fonk uret_liste_cagri(sayi expr, metin on) -> metin {
    sayi member = dugum_a(expr);
    oto recv = uret_ifade(dugum_a(member));
    oto elem = liste_elem_ad(on);
    sayi tag = koleksiyon_etiket(elem);
    oto name = dugum_ad(member);
    sayi args = dugum_liste(expr);
    eger (metin_esit(name, "ekle")) {
        don kat(kat5("upp_liste_ekle(&(", recv, "), ", sayi_metin(tag), ", "), kat(uret_kol_pack(elem, uret_ifade(liste_al(args, 0))), ")"));
    }
    eger (metin_esit(name, "al")) {
        don uret_liste_al(elem, recv, uret_ifade(liste_al(args, 0)));
    }
    eger (metin_esit(name, "yaz")) {
        don kat(kat5("upp_liste_yaz(&(", recv, "), ", sayi_metin(tag), ", "), kat(kat3(uret_ifade(liste_al(args, 0)), ", ", uret_kol_pack(elem, uret_ifade(liste_al(args, 1)))), ")"));
    }
    eger (metin_esit(name, "uzunluk")) {
        don kat3("upp_liste_uzunluk(", recv, ")");
    }
    eger (metin_esit(name, "bosalt")) {
        don kat3("upp_liste_bosalt(&(", recv, "))");
    }
    eger (metin_esit(name, "sil")) {
        don kat(kat3("upp_liste_sil(&(", recv, "), "), kat(uret_ifade(liste_al(args, 0)), ")"));
    }
    eger (metin_esit(name, "temizle")) {
        don kat3("upp_liste_temizle(&(", recv, "))");
    }
    don "0";
}

fonk uret_harita_al(metin vtur, metin recv, metin kpack) -> metin {
    eger (metin_esit(vtur, "ondalik")) { don kat4("upp_harita_al_d(", recv, ", ", kat(kpack, ")")); }
    eger (metin_esit(vtur, "metin")) { don kat4("upp_harita_al_s(", recv, ", ", kat(kpack, ")")); }
    eger (metin_esit(vtur, "mantik")) { don kat4("(bool)upp_harita_al_i(", recv, ", ", kat(kpack, ")")); }
    don kat4("upp_harita_al_i(", recv, ", ", kat(kpack, ")"));
}

fonk uret_harita_cagri(sayi expr, metin on) -> metin {
    sayi member = dugum_a(expr);
    oto recv = uret_ifade(dugum_a(member));
    oto ktur = harita_anahtar_ad(on);
    oto vtur = harita_deger_ad(on);
    sayi ktag = koleksiyon_etiket(ktur);
    sayi vtag = koleksiyon_etiket(vtur);
    oto name = dugum_ad(member);
    sayi args = dugum_liste(expr);
    eger (metin_esit(name, "koy")) {
        don kat(kat5("upp_harita_koy(&(", recv, "), ", sayi_metin(ktag), ", "), kat(kat5(sayi_metin(vtag), ", ", uret_harita_key(ktur, liste_al(args, 0)), ", ", uret_kol_pack(vtur, uret_ifade(liste_al(args, 1)))), ")"));
    }
    eger (metin_esit(name, "al")) {
        don uret_harita_al(vtur, recv, kat3(sayi_metin(ktag), ", ", uret_harita_key(ktur, liste_al(args, 0))));
    }
    eger (metin_esit(name, "var_mi")) {
        don kat(kat5("(bool)upp_harita_var_mi(", recv, ", ", sayi_metin(ktag), ", "), kat(uret_harita_key(ktur, liste_al(args, 0)), ")"));
    }
    eger (metin_esit(name, "uzunluk")) {
        don kat3("upp_harita_uzunluk(", recv, ")");
    }
    eger (metin_esit(name, "bosalt")) {
        don kat3("upp_harita_bosalt(&(", recv, "))");
    }
    eger (metin_esit(name, "anahtarlar")) {
        don kat4("upp_harita_anahtarlar(", recv, ", ", kat(sayi_metin(ktag), ")"));
    }
    eger (metin_esit(name, "sil")) {
        don kat(kat5("(bool)upp_harita_sil(&(", recv, "), ", sayi_metin(ktag), ", "), kat(uret_harita_key(ktur, liste_al(args, 0)), ")"));
    }
    eger (metin_esit(name, "temizle")) {
        don kat3("upp_harita_temizle(&(", recv, "))");
    }
    don "0";
}

fonk uret_uye(sayi e) -> metin {
    sayi obj_t = tip_ifade(dugum_a(e));
    oto on = dugum_ad(obj_t);
    eger (metin_uzun(on) >= 8 && metin_esit(intern_dilim(on, 0, 8), "secenek.")) {
        don kat3(nokta_altcizgi(intern_dilim(on, 8, metin_uzun(on))), "_", dugum_ad(e));
    }
    eger (metin_uzun(on) >= 6 && metin_esit(intern_dilim(on, 0, 6), "modul.")) {
        don c_sembol(dugum_ad(e), intern_dilim(on, 6, metin_uzun(on)));
    }
    eger (metin_uzun(on) >= 6 && metin_esit(intern_dilim(on, 0, 6), "sinif.")) {
        oto key = intern_dilim(on, 6, metin_uzun(on));
        sayi cls = tablo_bul(0, key);
        eger (cls == 0) { don "0"; }
        don kat3(dugum_c_ad(cls), "_", dugum_ad(e));
    }
    eger (liste_tur_mi(on) || harita_tur_mi(on)) {
        hata_ver(dugum_satir(e), dugum_sutun(e), "Bu üye bir metottur; çağrı '...' ile yazın.");
        don "0";
    }
    oto ok = ".";
    eger (dugum_ptrd(obj_t) > 0) { ok = "->"; }
    don kat3(uret_ifade(dugum_a(e)), ok, dugum_ad(e));
}

fonk uret_upp_cagri(metin name, sayi args, sayi satir, sayi sutun) -> metin {
    eger (metin_esit(name, "yaz") || metin_esit(name, "satir_yaz")) {
        don uret_yazdir(args, metin_esit(name, "satir_yaz"), yanlis);
    }
    eger (metin_esit(name, "hata_yaz") || metin_esit(name, "hata_satir_yaz")) {
        don uret_yazdir(args, metin_esit(name, "hata_satir_yaz"), dogru);
    }
    eger (metin_esit(name, "bekle")) {
        don kat3("upp_arkaplan_bekle_deger(", uret_ifade(liste_al(args, 0)), ")");
    }
    sayi tyi = yerlesik_bul("", name);
    eger (tyi != 0) {
        don kat4(yerlesik_c(tyi), "(", uret_args(args), ")");
    }
    metin cn = name;
    eger (metin_esit(name, "mesaj")) { cn = "upp_mesaj"; }
    yoksa eger (metin_esit(name, "hata")) { cn = "upp_hata"; }
    yoksa eger (metin_esit(name, "ses_cal")) { cn = "upp_ses_cal"; }
    yoksa eger (metin_esit(name, "uyut")) { cn = "upp_uyut"; }
    yoksa eger (metin_esit(name, "rastgele")) { cn = "upp_rastgele"; }
    yoksa eger (metin_esit(name, "dosya_oku")) { cn = "upp_dosya_oku"; }
    yoksa eger (metin_esit(name, "dosya_yaz")) { cn = "upp_dosya_yaz"; }
    yoksa eger (metin_esit(name, "uzunluk")) { cn = "upp_uzunluk"; }
    yoksa eger (metin_esit(name, "giris")) { cn = "upp_giris"; }
    yoksa eger (metin_esit(name, "min")) { cn = "upp_min"; }
    yoksa eger (metin_esit(name, "max")) { cn = "upp_max"; }
    yoksa eger (metin_esit(name, "mutlak")) { cn = "upp_mutlak"; }
    yoksa eger (metin_esit(name, "arguman_sayisi")) { cn = "upp_arguman_sayisi"; }
    yoksa eger (metin_esit(name, "arguman")) { cn = "upp_arguman"; }
    yoksa eger (metin_esit(name, "dosya_var_mi")) { cn = "upp_dosya_var_mi"; }
    yoksa eger (metin_esit(name, "dosya_sil")) { cn = "upp_dosya_sil"; }
    yoksa eger (metin_esit(name, "zaman")) { cn = "upp_zaman"; }
    yoksa eger (metin_esit(name, "metinden_sayiya")) { cn = "upp_metinden_sayiya"; }
    yoksa eger (metin_esit(name, "sayidan_metin")) { cn = "upp_sayidan_metin"; }
    yoksa eger (metin_esit(name, "ondalikdan_metin")) { cn = "upp_ondalikdan_metin"; }
    yoksa eger (metin_esit(name, "metinden_ondalik")) { cn = "upp_metinden_ondalik"; }
    yoksa eger (metin_esit(name, "dosya_ekle")) { cn = "upp_dosya_ekle"; }
    yoksa eger (metin_esit(name, "dosya_boyut")) { cn = "upp_dosya_boyut"; }
    yoksa eger (metin_esit(name, "ortam_al")) { cn = "upp_ortam_al"; }
    yoksa eger (metin_esit(name, "ortam_yaz")) { cn = "upp_ortam_yaz"; }
    yoksa eger (metin_esit(name, "platform")) { cn = "upp_platform"; }
    eger (metin_esit(name, "uzunluk") && liste_uzunluk(args) == 1) {
        sayi a0 = liste_al(args, 0);
        sayi at = tip_ifade(a0);
        eger (dugum_dims(at) > 0) {
            eger (dugum_tur(a0) == DugumTur.D_DIZI_SABIT) {
                don sayi_metin(liste_uzunluk(dugum_liste(a0)));
            }
            oto c = uret_ifade(a0);
            don kat5("(long long)(sizeof(", c, ") / sizeof((", c, ")[0]))");
        }
        eger (liste_tur_mi(dugum_ad(at))) {
            don kat3("upp_liste_uzunluk(", uret_ifade(a0), ")");
        }
        eger (harita_tur_mi(dugum_ad(at))) {
            don kat3("upp_harita_uzunluk(", uret_ifade(a0), ")");
        }
        eger (tip_ref_dilim_mi(at)) {
            don kat3("(", uret_ifade(a0), ").uzunluk");
        }
        eger (tip_ref_metin_mi(at)) {
            don kat3("upp_uzunluk((", uret_ifade(a0), ").veri)");
        }
    }
    don kat4(cn, "(", uret_args(args), ")");
}

fonk uret_dizi_ptr_say(sayi e, metin elem_c) -> metin {
    oto c = "";
    sayi L = 0;
    eger (e == 0) {
        don kat5("((", elem_c, "*)0), 0", "", "");
    }
    eger (dugum_tur(e) == DugumTur.D_DIZI_SABIT) {
        L = dugum_liste(e);
        eger (liste_uzunluk(L) == 0) {
            don kat3("((", elem_c, "*)0), 0");
        }
        don kat(kat5("(", elem_c, "[]){", uret_args(L), "}, "), sayi_metin(liste_uzunluk(L)));
    }
    c = uret_ifade(e);
    don kat(kat5(c, ", (long long)(sizeof(", c, ") / sizeof((", c), ")[0]))");
}

fonk uret_ns_cagri(metin ns, metin name, sayi args) -> metin {
    sayi nyi = yerlesik_bul(ns, name);
    eger (nyi != 0) {
        don kat4(yerlesik_c(nyi), "(", uret_args(args), ")");
    }
    eger (metin_esit(ns, "matematik")) {
        metin cn = kat("upp_mat_", name);
        eger (metin_esit(name, "mesafe")) { cn = "upp_mat_mesafe_v3"; }
        yoksa eger (metin_esit(name, "mesafe_3d")) { cn = "upp_mat_mesafe_3d"; }
        yoksa eger (metin_esit(name, "aci_hesapla")) { cn = "upp_mat_aci_hesapla"; }
        yoksa eger (metin_esit(name, "dunya_ekran")) {
            don kat(kat(kat5("upp_mat_dunya_ekran(", uret_ifade(liste_al(args, 0)), ", ", uret_ifade(liste_al(args, 1)), ", "), kat5(uret_ifade(liste_al(args, 2)), ", ", uret_dizi_ptr_say(liste_al(args, 3), "double"), ", ", uret_ifade(liste_al(args, 4)))), kat3(", ", uret_ifade(liste_al(args, 5)), ")"));
        }
        don kat4(cn, "(", uret_args(args), ")");
    }
    eger ((metin_esit(ns, "windows.bellek") || metin_esit(ns, "bellek")) && metin_esit(name, "zincir_oku")) {
        don kat(kat3("upp_windows_bellek_zincir_oku(", uret_ifade(liste_al(args, 0)), ", "), kat(uret_dizi_ptr_say(liste_al(args, 1), "long long"), ")"));
    }
    metin pref = kat3("upp_", nokta_altcizgi(ns), "_");
    eger (metin_esit(ns, "metin")) { pref = "upp_metin_"; }
    yoksa eger (metin_esit(ns, "girdi")) { pref = "upp_girdi_"; }
    yoksa eger (metin_esit(ns, "bellek")) { pref = "upp_bellek_"; }
    yoksa eger (metin_esit(ns, "cizim")) { pref = "upp_cizim_"; }
    yoksa eger (metin_esit(ns, "json")) { pref = "upp_json_"; }
    yoksa eger (metin_esit(ns, "stdio")) { pref = "upp_stdio_"; }
    yoksa eger (metin_esit(ns, "sistem")) { pref = "upp_sistem_"; }
    yoksa eger (metin_esit(ns, "yol")) { pref = "upp_yol_"; }
    yoksa eger (metin_esit(ns, "dosya")) { pref = "upp_dosya_"; }
    eger (metin_esit(ns, "metin") && metin_esit(name, "birlestir")) {
        don kat4("upp_metin_liste_birlestir(", uret_args(args), "", ")");
    }
    don kat4(pref, name, "(", kat(uret_args(args), ")"));
}

fonk uret_metot(sayi expr) -> metin {
    sayi member = dugum_a(expr);
    sayi obj_t = tip_ifade(dugum_a(member));
    oto on = dugum_ad(obj_t);
    eger (metin_esit(on, "upp")) {
        don uret_upp_cagri(dugum_ad(member), dugum_liste(expr), dugum_satir(expr), dugum_sutun(expr));
    }
    eger (metin_uzun(on) >= 4 && metin_esit(intern_dilim(on, 0, 4), "upp.")) {
        don uret_ns_cagri(intern_dilim(on, 4, metin_uzun(on)), dugum_ad(member), dugum_liste(expr));
    }
    eger (metin_esit(on, "ArkaplanIs") && metin_esit(dugum_ad(member), "bekle")) {
        don kat3("upp_arkaplan_bekle(&(", uret_ifade(dugum_a(member)), "))");
    }
    eger (metin_esit(on, "Kilit") && (metin_esit(dugum_ad(member), "kilitle") || metin_esit(dugum_ad(member), "birak"))) {
        don kat(kat5("upp_kilit_", dugum_ad(member), "(&(", uret_ifade(dugum_a(member)), "))"), "");
    }
    eger (metin_uzun(on) >= 6 && metin_esit(intern_dilim(on, 0, 6), "modul.")) {
        oto alias = intern_dilim(on, 6, metin_uzun(on));
        oto name = dugum_ad(member);
        sayi fn = tablo_bul(1, c_sembol(name, alias));
        eger (fn != 0) {
            don kat4(dugum_c_ad(fn), "(", uret_args_fn(fn, dugum_liste(expr)), ")");
        }
        sayi kcls = tablo_bul(0, intern(kat3(alias, ".", name)));
        eger (kcls != 0) {
            don uret_kurucu(kcls, dugum_liste(expr));
        }
        don "0";
    }
    eger (metin_uzun(on) >= 6 && metin_esit(intern_dilim(on, 0, 6), "sinif.")) {
        oto key = intern_dilim(on, 6, metin_uzun(on));
        sayi kcls = tablo_bul(0, key);
        eger (kcls != 0) {
            don uret_kurucu(kcls, dugum_liste(expr));
        }
        don "0";
    }
    eger (liste_tur_mi(on)) {
        don uret_liste_cagri(expr, on);
    }
    eger (harita_tur_mi(on)) {
        don uret_harita_cagri(expr, on);
    }
    sayi cls = tablo_bul(0, on);
    metin cn = nokta_altcizgi(on);
    eger (cls != 0) { cn = dugum_c_ad(cls); }
    sayi method = 0;
    eger (cls != 0) {
        sayi M = dugum_liste2(cls);
        sayi mi = 0;
        iken (mi < liste_uzunluk(M)) {
            eger (metin_esit(dugum_ad(liste_al(M, mi)), dugum_ad(member))) {
                method = liste_al(M, mi);
            }
            mi = mi + 1;
        }
    }
    metin s = kat5(cn, "_", dugum_ad(member), "(&(", uret_ifade(dugum_a(member)));
    s = kat(s, ")");
    eger (method != 0) {
        eger (liste_uzunluk(dugum_liste(method)) > 0) {
            s = kat3(s, ", ", uret_args_fn(method, dugum_liste(expr)));
        }
    } yoksa eger (liste_uzunluk(dugum_liste(expr)) > 0) {
        s = kat3(s, ", ", uret_args(dugum_liste(expr)));
    }
    don kat(s, ")");
}

fonk uret_dizi_idx(sayi arr_t, sayi idx_e) -> metin {
    oto idx = uret_ifade(idx_e);
    eger (arr_t != 0 && dugum_dims(arr_t) > 0 && dugum_sayi(arr_t) > 0) {
        don kat4("upp_dizi_idx(", idx, ", ", kat(sayi_metin(dugum_sayi(arr_t)), ")"));
    }
    don idx;
}

fonk uret_dizi_n(metin arr_c) -> metin {
    don kat5("(long long)(sizeof(", arr_c, ") / sizeof((", arr_c, ")[0]))");
}

fonk uret_dilim_fn(metin elem) -> metin {
    eger (metin_esit(elem, "bayt")) { don "upp_dilim_bayt"; }
    eger (metin_esit(elem, "ubayt")) { don "upp_dilim_ubayt"; }
    eger (metin_esit(elem, "ondalik")) { don "upp_dilim_ondalik"; }
    eger (metin_esit(elem, "mantik")) { don "upp_dilim_mantik"; }
    don "upp_dilim_sayi";
}

fonk uret_dilim_ifade(sayi src_t, metin arr_c, metin a_c, metin b_c) -> metin {
    eger (liste_tur_mi(dugum_ad(src_t))) {
        oto elem = liste_elem_ad(dugum_ad(src_t));
        eger (metin_esit(elem, "ondalik")) {
            don kat(kat5("upp_liste_dilim_ondalik(", arr_c, ", ", a_c, ", "), kat(b_c, ")"));
        }
        don kat(kat5("upp_liste_dilim_sayi(", arr_c, ", ", a_c, ", "), kat(b_c, ")"));
    }
    eger (tip_ref_dilim_mi(src_t)) {
        oto elem = dilim_ref_elem_ad(dugum_ad(src_t));
        don kat(kat5(uret_dilim_fn(elem), "(", arr_c, ".veri, ", arr_c), kat(kat5(".uzunluk, ", a_c, ", ", b_c, ")"), ""));
    }
    don kat(kat4(uret_dilim_fn(dugum_ad(src_t)), "(", arr_c, ", "), kat(kat3(uret_dizi_n(arr_c), ", ", kat3(a_c, ", ", b_c)), ")"));
}

fonk uret_gorunum_dilim(sayi dst_t, sayi src_e) -> metin {
    sayi src_t = tip_ifade(src_e);
    oto arr_c = uret_ifade(src_e);
    oto elem = dilim_ref_elem_ad(dugum_ad(dst_t));
    eger (tip_ref_dilim_mi(src_t)) {
        don arr_c;
    }
    eger (dugum_tur(src_e) == DugumTur.D_INDIS && dugum_c(src_e) != 0) {
        don arr_c;
    }
    eger (liste_tur_mi(dugum_ad(src_t))) {
        eger (metin_esit(elem, "ondalik")) {
            don kat3("upp_liste_gorunum_ondalik(", arr_c, ")");
        }
        don kat3("upp_liste_gorunum_sayi(", arr_c, ")");
    }
    don uret_dilim_ifade(src_t, arr_c, "0", uret_dizi_n(arr_c));
}

fonk uret_cagri_metin_son(metin c, sayi ty) -> metin {
    eger (tip_metin_mi(ty) && hoist_izin_al() != 0) {
        don uret_metin_temp(c);
    }
    sayi cls = tur_sahipli_sinif(ty);
    eger (cls != 0 && hoist_izin_al() != 0) {
        oto ad = kat("_t", sayi_metin(tmp_yeni()));
        emit(kat5(sinif_c_ad(cls), " ", ad, " = ", kat(c, ";")));
        drop_kaydet_fn(ad, sinif_birak_fn(cls));
        don ad;
    }
    don c;
}

fonk uret_kosul(sayi e) -> metin {
    eger (e == 0) { don "0"; }
    eger (dugum_tur(e) == DugumTur.D_IKIL) {
        oto op = dugum_ad(e);
        eger (metin_esit(op, "&&")) {
            sayi id = tmp_yeni();
            oto ad = kat("_k", sayi_metin(id));
            emit(kat3("bool ", ad, " = false;"));
            emit(kat3("if (", uret_kosul(dugum_a(e)), ") {"));
            indent_ekle(1);
            drop_cerceve_ac();
            emit(kat(kat3(ad, " = ", uret_kosul(dugum_b(e))), ";"));
            emit_drop_cerceve();
            drop_cerceve_pop();
            indent_ekle(-1);
            emit("}");
            don ad;
        }
        eger (metin_esit(op, "||")) {
            sayi id = tmp_yeni();
            oto ad = kat("_k", sayi_metin(id));
            emit(kat3("bool ", ad, " = false;"));
            emit(kat3("if (!(", uret_kosul(dugum_a(e)), ")) {"));
            indent_ekle(1);
            drop_cerceve_ac();
            emit(kat(kat3(ad, " = ", uret_kosul(dugum_b(e))), ";"));
            emit_drop_cerceve();
            drop_cerceve_pop();
            indent_ekle(-1);
            emit("} else {");
            indent_ekle(1);
            emit(kat(ad, " = true;"));
            indent_ekle(-1);
            emit("}");
            don ad;
        }
    }
    don uret_ifade(e);
}

fonk uret_ifade(sayi e) -> metin {
    eger (e == 0) { don ""; }
    sayi t = dugum_tur(e);
    eger (t == DugumTur.D_SABIT) { don uret_sabit(e); }
    eger (t == DugumTur.D_KIMLIK) { don dugum_ad(e); }
    eger (t == DugumTur.D_ATAMA) {
        oto op = dugum_ad(e);
        eger (metin_esit(op, "")) { op = "="; }
        eger (dugum_tur(dugum_a(e)) == DugumTur.D_INDIS) {
            sayi arr_t = tip_ifade(dugum_a(dugum_a(e)));
            eger (liste_tur_mi(dugum_ad(arr_t))) {
                oto elem = liste_elem_ad(dugum_ad(arr_t));
                oto arr = uret_ifade(dugum_a(dugum_a(e)));
                oto idx = uret_ifade(dugum_b(dugum_a(e)));
                metin rhs = uret_ifade(dugum_b(e));
                eger (!metin_esit(op, "=")) {
                    oto al = uret_liste_al(elem, arr, idx);
                    rhs = kat5("(", al, kat3(" ", intern_dilim(op, 0, 1), " "), rhs, ")");
                }
                don kat(kat5("upp_liste_yaz(&(", arr, "), ", sayi_metin(koleksiyon_etiket(elem)), ", "), kat(kat3(idx, ", ", uret_kol_pack(elem, rhs)), ")"));
            }
        }
        eger (metin_esit(op, "+=")) {
            sayi tt = tip_ifade(dugum_a(e));
            eger (tip_metin_mi(tt) && dugum_tur(dugum_a(e)) != DugumTur.D_INDIS) {
                don kat4("upp_metin_ekle(&(", uret_ifade(dugum_a(e)), "), ", kat(uret_ifade(dugum_b(e)), ")"));
            }
        }
        eger (metin_esit(op, "=")) {
            sayi tt = tip_ifade(dugum_a(e));
            sayi scls = tur_sahipli_sinif(tt);
            eger (scls != 0) {
                oto sdeger = uret_sinif_deger(dugum_b(e), scls);
                oto slhs = uret_ifade(dugum_a(e));
                oto sas = kat("_as", sayi_metin(tmp_yeni()));
                emit(kat5(sinif_c_ad(scls), " ", sas, " = ", kat(sdeger, ";")));
                emit(kat4(sinif_birak_fn(scls), "(&", slhs, ");"));
                emit(kat4(slhs, " = ", sas, ";"));
                don slhs;
            }
            oto lhs = uret_ifade(dugum_a(e));
            eger (tip_metin_mi(tt) && dugum_tur(dugum_a(e)) != DugumTur.D_INDIS) {
                uret_metin_ata_hedef(lhs, dugum_b(e));
                don lhs;
            }
            eger (tip_ref_metin_mi(tt)) {
                emit(kat(kat3(lhs, " = ", uret_gorunum_metin(dugum_b(e))), ";"));
                don lhs;
            }
            eger (tip_ref_dilim_mi(tt)) {
                emit(kat(kat3(lhs, " = ", uret_gorunum_dilim(tt, dugum_b(e))), ";"));
                don lhs;
            }
        }
        don kat5("(", uret_ifade(dugum_a(e)), kat3(" ", op, " "), uret_ifade(dugum_b(e)), ")");
    }
    eger (t == DugumTur.D_UCLU) {
        eger (tip_metin_mi(tip_ifade(e)) && hoist_izin_al() != 0) {
            sayi id = tmp_yeni();
            oto ad = kat("_t", sayi_metin(id));
            emit(kat3("char* ", ad, " = NULL;"));
            drop_kaydet(ad);
            emit(kat3("if (", uret_ifade(dugum_a(e)), ") {"));
            indent_ekle(1);
            uret_metin_ata_hedef(ad, dugum_b(e));
            indent_ekle(-1);
            emit("} else {");
            indent_ekle(1);
            uret_metin_ata_hedef(ad, dugum_c(e));
            indent_ekle(-1);
            emit("}");
            don ad;
        }
        sayi eski_u = hoist_izin_al();
        hoist_izin_yaz(0);
        oto us = kat(kat5("(", uret_ifade(dugum_a(e)), " ? ", uret_ifade(dugum_b(e)), " : "), kat(uret_ifade(dugum_c(e)), ")"));
        hoist_izin_yaz(eski_u);
        don us;
    }
    eger (t == DugumTur.D_IKIL) {
        sayi lt = tip_ifade(dugum_a(e));
        sayi rt = tip_ifade(dugum_b(e));
        eger (metin_esit(dugum_ad(e), "+") && tip_metin_mi(lt) && tip_metin_mi(rt)) {
            oto lc = uret_ifade(dugum_a(e));
            oto rc = uret_ifade(dugum_b(e));
            oto bir = kat4("upp_metin_birlestir(", lc, ", ", kat(rc, ")"));
            eger (hoist_izin_al() != 0) {
                don uret_metin_temp(bir);
            }
            don bir;
        }
        eger ((metin_esit(dugum_ad(e), "==") || metin_esit(dugum_ad(e), "!=")) && tip_metin_karsilastir_mi(lt) && tip_metin_karsilastir_mi(rt)) {
            oto eq = kat4("upp_metin_esit(", uret_metin_ptr(dugum_a(e)), ", ", kat(uret_metin_ptr(dugum_b(e)), ")"));
            eger (metin_esit(dugum_ad(e), "!=")) { don kat3("(!", eq, ")"); }
            don eq;
        }
        eger (metin_esit(dugum_ad(e), "&&") || metin_esit(dugum_ad(e), "||")) {
            don uret_kosul(e);
        }
        don kat5("(", uret_ifade(dugum_a(e)), kat3(" ", dugum_ad(e), " "), uret_ifade(dugum_b(e)), ")");
    }
    eger (t == DugumTur.D_TEKIL) {
        don kat4("(", dugum_ad(e), uret_ifade(dugum_a(e)), ")");
    }
    eger (t == DugumTur.D_CAGRI) {
        metin cc = "";
        sayi ct = 0;
        eger (dugum_tur(dugum_a(e)) == DugumTur.D_UYE) {
            cc = uret_metot(e);
        } yoksa eger (dugum_tur(dugum_a(e)) == DugumTur.D_KIMLIK) {
            oto name = dugum_ad(dugum_a(e));
            sayi cls_id = tablo_bul(0, name);
            eger (cls_id != 0 && !yerlesik_sinif_mi(name)) {
                don uret_kurucu(cls_id, dugum_liste(e));
            }
            sayi fn = tablo_bul(1, name);
            eger (fn != 0) {
                cc = kat4(dugum_c_ad(fn), "(", uret_args_fn(fn, dugum_liste(e)), ")");
            } yoksa {
                cc = kat4(uret_ifade(dugum_a(e)), "(", uret_args(dugum_liste(e)), ")");
            }
        } yoksa {
            cc = kat4(uret_ifade(dugum_a(e)), "(", uret_args(dugum_liste(e)), ")");
        }
        ct = tip_ifade(e);
        don uret_cagri_metin_son(cc, ct);
    }
    eger (t == DugumTur.D_UYE) { don uret_uye(e); }
    eger (t == DugumTur.D_INDIS) {
        sayi arr_t = tip_ifade(dugum_a(e));
        eger (dugum_c(e) != 0) {
            oto arr_c = uret_ifade(dugum_a(e));
            don uret_dilim_ifade(arr_t, arr_c, uret_ifade(dugum_b(e)), uret_ifade(dugum_c(e)));
        }
        eger (liste_tur_mi(dugum_ad(arr_t))) {
            oto al = uret_liste_al(liste_elem_ad(dugum_ad(arr_t)), uret_ifade(dugum_a(e)), uret_ifade(dugum_b(e)));
            eger (metin_esit(liste_elem_ad(dugum_ad(arr_t)), "metin") && hoist_izin_al() != 0) {
                don uret_metin_temp(al);
            }
            don al;
        }
        eger (tip_ref_dilim_mi(arr_t)) {
            oto arr_c = uret_ifade(dugum_a(e));
            don kat(kat5(arr_c, ".veri[upp_dizi_idx(", uret_ifade(dugum_b(e)), ", ", arr_c), ".uzunluk)]");
        }
        eger (tip_metin_mi(arr_t)) {
            don kat4("upp_metin_kod(", uret_ifade(dugum_a(e)), ", ", kat(uret_ifade(dugum_b(e)), ")"));
        }
        don kat4(uret_ifade(dugum_a(e)), "[", uret_dizi_idx(arr_t, dugum_b(e)), "]");
    }
    eger (t == DugumTur.D_DIZI_SABIT) {
        don kat3("{", uret_args(dugum_liste(e)), "}");
    }
    eger (t == DugumTur.D_ARKAPLAN_IFADE) {
        don uret_bg_ifade(e);
    }
    don "0";
}

fonk uret_bg_sifir(sayi t) -> metin {
    eger (t == 0) { don "0"; }
    eger (dugum_ptrd(t) > 0 || tip_metin_mi(t)) { don "NULL"; }
    eger (tip_gorunum_mi(t)) { don "{0}"; }
    eger (metin_esit(dugum_ad(t), "mantik")) { don "false"; }
    eger (metin_esit(dugum_ad(t), "ondalik")) { don "0.0"; }
    eger (liste_tur_mi(dugum_ad(t)) || harita_tur_mi(dugum_ad(t))) { don "{0}"; }
    eger (tablo_bul(0, dugum_ad(t)) != 0) { don "{0}"; }
    don "0";
}

fonk uret_bg_ctx_ad(sayi id) -> metin {
    don kat("_upp_bgctx_", sayi_metin(id));
}

fonk uret_bg_fn_ad(sayi id) -> metin {
    don kat("_upp_bg_", sayi_metin(id));
}

fonk uret_bg_sp_ad(sayi id) -> metin {
    don kat("_upp_spawn_", sayi_metin(id));
}

fonk uret_bg_kopya_alan(metin hedef, sayi cap) -> bos {
    oto ad = dugum_ad(cap);
    eger (tip_metin_mi(dugum_a(cap))) {
        emit(kat(kat3(hedef, ad, " = upp_metin_derin("), kat(ad, ");")));
    } yoksa {
        emit(kat(kat3(hedef, ad, " = "), kat(ad, ";")));
    }
}

fonk uret_bg_metin_ctx_birak(sayi caps, metin p) -> bos {
    sayi i = 0;
    iken (i < liste_uzunluk(caps)) {
        sayi cap = liste_al(caps, i);
        eger (tip_metin_mi(dugum_a(cap))) {
            emit(kat(kat3("upp_metin_release(", p, "->"), kat(dugum_ad(cap), ");")));
        }
        i = i + 1;
    }
}

fonk uret_bg_kopya_hata_kosul(metin hedef, sayi caps) -> metin {
    metin s = "";
    sayi i = 0;
    iken (i < liste_uzunluk(caps)) {
        sayi cap = liste_al(caps, i);
        eger (tip_metin_mi(dugum_a(cap))) {
            oto ad = dugum_ad(cap);
            oto parca = kat(kat5("(", ad, " && !", hedef, ad), ")");
            eger (metin_esit(s, "")) {
                s = parca;
            } yoksa {
                s = kat3(s, " || ", parca);
            }
        }
        i = i + 1;
    }
    don s;
}

fonk uret_bg_param_listesi(sayi caps) -> metin {
    metin s = "";
    sayi i = 0;
    eger (liste_uzunluk(caps) == 0) { don "void"; }
    iken (i < liste_uzunluk(caps)) {
        sayi cap = liste_al(caps, i);
        eger (i > 0) { s = kat(s, ", "); }
        s = kat(s, uret_ctur(dugum_a(cap)));
        s = kat(s, " ");
        s = kat(s, dugum_ad(cap));
        i = i + 1;
    }
    don s;
}

fonk uret_bg_arg_listesi(sayi caps) -> metin {
    metin s = "";
    sayi i = 0;
    iken (i < liste_uzunluk(caps)) {
        eger (i > 0) { s = kat(s, ", "); }
        s = kat(s, dugum_ad(liste_al(caps, i)));
        i = i + 1;
    }
    don s;
}

fonk uret_bg_ifade(sayi e) -> metin {
    sayi id = dugum_sayi(e);
    sayi caps = dugum_liste2(e);
    don kat4(uret_bg_sp_ad(id), "(", uret_bg_arg_listesi(caps), ")");
}

fonk linux_mi() -> mantik {
    don os_hedef_al() != 0;
}

fonk uret_bg_isci(sayi node) -> bos {
    sayi id = dugum_sayi(node);
    oto fn = uret_bg_fn_ad(id);
    oto sp = uret_bg_sp_ad(id);
    oto ctx = uret_bg_ctx_ad(id);
    sayi caps = dugum_liste2(node);
    sayi eski = indent_al();
    sayi i = 0;
    sayi cap = 0;
    sayi body = 0;
    indent_kur(0);
    eger (liste_uzunluk(caps) > 0) {
        emit(kat3("struct ", ctx, " {"));
        indent_ekle(1);
        i = 0;
        iken (i < liste_uzunluk(caps)) {
            cap = liste_al(caps, i);
            emit(kat(kat3(uret_ctur(dugum_a(cap)), " ", dugum_ad(cap)), ";"));
            i = i + 1;
        }
        indent_ekle(-1);
        emit("};");
    }
    eger (linux_mi()) {
        emit(kat3("static void* ", fn, "(void* _p) {"));
    } yoksa {
        emit(kat3("static DWORD WINAPI ", fn, "(LPVOID _p) {"));
    }
    indent_ekle(1);
    eger (liste_uzunluk(caps) > 0) {
        emit(kat3("struct ", ctx, " _c;"));
        i = 0;
        iken (i < liste_uzunluk(caps)) {
            cap = liste_al(caps, i);
            emit(kat(kat5(uret_ctur(dugum_a(cap)), " ", dugum_ad(cap), " = ", uret_bg_sifir(dugum_a(cap))), ";"));
            i = i + 1;
        }
        emit("if (_p) {");
        indent_ekle(1);
        emit(kat3("_c = *(struct ", ctx, "*)_p;"));
        emit("UPP_BIRAK(_p);");
        i = 0;
        iken (i < liste_uzunluk(caps)) {
            cap = liste_al(caps, i);
            emit(kat(kat3(dugum_ad(cap), " = _c.", dugum_ad(cap)), ";"));
            i = i + 1;
        }
        indent_ekle(-1);
        emit("}");
    } yoksa {
        emit("(void)_p;");
    }
    kapsam_sifirla();
    kapsam_ac();
    i = 0;
    iken (i < liste_uzunluk(caps)) {
        cap = liste_al(caps, i);
        kapsam_bagla(dugum_ad(cap), dugum_a(cap));
        i = i + 1;
    }
    bg_yaz(bg_al() + 1);
    emit("{");
    indent_ekle(1);
    drop_sifirla();
    drop_cerceve_ac();
    body = dugum_a(node);
    eger (body != 0 && dugum_tur(body) == DugumTur.D_BLOK) {
        sayi L = dugum_liste(body);
        i = 0;
        iken (i < liste_uzunluk(L)) {
            uret_cumle(liste_al(L, i));
            i = i + 1;
        }
    } yoksa {
        uret_cumle(body);
    }
    emit_drop_cerceve();
    drop_cerceve_pop();
    indent_ekle(-1);
    emit("}");
    bg_yaz(bg_al() - 1);
    kapsam_kapat();
    i = 0;
    iken (i < liste_uzunluk(caps)) {
        cap = liste_al(caps, i);
        eger (tip_metin_mi(dugum_a(cap))) {
            emit(kat3("upp_metin_release(", dugum_ad(cap), ");"));
        }
        i = i + 1;
    }
    emit("return 0;");
    indent_ekle(-1);
    emit("}");
    eger (dugum_tur(node) == DugumTur.D_ARKAPLAN_IFADE) {
        emit(kat4("static ArkaplanIs ", sp, "(", kat(uret_bg_param_listesi(caps), ") {")));
        indent_ekle(1);
        emit("ArkaplanIs _j;");
        emit("_j.handle = 0;");
        eger (liste_uzunluk(caps) > 0) {
            emit(kat(kat5("struct ", ctx, "* _ctx = (struct ", ctx, "*)UPP_AYIR(sizeof(struct "), kat(ctx, "));")));
            emit("if (!_ctx) {");
            indent_ekle(1);
            emit("upp_arkaplan_hata(0);");
            emit("return _j;");
            indent_ekle(-1);
            emit("}");
            i = 0;
            iken (i < liste_uzunluk(caps)) {
                uret_bg_kopya_alan("_ctx->", liste_al(caps, i));
                i = i + 1;
            }
            oto kosul = uret_bg_kopya_hata_kosul("_ctx->", caps);
            eger (!metin_esit(kosul, "")) {
                emit(kat3("if (", kosul, ") {"));
                indent_ekle(1);
                emit("upp_arkaplan_hata(0);");
                uret_bg_metin_ctx_birak(caps, "_ctx");
                emit("UPP_BIRAK(_ctx);");
                emit("return _j;");
                indent_ekle(-1);
                emit("}");
            }
            eger (linux_mi()) {
                emit(kat3("{ pthread_t _th; if (pthread_create(&_th, NULL, ", fn, ", _ctx) == 0) { _j.handle = (long long)(uintptr_t)_th; upp_arkaplan_kaydet(_j.handle); } else {"));
            } yoksa {
                emit(kat3("{ HANDLE _th = CreateThread(NULL, 0, ", fn, ", _ctx, 0, NULL);"));
                emit("  if (_th) { _j.handle = (long long)(intptr_t)_th; upp_arkaplan_kaydet(_j.handle); } else {");
            }
            indent_ekle(1);
            emit("upp_arkaplan_hata(1);");
            uret_bg_metin_ctx_birak(caps, "_ctx");
            emit("UPP_BIRAK(_ctx);");
            indent_ekle(-1);
            emit("} }");
        } yoksa {
            eger (linux_mi()) {
                emit(kat3("{ pthread_t _th; if (pthread_create(&_th, NULL, ", fn, ", NULL) == 0) { _j.handle = (long long)(uintptr_t)_th; upp_arkaplan_kaydet(_j.handle); } else {"));
            } yoksa {
                emit(kat3("{ HANDLE _th = CreateThread(NULL, 0, ", fn, ", NULL, 0, NULL);"));
                emit("  if (_th) { _j.handle = (long long)(intptr_t)_th; upp_arkaplan_kaydet(_j.handle); } else {");
            }
            emit("    upp_arkaplan_hata(1);");
            emit("} }");
        }
        emit("return _j;");
        indent_ekle(-1);
        emit("}");
    }
    emit("");
    indent_kur(eski);
}

fonk uret_bg_deyim(sayi stmt) -> bos {
    sayi id = dugum_sayi(stmt);
    oto fn = uret_bg_fn_ad(id);
    oto ctx = uret_bg_ctx_ad(id);
    sayi caps = dugum_liste2(stmt);
    sayi i = 0;
    emit("{");
    indent_ekle(1);
    eger (liste_uzunluk(caps) > 0) {
        emit(kat(kat5("struct ", ctx, "* _ctx = (struct ", ctx, "*)UPP_AYIR(sizeof(struct "), kat(ctx, "));")));
        emit("if (_ctx) {");
        indent_ekle(1);
        i = 0;
        iken (i < liste_uzunluk(caps)) {
            uret_bg_kopya_alan("_ctx->", liste_al(caps, i));
            i = i + 1;
        }
        oto kosul = uret_bg_kopya_hata_kosul("_ctx->", caps);
        eger (!metin_esit(kosul, "")) {
            emit(kat3("if (", kosul, ") {"));
            indent_ekle(1);
            emit("upp_arkaplan_hata(0);");
            uret_bg_metin_ctx_birak(caps, "_ctx");
            emit("UPP_BIRAK(_ctx);");
            indent_ekle(-1);
            emit("} else {");
            indent_ekle(1);
        }
        eger (linux_mi()) {
            emit(kat3("pthread_t _th; if (pthread_create(&_th, NULL, ", fn, ", _ctx) == 0) { pthread_detach(_th); } else {"));
        } yoksa {
            emit(kat3("HANDLE _th = CreateThread(NULL, 0, ", fn, ", _ctx, 0, NULL);"));
            emit("if (_th) { CloseHandle(_th); } else {");
        }
        indent_ekle(1);
        emit("upp_arkaplan_hata(1);");
        uret_bg_metin_ctx_birak(caps, "_ctx");
        emit("UPP_BIRAK(_ctx);");
        indent_ekle(-1);
        emit("}");
        eger (!metin_esit(kosul, "")) {
            indent_ekle(-1);
            emit("}");
        }
        indent_ekle(-1);
        emit("} else {");
        indent_ekle(1);
        emit("upp_arkaplan_hata(0);");
        indent_ekle(-1);
        emit("}");
    } yoksa {
        eger (linux_mi()) {
            emit(kat3("pthread_t _th; if (pthread_create(&_th, NULL, ", fn, ", NULL) == 0) { pthread_detach(_th); } else {"));
        } yoksa {
            emit(kat3("HANDLE _th = CreateThread(NULL, 0, ", fn, ", NULL, 0, NULL);"));
            emit("if (_th) { CloseHandle(_th); } else {");
        }
        indent_ekle(1);
        emit("upp_arkaplan_hata(1);");
        indent_ekle(-1);
        emit("}");
    }
    indent_ekle(-1);
    emit("}");
}

fonk bg_yuru(sayi n, sayi kip) -> bos {
    eger (n == 0) { don; }
    bg_yuru(dugum_a(n), kip);
    bg_yuru(dugum_b(n), kip);
    bg_yuru(dugum_c(n), kip);
    bg_yuru(dugum_d(n), kip);
    sayi L = dugum_liste(n);
    sayi i = 0;
    iken (i < liste_uzunluk(L)) {
        bg_yuru(liste_al(L, i), kip);
        i = i + 1;
    }
    L = dugum_liste2(n);
    i = 0;
    iken (i < liste_uzunluk(L)) {
        bg_yuru(liste_al(L, i), kip);
        i = i + 1;
    }
    sayi t = dugum_tur(n);
    eger (t == DugumTur.D_ARKAPLAN || t == DugumTur.D_ARKAPLAN_IFADE) {
        eger (kip == 0) {
            eger (dugum_sayi(n) == 0) { dugum_yaz_sayi(n, bgid_yeni()); }
        } yoksa {
            uret_bg_isci(n);
        }
    }
}

fonk uret_govde(sayi stmt) -> bos {
    eger (stmt == 0) {
        emit("{");
        emit("}");
        don;
    }
    sayi t = dugum_tur(stmt);
    eger (t == DugumTur.D_BLOK || t == DugumTur.D_GUVENSIZ || t == DugumTur.D_GUVENLI || t == DugumTur.D_SECIM || t == DugumTur.D_HER) {
        uret_cumle(stmt);
        don;
    }
    emit("{");
    indent_ekle(1);
    drop_cerceve_ac();
    uret_cumle(stmt);
    emit_drop_cerceve();
    drop_cerceve_pop();
    indent_ekle(-1);
    emit("}");
}

fonk kilit_hazir_gerekli(sayi d) -> mantik {
    sayi ty = 0;
    eger (d == 0) { don yanlis; }
    ty = dugum_a(d);
    eger (ty == 0) { don yanlis; }
    eger (!metin_esit(dugum_ad(ty), "Kilit")) { don yanlis; }
    eger (dugum_ptrd(ty) != 0) { don yanlis; }
    eger (dugum_c(d) != 0) { don yanlis; }
    eger (dugum_b(d) != 0) { don yanlis; }
    eger ((dugum_bayrak(d) & 16) != 0) { don yanlis; }
    don dogru;
}

fonk uret_var(sayi d, mantik kuresel) -> bos {
    sayi ty = dugum_a(d);
    metin s = uret_ctur(ty);
    eger ((dugum_bayrak(d) & 16) != 0) {
        s = kat("const ", s);
    }
    s = kat(s, " ");
    oto ad = dugum_ad(d);
    eger (kuresel) { ad = dugum_c_ad(d); }
    s = kat(s, ad);
    eger (dugum_b(d) != 0) {
        s = kat(s, "[");
        s = kat(s, uret_ifade(dugum_b(d)));
        s = kat(s, "]");
    } yoksa eger ((dugum_bayrak(d) & 8) != 0 || dugum_dims(ty) > 0) {
        s = kat(s, "[]");
    }
    mantik sahip_metin = tip_metin_mi(ty) && (dugum_bayrak(d) & 16) == 0;
    sayi scls = 0;
    eger (!kuresel && dugum_b(d) == 0 && (dugum_bayrak(d) & 8) == 0) { scls = tur_sahipli_sinif(ty); }
    eger (scls != 0) {
        eger (dugum_c(d) != 0) {
            s = kat3(s, " = ", uret_sinif_deger(dugum_c(d), scls));
        } yoksa {
            s = kat(s, " = {0}");
        }
        emit(kat(s, ";"));
        drop_kaydet_fn(ad, sinif_birak_fn(scls));
    } yoksa eger (sahip_metin) {
        s = kat(s, " = NULL");
        emit(kat(s, ";"));
        eger (!kuresel) {
            drop_kaydet(ad);
        }
        eger (dugum_c(d) != 0 && !(kuresel && sahip_metin)) {
            uret_metin_ata_hedef(ad, dugum_c(d));
        }
    } yoksa eger (dugum_c(d) != 0 && !(kuresel && tip_metin_mi(ty))) {
        eger (tip_ref_metin_mi(ty)) {
            s = kat(s, " = ");
            s = kat(s, uret_gorunum_metin(dugum_c(d)));
        } yoksa eger (tip_ref_dilim_mi(ty)) {
            s = kat(s, " = ");
            s = kat(s, uret_gorunum_dilim(ty, dugum_c(d)));
        } yoksa {
            s = kat(s, " = ");
            s = kat(s, uret_ifade(dugum_c(d)));
        }
        emit(kat(s, ";"));
    } yoksa eger (dugum_ptrd(ty) > 0 || tip_metin_mi(ty)) {
        s = kat(s, " = NULL");
        emit(kat(s, ";"));
    } yoksa eger (tip_gorunum_mi(ty) || liste_tur_mi(dugum_ad(ty)) || harita_tur_mi(dugum_ad(ty))) {
        s = kat(s, " = {0}");
        emit(kat(s, ";"));
    } yoksa eger (tablo_bul(0, dugum_ad(ty)) != 0 && dugum_ptrd(ty) == 0) {
        s = kat(s, " = {0}");
        emit(kat(s, ";"));
    } yoksa eger (tablo_bul(2, dugum_ad(ty)) != 0) {
        s = kat(s, " = 0");
        emit(kat(s, ";"));
    } yoksa {
        emit(kat(s, ";"));
    }
    kapsam_bagla(ad, ty);
    eger (kuresel && !metin_esit(ad, dugum_ad(d))) {
        kapsam_bagla(dugum_ad(d), ty);
    }
    eger (!kuresel && kilit_hazir_gerekli(d)) {
        emit(kat3("upp_kilit_hazir(&", ad, ");"));
    }
}

fonk uret_cumle(sayi stmt) -> bos {
    eger (stmt == 0) { don; }
    sayi t = dugum_tur(stmt);
    eger (t == DugumTur.D_BOS_CUMLE) { emit(";"); don; }
    eger (t == DugumTur.D_BLOK) {
        kapsam_ac();
        emit("{");
        indent_ekle(1);
        drop_cerceve_ac();
        sayi L = dugum_liste(stmt);
        sayi i = 0;
        iken (i < liste_uzunluk(L)) {
            uret_cumle(liste_al(L, i));
            i = i + 1;
        }
        emit_drop_cerceve();
        drop_cerceve_pop();
        indent_ekle(-1);
        emit("}");
        kapsam_kapat();
        don;
    }
    eger (t == DugumTur.D_GUVENSIZ) {
        emit("/* guvensiz */ {");
        indent_ekle(1);
        uret_cumle(dugum_a(stmt));
        indent_ekle(-1);
        emit("}");
        don;
    }
    eger (t == DugumTur.D_GUVENLI) {
        emit("/* guvenli */ {");
        indent_ekle(1);
        uret_cumle(dugum_a(stmt));
        indent_ekle(-1);
        emit("}");
        don;
    }
    eger (t == DugumTur.D_C_GOMMU) {
        emit("/* c_kod */");
        emit(dugum_ad(stmt));
        don;
    }
    eger (t == DugumTur.D_DEGISKEN) { uret_var(stmt, yanlis); don; }
    eger (t == DugumTur.D_EGER) {
        emit(kat3("if (", uret_kosul(dugum_a(stmt)), ")"));
        uret_govde(dugum_b(stmt));
        eger (dugum_c(stmt) != 0) {
            emit("else");
            uret_govde(dugum_c(stmt));
        }
        don;
    }
    eger (t == DugumTur.D_IKEN) {
        emit("while (1) {");
        indent_ekle(1);
        drop_dongu_it(drop_cer_cur_al());
        drop_cerceve_ac();
        emit(kat3("if (!(", uret_kosul(dugum_a(stmt)), ")) {"));
        indent_ekle(1);
        emit_drop_cerceve();
        emit("break;");
        indent_ekle(-1);
        emit("}");
        emit_drop_cerceve();
        drop_cerceve_pop();
        uret_govde(dugum_b(stmt));
        indent_ekle(-1);
        emit("}");
        drop_dongu_cek();
        don;
    }
    eger (t == DugumTur.D_DONGU) {
        kapsam_ac();
        emit("{");
        indent_ekle(1);
        drop_cerceve_ac();
        drop_dongu_it(drop_cer_cur_al());
        eger (dugum_a(stmt) != 0 && dugum_tur(dugum_a(stmt)) == DugumTur.D_DEGISKEN) {
            uret_var(dugum_a(stmt), yanlis);
        } yoksa eger (dugum_a(stmt) != 0 && dugum_tur(dugum_a(stmt)) == DugumTur.D_IFADE_CUMLE) {
            emit(kat(uret_ifade(dugum_a(dugum_a(stmt))), ";"));
        }
        metin incr_s = "";
        eger (dugum_c(stmt) != 0) {
            sayi eski_d = hoist_izin_al();
            hoist_izin_yaz(0);
            incr_s = uret_ifade(dugum_c(stmt));
            hoist_izin_yaz(eski_d);
        }
        eger (!metin_esit(incr_s, "")) {
            emit(kat3("for (;; ", incr_s, ") {"));
        } yoksa {
            emit("for (;;) {");
        }
        indent_ekle(1);
        eger (dugum_b(stmt) != 0) {
            drop_cerceve_ac();
            emit(kat3("if (!(", uret_kosul(dugum_b(stmt)), ")) {"));
            indent_ekle(1);
            emit_drop_cerceve();
            emit("break;");
            indent_ekle(-1);
            emit("}");
            emit_drop_cerceve();
            drop_cerceve_pop();
        }
        uret_govde(dugum_d(stmt));
        indent_ekle(-1);
        emit("}");
        emit_drop_cerceve();
        drop_dongu_cek();
        drop_cerceve_pop();
        indent_ekle(-1);
        emit("}");
        kapsam_kapat();
        don;
    }
    eger (t == DugumTur.D_SECIM) {
        sayi sw_t = tip_ifade(dugum_a(stmt));
        eger (tip_metin_mi(sw_t)) {
            sayi swid = tmp_yeni();
            oto swv = kat("_upp_sw", sayi_metin(swid));
            emit("{");
            indent_ekle(1);
            drop_cerceve_ac();
            emit(kat3("char* ", swv, " = NULL;"));
            drop_kaydet(swv);
            emit(kat(kat3("upp_metin_ata(&(", swv, "), "), kat(uret_ifade(dugum_a(stmt)), ");")));
            sayi L = dugum_liste(stmt);
            sayi i = 0;
            mantik first = dogru;
            iken (i < liste_uzunluk(L)) {
                sayi c = liste_al(L, i);
                eger (dugum_a(c) == 0) {
                    emit("else");
                } yoksa {
                    oto cond = kat4("upp_metin_esit(", swv, ", ", kat(uret_ifade(dugum_a(c)), ")"));
                    eger (first) {
                        emit(kat3("if (", cond, ")"));
                    } yoksa {
                        emit(kat3("else if (", cond, ")"));
                    }
                    first = yanlis;
                }
                emit("{");
                indent_ekle(1);
                drop_cerceve_ac();
                sayi sl = dugum_liste(c);
                sayi j = 0;
                iken (j < liste_uzunluk(sl)) {
                    sayi s = liste_al(sl, j);
                    eger (dugum_tur(s) != DugumTur.D_DUR) {
                        uret_cumle(s);
                    }
                    j = j + 1;
                }
                emit_drop_cerceve();
                drop_cerceve_pop();
                indent_ekle(-1);
                emit("}");
                i = i + 1;
            }
            emit_drop_cerceve();
            drop_cerceve_pop();
            indent_ekle(-1);
            emit("}");
            don;
        }
        emit(kat3("switch (", uret_ifade(dugum_a(stmt)), ") {"));
        indent_ekle(1);
        sayi L = dugum_liste(stmt);
        sayi i = 0;
        iken (i < liste_uzunluk(L)) {
            sayi c = liste_al(L, i);
            eger (dugum_a(c) == 0) { emit("default:"); }
            yoksa {
                emit(kat3("case ", uret_ifade(dugum_a(c)), ":"));
            }
            emit("{");
            indent_ekle(1);
            drop_cerceve_ac();
            sayi sl = dugum_liste(c);
            sayi j = 0;
            iken (j < liste_uzunluk(sl)) {
                sayi s = liste_al(sl, j);
                eger (dugum_tur(s) == DugumTur.D_DUR) {
                    emit_drop_cerceve();
                }
                uret_cumle(s);
                j = j + 1;
            }
            emit_drop_cerceve();
            drop_cerceve_pop();
            indent_ekle(-1);
            emit("}");
            i = i + 1;
        }
        indent_ekle(-1);
        emit("}");
        don;
    }
    eger (t == DugumTur.D_HER) {
        sayi idx = tmp_yeni();
        oto ix = kat("_upp_i", sayi_metin(idx));
        oto arr = uret_ifade(dugum_b(stmt));
        sayi it_t = tip_ifade(dugum_b(stmt));
        kapsam_ac();
        kapsam_bagla(dugum_ad(stmt), dugum_a(stmt));
        emit("{");
        indent_ekle(1);
        drop_cerceve_ac();
        drop_dongu_it(drop_cer_cur_al());
        emit(kat3("long long ", ix, ";"));
        metin s = "";
        eger (liste_tur_mi(dugum_ad(it_t))) {
            s = "for (";
            s = kat(s, ix);
            s = kat(s, " = 0; ");
            s = kat(s, ix);
            s = kat(s, " < upp_liste_uzunluk(");
            s = kat(s, arr);
            s = kat(s, "); ");
            s = kat(s, ix);
            s = kat(s, "++) {");
            emit(s);
            indent_ekle(1);
            drop_cerceve_ac();
            s = uret_ctur(dugum_a(stmt));
            s = kat(s, " ");
            s = kat(s, dugum_ad(stmt));
            eger (tip_metin_mi(dugum_a(stmt))) {
                s = kat(s, " = NULL;");
                emit(s);
                drop_kaydet(dugum_ad(stmt));
                emit(kat(kat3("upp_metin_ata(&(", dugum_ad(stmt), "), "), kat(uret_liste_al(liste_elem_ad(dugum_ad(it_t)), arr, ix), ");")));
            } yoksa {
                s = kat(s, " = ");
                s = kat(s, uret_liste_al(liste_elem_ad(dugum_ad(it_t)), arr, ix));
                s = kat(s, ";");
                emit(s);
            }
        } yoksa eger (harita_tur_mi(dugum_ad(it_t))) {
            oto ktur = harita_anahtar_ad(dugum_ad(it_t));
            sayi ktag = koleksiyon_etiket(ktur);
            sayi kid = tmp_yeni();
            oto keys = kat("_upp_hk", sayi_metin(kid));
            emit(kat(kat5("UppKolListe ", keys, " = upp_harita_anahtarlar(", arr, ", "), kat(sayi_metin(ktag), ");")));
            her_kaydet(keys);
            s = "for (";
            s = kat(s, ix);
            s = kat(s, " = 0; ");
            s = kat(s, ix);
            s = kat(s, " < upp_liste_uzunluk(");
            s = kat(s, keys);
            s = kat(s, "); ");
            s = kat(s, ix);
            s = kat(s, "++) {");
            emit(s);
            indent_ekle(1);
            s = uret_ctur(dugum_a(stmt));
            s = kat(s, " ");
            s = kat(s, dugum_ad(stmt));
            s = kat(s, " = ");
            s = kat(s, uret_liste_al(ktur, keys, ix));
            s = kat(s, ";");
            emit(s);
            uret_govde(dugum_c(stmt));
            indent_ekle(-1);
            emit("}");
            emit(kat3("upp_liste_bosalt(&(", keys, "));"));
            her_cek();
            emit_drop_cerceve();
            drop_dongu_cek();
            drop_cerceve_pop();
            indent_ekle(-1);
            emit("}");
            kapsam_kapat();
            don;
        } yoksa {
            s = "for (";
            s = kat(s, ix);
            s = kat(s, " = 0; ");
            s = kat(s, ix);
            s = kat(s, " < (long long)(sizeof(");
            s = kat(s, arr);
            s = kat(s, ") / sizeof((");
            s = kat(s, arr);
            s = kat(s, ")[0])); ");
            s = kat(s, ix);
            s = kat(s, "++) {");
            emit(s);
            indent_ekle(1);
            s = uret_ctur(dugum_a(stmt));
            s = kat(s, " ");
            s = kat(s, dugum_ad(stmt));
            s = kat(s, " = ");
            s = kat(s, arr);
            s = kat(s, "[");
            s = kat(s, ix);
            s = kat(s, "];");
            emit(s);
        }
        uret_govde(dugum_c(stmt));
        eger (liste_tur_mi(dugum_ad(it_t))) {
            emit_drop_cerceve();
            drop_cerceve_pop();
        }
        indent_ekle(-1);
        emit("}");
        emit_drop_cerceve();
        drop_dongu_cek();
        drop_cerceve_pop();
        indent_ekle(-1);
        emit("}");
        kapsam_kapat();
        don;
    }
    eger (t == DugumTur.D_DON) {
        eger (bg_al() > 0) {
            emit_drop_min(1);
            emit("return 0;");
            don;
        }
        sayi fn = cur_fn_al();
        mantik ana = fn != 0 && metin_esit(dugum_ad(fn), "ana") && dugum_c(fn) == 0;
        sayi rt = 0;
        eger (fn != 0) { rt = dugum_a(fn); }
        eger (dugum_a(stmt) == 0) {
            emit_don_temizlik();
            eger (ana) { emit("return 0;"); }
            yoksa { emit("return;"); }
        } yoksa eger (ana) {
            oto av = uret_ifade(dugum_a(stmt));
            oto rvt = kat("_rv", sayi_metin(tmp_yeni()));
            emit(kat(kat3("long long ", rvt, " = "), kat(av, ";")));
            emit_don_temizlik();
            emit(kat3("return (int)(", rvt, ");"));
        } yoksa eger (tip_metin_mi(rt)) {
            eger (dugum_tur(dugum_a(stmt)) == DugumTur.D_KIMLIK) {
                oto ad = dugum_ad(dugum_a(stmt));
                eger (drop_ad_var(ad) && tablo_bul(3, ad) == 0) {
                    emit(kat3("_retval = ", ad, ";"));
                    emit(kat(ad, " = NULL;"));
                } yoksa {
                    emit(kat3("_retval = upp_metin_kopya(", ad, ");"));
                }
            } yoksa eger (ifade_rvalue_metin_mi(dugum_a(stmt)) || interp_dugum_mi(dugum_a(stmt))) {
                oto tmp = uret_ifade(dugum_a(stmt));
                eger (drop_ad_var(tmp)) {
                    emit(kat3("_retval = ", tmp, ";"));
                    emit(kat(tmp, " = NULL;"));
                } yoksa {
                    emit(kat3("_retval = ", tmp, ";"));
                }
            } yoksa {
                emit(kat3("_retval = upp_metin_kopya(", uret_ifade(dugum_a(stmt)), ");"));
            }
            emit_don_temizlik();
            emit("return _retval;");
        } yoksa eger (tur_sahipli_sinif(rt) != 0) {
            sayi rcls = tur_sahipli_sinif(rt);
            oto rcn = sinif_c_ad(rcls);
            oto rvt = kat("_rv", sayi_metin(tmp_yeni()));
            sayi re = dugum_a(stmt);
            eger (dugum_tur(re) == DugumTur.D_KIMLIK && drop_ad_var(dugum_ad(re)) && tablo_bul(3, dugum_ad(re)) == 0) {
                emit(kat5(rcn, " ", rvt, " = ", kat(dugum_ad(re), ";")));
                emit(kat5(dugum_ad(re), " = (", rcn, "){0};", ""));
            } yoksa {
                emit(kat5(rcn, " ", rvt, " = ", kat(uret_sinif_deger(re, rcls), ";")));
            }
            emit_don_temizlik();
            emit(kat3("return ", rvt, ";"));
        } yoksa {
            oto rv = uret_ifade(dugum_a(stmt));
            oto rvt = kat("_rv", sayi_metin(tmp_yeni()));
            emit(kat(kat3(uret_ctur(rt), " ", rvt), kat3(" = ", rv, ";")));
            emit_don_temizlik();
            emit(kat3("return ", rvt, ";"));
        }
        don;
    }
    eger (t == DugumTur.D_DUR) {
        sayi dc = drop_dongu_al();
        eger (dc > 0) {
            emit_drop_min(dc + 1);
        }
        emit("break;");
        don;
    }
    eger (t == DugumTur.D_DEVAM) {
        sayi dc = drop_dongu_al();
        eger (dc > 0) {
            emit_drop_min(dc + 1);
        }
        emit("continue;");
        don;
    }
    eger (t == DugumTur.D_IFADE_CUMLE) {
        emit(kat(uret_ifade(dugum_a(stmt)), ";"));
        don;
    }
    eger (t == DugumTur.D_ARKAPLAN) {
        uret_bg_deyim(stmt);
        don;
    }
}

fonk uret_prototip(sayi decl) -> metin {
    eger (dugum_c(decl) != 0) {
        oto cn = metot_sinif_c_ad(decl);
        metin s = uret_ctur(dugum_a(decl));
        s = kat(s, " ");
        s = kat(s, cn);
        s = kat(s, "_");
        s = kat(s, dugum_ad(decl));
        s = kat(s, "(");
        s = kat(s, cn);
        s = kat(s, "* kendi");
        sayi P = dugum_liste(decl);
        sayi i = 0;
        iken (i < liste_uzunluk(P)) {
            sayi p = liste_al(P, i);
            s = kat(s, ", ");
            s = kat(s, uret_ctur(dugum_a(p)));
            s = kat(s, " ");
            s = kat(s, dugum_ad(p));
            i = i + 1;
        }
        don kat(s, ")");
    }
    eger (metin_esit(dugum_ad(decl), "ana") && metin_esit(dugum_alias_ad(decl), "")) {
        eger (serbest_mi()) { don "int upp_ana(void)"; }
        don "int main(int argc, char **argv)";
    }
    metin s = uret_ctur(dugum_a(decl));
    s = kat(s, " ");
    s = kat(s, dugum_c_ad(decl));
    s = kat(s, "(");
    sayi P = dugum_liste(decl);
    eger (liste_uzunluk(P) == 0) { s = kat(s, "void"); }
    yoksa {
        sayi i = 0;
        iken (i < liste_uzunluk(P)) {
            eger (i > 0) { s = kat(s, ", "); }
            sayi p = liste_al(P, i);
            s = kat(s, uret_ctur(dugum_a(p)));
            s = kat(s, " ");
            s = kat(s, dugum_ad(p));
            i = i + 1;
        }
    }
    don kat(s, ")");
}

fonk uret_fonksiyon(sayi decl) -> bos {
    cur_fn_yaz(decl);
    kapsam_sifirla();
    kapsam_ac();
    drop_sifirla();
    eger (dugum_c(decl) != 0) {
        oto stad = metot_sinif_tur_ad(decl);
        eger (metin_esit(stad, "")) { stad = dugum_ad(dugum_c(decl)); }
        cur_class_yaz(stad);
        kapsam_bagla("kendi", tur_dugum(dugum_satir(decl), dugum_sutun(decl), stad, 1, 0));
    } yoksa { cur_class_yaz(""); }
    sayi P = dugum_liste(decl);
    sayi pi = 0;
    iken (pi < liste_uzunluk(P)) {
        sayi p = liste_al(P, pi);
        kapsam_bagla(dugum_ad(p), dugum_a(p));
        pi = pi + 1;
    }
    emit(kat(uret_prototip(decl), " {"));
    indent_ekle(1);
    drop_cerceve_ac();
    eger (tip_metin_mi(dugum_a(decl))) {
        emit("char* _retval = NULL;");
    }
    pi = 0;
    iken (pi < liste_uzunluk(P)) {
        sayi p = liste_al(P, pi);
        eger (tip_metin_mi(dugum_a(p))) {
            oto pad = dugum_ad(p);
            emit(kat(kat3(pad, " = upp_metin_kopya(", pad), ");"));
            drop_kaydet(pad);
        } yoksa {
            sayi pcls = tur_sahipli_sinif(dugum_a(p));
            eger (pcls != 0) {
                oto pad = dugum_ad(p);
                emit(kat5(pad, " = ", sinif_kopya_fn(pcls), "(", kat(pad, ");")));
                drop_kaydet_fn(pad, sinif_birak_fn(pcls));
            }
        }
        pi = pi + 1;
    }
    eger (metin_esit(dugum_ad(decl), "ana") && dugum_c(decl) == 0 && serbest_mi()) {
        emit("_upp_kuresel_hazir();");
    } yoksa eger (metin_esit(dugum_ad(decl), "ana") && dugum_c(decl) == 0) {
        emit("upp_argv_ayarla(argc, argv);");
        emit("_upp_kuresel_hazir();");
        emit("#if defined(_WIN32)");
        emit("SetConsoleOutputCP(CP_UTF8);");
        emit("SetConsoleCP(CP_UTF8);");
        emit("#endif");
    }
    uret_cumle(dugum_b(decl));
    emit_drop_cerceve();
    drop_cerceve_pop();
    indent_ekle(-1);
    emit("}");
    emit("");
    cur_fn_yaz(0);
    cur_class_yaz("");
}

fonk uret_sahiplik_yardimcilari(sayi decls) -> bos {
    liste[metin] yerlesik;
    yerlesik.ekle("SurecCikti");
    yerlesik.ekle("JSONDeger");
    yerlesik.ekle("ArkaplanIs");
    yerlesik.ekle("Yonelme");
    yerlesik.ekle("EkranNokta");
    yerlesik.ekle("Vektor3");
    emit("/* ---- sahipli sınıf yardımcıları ---- */");
    sayi i = 0;
    iken (i < yerlesik.uzunluk()) {
        sayi c = tablo_bul(0, yerlesik.al(i));
        eger (c != 0 && sinif_sahipli_mi(c)) { uret_sinif_sahiplik_prototip(c); }
        i = i + 1;
    }
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_SINIF && sinif_sahipli_mi(d)) { uret_sinif_sahiplik_prototip(d); }
        i = i + 1;
    }
    i = 0;
    iken (i < yerlesik.uzunluk()) {
        sayi c = tablo_bul(0, yerlesik.al(i));
        eger (c != 0 && sinif_sahipli_mi(c)) { uret_sinif_sahiplik_tanim(c); }
        i = i + 1;
    }
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_SINIF && sinif_sahipli_mi(d)) { uret_sinif_sahiplik_tanim(d); }
        i = i + 1;
    }
}

fonk uret_program(sayi program) -> bos {
    tampon_sifirla();
    tmp_sifirla();
    lit_havuz_sifirla();
    eger (serbest_mi()) {
        emit("/* u++ serbest (freestanding) hedef */");
    } yoksa eger (linux_mi()) {
        emit("#define UPP_HEDEF_LINUX 1");
        emit("#ifndef _FILE_OFFSET_BITS");
        emit("#define _FILE_OFFSET_BITS 64");
        emit("#endif");
        emit("#ifndef _DEFAULT_SOURCE");
        emit("#define _DEFAULT_SOURCE 1");
        emit("#endif");
        emit("#ifndef _POSIX_C_SOURCE");
        emit("#define _POSIX_C_SOURCE 200809L");
        emit("#endif");
    } yoksa {
        emit("#define UPP_HEDEF_WINDOWS 1");
    }
    sayi decls = dugum_liste(program);
    sayi i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_CEKLE) {
            oto spec = dugum_ad(d);
            hata_fmt_basla();
            hata_fmt_yaz("#include ");
            eger (metin_cp(spec, 0) == 60 || metin_cp(spec, 0) == 34) {
                hata_fmt_yaz(spec);
            } yoksa {
                hata_fmt_yaz("\"");
                hata_fmt_yaz(spec);
                hata_fmt_yaz("\"");
            }
            emit(intern(hata_fmt_al()));
        }
        i = i + 1;
    }
    emit("");
    emit("/* ==== u++ runtime başı ==== */");
    oto runtime = os_runtime_oku();
    eger (!metin_esit(runtime, "")) {
        emit(runtime);
    } yoksa eger (serbest_mi()) {
        os_runtime_serbest_yay();
    } yoksa {
        os_runtime_gomulu_yay();
    }
    emit("");
    emit("/* ==== u++ runtime sonu ==== */");
    emit(lit_havuz_isaret());
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_SECENEK) {
            hata_fmt_basla();
            hata_fmt_yaz("typedef enum ");
            hata_fmt_yaz(dugum_c_ad(d));
            hata_fmt_yaz(" {");
            emit(intern(hata_fmt_al()));
            indent_ekle(1);
            sayi L = dugum_liste(d);
            sayi j = 0;
            iken (j < liste_uzunluk(L)) {
                sayi v = liste_al(L, j);
                metin ev = kat5(dugum_c_ad(d), "_", dugum_ad(v), " = ", sayi_metin(dugum_sayi(v)));
                eger (j < liste_uzunluk(L) - 1) { ev = kat(ev, ","); }
                emit(ev);
                j = j + 1;
            }
            indent_ekle(-1);
            hata_fmt_basla();
            hata_fmt_yaz("} ");
            hata_fmt_yaz(dugum_c_ad(d));
            hata_fmt_yaz(";");
            emit(intern(hata_fmt_al()));
            emit("");
        }
        i = i + 1;
    }
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_SINIF) {
            hata_fmt_basla();
            hata_fmt_yaz("typedef struct ");
            hata_fmt_yaz(dugum_c_ad(d));
            hata_fmt_yaz(" ");
            hata_fmt_yaz(dugum_c_ad(d));
            hata_fmt_yaz(";");
            emit(intern(hata_fmt_al()));
        }
        i = i + 1;
    }
    emit("");
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_SINIF) {
            hata_fmt_basla();
            hata_fmt_yaz("struct ");
            hata_fmt_yaz(dugum_c_ad(d));
            hata_fmt_yaz(" {");
            emit(intern(hata_fmt_al()));
            indent_ekle(1);
            sayi F = dugum_liste(d);
            eger (liste_uzunluk(F) == 0) { emit("char _u_bos;"); }
            yoksa {
                sayi j = 0;
                iken (j < liste_uzunluk(F)) {
                    sayi f = liste_al(F, j);
                    metin fs = uret_ctur(dugum_a(f));
                    fs = kat(fs, " ");
                    fs = kat(fs, dugum_ad(f));
                    eger (dugum_b(f) != 0) {
                        fs = kat(fs, "[");
                        fs = kat(fs, uret_ifade(dugum_b(f)));
                        fs = kat(fs, "]");
                    }
                    emit(kat(fs, ";"));
                    j = j + 1;
                }
            }
            indent_ekle(-1);
            emit("};");
            emit("");
        }
        i = i + 1;
    }
    uret_sahiplik_yardimcilari(decls);
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_SINIF) {
            sayi holder = dugum_c(d);
            eger (holder != 0) {
                sayi CL = dugum_liste(holder);
                sayi j = 0;
                iken (j < liste_uzunluk(CL)) {
                    sayi c = liste_al(CL, j);
                    metin cs = "static const ";
                    cs = kat(cs, uret_ctur(dugum_a(c)));
                    cs = kat(cs, " ");
                    cs = kat(cs, dugum_c_ad(d));
                    cs = kat(cs, "_");
                    cs = kat(cs, dugum_ad(c));
                    eger (dugum_c(c) != 0) {
                        cs = kat(cs, " = ");
                        cs = kat(cs, uret_ifade(dugum_c(c)));
                    }
                    emit(kat(cs, ";"));
                    j = j + 1;
                }
            }
            sayi M = dugum_liste2(d);
            sayi mj = 0;
            iken (mj < liste_uzunluk(M)) {
                emit(kat(uret_prototip(liste_al(M, mj)), ";"));
                mj = mj + 1;
            }
        }
        i = i + 1;
    }
    emit("/* ---- prototipler ---- */");
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_FONK) {
            emit(kat(uret_prototip(d), ";"));
        }
        i = i + 1;
    }
    emit("");
    emit("/* ---- u++ üst düzey değişkenler ---- */");
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_DEGISKEN) {
            emit("static");
            uret_var(d, dogru);
        }
        i = i + 1;
    }
    emit("static void _upp_kuresel_hazir(void) {");
    indent_ekle(1);
    sayi hazir = 0;
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_DEGISKEN) {
            sayi ty = dugum_a(d);
            eger (metin_esit(dugum_ad(ty), "metin") && dugum_ptrd(ty) == 0 && (dugum_bayrak(d) & 16) == 0 && dugum_c(d) != 0) {
                emit(kat(kat3(dugum_c_ad(d), " = upp_metin_kopya(", uret_ifade(dugum_c(d))), ");"));
                hazir = hazir + 1;
            }
            eger (kilit_hazir_gerekli(d)) {
                emit(kat3("upp_kilit_hazir(&", dugum_c_ad(d), ");"));
                hazir = hazir + 1;
            }
        }
        i = i + 1;
    }
    eger (hazir == 0) {
        emit("(void)0;");
    }
    indent_ekle(-1);
    emit("}");
    emit("");
    bg_yuru(program, 0);
    emit("/* ---- u++ arkaplan ---- */");
    sayi kayit_indent = indent_al();
    indent_kur(0);
    bg_yuru(program, 1);
    indent_kur(kayit_indent);
    emit("");
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_SINIF) {
            sayi M = dugum_liste2(d);
            sayi j = 0;
            oto stad = sinif_tur_ad(d);
            iken (j < liste_uzunluk(M)) {
                sayi m = liste_al(M, j);
                eger (dugum_c(m) == 0 || metin_esit(dugum_ad(dugum_c(m)), "")) {
                    dugum_yaz_c(m, kimlik_dugum(dugum_satir(m), dugum_sutun(m), stad));
                }
                uret_fonksiyon(m);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    iken (i < liste_uzunluk(decls)) {
        sayi d = liste_al(decls, i);
        eger (dugum_tur(d) == DugumTur.D_FONK) {
            uret_fonksiyon(d);
        }
        i = i + 1;
    }
    eger (serbest_mi()) {
        emit("");
        emit("/* Önyükleyicinin çağırdığı giriş: ana() döndükten sonra işlemci durdurulur. */");
        emit("void upp_cekirdek_giris(void) {");
        emit("    upp_cekirdek_kesmeler_kur();");
        emit("    (void)upp_ana();");
        emit("    _upp_sonsuz_dur();");
        emit("}");
    }
    tampon_degistir(lit_havuz_isaret(), lit_havuz_tanim());
}
