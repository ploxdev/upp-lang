fonk dugum_tur_mi(sayi id, sayi tur) -> mantik {
    eger (id == 0) {
        don tur == DugumTur.D_YOK;
    }
    don dugum_tur(id) == tur;
}

fonk tur_dugum(sayi satir, sayi sutun, metin ad, sayi ptrd, sayi dims) -> sayi {
    sayi n = dugum_yeni(DugumTur.D_TUR, satir, sutun);
    dugum_yaz_ad(n, ad);
    dugum_yaz_ptrd(n, ptrd);
    dugum_yaz_dims(n, dims);
    don n;
}

fonk tur_kopya(sayi t) -> sayi {
    eger (t == 0) {
        don tur_dugum(0, 1, "bos", 0, 0);
    }
    sayi n = tur_dugum(dugum_satir(t), dugum_sutun(t), dugum_ad(t), dugum_ptrd(t), dugum_dims(t));
    dugum_yaz_sayi(n, dugum_sayi(t));
    dugum_yaz_bayrak(n, dugum_bayrak(t));
    don n;
}

fonk tur_aciklama(sayi t) -> metin {
    sayi i = 0;
    eger (t == 0) {
        don "bos";
    }
    hata_fmt_basla();
    hata_fmt_yaz(dugum_ad(t));
    dongu (i = 0; i < dugum_ptrd(t); i = i + 1) {
        hata_fmt_yaz("*");
    }
    dongu (i = 0; i < dugum_dims(t); i = i + 1) {
        hata_fmt_yaz("[]");
    }
    don intern(hata_fmt_al());
}

fonk sabit_sayi(sayi satir, sayi sutun, sayi v) -> sayi {
    sayi n = dugum_yeni(DugumTur.D_SABIT, satir, sutun);
    dugum_yaz_ad(n, "sayi");
    dugum_yaz_sayi(n, v);
    don n;
}

fonk kimlik_dugum(sayi satir, sayi sutun, metin ad) -> sayi {
    sayi n = dugum_yeni(DugumTur.D_KIMLIK, satir, sutun);
    dugum_yaz_ad(n, ad);
    don n;
}

fonk anahtar_mi(metin s) -> mantik {
    eger (metin_esit(s, "fonk")) { don dogru; }
    eger (metin_esit(s, "don")) { don dogru; }
    eger (metin_esit(s, "eger")) { don dogru; }
    eger (metin_esit(s, "yoksa")) { don dogru; }
    eger (metin_esit(s, "iken")) { don dogru; }
    eger (metin_esit(s, "dongu")) { don dogru; }
    eger (metin_esit(s, "dur")) { don dogru; }
    eger (metin_esit(s, "devam")) { don dogru; }
    eger (tamsayi_yazim_mi(s)) { don dogru; }
    eger (metin_esit(s, "ondalik")) { don dogru; }
    eger (metin_esit(s, "metin")) { don dogru; }
    eger (metin_esit(s, "mantik")) { don dogru; }
    eger (metin_esit(s, "bos")) { don dogru; }
    eger (metin_esit(s, "liste")) { don dogru; }
    eger (metin_esit(s, "harita")) { don dogru; }
    eger (metin_esit(s, "dilim")) { don dogru; }
    eger (metin_esit(s, "dogru")) { don dogru; }
    eger (metin_esit(s, "yanlis")) { don dogru; }
    eger (metin_esit(s, "yok")) { don dogru; }
    eger (metin_esit(s, "guvensiz")) { don dogru; }
    eger (metin_esit(s, "guvenli")) { don dogru; }
    eger (metin_esit(s, "arkaplan")) { don dogru; }
    eger (metin_esit(s, "sinif")) { don dogru; }
    eger (metin_esit(s, "kendi")) { don dogru; }
    eger (metin_esit(s, "oto")) { don dogru; }
    eger (metin_esit(s, "c_ekle")) { don dogru; }
    eger (metin_esit(s, "c_harici")) { don dogru; }
    eger (metin_esit(s, "cmetin")) { don dogru; }
    eger (metin_esit(s, "secim")) { don dogru; }
    eger (metin_esit(s, "durum")) { don dogru; }
    eger (metin_esit(s, "varsayilan")) { don dogru; }
    eger (metin_esit(s, "her")) { don dogru; }
    eger (metin_esit(s, "in")) { don dogru; }
    eger (metin_esit(s, "secenek")) { don dogru; }
    eger (metin_esit(s, "kullan")) { don dogru; }
    eger (metin_esit(s, "olarak")) { don dogru; }
    eger (metin_esit(s, "sabit")) { don dogru; }
    eger (metin_esit(s, "ertele")) { don dogru; }
    eger (metin_esit(s, "hata_ertele")) { don dogru; }
    eger (metin_esit(s, "beklenen")) { don dogru; }
    don yanlis;
}

fonk tamsayi_yazim_mi(metin s) -> mantik {
    eger (metin_esit(s, "sayi") || metin_esit(s, "s64")) { don dogru; }
    eger (metin_esit(s, "bayt") || metin_esit(s, "s8")) { don dogru; }
    eger (metin_esit(s, "ubayt") || metin_esit(s, "u8")) { don dogru; }
    eger (metin_esit(s, "s16") || metin_esit(s, "u16")) { don dogru; }
    eger (metin_esit(s, "s32") || metin_esit(s, "u32")) { don dogru; }
    eger (metin_esit(s, "u64") || metin_esit(s, "usayi")) { don dogru; }
    don yanlis;
}

fonk kanonik_tur(metin s) -> metin {
    eger (metin_esit(s, "s8") || metin_esit(s, "bayt")) { don "bayt"; }
    eger (metin_esit(s, "u8") || metin_esit(s, "ubayt")) { don "ubayt"; }
    eger (metin_esit(s, "s64") || metin_esit(s, "sayi")) { don "sayi"; }
    eger (metin_esit(s, "usayi") || metin_esit(s, "u64")) { don "u64"; }
    don s;
}

fonk tur_adi_mi(metin s) -> mantik {
    eger (tamsayi_yazim_mi(s)) { don dogru; }
    eger (metin_esit(s, "ondalik")) { don dogru; }
    eger (metin_esit(s, "metin")) { don dogru; }
    eger (metin_esit(s, "mantik")) { don dogru; }
    eger (metin_esit(s, "bos")) { don dogru; }
    eger (metin_esit(s, "liste")) { don dogru; }
    eger (metin_esit(s, "harita")) { don dogru; }
    eger (metin_esit(s, "dilim")) { don dogru; }
    eger (metin_esit(s, "beklenen")) { don dogru; }
    eger (metin_esit(s, "cmetin")) { don dogru; }
    don yanlis;
}

fonk koleksiyon_elem_mi(metin s) -> mantik {
    eger (tamsayi_yazim_mi(s)) { don dogru; }
    eger (metin_esit(s, "ondalik")) { don dogru; }
    eger (metin_esit(s, "mantik")) { don dogru; }
    eger (metin_esit(s, "metin")) { don dogru; }
    don yanlis;
}

fonk liste_tur_mi(metin n) -> mantik {
    sayi L = metin_uzun(n);
    eger (L < 8) { don yanlis; }
    eger (!metin_esit(intern_dilim(n, 0, 6), "liste[")) { don yanlis; }
    eger (metin_cp(n, L - 1) != 93) { don yanlis; }
    don dogru;
}

fonk liste_elem_ad(metin n) -> metin {
    don intern_dilim(n, 6, metin_uzun(n) - 1);
}

fonk harita_tur_mi(metin n) -> mantik {
    sayi L = metin_uzun(n);
    eger (L < 10) { don yanlis; }
    eger (!metin_esit(intern_dilim(n, 0, 7), "harita[")) { don yanlis; }
    eger (metin_cp(n, L - 1) != 93) { don yanlis; }
    don dogru;
}

fonk harita_anahtar_ad(metin n) -> metin {
    sayi i = 7;
    sayi L = metin_uzun(n);
    iken (i < L - 1) {
        eger (metin_cp(n, i) == 44) { don intern_dilim(n, 7, i); }
        i = i + 1;
    }
    don "";
}

fonk harita_deger_ad(metin n) -> metin {
    sayi i = 7;
    sayi L = metin_uzun(n);
    iken (i < L - 1) {
        eger (metin_cp(n, i) == 44) { don intern_dilim(n, i + 1, L - 1); }
        i = i + 1;
    }
    don "";
}

fonk koleksiyon_etiket(metin e) -> sayi {
    eger (metin_esit(e, "sayi")) { don 0; }
    eger (metin_esit(e, "ondalik")) { don 1; }
    eger (metin_esit(e, "mantik")) { don 2; }
    eger (metin_esit(e, "metin")) { don 3; }
    eger (metin_esit(e, "bayt")) { don 4; }
    don 0;
}

fonk tip_ref_metin_mi(sayi t) -> mantik {
    don t != 0 && metin_esit(dugum_ad(t), "&metin") && dugum_ptrd(t) == 0 && dugum_dims(t) == 0;
}

fonk tip_ref_dilim_mi(sayi t) -> mantik {
    sayi L = 0;
    metin n = "";
    eger (t == 0 || dugum_ptrd(t) != 0 || dugum_dims(t) != 0) { don yanlis; }
    n = dugum_ad(t);
    L = metin_uzun(n);
    eger (L < 10) { don yanlis; }
    eger (!metin_esit(intern_dilim(n, 0, 7), "&dilim[")) { don yanlis; }
    eger (metin_cp(n, L - 1) != 93) { don yanlis; }
    don dogru;
}

fonk tip_gorunum_mi(sayi t) -> mantik {
    don tip_ref_metin_mi(t) || tip_ref_dilim_mi(t);
}

fonk dilim_ref_elem_ad(metin n) -> metin {
    sayi L = metin_uzun(n);
    eger (L < 10) { don ""; }
    don intern_dilim(n, 7, L - 1);
}

fonk yerlesik_sinif_mi(metin s) -> mantik {
    eger (metin_esit(s, "Yonelme")) { don dogru; }
    eger (metin_esit(s, "EkranNokta")) { don dogru; }
    eger (metin_esit(s, "Vektor3")) { don dogru; }
    eger (metin_esit(s, "ArkaplanIs")) { don dogru; }
    eger (metin_esit(s, "JSONDeger")) { don dogru; }
    eger (metin_esit(s, "SurecCikti")) { don dogru; }
    eger (metin_esit(s, "Kilit")) { don dogru; }
    don yanlis;
}

fonk c_sembol(metin ad, metin alias) -> metin {
    eger (metin_esit(alias, "") || alias == yok) { don ad; }
    don kat3(alias, "_", ad);
}

fonk nokta_altcizgi(metin n) -> metin {
    sayi i = 0;
    sayi L = metin_uzun(n);
    metin s = "";
    iken (i < L) {
        sayi c = metin_cp(n, i);
        sayi adv = metin_adv(n, i);
        eger (c == 46) { s = kat(s, "_"); }
        yoksa { s = kat(s, intern_dilim(n, i, i + adv)); }
        i = i + adv;
    }
    don intern(s);
}

fonk dugum_alias_ad(sayi n) -> metin {
    eger (n == 0 || dugum_d(n) == 0) { don ""; }
    eger (dugum_tur(dugum_d(n)) != DugumTur.D_KIMLIK) { don ""; }
    don dugum_ad(dugum_d(n));
}

fonk dugum_c_ad(sayi n) -> metin {
    don c_sembol(dugum_ad(n), dugum_alias_ad(n));
}

fonk sinif_tur_ad(sayi cls) -> metin {
    oto alias = dugum_alias_ad(cls);
    eger (metin_esit(alias, "")) { don dugum_ad(cls); }
    don intern(kat3(alias, ".", dugum_ad(cls)));
}

fonk metot_sinif_tur_ad(sayi fn) -> metin {
    eger (fn == 0 || dugum_c(fn) == 0) { don ""; }
    oto ad = dugum_ad(dugum_c(fn));
    oto alias = dugum_alias_ad(fn);
    eger (metin_esit(alias, "")) { don ad; }
    don intern(kat3(alias, ".", ad));
}

fonk metot_sinif_c_ad(sayi fn) -> metin {
    eger (fn == 0 || dugum_c(fn) == 0) { don ""; }
    don c_sembol(dugum_ad(dugum_c(fn)), dugum_alias_ad(fn));
}

// Fonksiyon türü: kanonik ad "fonk(P1,P2)->R" (parametre/dönüş adları yıldızlarıyla).
fonk fonk_tur_mi(metin n) -> mantik {
    eger (metin_uzun(n) < 7) { don yanlis; }
    don metin_esit(intern_dilim(n, 0, 5), "fonk(");
}

// Eşleşen ')' konumu (5'ten taranır); parçalar iç içe () ve [] içerebilir.
fonk fonk_kapa_yer(metin n) -> sayi {
    sayi i = 5;
    sayi d = 0;
    sayi L = metin_uzun(n);
    iken (i < L) {
        sayi c = metin_cp(n, i);
        eger (c == 40 || c == 91) { d = d + 1; }
        yoksa eger (c == 93) { d = d - 1; }
        yoksa eger (c == 41) {
            eger (d == 0) { don i; }
            d = d - 1;
        }
        i = i + 1;
    }
    don L;
}

fonk fonk_param_say(metin n) -> sayi {
    sayi k = fonk_kapa_yer(n);
    eger (k == 5) { don 0; }
    sayi i = 5;
    sayi d = 0;
    sayi say = 1;
    iken (i < k) {
        sayi c = metin_cp(n, i);
        eger (c == 40 || c == 91) { d = d + 1; }
        yoksa eger (c == 41 || c == 93) { d = d - 1; }
        yoksa eger (c == 44 && d == 0) { say = say + 1; }
        i = i + 1;
    }
    don say;
}

fonk fonk_param_ad(metin n, sayi idx) -> metin {
    sayi k = fonk_kapa_yer(n);
    sayi i = 5;
    sayi d = 0;
    sayi bas = 5;
    sayi say = 0;
    iken (i <= k) {
        sayi c = 0;
        eger (i < k) { c = metin_cp(n, i); }
        eger (i < k && (c == 40 || c == 91)) { d = d + 1; }
        yoksa eger (i < k && (c == 41 || c == 93)) { d = d - 1; }
        yoksa eger (i == k || (c == 44 && d == 0)) {
            eger (say == idx) { don intern_dilim(n, bas, i); }
            say = say + 1;
            bas = i + 1;
        }
        i = i + 1;
    }
    don "";
}

fonk fonk_donus_ad(metin n) -> metin {
    sayi k = fonk_kapa_yer(n);
    don intern_dilim(n, k + 3, metin_uzun(n));
}

// Kanonik parça adından tür düğümü ("sayi*" -> sayi, ptrd 1).
fonk ad_tur_dugum(metin s) -> sayi {
    eger (fonk_tur_mi(s)) { don tur_dugum(0, 1, s, 0, 0); }
    sayi L = metin_uzun(s);
    sayi p = 0;
    iken (L > 0 && metin_cp(s, L - 1) == 42) {
        L = L - 1;
        p = p + 1;
    }
    don tur_dugum(0, 1, intern_dilim(s, 0, L), p, 0);
}

fonk tur_kanonik_ad(sayi t) -> metin {
    eger (t == 0) { don "bos"; }
    metin s = dugum_ad(t);
    sayi i = 0;
    iken (i < dugum_ptrd(t)) {
        s = kat(s, "*");
        i = i + 1;
    }
    don intern(s);
}

// Bir fonksiyon bildiriminin değer türü.
fonk fonk_imza_tur(sayi fn) -> sayi {
    sayi P = dugum_liste(fn);
    metin s = "fonk(";
    sayi i = 0;
    iken (i < liste_uzunluk(P)) {
        eger (i > 0) { s = kat(s, ","); }
        s = kat(s, tur_kanonik_ad(dugum_a(liste_al(P, i))));
        i = i + 1;
    }
    s = kat3(s, ")->", tur_kanonik_ad(dugum_a(fn)));
    don tur_dugum(dugum_satir(fn), dugum_sutun(fn), intern(s), 0, 0);
}

// beklenen[T,H]: kanonik ad her zaman iki parçalıdır ("beklenen[sayi,metin]").
fonk beklenen_tur_mi(metin n) -> mantik {
    sayi L = metin_uzun(n);
    eger (L < 12) { don yanlis; }
    eger (!metin_esit(intern_dilim(n, 0, 9), "beklenen[")) { don yanlis; }
    don metin_cp(n, L - 1) == 93;
}

// En dıştaki ayırıcı virgülün yeri (iç içe [] ve () atlanır).
fonk beklenen_virgul_yer(metin n) -> sayi {
    sayi i = 9;
    sayi d = 0;
    sayi L = metin_uzun(n) - 1;
    iken (i < L) {
        sayi c = metin_cp(n, i);
        eger (c == 40 || c == 91) { d = d + 1; }
        yoksa eger (c == 41 || c == 93) { d = d - 1; }
        yoksa eger (c == 44 && d == 0) { don i; }
        i = i + 1;
    }
    don L;
}

fonk beklenen_deger_ad(metin n) -> metin {
    don intern_dilim(n, 9, beklenen_virgul_yer(n));
}

fonk beklenen_hata_ad(metin n) -> metin {
    sayi v = beklenen_virgul_yer(n);
    don intern_dilim(n, v + 1, metin_uzun(n) - 1);
}

// hata(e) ifadesinin iç türü: "hata[H]". Yalnızca beklenen[_, H]'ye atanabilir.
fonk hata_isaret_mi(metin n) -> mantik {
    sayi L = metin_uzun(n);
    eger (L < 7) { don yanlis; }
    don metin_esit(intern_dilim(n, 0, 5), "hata[") && metin_cp(n, L - 1) == 93;
}

fonk hata_isaret_ad(metin n) -> metin {
    don intern_dilim(n, 5, metin_uzun(n) - 1);
}
