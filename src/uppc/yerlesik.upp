    // ---- upp.cekirdek (serbest hedef, donanım) ----
    yk("cekirdek.port_yaz8", "sayi,sayi", "bos", "upp_cekirdek_port_yaz8", 1 + 64);
    yk("cekirdek.port_yaz16", "sayi,sayi", "bos", "upp_cekirdek_port_yaz16", 1 + 64);
