    yk("cekirdek.disk_yaz", "sayi,sayi,sayi,sayi,sayi", "mantik", "upp_cekirdek_disk_yaz", 64);
    // PCI yapılandırma alanı, MMIO pencereleri (bus_space benzeri), DMA için fiziksel adres
    yk("cekirdek.pci_oku", "sayi,sayi,sayi,sayi", "sayi", "upp_cekirdek_pci_oku", 64);
    yk("cekirdek.pci_yaz", "sayi,sayi,sayi,sayi,sayi", "bos", "upp_cekirdek_pci_yaz", 1 + 64);
    yk("cekirdek.mmio_ac", "sayi,sayi", "sayi", "upp_cekirdek_mmio_ac", 1 + 64);
    yk("cekirdek.mmio_oku8", "sayi,sayi", "sayi", "upp_cekirdek_mmio_oku8", 64);
    yk("cekirdek.mmio_oku16", "sayi,sayi", "sayi", "upp_cekirdek_mmio_oku16", 64);
    yk("cekirdek.mmio_oku32", "sayi,sayi", "sayi", "upp_cekirdek_mmio_oku32", 64);
    yk("cekirdek.mmio_yaz8", "sayi,sayi,sayi", "bos", "upp_cekirdek_mmio_yaz8", 64);
    yk("cekirdek.mmio_yaz16", "sayi,sayi,sayi", "bos", "upp_cekirdek_mmio_yaz16", 64);
    yk("cekirdek.mmio_yaz32", "sayi,sayi,sayi", "bos", "upp_cekirdek_mmio_yaz32", 64);
    yk("cekirdek.tampon_fiziksel", "sayi,sayi", "sayi", "upp_cekirdek_tampon_fiziksel", 64);
    // ---- upp.windows ----
    yk("windows.mesaj", "metin,metin", "bos", "upp_mesaj", 2 + 4);
    yk("windows.hata", "metin,metin", "bos", "upp_hata", 2 + 4);
    yk("windows.ses_cal", "metin", "mantik", "upp_ses_cal", 2 + 4);
    yk("windows.bellek.baglan", "metin", "sayi", "upp_bellek_baglan", 1 + 2);
    yk("windows.bellek.modul_bul", "metin", "sayi", "upp_bellek_modul_bul", 1 + 2);
    yk("windows.bellek.sayioku", "sayi", "sayi", "upp_bellek_sayioku", 1 + 2);
    yk("windows.bellek.sayiyaz", "sayi,sayi", "mantik", "upp_bellek_sayiyaz", 1 + 2);
    yk("windows.bellek.oku_ondalik", "sayi", "ondalik", "upp_bellek_oku_ondalik", 1 + 2);
    yk("windows.bellek.yaz_ondalik", "sayi,ondalik", "mantik", "upp_bellek_yaz_ondalik", 1 + 2);
    yk("windows.bellek.oku_metin", "sayi,sayi", "metin", "upp_bellek_oku_metin", 1 + 2);
    yk("windows.bellek.yama_yap", "sayi,metin", "mantik", "upp_bellek_yama_yap", 1 + 2);
    yk("windows.bellek.koruma_degistir", "sayi,sayi,metin", "mantik", "upp_bellek_koruma_degistir", 1 + 2);
    yk("windows.bellek.koruma_degistir_sayi", "sayi,sayi,sayi", "mantik", "upp_bellek_koruma_degistir_sayi", 1 + 2);
    yk("windows.bellek.son_hata", "", "sayi", "upp_bellek_son_hata", 1 + 2);
    yk("windows.bellek.okundu", "", "sayi", "upp_bellek_okundu", 1 + 2);
    yk("windows.girdi.fare_tasi", "sayi,sayi", "bos", "upp_girdi_fare_tasi", 2 + 4);
    yk("windows.girdi.fare_tikla", "", "bos", "upp_girdi_fare_tikla", 2 + 4);
    yk("windows.girdi.tus_bas", "metin", "bos", "upp_girdi_tus_bas", 2 + 4);
    yk("windows.cizim.baslat", "metin", "sayi", "upp_cizim_baslat", 2 + 4);
    yk("windows.cizim.temizle", "", "bos", "upp_cizim_temizle", 2 + 4);
    yk("windows.cizim.kutu", "sayi,sayi,sayi,sayi,metin", "bos", "upp_cizim_kutu", 2 + 4);
    yk("windows.cizim.yazi", "sayi,sayi,metin,metin", "bos", "upp_cizim_yazi", 2 + 4);
}

fonk yerlesik_anahtar(metin ns, metin ad) -> metin {
    eger (ns == yok || metin_esit(ns, "")) { don ad; }
    don kat3(ns, ".", ad);
}

// 1 tabanlı tablo indeksi; yoksa 0.
fonk yerlesik_bul(metin ns, metin ad) -> sayi {
    yerlesik_kur();
    oto k = yerlesik_anahtar(ns, ad);
    eger (y_idx.var_mi(k)) { don y_idx.al(k); }
    don 0;
}

fonk yerlesik_c(sayi yi) -> metin { don y_c.al(yi - 1); }
fonk yerlesik_donus(sayi yi) -> metin { don y_donus.al(yi - 1); }
fonk yerlesik_bayrak(sayi yi) -> sayi { don y_bayrak.al(yi - 1); }
fonk yerlesik_param_metin(sayi yi) -> metin { don y_param.al(yi - 1); }

fonk yerlesik_guvensiz_mi(sayi yi) -> mantik {
    don yi != 0 && (yerlesik_bayrak(yi) & 1) != 0;
}

// "metin,sayi" → parça sayısı / k'ıncı parça. Ayırıcı yalnızca parantez dışındaki
// virgüldür: "fonk(sayi,sayi)->sayi" ve "harita[metin,sayi]" tek parçadır.
fonk yerlesik_param_say(sayi yi) -> sayi {
    oto p = yerlesik_param_metin(yi);
    eger (metin_esit(p, "")) { don 0; }
    sayi n = 1;
    sayi derin = 0;
    sayi m = metin_uzun(p);
    dongu (sayi i = 0; i < m; i += 1) {
        sayi c = metin_cp(p, i);
        eger (c == 40 || c == 91) { derin = derin + 1; }
        yoksa eger (c == 41 || c == 93) { derin = derin - 1; }
        yoksa eger (c == 44 && derin == 0) { n = n + 1; }
    }
    don n;
}

fonk yerlesik_param_tur(sayi yi, sayi k) -> metin {
    oto p = yerlesik_param_metin(yi);
    sayi m = metin_uzun(p);
    sayi bas = 0;
    sayi say = 0;
    sayi derin = 0;
    dongu (sayi i = 0; i <= m; i += 1) {
        sayi c = -1;
        eger (i < m) { c = metin_cp(p, i); }
        eger (c == 40 || c == 91) { derin = derin + 1; }
        yoksa eger (c == 41 || c == 93) { derin = derin - 1; }
        yoksa eger (i == m || (c == 44 && derin == 0)) {
            eger (say == k) { don intern_dilim(p, bas, i); }
            say = say + 1;
            bas = i + 1;
        }
    }
    don "";
}

// Aynı ad alanındaki yerleşiklerin listesi (öneri için).
fonk yerlesik_ns_adlari(metin ns) -> metin {
    yerlesik_kur();
    metin o = "";
    sayi i = 0;
    oto on = kat(ns, ".");
    sayi n_on = metin_uzun(on);
    iken (i < y_anahtar.uzunluk()) {
        oto k = y_anahtar.al(i);
        mantik uygun = yanlis;
        eger (metin_esit(ns, "")) {
            uygun = upp.metin.bul(k, ".") < 0;
        } yoksa eger (metin_uzun(k) > n_on && metin_esit(intern_dilim(k, 0, n_on), on)) {
            oto kalan = intern_dilim(k, n_on, metin_uzun(k));
            uygun = upp.metin.bul(kalan, ".") < 0;
        }
        eger (uygun && (y_bayrak.al(i) & 32) == 0) {
            eger (!metin_esit(o, "")) { o += ", "; }
            eger (metin_esit(ns, "")) { o += k; } yoksa { o += intern_dilim(k, n_on, metin_uzun(k)); }
        }
        i = i + 1;
    }
    don o;
}

// Kaldırılmış yazımlar → yerine geçen tam ad (upp. öneki olmadan).
fonk yerlesik_kaldirilan(metin anahtar) -> metin {
    eger (metin_esit(anahtar, "dosya_oku")) { don "dosya.oku"; }
    eger (metin_esit(anahtar, "dosya_yaz")) { don "dosya.yaz"; }
    eger (metin_esit(anahtar, "dosya_ekle")) { don "dosya.ekle"; }
    eger (metin_esit(anahtar, "dosya_var_mi")) { don "dosya.var_mi"; }
    eger (metin_esit(anahtar, "dosya_sil")) { don "dosya.sil"; }
    eger (metin_esit(anahtar, "dosya_boyut")) { don "dosya.boyut"; }
    eger (metin_esit(anahtar, "ortam_al")) { don "sistem.ortam_al"; }
    eger (metin_esit(anahtar, "ortam_yaz")) { don "sistem.ortam_yaz"; }
    eger (metin_esit(anahtar, "metin.icinde")) { don "metin.bul"; }
    eger (metin_esit(anahtar, "metin.baslangic_mi")) { don "metin.baslar"; }
    eger (metin_esit(anahtar, "metin.bitis_mi")) { don "metin.biter"; }
    eger (metin_esit(anahtar, "yol.klasor_olustur")) { don "yol.dizin_olustur"; }
    eger (metin_esit(anahtar, "matematik.sin")) { don "matematik.sinus"; }
    eger (metin_esit(anahtar, "matematik.cos")) { don "matematik.kosinus"; }
    eger (metin_esit(anahtar, "matematik.tan")) { don "matematik.tanjant"; }
    eger (metin_esit(anahtar, "json.dizi_eleman")) { don "json.indeks_al"; }
    don "";
}
