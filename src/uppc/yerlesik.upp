// Yerleşik (upp.*) fonksiyon tablosu — tek doğru kaynak.
// Tür denetimi argüman sayısını/türlerini ve dönüş türünü, codegen C adını,
// güvenlik denetimi 'guvensiz' zorunluluğunu buradan okur.
// Tabloda olmayan yerleşikler (yaz, satir_yaz, uzunluk, bekle, dunya_ekran,
// zincir_oku) özel kuralla tur.upp/codegen.upp içinde ele alınır.
//
// Bayraklar:
//   1  YB_GUVENSIZ     yalnızca 'guvensiz' blokta
//   2  YB_BARINDIRILAN işletim sistemi/libc gerektirir (freestanding'de yok)
//   4  YB_WINDOWS      yalnızca Windows hedefi
//   8  YB_LINUX        yalnızca Linux hedefi
//  64  YB_SERBEST      yalnızca serbest/çekirdek hedefi

harita[metin, sayi] y_idx;
liste[metin] y_anahtar;
liste[metin] y_param;
liste[metin] y_donus;
liste[metin] y_c;
liste[sayi] y_bayrak;
sayi y_hazir = 0;

fonk yk(metin anahtar, metin param, metin donus, metin c, sayi bayrak) -> bos {
    y_idx.koy(anahtar, y_anahtar.uzunluk() + 1);
    y_anahtar.ekle(anahtar);
    y_param.ekle(param);
    y_donus.ekle(donus);
    y_c.ekle(c);
    y_bayrak.ekle(bayrak);
}

fonk yerlesik_kur() -> bos {
    eger (y_hazir != 0) { don; }
    y_hazir = 1;
    // ---- upp.* (üst düzey) ----
    yk("giris", "", "metin", "upp_giris", 0);
    yk("metinden_sayiya", "metin", "sayi", "upp_metinden_sayiya", 0);
    yk("sayidan_metin", "sayi", "metin", "upp_sayidan_metin", 0);
