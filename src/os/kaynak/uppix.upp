// Yalnızca eksik dosyaları oluşturur (ext4 kökte ilk açılış ya da ramfs).
fonk etc_dosya(metin yol, metin icerik, sayi kip) -> bos {
    eger (fs_coz(yol) < 0) { fs_dosya(yol, icerik, kip); }
}

fonk etc_kur() -> bos {
    etc_dosya("/etc/hostname", "uppix\n", 420);
    etc_dosya("/etc/passwd", "root:x:0:0:root:/root:/bin/sh\n", 420);
    etc_dosya("/etc/group", "root:x:0:\n", 420);
    etc_dosya("/etc/shells", "/bin/sh\n", 420);
    etc_dosya("/etc/os-release", "NAME=\"Uppix\"\nVERSION=\"" + UPPIX_SURUM + "\"\nID=uppix\nPRETTY_NAME=\"Uppix " + UPPIX_SURUM + " (u++)\"\n", 420);
    metin motd = "\n";
    motd += "  Uppix'e hoş geldiniz — tamamen u++ ile yazılmış bir Unix benzeri sistem.\n";
    motd += "\n";
    motd += "  'help' komutları listeler, 'uppfetch' sistem özetini gösterir.\n";
    motd += "  Dosya sistemi RAM'dedir (ramfs); kapatınca içerik kaybolur.\n";
    motd += "\n";
    etc_dosya("/etc/motd", motd, 420);
    metin profil = "# /etc/profile — her oturumda çalışır\n";
    profil += "export PATH=/bin:/usr/bin\n";
    profil += "alias ll='ls -l'\n";
    profil += "alias la='ls -a'\n";
    profil += "alias l='ls -1'\n";
    profil += "alias ..='cd ..'\n";
    etc_dosya("/etc/profile", profil, 420);
    metin beni = "Uppix ramfs üzerinde çalışıyor.\n";
    beni += "Bir şeyler deneyin:\n";
    beni += "  ls -l /\n";
    beni += "  cat /proc/meminfo\n";
    beni += "  echo merhaba > /tmp/not.txt && cat /tmp/not.txt\n";
    beni += "  seq 10 | grep 1 | wc -l\n";
    beni += "  sleep 3 && echo bitti &\n";
    beni += "  ps\n";
    beni += "  sh /usr/share/ornekler/selam.sh Dünya\n";
    etc_dosya("/root/beni_oku.txt", beni, 420);
    fs_dizin("/usr/share/ornekler", 493);
    metin betik = "#!/bin/sh\n";
    betik += "# Örnek betik: konum parametreleri ve koşullar\n";
    betik += "echo \"Merhaba, $1!\"\n";
    betik += "echo \"Bu betik $# argüman aldı: $@\"\n";
    betik += "test -d /tmp && echo \"/tmp var\" || echo \"/tmp yok\"\n";
    betik += "echo \"Kabuk süreci: $$\"\n";
    etc_dosya("/usr/share/ornekler/selam.sh", betik, 493);
    metin sayac = "#!/bin/sh\n";
    sayac += "# Arka planda saniyede bir yazar: sh /usr/share/ornekler/sayac.sh 5 &\n";
    sayac += "echo \"sayaç başladı ($1 adım)\"\n";
    sayac += "sleep 1 && echo \"  tik 1\"\n";
    sayac += "sleep 1 && echo \"  tik 2\"\n";
    sayac += "sleep 1 && echo \"  tik 3\"\n";
    sayac += "echo \"sayaç bitti\"\n";
    etc_dosya("/usr/share/ornekler/sayac.sh", sayac, 493);
}

fonk bin_kur() -> bos {
    sayi bin = fs_coz("/bin");
    liste[metin] adlar;
    her (oto ad in g_komut) { adlar.ekle(ad); }
    her (oto ad in adlari_sirala(adlar)) {
        eger (ad == "." || ad == "[") { devam; }
        sayi no = fs_dugum_ekle(bin, ad, D_DOSYA, 493);
        g_fs[no].veri = "#!/yerlesik/" + ad + "\n";
    }
}

// Diskleri tarar; ext4 kökü bağlar ("uppix-kok" etiketli olan önce). Dönüş: kök ext4 mü.
fonk diskleri_kur() -> mantik {
    blok_tara();
    her (oto b in g_blok) {
        metin tanim = "/dev/" + b.ad + ": " + boyut_insan(b.sektor * 512);
        eger (b.bolum == 0) { tanim += " " + upp.cekirdek.disk_model(b.disk); }
        eger (b.fs != "") { tanim += ", " + b.fs; }
        eger (b.etiket != "") { tanim += " \"" + b.etiket + "\""; }
        klog("blok: " + tanim);
    }
    sayi kok = -1;
    dongu (sayi i = 0; i < g_blok.uzunluk(); i += 1) {
        eger (g_blok[i].fs == "ext4" && (kok < 0 || g_blok[i].etiket == "uppix-kok")) {
            eger (kok < 0 || g_blok[kok].etiket != "uppix-kok") { kok = i; }
        }
    }
    eger (kok < 0) {
        klog("kök: ext4 disk bulunamadı, RAM'deki rootfs kullanılıyor");
        don yanlis;
    }
    eger (fs_bagla("ext4", "/dev/" + g_blok[kok].ad, kok, 0, yanlis) < 0) {
        klog("kök: /dev/" + g_blok[kok].ad + " bağlanamadı: " + g_fs_hata);
        don yanlis;
    }
    metin kip = "rw";
    eger (g_bag[g_fs[0].bag].salt_okunur) { kip = "ro (desteklenmeyen özellik)"; }
    klog("ext4: /dev/" + g_blok[kok].ad + " kök (/) olarak bağlandı, " + kip);
    don dogru;
}

// Kök dışındaki dosya sistemlerini /mnt/<aygıt> altına bağlar.
fonk diger_diskleri_bagla() -> bos {
    sayi mnt = fs_coz("/mnt");
    dongu (sayi i = 0; i < g_blok.uzunluk(); i += 1) {
        eger (g_blok[i].fs == "") { devam; }
        mantik bagli = yanlis;
        her (oto x in g_bag) {
            eger (x.etkin && x.aygit == "/dev/" + g_blok[i].ad) { bagli = dogru; }
        }
        eger (bagli) { devam; }
        // Önyükleme bölümü (Limine imajında "UPPIXBOOT") /boot'a bağlanır.
        mantik boot_bolumu = g_blok[i].fs == "vfat" && g_blok[i].etiket == "UPPIXBOOT";
        sayi d = -1;
        metin hedef = "/mnt/" + g_blok[i].ad;
        eger (boot_bolumu) {
            d = fs_dizin("/boot", 493);
            hedef = "/boot";
        } yoksa {
            d = fs_yeni(mnt, g_blok[i].ad, D_DIZIN, 493);
        }
        eger (d < 0) { devam; }
        eger (fs_bagla(g_blok[i].fs, "/dev/" + g_blok[i].ad, i, d, yanlis) < 0) {
            klog(g_blok[i].fs + ": /dev/" + g_blok[i].ad + " bağlanamadı: " + g_fs_hata);
            eger (!boot_bolumu) { fs_sil(d); }
        } yoksa {
            klog(g_blok[i].fs + ": /dev/" + g_blok[i].ad + " → " + hedef);
        }
    }
}

fonk ortam_kur() -> bos {
    g_ortam.koy("HOME", "/root");
    g_ortam.koy("USER", "root");
    g_ortam.koy("LOGNAME", "root");
    g_ortam.koy("SHELL", "/bin/sh");
    g_ortam.koy("PATH", "/bin:/usr/bin");
    g_ortam.koy("TERM", "vt100");
    g_ortam.koy("HOSTNAME", "uppix");
    g_ortam.koy("PWD", "/root");
}

fonk uppix_baslat() -> bos {
    upp.cekirdek.ekran_temizle();
    upp.satir_yaz("\e[1;36mUppix " + UPPIX_SURUM + "\e[0m — u++ ile yazılmış Unix benzeri işletim sistemi");
    metin onyukleyici = upp.cekirdek.onyukleyici();
    eger (onyukleyici == "") { onyukleyici = "bilinmiyor"; }
    klog("Uppix " + UPPIX_SURUM + " çekirdeği başlıyor (x86_64 long mode, önyükleyici: " + onyukleyici + ")");
    klog("ekran: " + upp.cekirdek.ekran());
    klog("işlemci: " + upp.cekirdek.islemci());
    klog("bellek: {upp.cekirdek.bellek_toplam() / 1048576} MiB RAM, çekirdek yığını {upp.cekirdek.yigin_boyut() / 1048576} MiB");
    klog("kesmeler: IDT 48 giriş, PIC yeniden eşlendi, PIT 1000 Hz");
    klog("girdi: PS/2 klavye (Türkçe Q), COM1 seri 115200");
    klog("saat: CMOS RTC " + upp.cekirdek.tarih() + " UTC");
    zaman_kur();
    ext4_kaydet();
    fat_kaydet();
    exfat_kaydet();
    fs_kok_kur();
    mantik disk_kok = diskleri_kur();
    fs_sanal_kur();
    klog("procfs: /proc, devfs: /dev, tmpfs: /tmp ve /mnt bağlandı");
    diger_diskleri_bagla();
    ortam_kur();
    komutlari_kur();
    etc_kur();
    bin_kur();
    sayi hn = fs_coz("/etc/hostname");
    eger (hn >= 0) {
        metin ad = upp.metin.kirp(fs_oku(hn));
        eger (ad != "") { g_ortam.koy("HOSTNAME", ad); }
    }
    eger (!disk_kok) { klog("rootfs: kalıcı değil; değişiklikler kapatınca kaybolur"); }
    klog("uppsh: {g_komut.uzunluk()} yerleşik komut /bin altında");
    klog("görevler: işbirlikçi zamanlayıcı hazır (en çok 32 görev)");
    g_cwd = fs_coz("/root");
    liste[metin] profil_arg;
    profil_arg.ekle("source");
    profil_arg.ekle("/etc/profile");
    k_source(profil_arg, yok);
    terminale_yaz(fs_oku(fs_coz("/etc/motd")));
    kabuk_dongu();
    fs_tum_ayir();
    upp.satir_yaz("Oturum kapandı.");
    upp.cekirdek.kapat();
}
