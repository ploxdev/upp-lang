// Uppix — u++ ile yazılmış Unix benzeri işletim sistemi.
// Bu dosya açılışı yapar: çekirdek günlüğü, dosya sistemi, /etc, komut tablosu,
// /etc/profile ve oturum kabuğu. Giriş noktası uppix_baslat()'tır.

kullan "yardimci.upp";
kullan "cikti.upp";
kullan "vfs.upp";
kullan "blok.upp";
kullan "ext4.upp";
kullan "fat.upp";
kullan "exfat.upp";
kullan "satir.upp";
kullan "kabuk.upp";
kullan "komut_dosya.upp";
kullan "komut_metin.upp";
kullan "komut_sistem.upp";
kullan "komut_disk.upp";

sabit metin UPPIX_SURUM = "0.3.0";

liste[metin] g_dmesg;

fonk klog(metin m) -> bos {
    sayi t = upp.zaman();
    metin z = "[" + sag_hizala("{t / 1000}", 5) + "." + sifir_doldur(t % 1000, 3) + "] " + m;
    g_dmesg.ekle(z);
    upp.satir_yaz("\e[90m" + z + "\e[0m");
}

