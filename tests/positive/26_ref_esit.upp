// Pozitif: &metin == / !=
// @stdout
// 1
// 1
// 1

fonk ana() -> sayi {
    metin s = "test";
    &metin v = s;
    eger (v == "test") {
        upp.satir_yaz("1");
    } yoksa {
        upp.satir_yaz("0");
    }
    &metin v2 = s;
    eger (v == v2) {
        upp.satir_yaz("1");
    } yoksa {
        upp.satir_yaz("0");
    }
    eger (v != "x") {
        upp.satir_yaz("1");
    } yoksa {
        upp.satir_yaz("0");
    }
    don 0;
}
