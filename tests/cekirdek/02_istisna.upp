// Çekirdek: işlemci istisnası (ud2) Türkçe panik mesajı verir ve QEMU kapanır
// @icerir: işlemci istisnası #6 (geçersiz işlem kodu)

fonk ana() -> sayi {
    upp.satir_yaz("istisna öncesi");
    guvensiz {
        c_kod {
            __asm__ volatile("ud2");
        }
    }
    upp.satir_yaz("ulaşılmamalı");
    don 0;
}
