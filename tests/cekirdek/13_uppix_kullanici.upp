// Çekirdek: Uppix kullanıcı kipi (ring 3) ve Linux x86_64 uyumlu sistem çağrıları.
// /usr/bin'deki programlar libc'siz statik Linux ELF'leridir (src/os/kullanici/*.c).
// Sınananlar: argv/exit kodu, 12 sistem çağrısı (sctest), terminal ioctl'u, boru,
// SIGSEGV'de yalnızca sürecin sonlanması, zaman dilimiyle kesilen sonsuz döngü ve kill.
// Denetim: aynı sctest ikilisi gerçek Linux'ta çalıştırılır; çıktısı Uppix'teki
// çıktıyla satır satır aynı olmalıdır.
// @gerek: cc mkfs.ext4 e2fsck debugfs sfdisk mkfs.fat fsck.fat mcopy
// @hazirla: rm -rf tests/_cikti/kullanici_img
// @bayrak: --onyukleyici limine --disk tests/_cikti/kullanici_img/uppix.img --disk-hazirla src/os/disk_yap.sh
// @girdi: merhaba bir iki --cik; echo kod=$?
// @girdi: sctest
// @girdi: ekran
// @girdi: echo boru verisi | ucat
// @girdi: cokme; echo kod=$?
// @girdi: dongu &
// @girdi: echo kabuk yanit veriyor
// @girdi: kill %1
// @girdi: dmesg | grep -c "kullanıcı kipi: ring 3"
// @girdi: poweroff
// @icerir: Merhaba, ring 3! Linux sistem çağrılarıyla konuşuyorum.
// @icerir: argv[2] = iki
// @icerir: kod=7
// @icerir: === sctest bitti ===
// @icerir: terminal: 160 sütun x 50 satır
// @icerir: boru verisi
// @icerir: Bölümleme hatası (SIGSEGV): komut
// @icerir: kod=139
// @icerir: kabuk yanit veriyor
// @icerir: Sistem kapatılıyor...
// @denetle: test -x tests/_cikti/kullanici_img/kullanici/sctest
// @denetle: K=$(pwd) && D=$(mktemp -d) && cd "$D" && "$K/tests/_cikti/kullanici_img/kullanici/sctest" > linux.txt && cd "$K" && sed -n '/=== sctest başla/,/=== sctest bitti/p' tests/_cikti/ck_13_uppix_kullanici.konsol | tr -d '\r' > "$D/uppix.txt" && diff "$D/linux.txt" "$D/uppix.txt" && rm -rf "$D"
// @denetle: dd if=tests/_cikti/kullanici_img/uppix.img of=/tmp/upp_kul_p2.img bs=1M skip=65 status=none && e2fsck -fn /tmp/upp_kul_p2.img && rm -f /tmp/upp_kul_p2.img

kullan "../../src/os/kaynak/uppix.upp";

fonk ana() -> sayi {
    uppix_baslat();
    don 0;
}
