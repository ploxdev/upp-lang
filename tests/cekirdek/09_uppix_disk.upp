// Çekirdek: Uppix ext4 kökten açılır, FAT32 (MBR bölümü) ve exFAT diskleri tanır, üçüne de yazar.
// Yazılanlar QEMU kapandıktan sonra Linux araçlarıyla (e2fsck, debugfs, fsck.fat, mtools, fsck.exfat) denetlenir.
// @gerek: mkfs.ext4 e2fsck debugfs sfdisk mkfs.fat fsck.fat mcopy mtype mkfs.exfat fsck.exfat
// @hazirla: rm -rf tests/_cikti/disk && sh src/os/disk_yap.sh tests/_cikti/disk
// @bayrak: --disk tests/_cikti/disk/uppix-kok.img --disk tests/_cikti/disk/usb-fat32.img --disk tests/_cikti/disk/usb-exfat.img
// @girdi: lsblk
// @girdi: mount | grep sd
// @girdi: cat /etc/hostname
// @girdi: cat "/mnt/sdb1/Türkçe uzun dosya adı.txt"
// @girdi: cat /mnt/sdb1/Belgeler/notlar.txt
// @girdi: echo "ext4 kalıcı veri" > /root/kalici.txt
// @girdi: mkdir -p /home/arda/belgeler && echo derin > /home/arda/belgeler/a.txt
// @girdi: seq 300 > /home/arda/sayilar.txt && wc -l /home/arda/sayilar.txt
// @girdi: echo "FAT32 yazıldı" > "/mnt/sdb1/Uppix Notu.txt"
// @girdi: mkdir /mnt/sdb1/Yedek && cp /root/kalici.txt /mnt/sdb1/Yedek/
// @girdi: rm /mnt/sdb1/BENIOKU.TXT
// @girdi: echo "exFAT yazıldı" > /mnt/sdc/ilk.txt && mkdir /mnt/sdc/Klasör && echo içerik > /mnt/sdc/Klasör/iç.txt
// @girdi: mv /mnt/sdc/ilk.txt /mnt/sdc/Klasör/tasindi.txt && ls /mnt/sdc/Klasör | tr '\n' ' '
// @girdi: chmod 700 /root/kalici.txt && ls -l /root/kalici.txt | cut -c 1-10
// @girdi: df -h | grep sd
// @girdi: poweroff
// @icerir: sda       64M disk  ext4   uppix-kok        /
// @icerir: /dev/sdb1 on /mnt/sdb1 type vfat (rw)
// @icerir: /dev/sdc on /mnt/sdc type exfat (rw)
// @icerir: Uzun ve Türkçe bir dosya adı: şğüöçı ŞĞÜÖÇİ
// @icerir: alışveriş: ekmek, süt
// @icerir: 300 /home/arda/sayilar.txt
// @icerir: iç.txt tasindi.txt
// @icerir: -rwx------
// @icerir: Sistem kapatılıyor...
// @denetle: e2fsck -fn tests/_cikti/disk/uppix-kok.img
// @denetle: debugfs -R 'cat /root/kalici.txt' tests/_cikti/disk/uppix-kok.img 2>/dev/null | grep -q 'ext4 kalıcı veri'
// @denetle: debugfs -R 'cat /home/arda/sayilar.txt' tests/_cikti/disk/uppix-kok.img 2>/dev/null | tail -1 | grep -qx 300
// @denetle: dd if=tests/_cikti/disk/usb-fat32.img of=/tmp/upp_fat_p1.img bs=512 skip=2048 status=none && fsck.fat -n /tmp/upp_fat_p1.img
// @denetle: mtype -i tests/_cikti/disk/usb-fat32.img@@1M '::/Uppix Notu.txt' | grep -q 'FAT32 yazıldı'
// @denetle: mtype -i tests/_cikti/disk/usb-fat32.img@@1M ::/Yedek/kalici.txt | grep -q 'ext4 kalıcı veri'
// @denetle: ! mtype -i tests/_cikti/disk/usb-fat32.img@@1M ::/BENIOKU.TXT >/dev/null 2>&1
// @denetle: fsck.exfat -n tests/_cikti/disk/usb-exfat.img

kullan "../../src/os/kaynak/uppix.upp";

fonk ana() -> sayi {
    uppix_baslat();
    don 0;
}
