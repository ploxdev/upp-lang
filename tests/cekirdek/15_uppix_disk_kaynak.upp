// Çekirdek: Uppix disk kaynaklarının geri verilmesi.
// - ext4: Linux'ta fallocate ile önceden ayrılmış (yazılmamış kapsamlı) bir dosya
//   Uppix'te sıfır okunur; silinince blokları bırakılır (e2fsck bitmap farkı yok).
// - FAT32: bölüm art arda ayrılıp yeniden bağlanır; FAT sektör tamponu her
//   ayırmada bırakılır, yeniden bağlamada okuma ve yazma çalışır.
// @gerek: mkfs.ext4 e2fsck debugfs sfdisk mkfs.fat fsck.fat mcopy mtype mkfs.exfat
// @hazirla: rm -rf tests/_cikti/disk15 && sh src/os/disk_yap.sh tests/_cikti/disk15 && printf 'cd /root\nwrite /dev/null fa.bin\nfallocate fa.bin 0 99\nsif fa.bin size 409600\n' > tests/_cikti/disk15/dk && debugfs -w -f tests/_cikti/disk15/dk tests/_cikti/disk15/uppix-kok.img && debugfs -R 'stat /root/fa.bin' tests/_cikti/disk15/uppix-kok.img 2>/dev/null | grep -q '\[u\]'
// @bayrak: --disk tests/_cikti/disk15/uppix-kok.img --disk tests/_cikti/disk15/usb-fat32.img
// @girdi: wc -c /root/fa.bin
// @girdi: hexdump -C -n 32 /root/fa.bin
// @girdi: rm /root/fa.bin && echo fa-silindi
// @girdi: umount /mnt/sdb1 && mkdir -p /mnt/u && mount /dev/sdb1 /mnt/u && cat "/mnt/u/Türkçe uzun dosya adı.txt"
// @girdi: umount /mnt/u && mount /dev/sdb1 /mnt/u && echo "ikinci bağlama" > /mnt/u/ikinci.txt && umount /mnt/u
// @girdi: mount /dev/sdb1 /mnt/u && cat /mnt/u/ikinci.txt && umount /mnt/u && echo fat-tamam
// @girdi: sync
// @girdi: poweroff
// @icerir: 409600 /root/fa.bin
// @icerir: 00000000  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
// @icerir: fa-silindi
// @icerir: Uzun ve Türkçe bir dosya adı: şğüöçı ŞĞÜÖÇİ
// @icerir: ikinci bağlama
// @icerir: fat-tamam
// @icerir: Sistem kapatılıyor...
// @denetle: e2fsck -fn tests/_cikti/disk15/uppix-kok.img
// @denetle: ! debugfs -R 'stat /root/fa.bin' tests/_cikti/disk15/uppix-kok.img 2>/dev/null | grep -q Inode
// @denetle: dd if=tests/_cikti/disk15/usb-fat32.img of=/tmp/upp_fat15_p1.img bs=512 skip=2048 status=none && fsck.fat -n /tmp/upp_fat15_p1.img && rm -f /tmp/upp_fat15_p1.img
// @denetle: mtype -i tests/_cikti/disk15/usb-fat32.img@@1M ::/ikinci.txt | grep -q 'ikinci bağlama'

kullan "../../src/os/kaynak/uppix.upp";

fonk ana() -> sayi {
    uppix_baslat();
    don 0;
}
