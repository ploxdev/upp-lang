{
  "name": "u-plus-plus",
  "displayName": "u++",
  "description": "u++: sözdizimi, snippet, hover; native uppc ile tanı ve derleme.",
  "version": "3.0.1",
  "publisher": "u-plus-plus",
  "icon": "icons/upp-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:upp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "upp",
        "aliases": [
          "u++",
          "upp"
        ],
        "extensions": [
          ".upp",
          ".uph"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/upp-light.svg",
          "dark": "./icons/upp-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "upp",
        "scopeName": "source.upp",
        "path": "./syntaxes/upp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "upp",
        "path": "./snippets/upp.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "upp.derle",
        "title": "u++: Derle",
        "icon": "$(tools)",
        "enablement": "upp.uppcHazir"
      },
      {
        "command": "upp.calistir",
        "title": "u++: Çalıştır",
        "enablement": "upp.uppcHazir"
      },
      {
        "command": "upp.sadeceC",
        "title": "u++: Yalnızca C üret",
        "enablement": "upp.uppcHazir"
      },
      {
        "command": "upp.tara",
        "title": "u++: Derleyiciyi tara"
      },
      {
        "command": "upp.yolBelirt",
        "title": "u++: Derleyici yolu belirt"
      },
      {
        "command": "upp.durumMenu",
        "title": "u++: Derleyici menüsü"
      }
    ],
    "keybindings": [
      {
        "command": "upp.calistir",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == upp && resourceScheme == file && !inDebugMode && upp.uppcHazir"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "upp.derle",
          "when": "resourceLangId == upp && upp.uppcHazir",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "upp.derle",
          "when": "resourceLangId == upp && upp.uppcHazir",
          "group": "u++@1"
        },
        {
          "command": "upp.calistir",
          "when": "resourceLangId == upp && upp.uppcHazir",
          "group": "u++@2"
        }
      ],
      "commandPalette": [
        {
          "command": "upp.derle",
          "when": "upp.uppcHazir"
        },
        {
          "command": "upp.calistir",
          "when": "upp.uppcHazir"
        },
        {
          "command": "upp.sadeceC",
          "when": "upp.uppcHazir"
        }
      ]
    },
    "configurationDefaults": {
      "[upp]": {
        "editor.defaultFormatter": "u-plus-plus.u-plus-plus"
      }
    },
    "configuration": {
      "title": "u++",
      "properties": {
        "upp.uppcYolu": {
          "type": "string",
          "default": "",
          "description": "Native uppc yolu. Boşsa derleyici/uppc.exe (Windows) veya derleyici/uppc (Linux), sonra PATH."
        },
        "upp.ciktiKoku": {
          "type": "string",
          "default": "derleme",
          "description": "Kullanıcı programı .c / .exe çıktı klasörü (repo köküne göre)."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "upp",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "derle | calistir | sadece-c"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "upp-hata",
        "owner": "upp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^\\[u\\+\\+ HATA\\] Satır (\\d+)(?::(\\d+))?(?:\\s*\\(([^)]*)\\))?: (.*)$",
          "line": 1,
          "column": 2,
          "file": 3,
          "message": 4
        }
      },
      {
        "name": "upp-guvenlik",
        "owner": "upp",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^\\[u\\+\\+ BELLEK GÜVENLİĞİ İHLALİ\\] Satır (\\d+)(?::(\\d+))?(?:\\s*\\(([^)]*)\\))?: (.*)$",
          "line": 1,
          "column": 2,
          "file": 3,
          "message": 4
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/kesif.test.js out-test/test/surum.test.js out-test/test/tani.test.js out-test/test/sozluk.test.js out-test/test/nesil.test.js out-test/test/kayit.test.js out-test/test/ciktiYol.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.5"
  }
}
